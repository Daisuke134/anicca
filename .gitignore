# Sessions & logs (large, regenerated)
agents/*/sessions/*.jsonl
agents/*/sessions/*.jsonl.reset.*
agents/*/sessions/*.jsonl.deleted.*
agents/*/sessions/sessions.json
cron/runs/*.jsonl
logs/*.log

# Binary / media (too large for git)
*.mp4
*.mov
*.sqlite
*.b64
media/inbound/*

# Workspace generated media (PNGs in work dirs)
workspace/tiktok-marketing/work/**/*.png
workspace/tiktok-marketing/work/**/*.mp4
workspace/tiktok-marketing/work/**/*.mov
workspace/tiktok-marketing/ugc-library/**/*.mp4
workspace/tiktok-marketing/ugc-library/**/*.mov
workspace/ugc-library/**/*.mp4
workspace/ugc-library/**/*.mov

# Node modules
**/node_modules/

# Large workspace generated assets (renderings, slides, UGC)
workspace/mau-tiktok/hooks/
workspace/mau-tiktok/output/
workspace/mau-tiktok/cta-video/
workspace/tiktok-marketing/assets/6-slide-images/
workspace/tiktok-marketing/posts/
workspace/tiktok-marketing/ugc-library/
workspace/tiktok-marketing/work/
workspace/tiktok-marketing/work-*/
workspace/ugc-library/

# Auth (secrets)
agents/*/agent/auth-profiles.json

.env
*.env
skills/_shared/venv-cloak/

# Personal data (single source) — never commit
identity/profile.json
identity/scrub-patterns.json
skills/*/state/
skills/*/data/
skills/*/work/
skills/*/pdfs/
skills/*/queue/
skills/*/state/wallet.encrypted
skills/*/state/MNEMONIC_BACKUP_ONCE.txt

# Spec 12 — adapter state (sessions, DM logs, call logs all chmod 600)
adapters/custom/*/state/
state/adapter-test-log.jsonl
state/last-captcha-block.txt
# Exception: submitted proposals are evidence — kept in repo per HARD RULE #14
!adapters/custom/lancers/state/
adapters/custom/lancers/state/*
!adapters/custom/lancers/state/proposals/
!adapters/custom/coconala/state/
adapters/custom/coconala/state/*
!adapters/custom/coconala/state/proposals/
