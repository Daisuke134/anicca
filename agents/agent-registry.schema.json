{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aniccaai.com/schemas/life-manager-agent-registry-v1.json",
  "title": "Life Manager Agent Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_docs", "agents"],
  "properties": {
    "schema_version": { "const": 1 },
    "$schema": { "type": "string" },
    "generated_docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readme", "readme_ja", "catalog"],
      "properties": {
        "readme": { "type": "string" },
        "readme_ja": { "type": "string" },
        "catalog": { "type": "string" }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/agent" }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "display_name",
        "organ",
        "parent_agent_id",
        "objective",
        "objective_ja",
        "lifecycle",
        "deployments",
        "decision_owner",
        "skills",
        "tools",
        "loop_adapters",
        "runtime_families",
        "effect_classes",
        "source_refs",
        "evidence_refs"
      ],
      "properties": {
        "agent_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
        "display_name": { "type": "string", "minLength": 1 },
        "organ": { "enum": ["executive", "health", "finance", "growth", "technology", "opportunity"] },
        "parent_agent_id": { "type": ["string", "null"] },
        "objective": { "type": "string", "minLength": 1 },
        "objective_ja": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["live", "shadow", "legacy_live", "dormant", "planned", "deprecated"] },
        "deployments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["local", "cloud"] }
        },
        "decision_owner": { "const": "model" },
        "skills": { "$ref": "#/$defs/stringArray" },
        "tools": { "$ref": "#/$defs/stringArray" },
        "loop_adapters": { "$ref": "#/$defs/stringArray" },
        "runtime_families": { "$ref": "#/$defs/stringArray" },
        "effect_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["none", "read", "draft", "message", "publish", "money"] }
        },
        "source_refs": { "$ref": "#/$defs/stringArray" },
        "evidence_refs": { "$ref": "#/$defs/stringArray" }
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
