<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Spec 10 — microtask 10.T7. Template launchd plist.
  Replace <USER> with the unix username (e.g. `anicca`) before installing:
    sed "s/<USER>/$USER/g" ai.anicca.agentmail-webhook.plist \
      > ~/Library/LaunchAgents/ai.anicca.agentmail-webhook.plist
    launchctl unload ~/Library/LaunchAgents/ai.anicca.agentmail-webhook.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/ai.anicca.agentmail-webhook.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.agentmail-webhook</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/&lt;USER&gt;/anicca-oss/runtime/agentmail/launch.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/&lt;USER&gt;/anicca-oss/runtime/agentmail</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>AGENTMAIL_WEBHOOK_PORT</key>
    <string>8810</string>
    <key>AGENTMAIL_QUEUE_PATH</key>
    <string>/Users/&lt;USER&gt;/.openclaw/state/inbox-queue.jsonl</string>
    <key>NODE_BIN</key>
    <string>/opt/homebrew/bin/node</string>
    <!--
      AGENTMAIL_WEBHOOK_SECRET (and AGENTMAIL_API_KEY) are sourced by
      launch.sh from ~/.openclaw/.env at startup. Do NOT inline secrets here.
    -->
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/&lt;USER&gt;/.openclaw/logs/agentmail-webhook.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/&lt;USER&gt;/.openclaw/logs/agentmail-webhook.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
