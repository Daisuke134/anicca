<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Spec 10 round 3 — Anicca's daily Reply-Zero nudge sweep.
  Fires once per day at 09:00 local time. Picks any awaiting_reply row where
  Anicca sent >24h ago and the counterparty stayed silent, then sends a polite
  follow-up. Caps at 1 nudge per thread (override via NUDGE_MAX_COUNT env).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.agentmail-nudge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/&lt;USER&gt;/anicca-oss/runtime/agentmail/nudge-tick.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/&lt;USER&gt;/anicca-oss/runtime/agentmail</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>NODE_BIN</key>
    <string>/opt/homebrew/bin/node</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/&lt;USER&gt;/.openclaw/logs/agentmail-nudge.launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/&lt;USER&gt;/.openclaw/logs/agentmail-nudge.launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
