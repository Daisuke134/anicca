<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Spec 10 round 3 — Anicca's autonomous reply cron.
  Fires every 300 seconds (= 5 minutes). Drains the webhook queue into
  SQLite and replies to any unreplied inbound mail.
  Install:
    sed "s/<USER>/$USER/g" ai.anicca.agentmail-replier.plist \
      > ~/Library/LaunchAgents/ai.anicca.agentmail-replier.plist
    launchctl unload ~/Library/LaunchAgents/ai.anicca.agentmail-replier.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/ai.anicca.agentmail-replier.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.agentmail-replier</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/&lt;USER&gt;/anicca-oss/runtime/agentmail/replier-tick.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/&lt;USER&gt;/anicca-oss/runtime/agentmail</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>NODE_BIN</key>
    <string>/opt/homebrew/bin/node</string>
  </dict>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/&lt;USER&gt;/.openclaw/logs/agentmail-replier.launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/&lt;USER&gt;/.openclaw/logs/agentmail-replier.launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
