{
  "version": 1,
  "scope": "life-manager",
  "timeout_seconds": 900,
  "providers": {
    "codex": {
      "executable": "codex",
      "automation_home": "~/.local/state/life-manager/codex-runner",
      "auth_file": "~/.codex/auth.json",
      "ssl_cert_file": "/etc/ssl/cert.pem",
      "project_doc_max_bytes": 0,
      "disabled_skills": ["imagegen", "openai-docs", "plugin-creator", "skill-creator", "skill-installer"],
      "disabled_features": ["apps", "auth_elicitation", "browser_use", "browser_use_external", "browser_use_full_cdp_access", "computer_use", "goals", "hooks", "image_generation", "in_app_browser", "multi_agent", "plugins", "remote_plugin", "tool_call_mcp_elicitation", "tool_suggest", "workspace_dependencies"],
      "capabilities": {"structured_json": true, "tools": true, "browser": false},
      "cost_tier": "subscription",
      "quota": {"source": "provider"}
    },
    "openclaw": {
      "executable": "openclaw",
      "agent": "life-manager",
      "capabilities": {"structured_json": true, "tools": true, "browser": true},
      "model_capabilities": {
        "openai/gpt-5.4": {"tool_write": true}
      },
      "cost_tier": "free-fallback",
      "quota": {"source": "provider"}
    },
    "claude": {
      "executable": "claude",
      "executable_fallbacks": ["~/.local/bin/claude"],
      "base_url": "http://127.0.0.1:8317",
      "auth_token_file": "~/.cli-proxy-api-key",
      "capabilities": {"structured_json": true, "tools": true, "browser": true},
      "cost_tier": "subscription",
      "quota": {"source": "provider"}
    },
    "claude-direct": {
      "executable": "claude",
      "executable_fallbacks": ["~/.local/bin/claude"],
      "capabilities": {"structured_json": true, "tools": true, "browser": true},
      "cost_tier": "subscription",
      "quota": {"source": "provider"}
    }
  },
  "candidate_profiles": {
    "gig-paid-builder": {
      "task_class": "high-value-agent",
      "openclaw": {
        "agent": "gig-paid-builder",
        "sandbox": {
          "mode": "all",
          "workspaceAccess": "rw",
          "workspace": "~/gig/projects",
          "containerWorkspace": "/workspace",
          "sessionIsSandboxed": true,
          "elevated": false,
          "execHost": "sandbox"
        }
      }
    }
  },
  "task_classes": {
    "deterministic": {
      "route": "deterministic",
      "candidates": []
    },
    "composition-agent": {
      "route": "terra-medium-bounded",
      "token_reservation": 16384,
      "candidates": [
        {"provider": "codex", "model": "gpt-5.6-terra", "effort": "medium"},
        {"provider": "claude-direct", "model": "sonnet"}
      ]
    },
    "repeatable-agent": {
      "route": "luna-medium-decision",
      "token_reservation": 32768,
      "timeout_seconds": 90,
      "candidates": [
        {"provider": "codex", "model": "gpt-5.6-luna", "effort": "medium"},
        {"provider": "claude-direct", "model": "sonnet"}
      ]
    },
    "tool-agent": {
      "route": "terra-medium-bounded",
      "token_reservation": 24576,
      "timeout_seconds": 180,
      "candidates": [
        {"provider": "codex", "model": "gpt-5.6-terra", "effort": "medium"},
        {"provider": "claude-direct", "model": "sonnet"}
      ]
    },
    "browser-lane-agent": {
      "route": "terra-medium-bounded",
      "token_reservation": 24576,
      "_timeout_note": "Split from tool-agent 2026-07-27. The two jobs want opposite bounds: the reality auditor must stay short (180s) so it cannot itself become the stall, while the browser lanes need minutes. Measured on the apply lane: attempt-01 ran 174s against Coconala and was killed as transient_timeout with 289KB of progress already on stdout. Delivery, at 900s, completed; applications, at 180s, ran five times in a week. Scanning postings, opening each and writing a proposal is minutes of browser work, so the old cap made the lane structurally unable to finish. Same 900s as high-value-agent.",
      "timeout_seconds": 900,
      "candidates": [
        {"provider": "codex", "model": "gpt-5.6-terra", "effort": "medium"},
        {"provider": "claude-direct", "model": "sonnet"}
      ]
    },
    "application-lane-agent": {
      "route": "terra-medium-exhaustive-application",
      "token_reservation": 24576,
      "_timeout_note": "B2-only route. Measured 2026-07-29: newest plus 27 category sources plus keyword/pagination had traversed only the first category after three minutes. The shared 900s browser bound contradicts the exhaustive-search completion contract. One hour remains below the launcher's 7200s runaway guard while allowing the money-entry lane to search before it returns.",
      "timeout_seconds": 3600,
      "candidates": [
        {"provider": "codex", "model": "gpt-5.6-terra", "effort": "medium"},
        {"provider": "claude-direct", "model": "sonnet"}
      ]
    },
    "diagnostic-agent": {
      "route": "luna-medium-decision",
      "token_reservation": 32768,
      "timeout_seconds": 120,
      "candidates": [
        {"provider": "codex", "model": "gpt-5.6-luna", "effort": "medium"},
        {"provider": "claude-direct", "model": "sonnet"}
      ]
    },
    "marketing-agent": {
      "route": "luna-medium-decision",
      "token_reservation": 49152,
      "timeout_seconds": 900,
      "candidates": [
        {"provider": "codex", "model": "gpt-5.6-luna", "effort": "medium"},
        {"provider": "claude-direct", "model": "sonnet"}
      ]
    },
    "high-value-agent": {
      "route": "luna-medium-decision",
      "token_reservation": 65536,
      "timeout_seconds": 900,
      "candidates": [
        {"provider": "codex", "model": "gpt-5.6-luna", "effort": "medium"},
        {"provider": "claude-direct", "model": "sonnet"}
      ]
    },
    "escalation-agent": {
      "route": "explicit-escalation",
      "requires_explicit_escalation": true,
      "token_reservation": 65536,
      "timeout_seconds": 900,
      "candidates": [
        {"provider": "codex", "model": "gpt-5.6-sol", "effort": "medium"},
        {"provider": "codex", "model": "gpt-5.6-luna", "effort": "high"},
        {"provider": "claude-direct", "model": "sonnet"}
      ]
    }
  }
}
