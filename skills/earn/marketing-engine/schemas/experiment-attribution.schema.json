{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aniccaai.com/schemas/experiment-attribution.schema.json",
  "title": "Marketing experiment attribution snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attribution_id", "observed_at", "publish_key",
    "experiment_id", "creative_id", "product_id", "account_id", "hook_id",
    "renderer_id", "attribution_token", "postiz_post_id", "native_post_id",
    "native_post_url", "published_at", "results"
  ],
  "properties": {
    "schema_version": {"const": "marketing.experiment-attribution.v1"},
    "attribution_id": {"type": "string", "pattern": "^attribution\\.[a-f0-9]{24}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "publish_key": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "creative_id": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "account_id": {"type": "string", "minLength": 1},
    "hook_id": {"type": "string", "minLength": 1},
    "renderer_id": {"type": "string", "minLength": 1},
    "attribution_token": {"type": "string", "minLength": 1},
    "postiz_post_id": {"type": "string", "minLength": 1},
    "native_post_id": {"type": "string", "minLength": 1},
    "native_post_url": {"type": "string", "format": "uri"},
    "published_at": {"type": "string", "format": "date-time"},
    "results": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_name", "status", "value", "unit", "source",
        "attribution_class", "confidence", "window_start", "window_end",
        "evidence_refs", "null_reason", "model"
      ],
      "properties": {
        "metric_name": {"enum": ["impressions", "views", "qualified_clicks", "first_time_downloads", "installs", "trials", "paid_orders", "refunds", "gross_revenue", "net_revenue"]},
        "status": {"enum": ["observed", "not_mature", "unavailable", "unknown"]},
        "value": {"type": ["number", "null"], "minimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "attribution_class": {"enum": ["deterministic", "apple_aggregate", "modeled", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "null_reason": {"type": ["string", "null"]},
        "model": {"type": ["object", "null"]}
      }
    }
  }
}
