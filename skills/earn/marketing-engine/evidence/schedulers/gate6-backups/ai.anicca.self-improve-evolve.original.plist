<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.anicca.self-improve-evolve</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>/Users/anicca/anicca/skills/earn/self-improve/run_evolve.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/anicca/anicca/skills/earn/self-improve</string>
  <!-- launchd gives jobs a minimal default PATH (no user/project customization). run_evolve.sh
       itself invokes openevolve-run by an absolute $HOME-expanded path so it does not strictly
       need PATH, but this is set anyway so any future step (python3, pip, etc.) run under this
       job still resolves the durable venv first, and so the wiring is self-documenting. -->
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/Users/anicca/.anicca-venvs/self-improve/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>HOME</key><string>/Users/anicca</string>
  </dict>
  <key>StartInterval</key><integer>21600</integer><key>ThrottleInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>/Users/anicca/.openclaw/logs/self-improve-evolve-launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/anicca/.openclaw/logs/self-improve-evolve-launchd.err.log</string>
</dict></plist>
