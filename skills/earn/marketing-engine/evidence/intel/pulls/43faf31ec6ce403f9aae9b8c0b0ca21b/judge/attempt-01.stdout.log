\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5ulul\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2qo05\", \"text\": \"\\n楽天市場を見ている人の多くは、\\n\\nすでに欲しい商品が決まっていたり、\\n複数の商品を比較していたりします。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"966oc\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2nqn4\", \"text\": \"つまり、ゼロから欲しくさせるのではなく、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 12, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"ajlo2\", \"text\": \"「どれを選べばいいか？」\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 7, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"8hj8l\", \"text\": \"を手伝えばいいんですよね。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fau3r\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"7ng11\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 16, \"offset\": 6, \"style\": \"Bold\"}], \"key\": \"5hvsn\", \"text\": \"2つ目は、\\n紹介できる商品の数が圧倒的に多いこと。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d61c4\", \"text\": \"\\n家電。コスメ。食品。日用品。\\nインテリア。アウトドア用品。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"9ifc4\", \"text\": \"⤴︎\\n生活の中で買うものの多くが、そのまま記事ネタになります。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"76p83\", \"text\": \"\\nしかも、新商品や季節商品も増えるので、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 25, \"offset\": 0, \"style\": 