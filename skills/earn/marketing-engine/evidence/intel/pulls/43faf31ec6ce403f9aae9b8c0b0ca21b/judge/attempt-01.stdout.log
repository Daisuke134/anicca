: \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 15, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"ae8s6\", \"text\": \"・Claude Codeの導入\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 10, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"fc18k\", \"text\": \"・記事作成プロンプト\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 11, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"f01d8\", \"text\": \"・比較記事テンプレート\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 14, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"8hk9v\", \"text\": \"・Threadsへの展開方法\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 11, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"ejcvd\", \"text\": \"・毎日の作業ルーティン\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 12, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"6a1j9\", \"text\": \"・分析と改善方法\\n〜〜〜\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d5j0b\", \"text\": \"までまとめています。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"69gur\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"csccc\", \"text\": \"「Claude Code×楽天アフィ」に挑戦したい方は\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"rhcm\", \"text\": \"ぜひプレゼントnoteを学んでください。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"29ukd\", \"text\": \"▼▼▼\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 33, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"7t4os\", \"text\": \"【Claude Code×楽天アフィ\\n　完全マニュアルを受け取る】\", \"type\": \"unstyled\"}, {\"data\": {\"urls\": [{\"fromIndex\": 0, \"text\": \"https://lin.ee/tDExHne\", \"toIndex\": 22}]}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d6oej\", \"text\": \"https://lin.ee/tDExHne\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2770k\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8912e\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"72oe3\", \"text\": \"●最後に\", \"type\": \"header-one\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cmuku\", \"text\": \"一番もったいないのは、\\n\\nClaude Codeについて調べ続けて、\\n一記事も作らずに終わることです。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ckdin\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"7vmvp\", \"text\": \"ジャンルを一つ決める。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"edf2m\", \"text\": \"読者の悩みを10個出す。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8af6h\", \"text\": \"記事の企画を一本作る。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3t9r7\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2deen\", \"text\": \"⤴︎まずは、これだけで十分です。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"9oeo4\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"53m9m\", \"text\": \"最初から、\\n完璧なサイトも、\\n100本の記事も必要ありません。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fvt6v\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cke1o\", \"text\": \"AIを使いこなせる人と、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 15, \"offset\": 45, \"style\": \"Bold\"}], \"key\": \"abn4j\", \"text\": \"情報を集め続ける人の差は、\\n実は知識量じゃないんですよ。\\n\\n\\n大事なのは、知ったあとに\\n\\n一度でも\\n手を動かしたかどうかです。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"976lt\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"foc92\", \"text\": \"まずはプレゼントを受け取って\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"db5d7\", \"text\": \"このあと、記事の企画を\\n一つだけ作ってみてください。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"e96bf\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fs37d\", \"text\": \"その一記事が、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"9brcl\", \"text\": \"あとから自分の代わりに働く\\n最初の資産になります。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"9bgh7\", \"text\": \"\", \"type\": \"header-two\"}], \"entityMap\": [{\"key\": \"12\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64e-200d-2640-fe0f.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"8\", \"value\": {\"data\": {\"entityKey\": \"0793b533-86eb-4a64-abe3-68b2b88354f7\", \"markdown\": \"```\\nあなたは商品比較記事の\\n企画担当者です。\\n以下のジャンルについて、\\n読者が商品を買う前に感じる悩みを\\n20個出してください。\\nジャンル：\\n【ここに入力】\\n想定読者：\\n【ここに入力】\\n条件：\\n・商品名ではなく悩みから考える\\n・生活場面が分かる内容にする\\n・似た悩みを重複させない\\n・複数商品を比較しやすくする\\n出力形式：\\n・読者の悩み\\n・悩みが起きる場面\\n・比較すべき項目\\n・記事タイトル案\\n```\"}, \"mutability\": \"Mutable\", \"type\": \"MARKDOWN\"}}, {\"key\": \"4\", \"value\": {\"data\": {\"entityKey\": \"d0da26a5-40cd-4fea-84e7-50201f3a9973\", \"markdown\": \"```\\nあなたは楽天アフィリエイトの\\nジャンル設計に詳しいマーケターです。\\n以下の情報をもとに、\\n初心者が記事を積み上げやすい\\nジャンル候補を5つ提案してください。\\n僕の情報：\\n・興味があること：\\n【ここに入力】\\n・過去に購入したもの：\\n【ここに入力】\\n・詳しいこと：\\n【ここに入力】\\n・想定読者：\\n【ここに入力】\\n条件：\\n・楽天市場で商品を複数探せる\\n・比較記事を20本以上作れる\\n・読者の悩みが具体的\\n・商品ごとの違いを説明しやすい\\n出力形式：\\n・ジャンル名\\n・想定読者\\n・読者の悩み\\n・比較項目\\n・記事テーマ例10個\\n```\"}, \"mutability\": \"Mutable\", \"type\": \"MARKDOWN\"}}, {\"key\": \"15\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f381.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"11\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"9\", \"value\": {\"data\": {\"entityKey\": \"ff064efb-6a77-4c54-a334-fefeaed3ab5d\", \"markdown\": \"```\\nあなたは楽天市場の商品比較に詳しい\\n編集者兼ライターです。\\n以下の商品情報をもとに、\\n購入を迷っている読者向けの\\n比較記事を作成してください。\\n記事テーマ：\\n【ここに入力】\\n想定読者：\\n【ここに入力】\\n比較する商品：\\n【商品名と公式情報を入力】\\n読者の悩み：\\n【ここに入力】\\n比較項目：\\n【価格・サイズ・機能など】\\n条件：\\n・提供した情報だけを使う\\n・不明な情報は「要確認」と書く\\n・使っていない商品を体験談として書かない\\n・すべての商品を無条件に褒めない\\n・良い点と気になる点を両方書く\\n・「絶対」「必ず」「誰でも」は使わない\\n・用途ごとにおすすめを分ける\\n・スマホで読みやすく改行する\\n構成：\\n①読者の悩みへの共感\\n②選ぶ基準\\n③比較表\\n④商品ごとの特徴\\n⑤良い点と気になる点\\n⑥向いている人、向かない人\\n⑦用途別の選び方\\n⑧まとめ\\n```\"}, \"mutability\": \"Mutable\", \"type\": \"MARKDOWN\"}}, {\"key\": \"13\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"16\", \"value\": {\"data\": {\"entityKey\": \"85571d0e-a16e-4f4a-9c17-ff250f92a5f7\", \"mediaItems\": [{\"localMediaId\": \"12\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083100714621120512\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"5\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/274c.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"10\", \"value\": {\"data\": {\"entityKey\": \"1aa76189-c466-4cd5-af7c-574e3e0210f8\", \"markdown\": \"```\\nあなたはThreads投稿の\\n編集担当者です。\\n以下の記事から、\\n読者に役立つ短文投稿を\\n5本作成してください。\\n記事本文：\\n【ここに記事を貼る】\\n想定読者：\\n【ここに入力】\\n条件：\\n・1投稿につき気づきは一つ\\n・記事を読まなくても役立つ\\n・共感、失敗回避、比較、意外性を混ぜる\\n・誇張表現や成果保証を使わない\\n・最後に自然な形で記事へつなげる\\n出力形式：\\n①共感型\\n②失敗回避型\\n③比較型\\n④意外性型\\n⑤チェックリスト型\\n```\"}, \"mutability\": \"Mutable\", \"type\": \"MARKDOWN\"}}, {\"key\": \"6\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/2b55.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"1\", \"value\": {\"data\": {\"entityKey\": \"380e64f8-eb52-4dfe-bd11-b07dfb7e68a9\", \"mediaItems\": [{\"localMediaId\": \"4\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083093358944333824\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"14\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64e-200d-2640-fe0f.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"0\", \"value\": {\"data\": {\"entityKey\": \"299d28ea-36b0-46b5-bd9c-bf590f5175d0\", \"mediaItems\": [{\"localMediaId\": \"2\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083087444791193600\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"2\", \"value\": {\"data\": {\"entityKey\": \"e91a6ab9-d88d-486e-9604-8a60f261c3dc\", \"mediaItems\": [{\"localMediaId\": \"6\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083093596589510656\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"7\", \"value\": {\"data\": {\"entityKey\": \"db6c091e-8759-4f6f-95b7-5cbeef572d12\", \"mediaItems\": [{\"localMediaId\": \"10\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083094116838395904\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"3\", \"value\": {\"data\": {\"entityKey\": \"e10dbac9-98da-4cbc-b67e-18fc29512e8e\", \"mediaItems\": [{\"localMediaId\": \"8\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083093826919616512\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}]}, \"created_at\": \"2026-07-31T09:12:18.000Z\", \"title\": \"Claude Code×楽天アフィで「自動販売機」を作るガイドブック【プロンプト付き】\"}\n{\"text\": \"「楽天アフィって\\n　単価も低いし、毎日大量に記事を書かないと\\n　稼げないやつでしょ」\"}\n{\"text\": \"\"}\n{\"text\": \"ぶっちゃけ、僕も\"}\n{\"text\": \"「楽天アフィも、結局は\\n　作業量で攻めるしかないんだろうな」\"}\n{\"text\": \"と思っていたんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"でも、Claude Code×楽天アフィの\\n仕組みを知って、去年から始めた結果\\n7月時点で“月36万”を1人で作れてしまいました（個人差はあります）。\"}\n{\"text\": \"\"}\n{\"text\": \"顔出しなし。\"}\n{\"text\": \"撮影なし。\"}\n{\"text\": \"文章が得意じゃなくてもOK。\"}\n{\"text\": \"\"}\n{\"text\": \"やることは、Claude Codeに\"}\n{\"text\": \"・商品リサーチ\\n・記事構成\\n・比較表\\n・紹介文\\n・Threads投稿\"}\n{\"text\": \"までまとめて作らせて、\"}\n{\"text\": \"自分は商品情報の確認と\\n経験やストーリーを加えるだけ。\"}\n{\"text\": \"\"}\n{\"text\": \"「いや、AIに記事を書かせて\\n　本当に収益につながるの？」\"}\n{\"text\": \"って思うかもしれません。\"}\n{\"text\": \"\"}\n{\"text\": \"僕も最初は、AIで作った文章なんて、\"}\n{\"text\": \"読者にバレるし、\"}\n{\"text\": \"検索にも評価されないし、\"}\n{\"text\": \"結局、売れないと思ってました。\"}\n{\"text\": \"\"}\n{\"text\": \"でも実際に、仕組みを分解してみると\\n他のアフィリエイトとは\"}\n{\"text\": \"『攻略パターンが少し違う』\"}\n{\"text\": \"と気づいたんです。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"というのも、理由が3つあって\"}\n{\"text\": \"\"}\n{\"text\": \"1つ目は、\\n楽天には“買う前提の人”が集まっていること。\"}\n{\"text\": \"\"}\n{\"text\": \"\\n楽天市場を見ている人の多くは、\\n\\nすでに欲しい商品が決まっていたり、\\n複数の商品を比較していたりします。\"}\n{\"text\": \"\"}\n{\"text\": \"つまり、ゼロから欲しくさせるのではなく、\"}\n{\"text\": \"「どれを選べばいいか？」\"}\n{\"text\": \"を手伝えばいいんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"2つ目は、\\n紹介できる商品の数が圧倒的に多いこと。\"}\n{\"text\": \"\\n家電。コスメ。食品。日用品。\\nインテリア。アウトドア用品。\"}\n{\"text\": \"⤴︎\\n生活の中で買うものの多くが、そのまま記事ネタになります。\"}\n{\"text\": \"\\nしかも、新商品や季節商品も増えるので、\"}\n{\"text\": \"ジャンルを一つ決めれば\\n記事テーマがほぼ尽きません。\"}\n{\"text\": \"\"}\n{\"text\": \"3つ目は、\\nClaude Codeで記事制作を\\n「作業→仕組み」に変えられること。\"}\n{\"text\": \"\"}\n{\"text\": \"楽天アフィで一番重いのは、\"}\n{\"text\": \"商品を調べて、\"}\n{\"text\": \"違いを整理して、\"}\n{\"text\": \"比較記事を書き、\"}\n{\"text\": \"さらにSNS用の投稿まで作る部分です。\"}\n{\"text\": \"\\n⤴︎\\nここを全部手作業でやると、\"}\n{\"text\": \"1記事作るだけで\\n普通に数時間かかります。\"}\n{\"text\": \"\"}\n{\"text\": \"でもClaude Codeなら、\\n一度ルールとテンプレートを作れば、\"}\n{\"text\": \"「商品名」や「読者の悩み」を変えながら、\\n同じ型で記事を積み上げられます。\"}\n{\"text\": \"\\nもちろん、AIに丸投げして\\nそのまま公開するわけではありません。\\n\"}\n{\"text\": \"価格。\\nサイズ。\\n商品の仕様。\\n在庫。\\n実際に使った感想。\"}\n{\"text\": \"⤴︎\\n信用に関わる部分は、必ず人間がチェックします。\"}\n{\"text\": \"\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n重い作業はAIに任せる。\\n\\nただし、\\n「売れる設計」と「事実確認」は自分がやる\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"⤴︎この役割分担ができると、\\n楽天アフィは\"}\n{\"text\": \"「毎日文章を書き続ける副業」\\nから、\"}\n{\"text\": \"『記事が積み上がる仕組みを作る副業』\"}\n{\"text\": \"に進化するんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"この記事では、\"}\n{\"text\": \"僕が実践してきて、初心者の方の場合だと\\nどうやって売れる仕組みを作るのか？\"}\n{\"text\": \"”Claude Code×楽天アフィの全体像”と、\"}\n{\"text\": \"そのまま使えるプロンプトまで\\n具体的に解説していきます。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"そもそも、\\n「Claude Code×楽天アフィ」とは？\"}\n{\"text\": \" \"}\n{\"text\": \"\\n全体の流れはシンプルです。\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n楽天市場から商品を探す\\n　↓\\nClaude Codeで情報を整理\\n　↓\\n比較・レビュー記事を作る\\n　↓\\n楽天アフィリンクを設置\\n　↓\\nThreadsから記事へ誘導\\n　↓\\nクリック・購入につなげる\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"ただし、Claude Codeは\\n\\n“自動で稼いでくれるツール”\\nではありません。\"}\n{\"text\": \"\"}\n{\"text\": \"得意なのは、\"}\n{\"text\": \"〜〜〜\\n・情報を整理する\"}\n{\"text\": \"・決まった構成で文章を作る\"}\n{\"text\": \"・複数の記事案を出す\"}\n{\"text\": \"・記事をSNS投稿へ変換する\"}\n{\"text\": \"・記事ファイルをまとめて管理する\\n〜〜〜\"}\n{\"text\": \"といった作業です。\"}\n{\"text\": \"\"}\n{\"text\": \"逆に、\"}\n{\"text\": \"〜〜〜\\n・商品情報が正しいか\"}\n{\"text\": \"・本当に読者に合うか\"}\n{\"text\": \"・価格や在庫が最新か\"}\n{\"text\": \"・誤解を招く表現がないか\\n〜〜〜\"}\n{\"text\": \"を確認するのは、自分の役割になるんですね。\"}\n{\"text\": \"\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n重い作業はAIに任せる\"}\n{\"text\": \"信用に関わる部分は人間が見る\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"⤴︎この分担が、収益化において\\nとても大切なんです。\"}\n{\"text\": \"\"}\n{\"text\": \"STEP①：最初にジャンルを一つ決める\"}\n{\"text\": \"初心者が最初にやるべきことは、\\nいきなり商品記事を書くことではありません。\"}\n{\"text\": \"まず、\"}\n{\"text\": \"『どのジャンルの記事を増やすか？』\"}\n{\"text\": \"⤴︎を決めます。\"}\n{\"text\": \"\"}\n{\"text\": \"たとえば、\"}\n{\"text\": \"〜〜〜\\n昨日は電気ケトル。\"}\n{\"text\": \"今日は化粧水。\"}\n{\"text\": \"明日はキャンプ用品。\"}\n{\"text\": \"次はお取り寄せグルメ。\\n〜〜〜\"}\n{\"text\": \"⤴︎こんな状態だと、\\n毎回ゼロから調べることになり、\\nAIを使っても普通に疲れます。笑\"}\n{\"text\": \"\"}\n{\"text\": \"最初は、\"}\n{\"text\": \"一つの大テーマを決めて\\nその中で商品を広げてください。\"}\n{\"text\": \"\"}\n{\"text\": \"たとえば、\"}\n{\"text\": \"━━━━━━━━\\n●一人暮らし用品\\n━━━━━━━━\"}\n{\"text\": \" \"}\n{\"text\": \"・小型家電\"}\n{\"text\": \"・収納グッズ\"}\n{\"text\": \"・キッチン用品\"}\n{\"text\": \"・掃除用品\\n\"}\n{\"text\": \"━━━━━━━━\\n●コスメ・スキンケア\\n━━━━━━━━\"}\n{\"text\": \" \"}\n{\"text\": \"・乾燥肌向け\"}\n{\"text\": \"・敏感肌向け\"}\n{\"text\": \"・時短ケア\"}\n{\"text\": \"・メンズコスメ\\n\"}\n{\"text\": \"━━━━━━━━\\n●食品・グルメ\\n━━━━━━━━\"}\n{\"text\": \" \"}\n{\"text\": \"・常温保存食品\"}\n{\"text\": \"・冷凍食品\"}\n{\"text\": \"・ギフト\"}\n{\"text\": \"・お取り寄せ\"}\n{\"text\": \"⤴︎\\nみたいなイメージです。\"}\n{\"text\": \"\"}\n{\"text\": \"ちなみに、\\nジャンルを選ぶときは、\\n↓の4つを確認してください。\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n①自分が興味を持てるか？\"}\n{\"text\": \"②商品を20個以上見つけられるか？\"}\n{\"text\": \"③商品ごとの違いを比較できるか？\"}\n{\"text\": \"④読者の悩みを具体的に出せるか？\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"\"}\n{\"text\": \"それでも、もし\\nジャンル選びに迷ったら、\\n↓のプロンプトが使えます。\"}\n{\"text\": \" \"}\n{\"text\": \"\"}\n{\"text\": \"AIに候補を出してもらったら、\\n楽天市場を実際に見て、\\n商品数や価格帯まで確認しましょう。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"STEP②：商品ではなく“買う前の悩み”を探す\"}\n{\"text\": \"ジャンルを決めたら、\\n次は記事テーマを探します。\"}\n{\"text\": \"\"}\n{\"text\": \"ただし、\"}\n{\"text\": \"「報酬が高い商品」だけで\\n考えるのはダメです。\"}\n{\"text\": \"\"}\n{\"text\": \"先に考えるのは、\"}\n{\"text\": \"『読者が何に迷っているか？』\"}\n{\"text\": \"⤴︎これが本質なんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"たとえば、\"}\n{\"text\": \"❌悪い例\\n　↓\\n楽天で売れている\\n電気ケトルを紹介する\"}\n{\"text\": \"\\n⭕️良い例\\n　↓\\n一人暮らしで場所を取らず、\\nコーヒー1杯分を沸かせる\\n電気ケトルを探している人向け\"}\n{\"text\": \"\"}\n{\"text\": \"同じ電気ケトルでも、\"}\n{\"text\": \"〜〜〜\\n・一人暮らし向け\"}\n{\"text\": \"・保温機能が欲しい人向け\"}\n{\"text\": \"・コーヒー用\"}\n{\"text\": \"・手入れ重視\"}\n{\"text\": \"・デザイン重視\\n〜〜〜\"}\n{\"text\": \"で、選ぶ商品は変わります。\"}\n{\"text\": \" \"}\n{\"text\": \"\"}\n{\"text\": \"つまり、記事を書く前に\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n①誰が\"}\n{\"text\": \"②どんな場面で\"}\n{\"text\": \"③何に困っていて\"}\n{\"text\": \"④何を基準に選びたいか？\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"を決める必要があります。\"}\n{\"text\": \"\"}\n{\"text\": \"ちなみに、記事テーマを出すときは\\n↓のプロンプトを使ってください。\"}\n{\"text\": \" \"}\n{\"text\": \"この悩みが、\\nそのまま記事ネタになります。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"STEP③：記事は“商品説明”ではなく判断材料を作る\"}\n{\"text\": \"商品が決まったら、\\nClaude Codeで記事を作ります。\"}\n{\"text\": \"\"}\n{\"text\": \"ここでよくある失敗が、\"}\n{\"text\": \"「レビュー記事を書いて」\"}\n{\"text\": \"だけで終わること。\"}\n{\"text\": \"\"}\n{\"text\": \"これだと、\\n商品のメリットを並べただけの\\nどこかで見た文章になりがちです。\"}\n{\"text\": \"\"}\n{\"text\": \"読者が知りたいのは、\\n商品の説明ではありません。\"}\n{\"text\": \"\"}\n{\"text\": \"『結局、自分にはどれが合うのか？』\"}\n{\"text\": \"という判断材料です。\"}\n{\"text\": \"\"}\n{\"text\": \"記事は↓の順番で作ります。\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n①読者の悩み\"}\n{\"text\": \"②選ぶ基準\"}\n{\"text\": \"③商品ごとの違い\"}\n{\"text\": \"④良い点・気になる点\"}\n{\"text\": \"⑤向いている人\"}\n{\"text\": \"⑥向いていない人\"}\n{\"text\": \"⑦選び方の結論\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"\"}\n{\"text\": \"また、記事作成には\\n↓のプロンプトが使えます。\"}\n{\"text\": \" \"}\n{\"text\": \"\"}\n{\"text\": \"ここで一番大切なのは、\"}\n{\"text\": \"『提供した情報だけを使う』\"}\n{\"text\": \"と指示することです。\"}\n{\"text\": \"\"}\n{\"text\": \"公開前に、\"}\n{\"text\": \"〜〜〜\\n・商品名\\n・価格\\n・サイズ\\n・仕様\\n・在庫\\n・販売元\\n・リンク先\\n〜〜〜\"}\n{\"text\": \"は必ず確認してくださいね。\"}\n{\"text\": \"\"}\n{\"text\": \"また、実際に使った商品なら、\"}\n{\"text\": \"・想像より便利だった点\"}\n{\"text\": \"・逆に使いにくかった点\"}\n{\"text\": \"を加えると、\\n記事の説得力が上がります。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"STEP④：1記事からThreads投稿を作る\"}\n{\"text\": \"記事を公開しても、\\n最初から大量のアクセスが\\n来るとは限りません。\"}\n{\"text\": \"そこで、記事を\\nThreads用の投稿へ変換します。\"}\n{\"text\": \"\"}\n{\"text\": \"ただし、\"}\n{\"text\": \"「記事を公開しました！」\"}\n{\"text\": \"だけでは弱いです。\"}\n{\"text\": \"\"}\n{\"text\": \"記事の中にある、\"}\n{\"text\": \"”一つの気づき”だけを抜き出します。\"}\n{\"text\": \"\"}\n{\"text\": \"たとえば、\\n電気ケトルの記事なら\"}\n{\"text\": \"〜〜〜\\n・容量が大きい＝便利とは限らない\"}\n{\"text\": \"・保温機能が不要な人もいますよ\"}\n{\"text\": \"・注ぎ口の形で使いやすさが変わる！\"}\n{\"text\": \"・置き場所から逆算した方が失敗しにくい\\n〜〜〜\"}\n{\"text\": \"といった内容です。\"}\n{\"text\": \"\"}\n{\"text\": \"Threads投稿への変換は、\\n↓のプロンプトでOKです。\"}\n{\"text\": \" \"}\n{\"text\": \"\"}\n{\"text\": \"投稿だけで売ろうとせず、\\nまず役立つ情報を渡して\\n詳しい内容を記事で読んでもらう。\"}\n{\"text\": \"⤴︎この流れを作ります。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"STEP⑤：反応が取れたテーマを横展開する\"}\n{\"text\": \"記事を作るといっても\\n毎回毎回、\\n新しい記事を考える必要ってないです。\"}\n{\"text\": \"\"}\n{\"text\": \"反応が取れた記事は、\\n読者や悩みを変えて横展開します。\"}\n{\"text\": \"\"}\n{\"text\": \"たとえば、\"}\n{\"text\": \"「一人暮らし向け電気ケトル」\"}\n{\"text\": \"が読まれたなら↓\"}\n{\"text\": \"〜〜〜\\n・狭いキッチン向け\"}\n{\"text\": \"・コーヒーを飲む人向け\"}\n{\"text\": \"・手入れ重視\"}\n{\"text\": \"・デザイン重視\"}\n{\"text\": \"・保温機能が欲しい人向け\\n〜〜〜\"}\n{\"text\": \"に広げられますよね？\"}\n{\"text\": \"\"}\n{\"text\": \"同じ文章をコピーするのではなく、\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n誰の\"}\n{\"text\": \"どんな悩みを\"}\n{\"text\": \"どの比較軸で解決するか\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"を変えるイメージです。\"}\n{\"text\": \"\"}\n{\"text\": \"あと、大事なポイントなんですが\\n週に1回は\"}\n{\"text\": \"〜〜〜\\n・記事の閲覧数\"}\n{\"text\": \"・リンクのクリック数\"}\n{\"text\": \"・クリックされた商品\"}\n{\"text\": \"・Threadsの反応\"}\n{\"text\": \"・読まれたテーマ\\n〜〜〜\"}\n{\"text\": \"を確認してください！\"}\n{\"text\": \"\"}\n{\"text\": \"数字が取れたテーマは増やす。\"}\n{\"text\": \"反応がない記事は、\\nタイトルや読者設定を見直す。\"}\n{\"text\": \"\"}\n{\"text\": \"すると、\\n何を書けばいいか分からない状態から、\"}\n{\"text\": \"“反応を見て次の記事を決める状態”\"}\n{\"text\": \"に変わります。\"}\n{\"text\": \"\"}\n{\"text\": \"●ただしデメリットも\"}\n{\"text\": \"\\nここまで読むと、\"}\n{\"text\": \"「Claude Codeに書かせれば\\n　ほぼ放置じゃね？」\"}\n{\"text\": \"と思うかもしれませんね。笑\"}\n{\"text\": \"\"}\n{\"text\": \"ただし、世の中\\nメリットがあれば、\\n当然デメリットもあります。\"}\n{\"text\": \"\"}\n{\"text\": \"①AIの記事をそのまま公開できない\"}\n{\"text\": \"AIは、存在しない仕様や、\\n古い価格を出す可能性があります。\"}\n{\"text\": \"記事制作は速くなっても、\\n事実確認は必要です。\"}\n{\"text\": \"\"}\n{\"text\": \"②価格や在庫は変わる\"}\n{\"text\": \"楽天市場の商品は、\"}\n{\"text\": \"「価格」\\n「在庫」\\n「販売ページ」\\n「仕様」\\n\\nが変わることがあります。\"}\n{\"text\": \"一度公開して終わりではなく、\\n定期的な確認も重要です。\"}\n{\"text\": \"\"}\n{\"text\": \"③最初から放置できるわけではない\"}\n{\"text\": \"〜〜〜\\nジャンルを決める。\"}\n{\"text\": \"記事の型を作る。\"}\n{\"text\": \"Threadsからアクセスを集める。\"}\n{\"text\": \"数字を見て改善する。\\n〜〜〜\"}\n{\"text\": \"⤴︎この土台を作ったあとに、\\n少しずつ作業が軽くなります。\"}\n{\"text\": \"\"}\n{\"text\": \"最初から放置ではなく、\"}\n{\"text\": \"『先に仕組みを作るから\\n　あとでラク（自動化）になる』\"}\n{\"text\": \"という順番です。\"}\n{\"text\": \"\"}\n{\"text\": \"●今日からのアクションプラン\"}\n{\"text\": \"\\n今日いきなり、\\n記事を20本書く必要はありません。笑\"}\n{\"text\": \"まずは、↓の3つだけでOKです。\"}\n{\"text\": \"\\n━━━━━━━━━━━━━━━━\\n①ジャンルを一つ決める\"}\n{\"text\": \"一人暮らし用品\\nコスメ\\n食品\\nアウトドア\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n②読者の悩みを10個出す\"}\n{\"text\": \"置き場所がない\\n手入れが面倒\\nどれを選べばいいか分からない\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n③比較記事の企画を一本作る\"}\n{\"text\": \"●読者\\n　↓\\n一人暮らしで\\n小型の電気ケトルを探している人\"}\n{\"text\": \"●比較項目\\n　↓\\n容量\\nサイズ\\n価格\\n手入れ\\n保温機能\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n\\n⤴︎ここまで作れば、\"}\n{\"text\": \"何を調べて、\\n何をClaude Codeに渡すか？\"}\n{\"text\": \"が見えてきます。\"}\n{\"text\": \"\"}\n{\"text\": \"ただ、実際に始めると、\"}\n{\"text\": \"🙍‍♂️Claude Codeをどう設定するの？\"}\n{\"text\": \"🙎‍♀️どのジャンルを選べばいい？\"}\n{\"text\": \"🙍‍♂️記事をどんな順番で出すべき？\"}\n{\"text\": \"🙎‍♀️Threadsからどう誘導するの？\"}\n{\"text\": \"と迷うと思います。\"}\n{\"text\": \"\"}\n{\"text\": \"そこで、今回\"}\n{\"text\": \"「Claude Code×楽天アフィ」を\\nゼロから進められるように\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\nClaude Code×楽天アフィ完全マニュアル\"}\n{\"text\": \"月収ゼロから月20万円を目指す全手順\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"を用意しました🎁\"}\n{\"text\": \" \"}\n{\"text\": \"〜〜〜\\n・楽天アフィの全体設計\"}\n{\"text\": \"・ジャンル選定\"}\n{\"text\": \"・Claude Codeの導入\"}\n{\"text\": \"・記事作成プロンプト\"}\n{\"text\": \"・比較記事テンプレート\"}\n{\"text\": \"・Threadsへの展開方法\"}\n{\"text\": \"・毎日の作業ルーティン\"}\n{\"text\": \"・分析と改善方法\\n〜〜〜\"}\n{\"text\": \"までまとめています。\"}\n{\"text\": \"\"}\n{\"text\": \"「Claude Code×楽天アフィ」に挑戦したい方は\"}\n{\"text\": \"ぜひプレゼントnoteを学んでください。\"}\n{\"text\": \"▼▼▼\"}\n{\"text\": \"【Claude Code×楽天アフィ\\n　完全マニュアルを受け取る】\"}\n{\"text\": \"https://lin.ee/tDExHne\"}\n{\"text\": \"https://lin.ee/tDExHne\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"●最後に\"}\n{\"text\": \"一番もったいないのは、\\n\\nClaude Codeについて調べ続けて、\\n一記事も作らずに終わることです。\"}\n{\"text\": \"\"}\n{\"text\": \"ジャンルを一つ決める。\"}\n{\"text\": \"読者の悩みを10個出す。\"}\n{\"text\": \"記事の企画を一本作る。\"}\n{\"text\": \"\"}\n{\"text\": \"⤴︎まずは、これだけで十分です。\"}\n{\"text\": \"\"}\n{\"text\": \"最初から、\\n完璧なサイトも、\\n100本の記事も必要ありません。\"}\n{\"text\": \"\"}\n{\"text\": \"AIを使いこなせる人と、\"}\n{\"text\": \"情報を集め続ける人の差は、\\n実は知識量じゃないんですよ。\\n\\n\\n大事なのは、知ったあとに\\n\\n一度でも\\n手を動かしたかどうかです。\"}\n{\"text\": \"\"}\n{\"text\": \"まずはプレゼントを受け取って\"}\n{\"text\": \"このあと、記事の企画を\\n一つだけ作ってみてください。\"}\n{\"text\": \"\"}\n{\"text\": \"その一記事が、\"}\n{\"text\": \"あとから自分の代わりに働く\\n最初の資産になります。\"}\n{\"text\": \"\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64e-200d-2640-fe0f.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f381.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/274c.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/2b55.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64e-200d-2640-fe0f.svg\"}\n{\"description\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\", \"name\": \"とら🐯AIマネタイズ\", \"url\": \"https://x.com/3Imzdo3\"}\n{\"text\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\"}\n{\"url\": \"https://lin.ee/cnl9M18\"}\n{\"text\": \"https://t.co/XhsLwgBJcf\"}\n{\"author\": {\"avatar_url\": \"https://pbs.twimg.com/profile_images/1893661706477535232/eH44MC_b_200x200.jpg\", \"banner_url\": \"https://pbs.twimg.com/profile_banners/1694244014671978496/1766544361\", \"description\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\", \"followers\": 1119, \"following\": 50, \"id\": \"1694244014671978496\", \"joined\": \"Wed Aug 23 07:03:56 +0000 2023\", \"likes\": 2438, \"location\": \"副収入を生み出す方法→\", \"media_count\": 138, \"name\": \"とら🐯AIマネタイズ\", \"protected\": false, \"raw_description\": {\"facets\": [], \"text\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\"}, \"screen_name\": \"3Imzdo3\", \"statuses\": 2914, \"type\": \"profile\", \"url\": \"https://x.com/3Imzdo3\", \"verification\": {\"type\": \"individual\", \"verified\": true, \"verified_at\": null}, \"website\": {\"display_url\": \"lin.ee/cnl9M18\", \"url\": \"https://lin.ee/cnl9M18\"}}, \"created_at\": \"Thu Jul 30 09:29:26 +0000 2026\", \"text\": \"\", \"url\": \"https://x.com/3Imzdo3/status/2082760469300011416\"}\n{\"content\": {\"blocks\": [{\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3lma5\", \"text\": \"\\nAI美女を作ってみた！\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ajeic\", \"text\": \"だけど...\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"b66cf\", \"text\": \"〜〜〜〜〜\\n・どのツールがベストなのか\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3ph8u\", \"text\": \"・生成しても人形っぽくなる\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3lde2\", \"text\": \"・毎回、別人のような顔になる\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"djpre\", \"text\": \"・どんな画像を投稿すればいいか分からない\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8tj0s\", \"text\": \"・そもそも収益につながるの？\\n〜〜〜〜〜\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fvjkb\", \"text\": \"と悩む人も多いんじゃないでしょうか？\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"47bii\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"24r8v\", \"text\": \"実際、生成AIに\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fdf8s\", \"text\": \"「かわいい日本人女性を作って」\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8pl5f\", \"text\": \"と入力するだけでも、\\nそれっぽい画像は作れます。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"7uj66\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ccp6\", \"text\": \"でも、いざSNSで使おうとしても\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cpjn7\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [{\"key\": 0, \"length\": 4, \"offset\": 0}], \"inlineStyleRanges\": [], \"key\": \"3pe9r\", \"text\": \"🙍‍♂️肌がツルツルすぎて、AI感満載じゃん…\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [{\"key\": 1, \"length\": 4, \"offset\": 0}], \"inlineStyleRanges\": [], \"key\": \"1jdhn\", \"text\": \"🙎‍♀️ポーズも背景も毎回同じになる…\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [{\"key\": 2, \"length\": 4, \"offset\": 0}], \"inlineStyleRanges\": [], \"key\": \"dbria\", \"text\": \"🙍‍♂️投稿してもアカウント伸びない…\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4snqf\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5hkac\", \"text\": \"という壁にぶつかるんですよね。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8s4f9\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ap56n\", \"text\": \"ただ、これは\\n画像生成の才能がないからではありません。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4hglo\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"akn5d\", \"text\": \"AI美女をSNSで伸ばすには、\\nただキレイな画像を作るのではなく、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 29, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"af1hj\", \"text\": \"━━━━━━━━━━━━━━━━\\n①キャラクターを設計する\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 14, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"2b5js\", \"text\": \"②リアルに見える要素を入れる\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 9, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"cc40v\", \"text\": \"③同じ人物に見せる\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 14, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"1ob0e\", \"text\": \"④投稿にストーリーを持たせる\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 11, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"35kfr\", \"text\": \"⑤収益導線までつなげる\\n━━━━━━━━━━━━━━━━\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3pv50\", \"text\": \"⤴︎この順番で作る必要があります。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"699db\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1jm4h\", \"text\": \"つまり、必要なのは\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 9, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"fsgf4\", \"text\": \"センスよりも『型』です。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cv94p\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5tu42\", \"text\": \"この記事では、\\n初心者でも実践できるように、\", \"type\": \"unstyled\"},