\"data\": {}, \"entityRanges\": [{\"key\": 6, \"length\": 1, \"offset\": 0}], \"inlineStyleRanges\": [], \"key\": \"f9ete\", \"text\": \" \", \"type\": \"atomic\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cvu5r\", \"text\": \"本来、有料コンテンツとして出す予定のものなので\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"dljad\", \"text\": \"定員に達したら配布を締め切ります。\\n\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d30o9\", \"text\": \"今のうちに\\n記事とあわせて受け取っておいてください。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 3, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"f33sp\", \"text\": \"▼▼▼\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [{\"key\": 7, \"length\": 7, \"offset\": 0}], \"inlineStyleRanges\": [], \"key\": \"a8sd0\", \"text\": \"特典を受け取る\", \"type\": \"header-two\"}], \"entityMap\": [{\"key\": \"4\", \"value\": {\"data\": {\"entityKey\": \"cf8ddf5a-fea9-41b2-91bf-b408769c7457\", \"mediaItems\": [{\"localMediaId\": \"10\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083462719773290496\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"5\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f381.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"6\", \"value\": {\"data\": {\"entityKey\": \"6cef04b1-1f34-4d55-9064-ae2aae00927b\", \"mediaItems\": [{\"localMediaId\": \"12\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083466308105261056\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"1\", \"value\": {\"data\": {\"entityKey\": \"55f55846-6d64-4d84-b5cf-fd4217c15aa8\", \"mediaItems\": [{\"localMediaId\": \"4\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083462268927488001\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"0\", \"value\": {\"data\": {\"entityKey\": \"fb70f08f-a0d3-4576-8c5a-5c24cac8b0f4\", \"mediaItems\": [{\"localMediaId\": \"2\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083462094612238336\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"2\", \"value\": {\"data\": {\"entityKey\": \"6d1e8b7c-1aa3-45b7-a7fc-644a905f6154\", \"mediaItems\": [{\"localMediaId\": \"6\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083462358803120128\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"7\", \"value\": {\"data\": {\"url\": \"https://lin.ee/PYg9oSd\"}, \"mutability\": \"Mutable\", \"type\": \"LINK\"}}, {\"key\": \"3\", \"value\": {\"data\": {\"entityKey\": \"9068c6dc-14f3-4acd-b0b7-3c3825075207\", \"mediaItems\": [{\"localMediaId\": \"8\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2083462473408229376\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}]}, \"created_at\": \"2026-08-01T09:08:34.000Z\", \"title\": \"何やっても稼ぐやつの正体\"}\n{\"text\": \"「何をやっても稼ぐ人」\\n\\nっているじゃないですか？\"}\n{\"text\": \"\"}\n{\"text\": \"物販をやっても稼ぐ。\"}\n{\"text\": \"SNSを始めても伸ばす。\"}\n{\"text\": \"投資へ移っても資産を増やす。\"}\n{\"text\": \"\"}\n{\"text\": \"扱う商品や市場が変わっても、\\n気づけば富を築いてる。\"}\n{\"text\": \"\"}\n{\"text\": \"反対に、\"}\n{\"text\": \"\"}\n{\"text\": \"同じ教材を買って、\"}\n{\"text\": \"同じ情報を学んで\"}\n{\"text\": \"同じノウハウを学んでいるのに、\"}\n{\"text\": \"半年後もまだ、\"}\n{\"text\": \"\"}\n{\"text\": \"「結局、何をやれば稼げますか？」\"}\n{\"text\": \"と聞き続けている人がいるのも\\nこのビジネス界隈。\"}\n{\"text\": \"\"}\n{\"text\": \"この違いを見ると、\"}\n{\"text\": \"\"}\n{\"text\": \"「だって、あいつには才能があるから」\"}\n{\"text\": \"「親が経営者じゃん」\"}\n{\"text\": \"「生い立ち（背景情報）が自分と違うし」\"}\n{\"text\": \"\"}\n{\"text\": \"と、過去の僕も片付けてる時がありました。\"}\n{\"text\": \"\"}\n{\"text\": \"でも、\"}\n{\"text\": \"本当に違うのは、選んだビジネスではない。\\n\"}\n{\"text\": \"選んだ後に、\\n\\nどう考えて、\\n\\nどこまで集中し、\\n\\n何回修正したのか？\"}\n{\"text\": \"\\n⤴︎ここに差があるんです。\"}\n{\"text\": \"\"}\n{\"text\": \"今回は、\"}\n{\"text\": \"その事例として取り上げたいのが「与沢翼」さん。\"}\n{\"text\": \" \"}\n{\"text\": \"\"}\n{\"text\": \"「いや、あいつ嫌いなんだけど」\"}\n{\"text\": \"と思う人も\"}\n{\"text\": \"いるのではないでしょうか？笑\"}\n{\"text\": \"\"}\n{\"text\": \"過去の情報商材ビジネスに\"}\n{\"text\": \"良い印象を持っていない人が多いのも事実。\"}\n{\"text\": \"\"}\n{\"text\": \"2025年には、\"}\n{\"text\": \"本人が薬物使用や離婚について発信し、\"}\n{\"text\": \"大きな騒動にもなりました。\"}\n{\"text\": \"\"}\n{\"text\": \"なので、僕自身も\"}\n{\"text\": \"彼の生き方や言動を\"}\n{\"text\": \"すべて肯定したいわけじゃありません。\"}\n{\"text\": \"\"}\n{\"text\": \"なんですが、\"}\n{\"text\": \"仕事で結果を出す能力と\"}\n{\"text\": \"人としての選択や\\n人生全体の幸福は別問題で、\\n\"}\n{\"text\": \"彼の\"}\n{\"text\": \"♢一点に100％集中するエネルギー\\n\\n♢数字で現実を見るスタンス\\n\\n♢決断したら、バグった基準値で行動する姿勢\\n\\n♢失敗後の分析スキル\"}\n{\"text\": \"\"}\n{\"text\": \"⤴︎には、参考になる部分が多いのも\\n１つの事実。\"}\n{\"text\": \"\"}\n{\"text\": \"〜〜〜\\nアパレル\"}\n{\"text\": \"情報発信\"}\n{\"text\": \"会社経営\"}\n{\"text\": \"海外移住\"}\n{\"text\": \"投資\"}\n{\"text\": \"不動産\\n\\netc...\\n〜〜〜\"}\n{\"text\": \"扱う分野が変わっても、\"}\n{\"text\": \"そのたびに結果を出してきた。\"}\n{\"text\": \"\"}\n{\"text\": \"つまり、\"}\n{\"text\": \"たまたま一つの市場を\\n当てただけでは無いってこと。\"}\n{\"text\": \"\"}\n{\"text\": \"分野が、市場が変わっても使える\"}\n{\"text\": \"『稼ぐ人の思考パターン』\"}\n{\"text\": \"を持ってるということです。\"}\n{\"text\": \"\"}\n{\"text\": \"もちろん、\"}\n{\"text\": \"彼だけの話ではありません。\"}\n{\"text\": \"\"}\n{\"text\": \"Amazonのジェフ・ベゾス。\"}\n{\"text\": \" \"}\n{\"text\": \"ダイソン創業者の\\nジェームズ・ダイソン。\"}\n{\"text\": \" \"}\n{\"text\": \"熟達した起業家を研究した\\nサラス・サラスバシー。\"}\n{\"text\": \" \"}\n{\"text\": \"\"}\n{\"text\": \"過去の偉人、成功者の\"}\n{\"text\": \"”歴史を振り返ると”\"}\n{\"text\": \"何をしても結果を出す人には、\"}\n{\"text\": \"驚くほど似た行動パターンがあります。\"}\n{\"text\": \"\"}\n{\"text\": \"僕なりに整理すると、特徴は5つ↓\"}\n{\"text\": \"\"}\n{\"text\": \"①全部やらず、センターピンを決める \"}\n{\"text\": \"\\n与沢翼さんの考え方で、非常に有名なのが\"}\n{\"text\": \"『センターピン』。\"}\n{\"text\": \"\"}\n{\"text\": \"ボウリングでは、\"}\n{\"text\": \"先頭のピンへ正しく当てることで\"}\n{\"text\": \"後ろのピンまで、連鎖して倒れます。\"}\n{\"text\": \" \"}\n{\"text\": \"\"}\n{\"text\": \"これは、ビジネスの世界も同じで\"}\n{\"text\": \"結果を大きく左右する\\n中心部分（コア）がある。\"}\n{\"text\": \"\"}\n{\"text\": \"たとえば、\"}\n{\"text\": \"商品が売れない時に、ほとんどの人は\\n\"}\n{\"text\": \"・投稿数を増やす\\n\\n・アイコンを変えてみる\\n\\n・別のSNSに手を出す\\n\\n・新しいAIツールを試す\\n\\n・新商品を作ってみる\\n\\n・教材を買ってみる\"}\n{\"text\": \"\\n⤴︎こういうのを、やりたくなります。\"}\n{\"text\": \"\"}\n{\"text\": \"でも、\\n本当の問題（ボトルネック）が\"}\n{\"text\": \"「誰向けの商品か分からないこと」\"}\n{\"text\": \"だった場合\\nほかを改善しても、大きくは変わりません。\"}\n{\"text\": \"\"}\n{\"text\": \"圧倒的に稼ぐ人は、\"}\n{\"text\": \"ひたすら努力しよう！とする前に\\n\"}\n{\"text\": \"今、一番結果を止めてる\\n問題点ってどこか？\"}\n{\"text\": \"\\nを考えます。\"}\n{\"text\": \"\"}\n{\"text\": \"そして、\"}\n{\"text\": \"センターピンを決めたら、\"}\n{\"text\": \"他のことには目を向けない。\"}\n{\"text\": \"\"}\n{\"text\": \"商品を作る時期なら、\\n商品作りへ集中する。\\n\"}\n{\"text\": \"販売する時期なら、\\n営業と導線へ集中する。\\n\"}\n{\"text\": \"発信を伸ばす時期なら、\\n投稿と分析へ集中する。\"}\n{\"text\": \"\"}\n{\"text\": \"一方で、\\n結果が出にくい人ほど、\"}\n{\"text\": \"\\nXをやりながら、\"}\n{\"text\": \"Instagramも始め、\"}\n{\"text\": \"noteも書き、\"}\n{\"text\": \"AIも勉強しながら、\"}\n{\"text\": \"投資情報まで追いかけます。\"}\n{\"text\": \"\"}\n{\"text\": \"一見すると、\"}\n{\"text\": \"すごく努力しているように見えます。\"}\n{\"text\": \"\"}\n{\"text\": \"ただ、大前提として\"}\n{\"text\": \"人間の脳みそは、\"}\n{\"text\": \"そこまで器用じゃないんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"ワシントン大学の\\nソフィー・ルロワは、\"}\n{\"text\": \"仕事を途中で切り替えてしまうと\"}\n{\"text\": \"頭の一部が、\\n前の作業に残ってしまい\"}\n{\"text\": \"次の作業への集中力が\\n落ちることが分かっています。\"}\n{\"text\": \"\"}\n{\"text\": \"つまり、\"}\n{\"text\": \"5つを同時に進めている人は、\"}\n{\"text\": \"一見すると効率がいいように見えて\"}\n{\"text\": \"実は、\"}\n{\"text\": \"切り替えるたびに\"}\n{\"text\": \"集中力まで失っているんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"●実践するときの注意点\"}\n{\"text\": \"\\nまず行動に移す前に、一度立ち止まって\"}\n{\"text\": \"今やっていることを\"}\n{\"text\": \"すべて書き出してください。\"}\n{\"text\": \"\"}\n{\"text\": \"その中から、\\n\"}\n{\"text\": \"今、一番結果を止めている原因は\\nどれになるのか？\"}\n{\"text\": \"\\nを一つ選ぶ。\"}\n{\"text\": \"\"}\n{\"text\": \"たとえば、\"}\n{\"text\": \"商品が売れないなら、\\n投稿数を増やす前に\"}\n{\"text\": \"「そもそも商品が欲しいと思われているか？」\"}\n{\"text\": \"\"}\n{\"text\": \"Xが伸びないなら、\\n別のSNSを始める前に\"}\n{\"text\": \"「投稿の中身に問題がないのか？」\"}\n{\"text\": \"⤴︎\\nを考える。\"}\n{\"text\": \"全部をまとめて改善しようとせず、\\n\"}\n{\"text\": \"〇〇を直したら、\\n一番結果に影響出る場所\"}\n{\"text\": \"\\n⤴︎これを一つ決めて、\\nまず30日間はそこに集中しましょう。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"②完璧な正解を待たずに、修正する前提で動く\"}\n{\"text\": \"\\n結果が出ない人ほど、\"}\n{\"text\": \"最初からベスト（正解）を当てようとしがちです。\\n\"}\n{\"text\": \"〜〜〜\\n・絶対に伸びるジャンル\"}\n{\"text\": \"・確実に売れる商品とは？\"}\n{\"text\": \"・失敗しない投稿\"}\n{\"text\": \"・今から参入しても遅くない市場\\n〜〜〜\"}\n{\"text\": \"を探し続ける。\"}\n{\"text\": \"\"}\n{\"text\": \"でも、\"}\n{\"text\": \"ビジネスの未来なんて、\"}\n{\"text\": \"誰にも完全には分かりません。\"}\n{\"text\": \"\"}\n{\"text\": \"Amazon創業者の\\nジェフ・ベゾスは、\"}\n{\"text\": \"〜〜〜\\n意思決定する時は\"}\n{\"text\": \"欲しい情報の約70％が集まった段階で\\n判断すべきだ\\n〜〜〜\"}\n{\"text\": \"と宣言してるくらいです。\"}\n{\"text\": \"\"}\n{\"text\": \"90％のクオリティまで待ってたら、\"}\n{\"text\": \"ほとんどの場合は遅すぎる。\"}\n{\"text\": \"\"}\n{\"text\": \"間違いを素早く見つけて\"}\n{\"text\": \"修正できる方が重要だ、\"}\n{\"text\": \"という考え方です。\"}\n{\"text\": \"\"}\n{\"text\": \"これは圧倒的に稼ぐ人が\"}\n{\"text\": \"全員、徹底してるポイントで、\"}\n{\"text\": \"最初から90点以上を当てようとせず\"}\n{\"text\": \"\"}\n{\"text\": \"仮説を決める\\n　↓\\n小さく出す\\n　↓\\n反応を見る\\n　↓\\n原因を考える\\n　↓\\n修正して、もう一度やる\"}\n{\"text\": \"\\nを高速で回しています。\"}\n{\"text\": \"\"}\n{\"text\": \"与沢翼さんも\"}\n{\"text\": \"一つの形へ、固執し続けたというより\"}\n{\"text\": \"事業や活動の形を\"}\n{\"text\": \"今まで何度も変えています。\"}\n{\"text\": \"\"}\n{\"text\": \"変えているのは『手段』です。\"}\n{\"text\": \"\"}\n{\"text\": \"けど、変えていないのは\"}\n{\"text\": \"「結果が出るまで、考えて動く」\"}\n{\"text\": \"という姿勢。\"}\n{\"text\": \"\"}\n{\"text\": \"逆に、\"}\n{\"text\": \"稼げない人のほとんどは\"}\n{\"text\": \"方法を修正する前に、市場ごと捨てます。\"}\n{\"text\": \"\"}\n{\"text\": \"Xを1か月やって伸びなかったら\"}\n{\"text\": \"「他のSNSはどうだろう？」\"}\n{\"text\": \"\"}\n{\"text\": \"商品を一つ出して売れなければ\"}\n{\"text\": \"「自分にはセンスがない...」\"}\n{\"text\": \"\"}\n{\"text\": \"ブログを10本書いても読まれなかったら\"}\n{\"text\": \"「ブログはオワコンだよ」\"}\n{\"text\": \"\"}\n{\"text\": \"そして、\"}\n{\"text\": \"またゼロから、別の副業を始める。\"}\n{\"text\": \"\"}\n{\"text\": \"これでは、\"}\n{\"text\": \"失敗のデータが次へ活かされません。\"}\n{\"text\": \"\"}\n{\"text\": \"●実践するなら\"}\n{\"text\": \"\\n始める前に、\"}\n{\"text\": \"↓の3つを決めてください。\\n\"}\n{\"text\": \"①何を達成したいのか？\\n　（ゴール）\\n\\n②何回試すのか？\\n\\n③どの数字で判断するのか？\"}\n{\"text\": \"\"}\n{\"text\": \"「なんとなく伸びなかった」\\nではなく、\"}\n{\"text\": \"「30本投稿しても、\\n　プロフィール遷移率が○％以下なら\\n　切り口を変えてみる」\\n\"}\n{\"text\": \"という形にする。\"}\n{\"text\": \"\"}\n{\"text\": \"続けるかどうか？を\"}\n{\"text\": \"感情で決めず、\"}\n{\"text\": \"回数と数字で判断しましょう。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"③儲けの上限より、損切りの上限を決める\\n\"}\n{\"text\": \"多くの人は、新しいことを始めるとき\"}\n{\"text\": \"「いくら稼げるか？」\"}\n{\"text\": \"から考えます。\"}\n{\"text\": \"\"}\n{\"text\": \"月10万円いけるのか？\"}\n{\"text\": \"半年で回収できるのか？\"}\n{\"text\": \"今から参入しても\\n伸びる余地があるのか？\"}\n{\"text\": \"\"}\n{\"text\": \"でも、\"}\n{\"text\": \"将来の利益を正確に予測するのは\\nほぼ不可能です。\"}\n{\"text\": \"\"}\n{\"text\": \"だから、確信が持てず、\"}\n{\"text\": \"泥沼のように調べ続けることになります。\"}\n{\"text\": \"\"}\n{\"text\": \"起業家の意思決定を研究した\\nサラス・サラスバシーは、\"}\n{\"text\": \"〜〜〜\\n成功している起業家ほど、\\n「いくら儲かるか？」より先に、\"}\n{\"text\": \"『最悪、いくらまでなら\\n　失っても大丈夫か？』\"}\n{\"text\": \"を決めてから動く傾向にある\\n〜〜〜\\n\\nと言ってます。\"}\n{\"text\": \"\"}\n{\"text\": \"これは、”アフォーダブル・ロス”。\"}\n{\"text\": \"日本語では\"}\n{\"text\": \"『許容できる損失ライン』\"}\n{\"text\": \"と呼ばれる考え方です。\"}\n{\"text\": \"\"}\n{\"text\": \"儲けの上限は、\"}\n{\"text\": \"自分ではコントロールできません。\"}\n{\"text\": \"\"}\n{\"text\": \"ただ、\"}\n{\"text\": \"損失の上限は、自分で決められます。\"}\n{\"text\": \"\"}\n{\"text\": \"たとえば、\"}\n{\"text\": \"新商品を作るとして\"}\n{\"text\": \"\\nいきなり半年かけて\\n大作を完成させるのではなく、\"}\n{\"text\": \"3日で試作品を作る。\"}\n{\"text\": \"\"}\n{\"text\": \"広告を出すなら、\"}\n{\"text\": \"生活に影響する金額を\\n一気に投入するのではなく、\"}\n{\"text\": \"失っても問題のない金額で\\n反応を確認する。\"}\n{\"text\": \"\"}\n{\"text\": \"副業を始めるなら、\"}\n{\"text\": \"会社を辞めて退路を断つ前に、\"}\n{\"text\": \"平日の夜と休日を使って\\n最初の売上を作る。\"}\n{\"text\": \"\"}\n{\"text\": \"圧倒的に稼ぐ人は\"}\n{\"text\": \"何も考えず、\\n大勝負をしているわけではありません。\\n\"}\n{\"text\": \"失敗しても\\n次の打席へ立てる形で試す\"}\n{\"text\": \"\\nのが上手いんです。\"}\n{\"text\": \"\"}\n{\"text\": \"ここは、\"}\n{\"text\": \"与沢翼さんの事例から\\n逆の意味でも学べます。\"}\n{\"text\": \"\"}\n{\"text\": \"一点集中（極端な行動力）は、\"}\n{\"text\": \"使い方によっては\\n強力な武器になります。\"}\n{\"text\": \"\"}\n{\"text\": \"ただ、逆に\"}\n{\"text\": \"〜〜〜\\n健康\"}\n{\"text\": \"家族\"}\n{\"text\": \"信用\"}\n{\"text\": \"生活基盤\\n〜〜〜\"}\n{\"text\": \"⤴︎\\nここまで支障をきたす設計だと\"}\n{\"text\": \"長期的に続きません。\"}\n{\"text\": \"\"}\n{\"text\": \"仕事への集中と、\"}\n{\"text\": \"自分を破壊することは別です。\"}\n{\"text\": \"\"}\n{\"text\": \"僕たちがマネすべきなのは、\"}\n{\"text\": \"大きく賭ける姿ではなく、\"}\n{\"text\": \"結果を出すまで\\n試行錯誤を続ける姿勢です。\"}\n{\"text\": \"\"}\n{\"text\": \"●実践するなら\"}\n{\"text\": \"\\n新しい挑戦をするときは、\"}\n{\"text\": \"先に↓を決めてください。\\n\"}\n{\"text\": \"①失ってもいい金額\\n\\n②使ってもいい期間\\n\\n③損切りを判断する数字\\n\\n④絶対に守る生活条件\"}\n{\"text\": \"\\n攻める範囲と同時に、守る範囲も決める。\"}\n{\"text\": \"\\n⤴︎\\nこれがあるから\"}\n{\"text\": \"何度でも復活して、挑戦できます。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"④勉強（インプット）を行動の代わりにしない\"}\n{\"text\": \"\\n本を読む。\"}\n{\"text\": \"動画を見る。\"}\n{\"text\": \"教材を買う。\"}\n{\"text\": \"成功者の投稿を追っている。\"}\n{\"text\": \"そして、\\n知識はどんどん増えている。\"}\n{\"text\": \"\"}\n{\"text\": \"にも関わらず、\\n\"}\n{\"text\": \"投稿は出していない。\"}\n{\"text\": \"商品も作っていない。\"}\n{\"text\": \"営業もしていない。\"}\n{\"text\": \"、、、\\n\\n⤴︎こういう状態って、\\n意外と多いんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"勉強している間は、\"}\n{\"text\": \"失敗しなくて済みます。\"}\n{\"text\": \"\"}\n{\"text\": \"投稿しなければ、\"}\n{\"text\": \"反応ゼロを見なくていい。\"}\n{\"text\": \"\"}\n{\"text\": \"商品を出さなければ、\"}\n{\"text\": \"売れない現実を見なくていい。\"}\n{\"text\": \"\"}\n{\"text\": \"営業しなければ、\"}\n{\"text\": \"断られて傷つかない。\"}\n{\"text\": \"\"}\n{\"text\": \"だから、\"}\n{\"text\": \"勉強している状態って\\n意外と心地いいんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"でも、\"}\n{\"text\": \"ビジネスで本当に必要な知識は、\"}\n{\"text\": \"動いたあとに見えてきます。\"}\n{\"text\": \"\"}\n{\"text\": \"投稿を出したから、\"}\n{\"text\": \"冒頭（フック）が弱いと分かる。\"}\n{\"text\": \"\"}\n{\"text\": \"商品を売ったから、\"}\n{\"text\": \"読者の悩みとズレていると分かる。\"}\n{\"text\": \"\"}\n{\"text\": \"導線を作ったから、\"}\n{\"text\": \"どこで人が離れてるか分かる。\"}\n{\"text\": \"\"}\n{\"text\": \"つまり、\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n行動する\\n　↓\\n分からない部分が見つかる\\n　↓\\n必要なことだけ学ぶ\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"が正しい順番です。\"}\n{\"text\": \"\"}\n{\"text\": \"心理学者のゴルヴィツァーらが行った\\n実行意図に関する研究では、\\n\"}\n{\"text\": \"ただ”頑張る”と決めずに\\n\\n『いつ』\\n『どこで』\\n『何をするか？』\\n\\nまで決める\"}\n{\"text\": \"⤴︎\\nこれが、目標達成に近づくと\\n報告されています。\"}\n{\"text\": \"\"}\n{\"text\": \"大事なのは、\"}\n{\"text\": \"モチベ上げじゃないんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"●実践するなら\"}\n{\"text\": \"\\n「毎日、副業を頑張る！」\"}\n{\"text\": \"ではなくて\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n平日の朝7時になったら\"}\n{\"text\": \"机に座って、投稿を一本作る\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"まで、鮮明にイメージできる粒度で\\n決めてください。\"}\n{\"text\": \"\"}\n{\"text\": \"動画を一本見たら、\"}\n{\"text\": \"その日のうちに一つ試す。\"}\n{\"text\": \"\"}\n{\"text\": \"教材を一章読んだら、\"}\n{\"text\": \"すべて読み終わる前に\\n課題を一つ実行する。\"}\n{\"text\": \"\"}\n{\"text\": \"知識量ではなく、\"}\n{\"text\": \"『行動が変わったかどうか？』を\"}\n{\"text\": \"勉強の基準にしてください。\"}\n{\"text\": \"\"}\n{\"text\": \"⑤自分を信じる前に『自分との約束』を守る\"}\n{\"text\": \"\\n何をしても稼ぐ人は、\"}\n{\"text\": \"根拠のない自信があるように\\n見えることがあります。\"}\n{\"text\": \"\"}\n{\"text\": \"「俺ならいける」\"}\n{\"text\": \"「失敗しても何とかなる」\"}\n{\"text\": \"「最後には形にできてる」\"}\n{\"text\": \"\"}\n{\"text\": \"⤴︎でも、その自信は、\"}\n{\"text\": \"何もないところから\\n突然生まれた訳じゃありません。\"}\n{\"text\": \"\"}\n{\"text\": \"〜〜〜\\n自分で決めた。\"}\n{\"text\": \"実際に動いた。\"}\n{\"text\": \"失敗した。\"}\n{\"text\": \"修正した。\"}\n{\"text\": \"もう一度やった。\\n〜〜〜\"}\n{\"text\": \"⤴︎この経験が積み重なって、\"}\n{\"text\": \"「今回も自分なら何とかできる」\"}\n{\"text\": \"という感覚になるんです。\"}\n{\"text\": \"\"}\n{\"text\": \"つまり、\"}\n{\"text\": \"本当の自信は、成功回数だけではなく、\\n\"}\n{\"text\": \"失敗した後に\\n立て直した回数\"}\n{\"text\": \"\\nから生まれます。\"}\n{\"text\": \"\"}\n{\"text\": \"与沢翼さんも、\"}\n{\"text\": \"ずっと順風満帆だったわけではありません。\"}\n{\"text\": \"\"}\n{\"text\": \"事業がうまくいかなくなったり、\\n大きく環境を変えたり、\"}\n{\"text\": \"何度も壁にぶつかっています。\"}\n{\"text\": \"\"}\n{\"text\": \"それでも、\"}\n{\"text\": \"一度失敗したからといって\\n「もう自分はダメだ」で終わらず、\\n\"}\n{\"text\": \"じゃあ、次はどうする？\"}\n{\"text\": \"\\nを考えて、\\nまた動いてきた。\"}\n{\"text\": \"\"}\n{\"text\": \"失敗したときに止まるのではなく、\\n\"}\n{\"text\": \"現実を見て、\\n\\nやり方を変えて、\\n\\nもう一回動く。\"}\n{\"text\": \"\\n⤴︎この姿勢は、\"}\n{\"text\": \"仕事で結果を出すうえで\"}\n{\"text\": \"非常に参考になる部分です。\"}\n{\"text\": \"\"}\n{\"text\": \"今日やると決めたことは、\"}\n{\"text\": \"今日終わらせる。\"}\n{\"text\": \"\"}\n{\"text\": \"投稿を一本作る。\"}\n{\"text\": \"見込み客の悩みを10個調べる。\"}\n{\"text\": \"商品案を三つ出す。\"}\n{\"text\": \"過去の数字を確認する。\"}\n{\"text\": \"\"}\n{\"text\": \"⤴︎他人から見れば、\"}\n{\"text\": \"小さな行動と笑われるかもしれません。\"}\n{\"text\": \"\"}\n{\"text\": \"でも、\"}\n{\"text\": \"自分で決めたことを\\n守った・やり遂げた事実は、\"}\n{\"text\": \"自信として残ります。\"}\n{\"text\": \"\"}\n{\"text\": \"●何をやっても稼ぐやつの正体\"}\n{\"text\": \"をまとめると、\"}\n{\"text\": \"5つの特徴があります。\\n\"}\n{\"text\": \"①センターピン以外を、一時的に捨てる\\n\\n②完璧を待たずに、修正する前提で動く\\n\\n③損切りのラインを決めて何度も試す\\n\\n④勉強（インプット）で行動した気にならない\"}\n{\"text\": \"\\n⤴︎この5つを見ると、\"}\n{\"text\": \"一つ大切なことが分かりますが、\"}\n{\"text\": \"\"}\n{\"text\": \"「稼ぐ力」って\"}\n{\"text\": \"特定のビジネス・副業に\\n詳しいことではありません。\"}\n{\"text\": \"\"}\n{\"text\": \"稼ぐ力の『本質』は\"}\n{\"text\": \"━━━━━━━━━━━━━\\nたった一つに集中し、\"}\n{\"text\": \"反応・数字を見て、\"}\n{\"text\": \"結果が出る形へ修正する力\\n━━━━━━━━━━━━━\"}\n{\"text\": \"⤴︎\\nこれが正体です。\"}\n{\"text\": \"\"}\n{\"text\": \"だから、\"}\n{\"text\": \"扱う商品や市場が変わっても、\"}\n{\"text\": \"何度も結果を出すんですよ。\"}\n{\"text\": \"\"}\n{\"text\": \"逆に、\"}\n{\"text\": \"稼げる市場を探し続けても、\"}\n{\"text\": \"\"}\n{\"text\": \"一つへ集中せず、\"}\n{\"text\": \"行動する前に悩み、\"}\n{\"text\": \"失敗したらすぐに別の方法へ移れば、\"}\n{\"text\": \"判断力は育ちません。\"}\n{\"text\": \"\"}\n{\"text\": \"与沢翼さんの人生を\\n丸ごと真似する必要はありません。\"}\n{\"text\": \"\"}\n{\"text\": \"過去の行動に対して、\"}\n{\"text\": \"厳しい評価をする人がいるのは当然です。\"}\n{\"text\": \"\"}\n{\"text\": \"ただ、\"}\n{\"text\": \"好きか嫌いかだけで、\"}\n{\"text\": \"『使える考え方』まで\\nすべて捨てる必要もありません。\\n\"}\n{\"text\": \"特定の人物を心酔せず、\\n「使える原則」だけを活かす\"}\n{\"text\": \"\\n⤴︎この距離感が大切です。\"}\n{\"text\": \"\\n\"}\n{\"text\": \"●アクションプラン\"}\n{\"text\": \"\\nいきなり\"}\n{\"text\": \"今、取り組んでること全てを\"}\n{\"text\": \"変える必要はなくて\"}\n{\"text\": \"まずは、\"}\n{\"text\": \"↓の3つだけで結果は出ます\"}\n{\"text\": \"\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n①今のセンターピンを一つ決める\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"Xを伸ばす。\"}\n{\"text\": \"商品を作る。\"}\n{\"text\": \"営業力を身につける。\"}\n{\"text\": \"副業で最初の売上を作る。\"}\n{\"text\": \"\\n⤴︎\\n今、一番集中すべきものを\\n一つ選びましょう。\"}\n{\"text\": \"\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n②30日間やらないことを決める\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"〜〜〜\\n・新しい副業を探さない。\"}\n{\"text\": \"・別のSNSを始めない。\"}\n{\"text\": \"・必要のない情報は見ない。\"}\n{\"text\": \"・惰性の付き合いを一つ減らす。\\n〜〜〜\"}\n{\"text\": \"やることより、\\nやらないことを先に決めます。\"}\n{\"text\": \"\"}\n{\"text\": \"━━━━━━━━━━━━\\n③今日中に一つ実行する\\n━━━━━━━━━━━━\"}\n{\"text\": \"情報を集めて終わらずに、\"}\n{\"text\": \"「投稿する」\"}\n{\"text\": \"「提案する」\"}\n{\"text\": \"「販売する」\"}\n{\"text\": \"「分析する」\"}\n{\"text\": \"一つだけでもいいので、\"}\n{\"text\": \"数字・反応として返ってくる行動を\\nしてください。\"}\n{\"text\": \"\"}\n{\"text\": \"●本質\"}\n{\"text\": \"\\n僕も以前は、\"}\n{\"text\": \"稼ぐ人や成功者って\"}\n{\"text\": \"特別な才能やセンスが\\nあると思っていました。\"}\n{\"text\": \"\"}\n{\"text\": \"でも、\"}\n{\"text\": \"いろいろな起業家や研究を分析してみると\"}\n{\"text\": \"違ったんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"稼ぐ人は、\"}\n{\"text\": \"最初から正解を\\n知っているわけではありません。\"}\n{\"text\": \"\"}\n{\"text\": \"〜〜〜\\n一つを決める。\"}\n{\"text\": \"余計なものを捨てる。\"}\n{\"text\": \"小さく動く。\"}\n{\"text\": \"数字を見る。\"}\n{\"text\": \"修正して、もう一度やる。\\n〜〜〜\"}\n{\"text\": \"⤴︎この回数が、\\n普通の人よりバグってるだけで。\"}\n{\"text\": \"\"}\n{\"text\": \"大切なのは、\"}\n{\"text\": \"稼げる副業を\\n探し続けることではありません。\"}\n{\"text\": \"\"}\n{\"text\": \"今選んだものを、\"}\n{\"text\": \"稼げるところまで\\n集中できる自分になることです。\"}\n{\"text\": \"\"}\n{\"text\": \"●さいごに\"}\n{\"text\": \"今回お伝えしたのは、\\n「何をしても稼ぐ人」の考え方です。\"}\n{\"text\": \"ただ、考え方を知るだけでは\\n現実は変わりません。\"}\n{\"text\": \"大事なのは、\\n知ったあとに実際に動くこと。\"}\n{\"text\": \"\\nこの記事と合わせて、 \\n副業で結果を出すまでの全体像も\\n知っておきたい方へ🎁\"}\n{\"text\": \"\"}\n{\"text\": \"現在、公式LINEにて\"}\n{\"text\": \"『SNS副業 完全攻略スターターキット』\"}\n{\"text\": \"を公開してます。\"}\n{\"text\": \" \"}\n{\"text\": \"本来、有料コンテンツとして出す予定のものなので\"}\n{\"text\": \"定員に達したら配布を締め切ります。\\n\"}\n{\"text\": \"今のうちに\\n記事とあわせて受け取っておいてください。\"}\n{\"text\": \"▼▼▼\"}\n{\"text\": \"特典を受け取る\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f381.svg\"}\n{\"url\": \"https://lin.ee/PYg9oSd\"}\n{\"description\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\", \"name\": \"とら🐯AIマネタイズ\", \"url\": \"https://x.com/3Imzdo3\"}\n{\"text\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\"}\n{\"url\": \"https://lin.ee/cnl9M18\"}\n{\"text\": \"https://t.co/VlOnsgmU9X\"}\n{\"author\": {\"avatar_url\": \"https://pbs.twimg.com/profile_images/1893661706477535232/eH44MC_b_200x200.jpg\", \"banner_url\": \"https://pbs.twimg.com/profile_banners/1694244014671978496/1766544361\", \"description\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\", \"followers\": 1119, \"following\": 50, \"id\": \"1694244014671978496\", \"joined\": \"Wed Aug 23 07:03:56 +0000 2023\", \"likes\": 2438, \"location\": \"副収入を生み出す方法→\", \"media_count\": 138, \"name\": \"とら🐯AIマネタイズ\", \"protected\": false, \"raw_description\": {\"facets\": [], \"text\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\"}, \"screen_name\": \"3Imzdo3\", \"statuses\": 2914, \"type\": \"profile\", \"url\": \"https://x.com/3Imzdo3\", \"verification\": {\"type\": \"individual\", \"verified\": true, \"verified_at\": null}, \"website\": {\"display_url\": \"lin.ee/cnl9M18\", \"url\": \"https://lin.ee/cnl9M18\"}}, \"created_at\": \"Fri Jul 31 09:12:18 +0000 2026\", \"text\": \"\", \"url\": \"https://x.com/3Imzdo3/status/2083118547816100254\"}\n{\"content\": {\"blocks\": [{\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"37ps6\", \"text\": \"「楽天アフィって\\n　単価も低いし、毎日大量に記事を書かないと\\n　稼げないやつでしょ」\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"mghb\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"c7nsg\", \"text\": \"ぶっちゃけ、僕も\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1v2ij\", \"text\": \"「楽天アフィも、結局は\\n　作業量で攻めるしかないんだろうな」\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3osor\", \"text\": \"と思っていたんですよね。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"970st\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d4vic\", \"text\": \"でも、Claude Code×楽天アフィの\\n仕組みを知って、去年から始めた結果\\n7月時点で“月36万”を1人で作れてしまいました（個人差はあります）。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2ohro\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"e43qr\", \"text\": \"顔出しなし。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1fn7d\", \"text\": \"撮影なし。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"9v1ja\", \"text\": \"文章が得意じゃなくてもOK。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"c1bp6\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8luvh\", \"text\": \"やることは、Claude Codeに\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2re19\", \"text\": \"・商品リサーチ\\n・記事構成\\n・比較表\\n・紹介文\\n・Threads投稿\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"evt7i\", \"text\": \"までまとめて作らせて、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8lk\", \"text\": \"自分は商品情報の確認と\\n経験やストーリーを加えるだけ。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1njl4\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"b75dg\", \"text\": \"「いや、AIに記事を書かせて\\n　本当に収益につながるの？」\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"au6mb\", \"text\": \"って思うかもしれません。\", \"type\": 