nstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4eup1\", \"text\": \"この順番で設計することが重要なんですよね。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4ie0h\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"908fv\", \"text\": \"STEP1：発信ジャンルを一つに絞る\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4cpq8\", \"text\": \"初心者が最初にやるべきことは、\\n動画を作ることではありません。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"86mu5\", \"text\": \"まずは、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"208rh\", \"text\": \"『何について発信するのか？』\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"9729a\", \"text\": \"を１つ決めましょう。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"86ds\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"e7n7f\", \"text\": \"というのも\\n発信ジャンルがバラバラだと、\\n視聴者から見て、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"7frbv\", \"text\": \"「...これ何のアカウント？」\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"56i7g\", \"text\": \"と何者なのか分からないので\\n離脱されちゃうんですよね。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"bhsr9\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"e23h8\", \"text\": \"たとえば、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ebtvm\", \"text\": \"昨日は、恋愛占い\\n今日は、転職\\n明日は、美容\\nその次の日は、投資\", \"type\": \"unstyled\"}, {\"data\": {}, \"