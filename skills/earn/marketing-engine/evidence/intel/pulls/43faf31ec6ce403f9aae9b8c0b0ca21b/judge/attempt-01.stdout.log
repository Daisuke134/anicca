{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json,glob,os,re\nbase='/Users/anicca/anicca/skills/earn/marketing-engine/evidence/intel/pulls'\npaths=glob.glob(base+'/*/*.json')\nfor p in paths:\n d=json.load(open(p)); print('\\\\n###',p)\n def walk(x,path=''):\n  if isinstance(x,dict):\n   # print dicts likely records\n   keys=set(x)\n   if keys & {'item_id','title','text','description','url','html_url','canonical_url','rating','rating_count','name','full_name','stargazers_count','watchers_count','commits'}:\n    out={k:x[k] for k in x if k in ['item_id','source_id','title','text','description','url','html_url','canonical_url','rating','rating_count','user_rating_count','averageUserRating','trackName','trackViewUrl','releaseNotes','name','full_name','stargazers_count','watchers_count','forks_count','topics','homepage','author','handle','metrics','published_at','created_at','updated_at','body','content','summary','commit','message']}\n    if out: print(json.dumps(out,ensure_ascii=False))\n   for k,v in x.items(): walk(v,path+'/'+k)\n  elif isinstance(x,list):\n   for i,v in enumerate(x): walk(v,path+f'[{i}]')\n walk(d)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
