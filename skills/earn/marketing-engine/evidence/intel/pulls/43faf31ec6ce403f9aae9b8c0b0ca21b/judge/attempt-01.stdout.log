\": \"Bold\"}, {\"length\": 16, \"offset\": 0, \"style\": \"Italic\"}], \"key\": \"6bk89\", \"text\": \"「AIっぽい画像になってしまう」\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 16, \"offset\": 0, \"style\": \"Bold\"}, {\"length\": 16, \"offset\": 0, \"style\": \"Italic\"}], \"key\": \"6m982\", \"text\": \"「SNSに使える画像を作りたい」\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 16, \"offset\": 0, \"style\": \"Bold\"}, {\"length\": 16, \"offset\": 0, \"style\": \"Italic\"}], \"key\": \"bhi0s\", \"text\": \"「まずは見本を使って生成したい」\\n\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"es7os\", \"text\": \"という方は↓から受け取ってください。\\n\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 29, \"offset\": 17, \"style\": \"Bold\"}], \"key\": \"efa76\", \"text\": \"━━━━━━━━━━━━━━━━\\n【リアルなAI美女プロンプト50選】\\n\\n合言葉「AI美女」と送っていただくと\\nプレゼントを受け取れます↓\", \"type\": \"unstyled\"}, {\"data\": {\"urls\": [{\"fromIndex\": 0, \"text\": \"https://lin.ee/XKLbNZiT\", \"toIndex\": 23}]}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"f85cs\", \"text\": \"https://lin.ee/XKLbNZiT\\n━━━━━━━━━━━━━━━━\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1umd\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 33, \"offset\": 22, \"style\": \"Bold\"}], \"key\": \"706q2\", \"text\": \"※iPhoneの場合は、リンククリック後 \\n①「LINEアプリを開く」を長押し \\n②「リンクを開く」を押す 　\\nと飛べます！\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"7f26k\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"50f4d\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4ahrd\", \"text\": \"●最後に\", \"type\": \"header-one\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6ckmp\", \"text\": \"一番もったいないのは、\\nツールやプロンプトを調べ続けて\\n一枚も作らずに終わることです。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1425v\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"aig4r\", \"text\": \"キャラクターを一人決める。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ahck3\", \"text\": \"プロンプトを一つコピーする。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"f3qta\", \"text\": \"画像を一枚生成する。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2ld8j\", \"text\": \"⤴︎\\nまずは、これだけで十分です。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d74co\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ateeu\", \"text\": \"最初から完璧な画像を\\n作る必要はありません。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"33mgb\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fqv2s\", \"text\": \"出てきた画像を見ながら、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"dr5vl\", \"text\": \"〜〜〜\\n髪型を変える。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d22au\", \"text\": \"服を変える。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8afcb\", \"text\": \"光を変える。\\n〜〜〜\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"adin8\", \"text\": \"少しずつ、自分のキャラクターへ\\n近づけていけばOKです。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"e470a\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5j92c\", \"text\": \"AIを使いこなせる人と、\\n情報を集め続ける人の差は、\\n知識量ではありません。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"efirv\", \"text\": \"\\n知ったあとに、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 15, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"ar4ik\", \"text\": \"一度でも\\n手を動かしたかどうかです。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cmrj5\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"bruj8\", \"text\": \"まずはプレゼントを受け取って、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d5kih\", \"text\": \"この後、一枚だけ\\n作ってみてください。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"a2q4\", \"text\": \"\\nその一枚が、あなたの発信を始める\\n最初の武器になります。\", \"type\": \"unstyled\"}], \"entityMap\": [{\"key\": \"12\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/2615.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"8\", \"value\": {\"data\": {\"entityKey\": \"849ceec6-488c-4c63-a9f7-17cf4d559119\", \"mediaItems\": [{\"localMediaId\": \"9\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2082724751785766912\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"19\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f381.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"4\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/274c.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"15\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"11\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/274c.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"9\", \"value\": {\"data\": {\"entityKey\": \"ef56f786-c92f-4cc3-bed5-1243bde4fc80\", \"mediaItems\": [{\"localMediaId\": \"13\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2082726122182320128\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"22\", \"value\": {\"data\": {\"entityKey\": \"59b84921-c404-4827-b9cc-7bd4ab7cf044\", \"mediaItems\": [{\"localMediaId\": \"13\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2082733362586976257\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"13\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/2b55.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"16\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64e-200d-2640-fe0f.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"5\", \"value\": {\"data\": {\"entityKey\": \"888c2dd5-b572-4489-852c-34a9390f7a98\", \"mediaItems\": [{\"localMediaId\": \"3\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2082704333913915392\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"10\", \"value\": {\"data\": {\"entityKey\": \"ed847698-7506-41a7-b2bb-b273e76a18c2\", \"mediaItems\": [{\"localMediaId\": \"6\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2082728207728664576\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"21\", \"value\": {\"data\": {\"entityKey\": \"f387b1ef-0aa6-46fb-84d7-cb152b077158\", \"mediaItems\": [{\"localMediaId\": \"10\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2082731620508028928\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"6\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/2b55.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"1\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64e-200d-2640-fe0f.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"17\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"14\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/2615.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"0\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"20\", \"value\": {\"data\": {\"entityKey\": \"a3a135ec-472b-485c-9757-1ee8bf3a91ce\", \"mediaItems\": [{\"localMediaId\": \"8\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2082730243824209920\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"2\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"18\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f4a6.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}, {\"key\": \"7\", \"value\": {\"data\": {\"entityKey\": \"6bee146f-57ff-4e1c-8dec-bccb841aa31b\", \"mediaItems\": [{\"localMediaId\": \"11\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2082725457364144128\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}, {\"key\": \"3\", \"value\": {\"data\": {\"entityKey\": \"178e0845-880e-4572-851a-04767e85c611\", \"mediaItems\": [{\"localMediaId\": \"1\", \"mediaCategory\": \"DraftTweetImage\", \"mediaId\": \"2082703811978862592\"}]}, \"mutability\": \"Immutable\", \"type\": \"MEDIA\"}}]}, \"created_at\": \"2026-07-30T09:29:26.000Z\", \"title\": \"【プロンプト付き】AI美女×SNSでマネタイズするための全体像\"}\n{\"text\": \"\\nAI美女を作ってみた！\"}\n{\"text\": \"だけど...\"}\n{\"text\": \"〜〜〜〜〜\\n・どのツールがベストなのか\"}\n{\"text\": \"・生成しても人形っぽくなる\"}\n{\"text\": \"・毎回、別人のような顔になる\"}\n{\"text\": \"・どんな画像を投稿すればいいか分からない\"}\n{\"text\": \"・そもそも収益につながるの？\\n〜〜〜〜〜\"}\n{\"text\": \"と悩む人も多いんじゃないでしょうか？\"}\n{\"text\": \"\"}\n{\"text\": \"実際、生成AIに\"}\n{\"text\": \"「かわいい日本人女性を作って」\"}\n{\"text\": \"と入力するだけでも、\\nそれっぽい画像は作れます。\"}\n{\"text\": \"\"}\n{\"text\": \"でも、いざSNSで使おうとしても\"}\n{\"text\": \"\"}\n{\"text\": \"🙍‍♂️肌がツルツルすぎて、AI感満載じゃん…\"}\n{\"text\": \"🙎‍♀️ポーズも背景も毎回同じになる…\"}\n{\"text\": \"🙍‍♂️投稿してもアカウント伸びない…\"}\n{\"text\": \"\"}\n{\"text\": \"という壁にぶつかるんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"ただ、これは\\n画像生成の才能がないからではありません。\"}\n{\"text\": \"\"}\n{\"text\": \"AI美女をSNSで伸ばすには、\\nただキレイな画像を作るのではなく、\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n①キャラクターを設計する\"}\n{\"text\": \"②リアルに見える要素を入れる\"}\n{\"text\": \"③同じ人物に見せる\"}\n{\"text\": \"④投稿にストーリーを持たせる\"}\n{\"text\": \"⑤収益導線までつなげる\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"⤴︎この順番で作る必要があります。\"}\n{\"text\": \"\"}\n{\"text\": \"つまり、必要なのは\"}\n{\"text\": \"センスよりも『型』です。\"}\n{\"text\": \"\"}\n{\"text\": \"この記事では、\\n初心者でも実践できるように、\"}\n{\"text\": \"〜〜〜\\n①キャラクター設計\"}\n{\"text\": \"②リアルな画像を作るコツ\"}\n{\"text\": \"③プロンプトの作り方\"}\n{\"text\": \"④投稿内容の設計\"}\n{\"text\": \"⑤収益化へのつなげ方\"}\n{\"text\": \"⑥デメリット・注意点\\n〜〜〜\"}\n{\"text\": \"まで具体的に解説します。\"}\n{\"text\": \"\"}\n{\"text\": \"STEP①：いきなり画像を作らない\"}\n{\"text\": \"\\nAI美女を始めるとき、多くの人が最初に\"}\n{\"text\": \"「とりあえず美女を生成してみよ」\"}\n{\"text\": \"と考えがちです。\"}\n{\"text\": \"\"}\n{\"text\": \"でも、先に決めるべきなのは、\"}\n{\"text\": \"『誰を作るのか？』\"}\n{\"text\": \"⤴︎これなんですよ。\"}\n{\"text\": \" \"}\n{\"text\": \"\"}\n{\"text\": \"〜〜〜\\n昨日は黒髪の会社員。\"}\n{\"text\": \"今日は金髪のアイドル。\"}\n{\"text\": \"明日はショートヘアのモデル。\\n〜〜〜\"}\n{\"text\": \"⤴︎こんな状態だと、\\n一枚ずつはキレイでも、\"}\n{\"text\": \"一人のキャラクターとして覚えてもらえません。\"}\n{\"text\": \"\"}\n{\"text\": \"一方で、\"}\n{\"text\": \"髪型や服装の方向性が統一され、\"}\n{\"text\": \"〜〜〜\\n「今日はカフェにいる」\"}\n{\"text\": \"「仕事終わりに買い物へ行った」\"}\n{\"text\": \"「休日に美術館へ行った」\\n〜〜〜\"}\n{\"text\": \"という投稿が続けば、ただの画像ではなく、\\n一人のキャラクター（人物）として\\nファン化の入り口に立てるんですね。\"}\n{\"text\": \"\"}\n{\"text\": \"ちなみに、最初に決めるのは\\n↓の項目です。\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n・名前\"}\n{\"text\": \"・成人だと分かる年齢\"}\n{\"text\": \"・髪型、髪色\"}\n{\"text\": \"・服装の系統\"}\n{\"text\": \"・仕事\"}\n{\"text\": \"・趣味\"}\n{\"text\": \"・性格\"}\n{\"text\": \"・よく行く場所\"}\n{\"text\": \"・投稿する内容\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"具体例を挙げると↓\"}\n{\"text\": \"〜〜〜〜〜\\n名前：美月\"}\n{\"text\": \"年齢：26歳\"}\n{\"text\": \"仕事：都内で働く会社員\"}\n{\"text\": \"髪型：黒髪ミディアム\"}\n{\"text\": \"服装：シンプルで清潔感のあるコーデ\"}\n{\"text\": \"趣味：カフェ、読書、旅行\"}\n{\"text\": \"投稿内容：\\n仕事の日常、休日のお出かけ、\\nカフェ、自宅での作業\\n〜〜〜〜〜\"}\n{\"text\": \"って感じですね。\"}\n{\"text\": \"\"}\n{\"text\": \"ちなみに、キャラクター設計には\\n↓のプロンプトが使えます。\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\nあなたはSNSキャラクター設計に詳しい\\nクリエイティブディレクターです。\"}\n{\"text\": \"以下の条件をもとに、\\n成人の架空の日本人女性キャラクターを\\n設計してください。\"}\n{\"text\": \"発信テーマ：\\n【カフェ・旅行・仕事・美容など】\"}\n{\"text\": \"キャラクターの雰囲気：\\n【親しみやすい・上品・活発など】\"}\n{\"text\": \"条件：\\n・実在の人物や有名人に似せない\\n・成人だと明確に分かる設定\\n・日常投稿を30個以上作れる\\n・髪型や服装に一貫性を持たせる\\n・過度な露出や性的な設定を避ける\"}\n{\"text\": \"出力形式：\\n・名前\\n・年齢\\n・仕事\\n・性格\\n・趣味\\n・髪型\\n・服装\\n・投稿テーマ10個\\n・プロフィール文\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"キャラ設定を作ったら、\"}\n{\"text\": \"「この人物は、\\n　どんな毎日を送っているのか？」\"}\n{\"text\": \"まで想像してみてください。\"}\n{\"text\": \"ここの細部のこだわりが\\n”実在感（リアルさ）”に直結してきます。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"STEP②：リアルさは“顔”だけで決まらない\"}\n{\"text\": \"AI美女を作るとき、\"}\n{\"text\": \"多くの人が、\"}\n{\"text\": \"「目の大きさ」\\n「顔の形」\\n「髪型」\\n「メイク」\"}\n{\"text\": \"ばかりを細かく指定します。\"}\n{\"text\": \"\"}\n{\"text\": \"でも、このリアル感って\"}\n{\"text\": \"顔のかわいさだけではありません。\"}\n{\"text\": \"重要なのは、\"}\n{\"text\": \"↓の6つです。\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n①光\"}\n{\"text\": \"②カメラ・画角\"}\n{\"text\": \"③肌の質感\"}\n{\"text\": \"④背景\"}\n{\"text\": \"⑤表情\"}\n{\"text\": \"⑥生活感\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"たとえば、\"}\n{\"text\": \"❌悪い例\"}\n{\"text\": \"かわいい日本人女性、\\n完璧な顔、超美人、最高品質\"}\n{\"text\": \"これだけだと、\"}\n{\"text\": \"キレイだけど、\"}\n{\"text\": \"肌がプラスチックのような\\n不自然な画像になりがちです。\"}\n{\"text\": \" \"}\n{\"text\": \"\"}\n{\"text\": \"一方で、\"}\n{\"text\": \"⭕️良い例\"}\n{\"text\": \"〜〜〜〜〜\\n成人の架空の日本人女性、\"}\n{\"text\": \"自然な黒髪、\"}\n{\"text\": \"白いTシャツ、\"}\n{\"text\": \"朝の窓際で撮影したセルフィー、\"}\n{\"text\": \"薄いメイク、\"}\n{\"text\": \"自然な毛穴と産毛、\"}\n{\"text\": \"少し生活感のある部屋、\"}\n{\"text\": \"窓から入る柔らかな自然光、\"}\n{\"text\": \"スマートフォンで撮影した実写写真\\n〜〜〜〜〜\"}\n{\"text\": \"と指定すると、\"}\n{\"text\": \"誰が\\nどこで\\n何をしていて\\nどんな光で撮ったのか\"}\n{\"text\": \"が具体的になります。\"}\n{\"text\": \" \"}\n{\"text\": \"\"}\n{\"text\": \"AIっぽさを減らしたいなら、\"}\n{\"text\": \"“完璧な美女”を目指すのではなく、\"}\n{\"text\": \"現実の写真にある情報を\\n足すのがポイントです。\"}\n{\"text\": \"たとえば、\"}\n{\"text\": \"〜〜〜\\n少し乱れた前髪\"}\n{\"text\": \"服にできた自然なシワ\"}\n{\"text\": \"わずかに左右差のある表情\"}\n{\"text\": \"背景に置かれたマグカップ\"}\n{\"text\": \"カメラを意識していない目線\\n〜〜〜\"}\n{\"text\": \"などです。\"}\n{\"text\": \"\"}\n{\"text\": \"さらにリアルにしたい場合は、\"}\n{\"text\": \"プロンプトの最後に\\n↓を追加してください。\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n自然な肌の毛穴と産毛、\"}\n{\"text\": \"わずかな左右差、\"}\n{\"text\": \"作り込みすぎない表情、\"}\n{\"text\": \"現実的な光と影、\"}\n{\"text\": \"過度な美肌加工なし、\"}\n{\"text\": \"プラスチックのような肌を避ける\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \" \"}\n{\"text\": \"ただし、プロンプトを入れれば\\n必ず完璧になるわけではありません。\"}\n{\"text\": \"生成後は、\"}\n{\"text\": \"・手指\\n・目線\\n・歯\\n・耳\\n・背景の文字\\n・鏡の反射\"}\n{\"text\": \"を確認しましょう。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"STEP③：プロンプトは“6つの箱”で作る\\n\"}\n{\"text\": \"毎回ゼロから考えるのは大変なので、\\nプロンプトを↓の6項目に分けます。\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n①人物\"}\n{\"text\": \"②髪型・服装\"}\n{\"text\": \"③場所\"}\n{\"text\": \"④行動・表情\"}\n{\"text\": \"⑤光・時間帯\"}\n{\"text\": \"⑥写真の撮られ方\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"\"}\n{\"text\": \"たとえば、カフェの画像なら、\"}\n{\"text\": \"〜〜〜〜〜\\n①人物\"}\n{\"text\": \"成人の架空の日本人女性\\n〜〜〜〜〜\\n②髪型・服装\"}\n{\"text\": \"ブラウンのミディアムヘア、\\n淡いブルーのシャツ\\n〜〜〜〜〜\\n③場所\"}\n{\"text\": \"明るいカフェの窓際\\n〜〜〜〜〜\\n④行動・表情\"}\n{\"text\": \"テーブル越しに自然に微笑む\\n〜〜〜〜〜\\n⑤光・時間帯\"}\n{\"text\": \"午後の柔らかな自然光\\n〜〜〜〜〜\\n⑥写真の撮られ方\"}\n{\"text\": \"35mmレンズで撮影した\\n自然な実写スナップ\\n〜〜〜〜〜\"}\n{\"text\": \"となります。\"}\n{\"text\": \" \"}\n{\"text\": \"要するに、\"}\n{\"text\": \"「美女を作って」\\nではなく、\"}\n{\"text\": \"『写真を撮った場面を説明する』\\nという感覚です。\"}\n{\"text\": \"\"}\n{\"text\": \"投稿シーンを増やしたい場合は、\\n↓のプロンプトを使ってみてください。\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\nあなたはSNS用の写真企画を考える\\nフォトディレクターです。\"}\n{\"text\": \"以下のキャラクターが投稿しそうな\\n実写風の画像シーンを20個提案してください。\"}\n{\"text\": \"キャラクター設定：\\n【設定を貼り付ける】\"}\n{\"text\": \"条件：\\n・成人の架空人物として扱う\\n・日常生活にありそうな場面\\n・同じ場所やポーズを重複させない\\n・自撮り、全身、横顔、友人撮影を混ぜる\\n・朝、昼、夕方、夜を入れる\\n・過度な露出や性的な場面を避ける\"}\n{\"text\": \"出力形式：\\n・シーン名\\n・場所\\n・服装\\n・行動\\n・表情\\n・光\\n・完成プロンプト\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"STEP④：“固定”と“変化”で同じ人物に見せる\"}\n{\"text\": \"\"}\n{\"text\": \"AI美女アカウントで重要なのが、\"}\n{\"text\": \"『毎回、同じ人物に見えるか？』\"}\n{\"text\": \"です。\"}\n{\"text\": \"\"}\n{\"text\": \"そこで、プロンプトを\\n「固定する部分」と「変える部分」に分けます。\"}\n{\"text\": \"\"}\n{\"text\": \"●固定する部分\"}\n{\"text\": \"・年齢\\n・顔の雰囲気\\n・髪型、髪色\\n・肌の特徴\\n・服装の系統\\n・写真全体の色味\\n\"}\n{\"text\": \"●変える部分\"}\n{\"text\": \"・場所\\n・時間帯\\n・ポーズ\\n・表情\\n・撮影距離\\n・細かい服装\\n\"}\n{\"text\": \"たとえば、\"}\n{\"text\": \"「26歳、黒髪ミディアム、落ち着いた雰囲気、薄いメイク」\"}\n{\"text\": \"までは固定する。\"}\n{\"text\": \"\"}\n{\"text\": \"そのうえで、\"}\n{\"text\": \"♢今日はカフェ。\"}\n{\"text\": \"♢明日はオフィス。\"}\n{\"text\": \"♢次は雨の日の駅前。\"}\n{\"text\": \"♢休日は美術館。\"}\n{\"text\": \"とシチュエーションを変えるイメージです。\"}\n{\"text\": \" \"}\n{\"text\": \"\"}\n{\"text\": \"また、正面の顔写真だけを\\n何枚も並べるのも不自然です。\"}\n{\"text\": \"・顔が分かるアップ\\n・自然な上半身\\n・全身のコーデ\\n・何かをしている横顔\\n・風景を含めた後ろ姿\"}\n{\"text\": \"を混ぜることで、\\n実際のSNSアカウントに近づけれますよ。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"STEP⑤：画像ではなく“生活”を投稿\\n\"}\n{\"text\": \"画像を作ったら、\\nそのまま投稿したくなりますよね。\"}\n{\"text\": \"でも、\\nただキレイな画像を並べるだけでは、\\n見られて終わる可能性が高いです。\"}\n{\"text\": \"\"}\n{\"text\": \"実際に、\\nフォロー・ファン化に繋げるには、\"}\n{\"text\": \"「どんな人物の\\n　どんな一日なのか？」\"}\n{\"text\": \"が分かる投稿にします。\"}\n{\"text\": \"\"}\n{\"text\": \"たとえば、\"}\n{\"text\": \"❌悪い例\\n→カフェに来ました☕️\"}\n{\"text\": \"⭕️良い例\\n→新しいカフェを見つけたので、\\n　仕事前に少しだけ寄り道☕️\"}\n{\"text\": \"　みんなは朝型？夜型？\"}\n{\"text\": \"\"}\n{\"text\": \"画像の説明だけではなく、\\nストーリーと\\n回答しやすい質問を入れる。\"}\n{\"text\": \"すると、\\n見るだけの投稿から\\nアクションを誘導できる投稿に変わります。\"}\n{\"text\": \"\"}\n{\"text\": \"ちなみに、投稿内容は\\n↓の4種類を混ぜると作りやすいです。\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n①日常\"}\n{\"text\": \"②趣味・好きなもの\"}\n{\"text\": \"③仕事や目標\"}\n{\"text\": \"④フォロワーへの質問\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"AI美女の画像を投稿するのではなく、\\n“キャラクターの生活を投稿する”。\"}\n{\"text\": \"⤴︎ここがポイントです。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"STEP⑥：画像・発信・収益導線をつなげる\\n\"}\n{\"text\": \"ここまでで、AI美女の作り方は\\nイメージできたと思います。\"}\n{\"text\": \"\"}\n{\"text\": \"ただ、正直なところ\"}\n{\"text\": \"キレイな画像を作れるだけでは\\n収益にはつながりません。\"}\n{\"text\": \"\"}\n{\"text\": \"よくあるのが、\"}\n{\"text\": \"〜〜〜〜〜\\n♢画像は作れたけど、\\n　何を発信すればいいか分からない…\"}\n{\"text\": \"♢投稿しているけど、インプが増えない…\"}\n{\"text\": \"♢商品を置いても売れない…\\n〜〜〜〜〜\"}\n{\"text\": \"という状態です。\"}\n{\"text\": \"\"}\n{\"text\": \"この場合、\\n画像のクオリティより、\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n誰に見せるのか？\"}\n{\"text\": \"何を発信するのか？\"}\n{\"text\": \"どこをゴールにするのか？\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"がつながっていない可能性があります。\"}\n{\"text\": \"\"}\n{\"text\": \"たとえば、\\n仕事や勉強を頑張るキャラクターなら、\"}\n{\"text\": \"・AI活用\\n・仕事効率化\\n・勉強方法\\n・便利なサービス\"}\n{\"text\": \"などと相性がいいです。\"}\n{\"text\": \"\"}\n{\"text\": \"旅行好きのキャラクターなら、\"}\n{\"text\": \"・旅行情報\\n・ホテル\\n・旅行グッズ\\n・地域別のまとめ\"}\n{\"text\": \"などが考えられます。\"}\n{\"text\": \"\"}\n{\"text\": \"大切なのは、\\n画像を作ったあとに\\n無理やり商品を決めるのではなく、\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n誰に見てもらうか\\n　↓\\n何を発信するか\\n　↓\\nどんな悩みを解決するか\\n　↓\\nどこで収益化するか\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"を一本につなげることで、\\nその中で画像を作っていくイメージです。\"}\n{\"text\": \"\"}\n{\"text\": \"ただし、架空の人物を\\n実在の専門家や利用者に見せて、\\n使っていない商品を\"}\n{\"text\": \"「私も使って効果がありました」\"}\n{\"text\": \"と紹介するのは避けましょう。\"}\n{\"text\": \"\"}\n{\"text\": \"長く運用するなら、\\n目先の数字より\\n信頼を優先することが大切です。\"}\n{\"text\": \"\"}\n{\"text\": \"デメリット面\"}\n{\"text\": \"ここまで読むと、\"}\n{\"text\": \"「プロンプトがあれば\\n　簡単にできそうじゃね？」\"}\n{\"text\": \"と思うかもしれません。笑\"}\n{\"text\": \"\\nただし、\\nメリットもあれば、当然デメリットもあります。\"}\n{\"text\": \"\"}\n{\"text\": \"①毎回同じ顔になるとは限らない\"}\n{\"text\": \"同じ文章でも、\"}\n{\"text\": \"角度や表情によって\\n別人のようになることがあります。\"}\n{\"text\": \"複数枚生成して、\\n使える画像を選ぶ作業は必要です。\"}\n{\"text\": \"\"}\n{\"text\": \"②画像を作っただけじゃ収益にはならない\"}\n{\"text\": \"AI美女は、あくまで発信に使う素材です。\"}\n{\"text\": \"投稿テーマやプロフィール、\\n収益導線がなければ、\\n画像が見られただけで売上は０です。\"}\n{\"text\": \"\"}\n{\"text\": \"③誤解を招く運用は、信用が消える\"}\n{\"text\": \"有名人に似せたり、\\n実在人物のように過度に装ったり、\\n架空の体験談で商品を紹介したりすると、\\n長期的な信頼を失います。\"}\n{\"text\": \"\\nつまり、AI美女は\\nボタン一つで自動的に稼げる方法ではありません。\"}\n{\"text\": \"\"}\n{\"text\": \"ですが、\"}\n{\"text\": \"〜〜〜\\nモデルを手配しなくていい\"}\n{\"text\": \"撮影場所が必要ない\"}\n{\"text\": \"多様なシーンを作れる\"}\n{\"text\": \"顔出しなしで素材を用意できる\"}\n{\"text\": \"改善しながら量産できる\\n〜〜〜\"}\n{\"text\": \"というメリットが最強なんですよね。\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"今日のアクション\\n\"}\n{\"text\": \"今日やることは、この3つだけ↓\"}\n{\"text\": \"\\n①キャラクターを一人決める\"}\n{\"text\": \"年齢\\n髪型\\n服装\\n仕事\\n趣味\"}\n{\"text\": \"\"}\n{\"text\": \"②画像シーンを3つ決める\"}\n{\"text\": \"朝の窓際\\nカフェ\\n仕事終わりの街中\"}\n{\"text\": \"\"}\n{\"text\": \"③同じ人物で3枚生成する\"}\n{\"text\": \"人物設定は固定し、背景や行動だけを変えます。\"}\n{\"text\": \"\\n3枚を並べて、\"}\n{\"text\": \"〜〜〜\\n・同じ人物に見えるか？\"}\n{\"text\": \"・AIっぽい肌になっていないか？\"}\n{\"text\": \"・指や背景が崩れていないか？\\n〜〜〜\"}\n{\"text\": \"を確認してください。\"}\n{\"text\": \"\"}\n{\"text\": \"ここまで進めれば、\\nAI美女アカウントの土台は\\nすでにできています。\"}\n{\"text\": \"\"}\n{\"text\": \"ただ、実際に作ろうとすると\\n\"}\n{\"text\": \"🙍‍♂️どんなプロンプトを入れたら、リアルになるの？\"}\n{\"text\": \"🙎‍♀️どのAIがいいんだろう...\"}\n{\"text\": \"🙍‍♂️毎回プロンプトを考えるのがしんどい💦\"}\n{\"text\": \"\\nと迷うと思います。\"}\n{\"text\": \"\"}\n{\"text\": \"そこで今回、コピペで使える\"}\n{\"text\": \"『リアルなAI美女プロンプト50選』\"}\n{\"text\": \"を用意しました🎁\"}\n{\"text\": \"\"}\n{\"text\": \"プレゼントには、\"}\n{\"text\": \"〜〜〜\\n♢自撮り・SNS投稿風\"}\n{\"text\": \"♢カフェ・お出かけ\"}\n{\"text\": \"♢仕事・勉強・副業風\"}\n{\"text\": \"♢ファッション・美容\"}\n{\"text\": \"♢アイドル・クリエイター風\\n〜〜〜\"}\n{\"text\": \"の5ジャンル、\"}\n{\"text\": \"合計50個のプロンプトを\\nまとめています。\"}\n{\"text\": \" \"}\n{\"text\": \" \"}\n{\"text\": \" \"}\n{\"text\": \"（⤴︎の画像もプレゼントのプロンプトで\\n　作成したものです）\"}\n{\"text\": \"\"}\n{\"text\": \"すべて、成人に見える\\n架空の日本人女性を想定し、\"}\n{\"text\": \"光\\nカメラ\\n肌の質感\\n背景\\n表情\\n生活感\"}\n{\"text\": \"まで入れています。\"}\n{\"text\": \"\"}\n{\"text\": \"使い方は、\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n①作りたいシーンを選ぶ\"}\n{\"text\": \"②プロンプトをコピーする\"}\n{\"text\": \"③髪型・服の色・場所を変える\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"この3STEPだけ。\"}\n{\"text\": \"\"}\n{\"text\": \"「AIっぽい画像になってしまう」\"}\n{\"text\": \"「SNSに使える画像を作りたい」\"}\n{\"text\": \"「まずは見本を使って生成したい」\\n\"}\n{\"text\": \"という方は↓から受け取ってください。\\n\"}\n{\"text\": \"━━━━━━━━━━━━━━━━\\n【リアルなAI美女プロンプト50選】\\n\\n合言葉「AI美女」と送っていただくと\\nプレゼントを受け取れます↓\"}\n{\"text\": \"https://lin.ee/XKLbNZiT\\n━━━━━━━━━━━━━━━━\"}\n{\"text\": \"https://lin.ee/XKLbNZiT\"}\n{\"text\": \"\"}\n{\"text\": \"※iPhoneの場合は、リンククリック後 \\n①「LINEアプリを開く」を長押し \\n②「リンクを開く」を押す 　\\nと飛べます！\"}\n{\"text\": \"\"}\n{\"text\": \"\"}\n{\"text\": \"●最後に\"}\n{\"text\": \"一番もったいないのは、\\nツールやプロンプトを調べ続けて\\n一枚も作らずに終わることです。\"}\n{\"text\": \"\"}\n{\"text\": \"キャラクターを一人決める。\"}\n{\"text\": \"プロンプトを一つコピーする。\"}\n{\"text\": \"画像を一枚生成する。\"}\n{\"text\": \"⤴︎\\nまずは、これだけで十分です。\"}\n{\"text\": \"\"}\n{\"text\": \"最初から完璧な画像を\\n作る必要はありません。\"}\n{\"text\": \"\"}\n{\"text\": \"出てきた画像を見ながら、\"}\n{\"text\": \"〜〜〜\\n髪型を変える。\"}\n{\"text\": \"服を変える。\"}\n{\"text\": \"光を変える。\\n〜〜〜\"}\n{\"text\": \"少しずつ、自分のキャラクターへ\\n近づけていけばOKです。\"}\n{\"text\": \"\"}\n{\"text\": \"AIを使いこなせる人と、\\n情報を集め続ける人の差は、\\n知識量ではありません。\"}\n{\"text\": \"\\n知ったあとに、\"}\n{\"text\": \"一度でも\\n手を動かしたかどうかです。\"}\n{\"text\": \"\"}\n{\"text\": \"まずはプレゼントを受け取って、\"}\n{\"text\": \"この後、一枚だけ\\n作ってみてください。\"}\n{\"text\": \"\\nその一枚が、あなたの発信を始める\\n最初の武器になります。\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/2615.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f381.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/274c.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/274c.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/2b55.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64e-200d-2640-fe0f.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/2b55.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64e-200d-2640-fe0f.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/2615.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f64d-200d-2642-fe0f.svg\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f4a6.svg\"}\n{\"description\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\", \"name\": \"とら🐯AIマネタイズ\", \"url\": \"https://x.com/3Imzdo3\"}\n{\"text\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\"}\n{\"url\": \"https://lin.ee/cnl9M18\"}\n{\"text\": \"https://t.co/PjR8Jn24iE\"}\n{\"author\": {\"avatar_url\": \"https://pbs.twimg.com/profile_images/1893661706477535232/eH44MC_b_200x200.jpg\", \"banner_url\": \"https://pbs.twimg.com/profile_banners/1694244014671978496/1766544361\", \"description\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\", \"followers\": 1119, \"following\": 50, \"id\": \"1694244014671978496\", \"joined\": \"Wed Aug 23 07:03:56 +0000 2023\", \"likes\": 2438, \"location\": \"副収入を生み出す方法→\", \"media_count\": 138, \"name\": \"とら🐯AIマネタイズ\", \"protected\": false, \"raw_description\": {\"facets\": [], \"text\": \"20代前半でSNS+サイト売却で4800万→サイドFIRE｜投資歴3年｜元工場リーマン(高卒)｜お金と時間に縛られない生活がモットー\"}, \"screen_name\": \"3Imzdo3\", \"statuses\": 2914, \"type\": \"profile\", \"url\": \"https://x.com/3Imzdo3\", \"verification\": {\"type\": \"individual\", \"verified\": true, \"verified_at\": null}, \"website\": {\"display_url\": \"lin.ee/cnl9M18\", \"url\": \"https://lin.ee/cnl9M18\"}}, \"created_at\": \"Wed Jul 29 09:01:08 +0000 2026\", \"text\": \"\", \"url\": \"https://x.com/3Imzdo3/status/2082390961368535423\"}\n{\"content\": {\"blocks\": [{\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"76r75\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"42vhc\", \"text\": \"副業を始めたい。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ebo07\", \"text\": \"とはいえ、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"89m2s\", \"text\": \"〜〜〜〜〜\\n顔出しはしたくない\\n\\nDM営業なんてしたくない\\n\\n高額商品を売るのは難しそう\\n\\n動画編集なんて分からない\\n\\nフォロワーも実績もゼロ\\n〜〜〜〜〜\\n、\\n、\\n、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fkls4\", \"text\": \"そう考える人と相性がいい選択肢の一つが、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 24, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"73hmt\", \"text\": \"『TikTok × LINE追加アフィリエイト』です。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [{\"key\": 0, \"length\": 1, \"offset\": 0}], \"inlineStyleRanges\": [], \"key\": \"4sunp\", \"text\": \" \", \"type\": \"atomic\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"tbk4\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"b58bb\", \"text\": \"一般的なアフィリエイトは、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1dimm\", \"text\": \"〜〜〜〜〜\\n商品を紹介する\\n　↓\\n読者が購入する\\n　↓\\n報酬が発生する\\n〜〜〜〜〜\\n\\nという流れですよね。\\n\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"e2jv\", \"text\": \"そのため、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [{\"key\": 1, \"length\": 4, \"offset\": 0}], \"inlineStyleRanges\": [], \"key\": \"68ljd\", \"text\": \"🙍‍♂️自分に商品を売れる気がしない...\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [{\"key\": 2, \"length\": 4, \"offset\": 0}, {\"key\": 3, \"length\": 1, \"offset\": 17}], \"inlineStyleRanges\": [], \"key\": \"2vsq\", \"text\": \"🙎‍♀️営業っぽい発信はしたくない💦\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [{\"key\": 4, \"length\": 4, \"offset\": 0}], \"inlineStyleRanges\": [], \"key\": \"2ec9r\", \"text\": \"🙍‍♂️フォロワーが少ないと無理そう...\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5u87c\", \"text\": \"と感じる人も多いと思います。\\n\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"b1gfb\", \"text\": \"でも、実は\\nアフィリエイト案件の中には、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 19, \"offset\": 77, \"style\": \"Bold\"}], \"key\": \"1lite\", \"text\": \"＝＝＝＝＝\\nTikTokの投稿で興味づけ\\n　↓\\nプロフィールから公式LINEへ誘導\\n　↓\\n新規で公式LINEに追加される\\n　↓\\n条件を満たせば成果が発生\\n（この時、お客さんはお金を払ってない）\\n＝＝＝＝＝\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"17k0o\", \"text\": \"という仕組みのものがあるんですよ。\\n\\n\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fg57f\", \"text\": \"案件によって条件は異なりますが、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 41, \"offset\": 0, \"style\": \"Bold\"}, {\"length\": 41, \"offset\": 0, \"style\": \"Italic\"}], \"key\": \"7n3ks\", \"text\": \"商品を購入してもらうのではなく、\\nLINEへの新規登録が成果地点になる案件がある。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"f619d\", \"text\": \"⤴︎ここが、\\n初心者でも取り組みやすい理由なんですよね。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"53b90\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"qraq\", \"text\": \"ただし、\\n先に大事なことを伝えます。\\n\\n\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6n47o\", \"text\": \"動画を投稿して、\\nプロフィールに公式LINEを置けば、\\n\\n勝手に登録者が増えて\\n自動的に報酬が発生するわけではありません。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"9a4ak\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"lhoi\", \"text\": \"作るべきなのは、\\nただ再生される動画ではなく、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 17, \"offset\": 0, \"style\": \"Bold\"}, {\"length\": 7, \"offset\": 43, \"style\": \"Bold\"}], \"key\": \"4jtrl\", \"text\": \"━━━━━━━━━━━━━━━━\\n興味を持った人が\\n自然に公式LINEまで進みたくなる\\n『収益導線』です。\\n━━━━━━━━━━━━━━━━\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1ml89\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"94m72\", \"text\": \"この記事では、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2p9st\", \"text\": \"TikTok × LINE追加アフィリエイトの作り方を、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"7qsfu\", \"text\": \"〜〜〜\\n①仕組み（全体像）\\n②ジャンル選びのポイント\\n③台本作成\\n④LINE誘導のコツ\\n⑤改善方法\\n⑥デメリット（注意点）\\n〜〜〜\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5o9k2\", \"text\": \"の順番で、\\n初心者向けに具体的に解説していきます。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fck0j\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ecrn3\", \"text\": \"TikTok × LINE追加アフィリエイトの仕組み\", \"type\": \"header-one\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fbon8\", \"text\": \"ぶっちゃけ、全体像自体は\\nとてもシンプルです↓\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"dk6le\", \"text\": \"━━━━━━━━\\nTikTokで動画を見る\\n　↓\\n自分の悩みに関係があると感じる\\n　↓\\n内容に興味を持つ\\n　↓\\nプロフィールを見る\\n　↓\\n無料診断や特典が気になる\\n　↓\\n公式LINEを追加する\\n　↓\\n条件を満たせば成果が発生\\n━━━━━━━━\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 4, \"offset\": 29, \"style\": \"Bold\"}], \"key\": \"fba7p\", \"text\": \"そう。\\n全体像はシンプルなんですが、\\n\\nここで大切なのは、最初から\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 23, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"61s7i\", \"text\": \"「どうやって\\n　公式LINEに登録させよう？」\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 7, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"51scn\", \"text\": \"と考えないことです。\\n\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"64lmo\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"dtd54\", \"text\": \"まず考えるのは、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 16, \"offset\": 0, \"style\": \"Bold\"}, {\"length\": 16, \"offset\": 0, \"style\": \"Italic\"}], \"key\": \"2cea1\", \"text\": \"【視聴者が何に悩んでいるのか？】\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"44sqg\", \"text\": \"です。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ag8o6\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"lg7\", \"text\": \"たとえば、\\n占い系のLINE案件を紹介したいからといって、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"eej56\", \"text\": \"「無料占いを受けたい人は\\n　LINEを追加してください！」\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"asfml\", \"text\": \"なんて風に伝えたところで\\n視聴者からすれば\\nよくある広告にしか見えませんよね？\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ah2k5\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6j4bc\", \"text\": \"一方で、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1dpfo\", \"text\": \"「最近、好きな人からの返信が\\n　急に遅くなった人へ」\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"aer7p\", \"text\": \"という動画ならどうでしょう？\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 5, \"offset\": 11, \"style\": \"Bold\"}], \"key\": \"eoj5a\", \"text\": \"恋愛に悩んでいる人は\\n『自分事』として続きを見たくなります。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ajkp8\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"95hof\", \"text\": \"そして、動画内で\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 47, \"offset\": 0, \"style\": \"Italic\"}], \"key\": \"f72n8\", \"text\": \"〜〜〜〜〜\\n返信は遅いけど質問は返ってくる\\n会う約束には応じてくれる\\n内容は以前と変わらず丁寧\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 8, \"offset\": 0, \"style\": \"Italic\"}], \"key\": \"c18bb\", \"text\": \"という状況なら、\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 28, \"offset\": 0, \"style\": \"Italic\"}], \"key\": \"3evh9\", \"text\": \"返信速度だけで\\n相手の気持ちを判断できない、\\n〜〜〜〜〜\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6b61u\", \"text\": \"と伝える。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1adc2\", \"text\": \"さらに、動画の最後で\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [{\"key\": 5, \"length\": 1, \"offset\": 42}], \"inline