L\\nwFRz1eY59MzJm6lNfan0mizfrazHyj6hHq/d3fDAMiWw19IU+Ut2iuL98yNBhivz\\n7XLSR53S/k2OMKgUWn+k/qQAv3xKi5LDVyH3j4gWV7du/1kTQnEFziq6expYgLwo\\n7GhaisMPwj7JAbbGH5BIZzy3duo+3K0Zad+Sljfz7pDPrnvxFQDsXHuWEBB9M5sW\\nfCLE0yUJt2G6fDijOaPKHJGQaoH6drj1zbCYWHXPBPnN8ldNEk68y5rfw2nV8Hml\\nFKy86Bpprit/QrFraNFUfJWduwm6R2xmPvBZH+mKKKDHz70u/t1wmEduyHUjC+G5\\n3uxfYUxe2pC5/IV2ynjO\\n=KF7V\\n-----END PGP SIGNATURE-----\\n\", \"verified\": true, \"verified_at\": \"2026-05-19T23:44:16Z\"}}, \"html_url\": \"https://github.com/davidteather/TikTok-Api/commit/4993fe4698acd4d9e495b1c41cec8ffee8b43be9\", \"url\": \"https://api.github.com/repos/davidteather/TikTok-Api/commits/4993fe4698acd4d9e495b1c41cec8ffee8b43be9\"}\n{\"html_url\": \"https://github.com/davidteather\", \"url\": \"https://api.github.com/users/davidteather\"}\n{\"author\": {\"date\": \"2026-05-19T23:44:16Z\", \"email\": \"34144122+davidteather@users.noreply.github.com\", \"name\": \"David Teather\"}, \"message\": \"Add sponsor rapidapi (#1302)\\n\\n* chore: add rapidproxy sponsor\\n\\n* chore: add rapidproxy sponsor\\n\\n* crop\", \"url\": \"https://api.github.com/repos/davidteather/TikTok-Api/git/commits/4993fe4698acd4d9e495b1c41cec8ffee8b43be9\"}\n{\"name\": \"David Teather\"}\n{\"name\": \"GitHub\"}\n{\"url\": \"https://api.github.com/repos/davidteather/TikTok-Api/git/trees/354ecb8a10d95be1136e7af2f4557a03da57a98c\"}\n{\"html_url\": \"https://github.com/web-flow\", \"url\": \"https://api.github.com/users/web-flow\"}\n{\"html_url\": \"https://github.com/davidteather/TikTok-Api/commit/8d8d37d9ce791e6ee95a62ac627645c10057f5e5\", \"url\": \"https://api.github.com/repos/davidteather/TikTok-Api/commits/8d8d37d9ce791e6ee95a62ac627645c10057f5e5\"}\n{\"created_at\": \"2019-05-26T17:06:09Z\", \"description\": \"The Unofficial TikTok API Wrapper In Python\", \"forks_count\": 1209, \"full_name\": \"davidteather/TikTok-Api\", \"homepage\": \"https://davidteather.github.io/TikTok-Api\", \"html_url\": \"https://github.com/davidteather/TikTok-Api\", \"name\": \"TikTok-Api\", \"stargazers_count\": 6538, \"topics\": [\"api\", \"download-tiktoks\", \"hacktoberfest\", \"python\", \"tik\", \"tiktok\", \"tiktok-api\", \"tiktok-automation\", \"tiktok-compilations\", \"tiktok-downloader\", \"tiktok-python\", \"tiktok-scraper\", \"tiktok-signature\", \"tiktok-trending-page\", \"tiktokapi\", \"tok\", \"trending\"], \"updated_at\": \"2026-08-01T08:56:33Z\", \"url\": \"https://api.github.com/repos/davidteather/TikTok-Api\", \"watchers_count\": 6538}\n{\"name\": \"MIT License\", \"url\": \"https://api.github.com/licenses/mit\"}\n{\"html_url\": \"https://github.com/davidteather\", \"url\": \"https://api.github.com/users/davidteather\"}\n\n### /Users/anicca/anicca/skills/earn/marketing-engine/evidence/intel/pulls/68f5220fe826411ab0d41408bda1f09e/x.george-lampro-articles.json\n{\"canonical_url\": \"https://x.com/GeorgeLampro20\", \"source_id\": \"x.george-lampro-articles\"}\n{\"author\": {\"avatar_url\": \"https://pbs.twimg.com/profile_images/2034922434248548352/-O_MEWDQ_200x200.jpg\", \"banner_url\": \"https://pbs.twimg.com/profile_banners/1903578997981646848/1767495013\", \"description\": \"100k+ downloads through apps built with Rork.\\n\\nBook a call with me 1-1 👇\", \"followers\": 10305, \"following\": 473, \"id\": \"1903578997981646848\", \"joined\": \"Sat Mar 22 22:46:22 +0000 2025\", \"likes\": 1263, \"location\": \"\", \"media_count\": 245, \"name\": \"George Lampropoulos\", \"protected\": false, \"raw_description\": {\"facets\": [], \"text\": \"100k+ downloads through apps built with Rork.\\n\\nBook a call with me 1-1 👇\"}, \"screen_name\": \"GeorgeLampro20\", \"statuses\": 2498, \"type\": \"profile\", \"url\": \"https://x.com/GeorgeLampro20\", \"verification\": {\"type\": \"individual\", \"verified\": true, \"verified_at\": null}, \"website\": {\"display_url\": \"georgelampropoulos.com\", \"url\": \"https://georgelampropoulos.com/\"}}, \"created_at\": \"Tue Jul 28 05:46:14 +0000 2026\", \"text\": \"I've spent the last month compiling everything I know about apps that took me from $0 to $50k a month. This is the Growth Playbook.\", \"url\": \"https://x.com/GeorgeLampro20/status/2081979523873038368\"}\n{\"content\": {\"blocks\": [{\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d096g\", \"text\": \"How to Scale Your App to $10K/Month (Easy Mode)\", \"type\": \"header-one\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1vfg\", \"text\": \"You clicked on this because you want to build a mobile app that actually makes money. Not a portfolio piece. Not a \\\"someday\\\" idea sitting in your notes. Real recurring revenue you can watch hit your dashboard every single morning.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4ol4q\", \"text\": \"Here is the good news, and I mean it: you do not need a dev team, you do not need funding, and you do not need to know how to code. I know that because I am living proof of it. I am 19. A couple of years ago I was working a register at TJ Maxx. Today I have made over $300,000 building consumer apps with AI. In the last 28 days alone I did $52,000 in revenue, and over the last 90 days I scaled two apps to $20K and $25K a month. It all started with an AI wrestling app called Wrestle AI, which did over $160,000 in its first six months and crossed 100,000 downloads. I do not know how to write a single line of code. I built all of it with AI.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"78a51\", \"text\": \"People have been making mobile apps since 2008, and for most of that time it kept getting harder to build something people would actually download and pay for. Then two things changed everything. AI made it so anyone can create software, and AI made it so you can build experiences that are genuinely better than what came before. Cal AI lets you photograph a plate of spaghetti and instantly know the calories. Wrestle AI lets you upload your match and instantly know what you did wrong. Those experiences simply were not possible before, and that is the entire opportunity.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fvd6d\", \"text\": \"This is everything I know, laid out as a playbook. Nothing held back. If you read it top to bottom and actually do the work, you can do what I did. Let me show you how.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ec7f2\", \"text\": \"Table of Contents\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"m5j0\", \"text\": \"The Only Math That Matters\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3jtgu\", \"text\": \"Start With an Idea That Can Actually Win\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"sj3r\", \"text\": \"How to Reverse Engineer a Viral App Idea\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6fjlh\", \"text\": \"Why a Good Idea Beats Good Distribution\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ff9ia\", \"text\": \"The Gotcha Moment: Your Single Most Important Asset\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"f2j02\", \"text\": \"The Six-Step Process I Use to Build Any App\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"f3r67\", \"text\": \"Build the App: Vibe Coding With AI\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d4nmc\", \"text\": \"Your Tech Stack and What It Costs\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d8i7k\", \"text\": \"Design, UX, and the Mom Test\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4v29b\", \"text\": \"Onboarding: Where Browsers Become Buyers\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8cigh\", \"text\": \"Pricing and the Paywall\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"br0hh\", \"text\": \"Distribution 1: Your Instagram Page Is a Weapon\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"be9h1\", \"text\": \"Distribution 2: Engineer Your Feed to Find Influencers\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"airhc\", \"text\": \"Distribution 3: Outreach at Volume\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"f4imh\", \"text\": \"Distribution 4: Closing the Deal on the Phone\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2egkn\", \"text\": \"Distribution 5: Creatives That Don't Feel Like Ads\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6dul\", \"text\": \"Distribution 6: Meme Pages, Organic, and Paid Ads\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"49np8\", \"text\": \"After They Post: How to Milk Every Video\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"b7k8q\", \"text\": \"The Launch: Pre-Orders and Hitting the Charts\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1l7to\", \"text\": \"Read Your Numbers, Then Fix the Leaks\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"bivkt\", \"text\": \"Proof That Anyone Can Do This\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"480fc\", \"text\": \"The Mindset That Ties It All Together\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"17m8e\", \"text\": \"Resources I'd Point You To\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8l4ks\", \"text\": \"Start Today\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2vn2d\", \"text\": \"1. The Only Math That Matters\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"f28mt\", \"text\": \"$10K a month sounds like a mountain. Break it down and it stops being one. $10K a month is $333 a day. That is it. To get there you really only need to nail one or two things and then let them compound on top of each other.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3t968\", \"text\": \"When I strip it all the way down, a successful app comes from three pillars and nothing else:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 12, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"cedhc\", \"text\": \"A good idea. Something people actually want, that solves a real problem.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 32, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"c0nr0\", \"text\": \"A product that matches the idea. The thing has to deliver on the promise the moment someone opens it.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 13, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"1altn\", \"text\": \"Distribution. Putting that idea in front of the exact people who feel the problem.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cglfr\", \"text\": \"Get those three right and the daily revenue takes care of itself. Over the last 90 days I scaled two newer projects to $20K and $25K a month, working roughly three to four hours a week on each. It is not about hours in. It is about following a playbook that gets you there fast.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4potf\", \"text\": \"Here is the framing I want you to hold in your head for the rest of this article. Everything from here is just those three pillars, explained in detail. Idea first, because your marketing will only ever take you as far as your idea allows. Product second, because a great idea with a broken or confusing product converts no one. Distribution third, and in the most depth, because that is where most of the actual work lives and where most people quietly fail. So let me walk you through each one, in order, exactly the way I do it.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2ei5q\", \"text\": \"2. Start With an Idea That Can Actually Win\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cpg0v\", \"text\": \"The easiest way to find an idea is to find a problem you personally have, and then figure out a creative way to solve it. When the idea comes from your own pain, something powerful happens: you become your own ideal customer. You instinctively know what to build, what features matter, what to cut, and exactly how to talk about it, because you are the person you are building for. It also means there are probably a lot more people out there experiencing the same problem you are.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"a1hf3\", \"text\": \"For me that problem was wrestling. I wrestled all through middle school and high school until COVID cut it short, and the sport genuinely changed my life. So when I was a freshman I asked myself a simple question: what would I have loved to have on my phone back then? That question was the entire idea. I was not guessing at what wrestlers wanted. I was a wrestler.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fia7c\", \"text\": \"It also gives you something you cannot fake, which is belief. When I sit across from an influencer or a designer or a developer and pitch them on Wrestle AI, they can feel that I actually care about it. People can tell the difference between someone selling snake oil and someone on a mission. That belief is what convinces creators to partner with me for cheaper rates and work harder than they otherwise would. If you do not believe in your own mission, it becomes very hard to get anyone else to.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8t9eo\", \"text\": \"So when you are picking an idea, build for something you are passionate about and would happily grind on for ten straight hours. That is not a motivational poster, it is a strategic advantage that shows up in your product quality and in every sales conversation you ever have.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2np31\", \"text\": \"When I break down what makes an idea actually good, there are three pillars underneath it: uniqueness, helpfulness, and the gotcha moment. You need uniqueness so it catches eyes and stops the scroll. You need helpfulness so it has stickiness and people stay. And you need a gotcha moment built into the app that conveys what it does in about five seconds. I will cover the gotcha moment on its own because it deserves it, but keep those three in mind as your filter.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3n5iv\", \"text\": \"Beyond that, a strong idea solves a problem that is:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 16, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"doj1u\", \"text\": \"Felt frequently. Daily or weekly, not once a month. Someone forgetting a password once a month is weak pain. Someone procrastinating every single day is high frequency pain. The more often a person feels a pain, the more likely they are to search for a solution, value it, pay for it, and build a habit around it.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 23, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"3jnqt\", \"text\": \"Emotionally irritating. Something that genuinely frustrates people on a gut level, not a mild inconvenience.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 29, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"8n7s6\", \"text\": \"Experienced by a large group, even if that group looks niche from the outside.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 60, \"offset\": 45, \"style\": \"Bold\"}], \"key\": \"8kps1\", \"text\": \"Here is something most people get backwards: follow what people actually do, not what they say they want. People say they want to read more. Their real behavior is scrolling TikTok until 2am. Users say one thing and behave differently, so use behavioral truth, not verbal claims. The best ideas often come from asking not \\\"what do people want\\\" but \\\"what do people actually do, even when they know they shouldn't.\\\"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 28, \"offset\": 38, \"style\": \"Bold\"}], \"key\": \"bbukp\", \"text\": \"And do not try to build for everyone. Go niche first, then expand. Every massive company started narrow. Facebook was Harvard only. Amazon was just books. Snapchat was teen messaging. TikTok was Gen Z dancing. When I told people I was building a wrestling app, most of them scoffed. \\\"How many wrestlers even are there?\\\" Turns out enough, and because the niche was so specific, I knew exactly who my customer was, which meant I could reverse engineer exactly where to find them. Owning a niche builds loyalty, trust, word of mouth, and authority. You earn the right to expand outward later. The democratization of building is what makes this possible now. You do not need a billion dollar market or a ton of capital to serve a tight community well. Wrestle AI never needed to be a billion dollar company to change my life.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 67, \"offset\": 31, \"style\": \"Bold\"}], \"key\": \"d45b2\", \"text\": \"One of my favorite moves is to steal proven mechanics from one category and apply them to another. The psychology already works, you are just porting it. A few examples:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 38, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"50fb8\", \"text\": \"Duolingo into fitness or productivity: streaks, XP, and level ups to gamify consistency.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 36, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"ejc1b\", \"text\": \"Spotify Wrapped into personal stats: a yearly fitness, study, sleep, or productivity recap that people want to share.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 35, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"1n5fv\", \"text\": \"MyFitnessPal into behavior logging: track moods, workouts, studying, spending, or habits instead of just food.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 28, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"7tenp\", \"text\": \"Tinder into swipe decisions: instantly choose exercises, outfits, meals, or daily goals.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 35, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"cv661\", \"text\": \"Fortnite into seasonal progression: short seasons of focused improvement with resets and rewards.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 11, \"offset\": 75, \"style\": \"Bold\"}], \"key\": \"a7ilq\", \"text\": \"The last filter, and it might be the most important: your idea has to be a Purple Cow. In a field of ordinary brown cows, the only one anybody remembers is the purple one. Your app has to visually stand out the instant it appears on a screen. It needs an element of surprise, something the viewer has never seen before, so curiosity alone makes them stop scrolling and download.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3ers1\", \"text\": \"And do not forget the back half. A viral hook with no real utility has no longevity. People come for the novelty and leave fast. Apps with valuable but less exciting features are the ones that retain. The ideal is to attract with a viral, attention grabbing feature and then retain with the practical, everyday ones. Pull them in with something fun, keep them with something useful.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ae71v\", \"text\": \"3. How to Reverse Engineer a Viral App Idea\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1fjga\", \"text\": \"If you sat me down right now and told me I had to come up with an app idea today, here is exactly what I would do, step by step.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4q0p0\", \"text\": \"I would open Instagram or TikTok and just scroll for about fifteen minutes. But I would not scroll passively. Every single time I watched a video, I would ask myself three questions:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 31, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"2v5in\", \"text\": \"Who watches this type of video?\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 50, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"dta08\", \"text\": \"What problem does this influencer's audience face?\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 91, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"a5g16\", \"text\": \"How could an influencer promote an app for this, seamlessly, without it feeling like an ad?\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8vn5e\", \"text\": \"That third question is the whole game. I am not just looking for a problem, I am looking for a problem where I can already picture the promotion. If I looked at wrestling content creators, I would ask: how could this person show my app for five seconds within the first thirty seconds of their video and have it feel completely natural? When I found wrestling day in the life creators, I knew instantly they were perfect, because a wrestling app slotting into a wrestler's daily routine feels like real life, not an advertisement.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"bbffa\", \"text\": \"This is the same thing as reverse engineering the viral video and building the product to fit it, which I will hit again in the gotcha moment section, because it is that important. Most people build a product and then panic about how to market it. Flip the order. Find where your ideal customer already spends attention, find what they already engage with, and build something that plugs into that existing behavior. When you do it this way, distribution stops being a wall and becomes a slot your product just drops into.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3ae93\", \"text\": \"The other reason this works: once you have scrolled as your ideal customer for a while, you have quietly trained the algorithm to show you nothing but relevant creators. You have simultaneously found your idea and built your entire outreach lead list. More on that in the feed engineering section.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"aj8t4\", \"text\": \"4. Why a Good Idea Beats Good Distribution\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fvtf4\", \"text\": \"There is a constant argument online, especially on Twitter, that distribution beats product. I push back on that hard, and I have the receipts to prove why.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"29ne1\", \"text\": \"In October I launched two apps at the same time. The first was Wrestle AI, an idea I was obsessed with. The second was an app I will be honest, I kind of hated. It was a RizzGPT style AI dating assistant, completely unoriginal, but I had an influencer with over two million followers ready to partner with me, so I figured it would print money regardless. I threw out my own rule about building things I care about and chased the bigger audience instead.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"eovaa\", \"text\": \"Look at what happened. In the first month, Wrestle AI did around a million views and made $17,000. In that same first month, the dating app, called Green, did 1.8 million views and made $35. That is not a typo. From 1.8 million views I got five weekly subscriptions. Thirty five dollars.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"84vba\", \"text\": \"I sat there trying to convince myself it was my marketing, my creatives, my targeting. Eventually I got honest with myself. It was none of that. The idea just sucked. Everyone had seen a hundred versions of it already, so nothing converted. Wrestle AI converted because it was actually unique in its niche. Same founder, same effort, same level of reach. The only variable was meaning. Wrestle AI was a Purple Cow. Green was a remix of things people had already scrolled past a thousand times.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"65k4q\", \"text\": \"That experience set my rule in stone: I only build things I am genuinely passionate about and that are actually novel. Because here is the lesson underneath it all. All distribution does is distribute your idea and your mission. If the idea is weak, all your distribution does is help it fail faster in front of more people. So if your product is not a Purple Cow, then your marketing has to be the Purple Cow instead. Think about a brand like Liquid Death or Rainbet. Their differentiation lives entirely in how they market, and the experience is the marketing. When the product itself is not remarkable, the marketing has to carry everything, and that is a much harder game. But when the product is genuinely remarkable, marketing stops being a crutch and becomes pure leverage.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5r68t\", \"text\": \"5. The Gotcha Moment: Your Single Most Important Asset\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ehltf\", \"text\": \"If you remember one thing from this entire article, make it this section. The gotcha moment is the feature I spend the overwhelming majority of my build time on, and it is the thing that quietly determines whether all your distribution works or falls flat. At least half of your build time, honestly more, should go into creating and refining this one thing.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"b9gfu\", \"text\": \"The gotcha moment is the one feature that stops the scroll and sends someone straight to the App Store. It has to be so simple that anyone watching it for five seconds instantly understands the entire thesis of your app, without a single word of explanation.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6rf8u\", \"text\": \"Cal AI: take a picture of your food, get the calories.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"brokq\", \"text\": \"Wrestle AI: upload your match, get told exactly what you did right and what you did wrong.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"9egce\", \"text\": \"Quittr: panic mode.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8oce8\", \"text\": \"UMax: the face rater.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"c1hi3\", \"text\": \"Notice the pattern. Every one of them can be explained in a single sentence, and every one delivers personalized feedback you can only experience by actually using the app. That personalization is key. These features work because they either solve a problem in a genuinely unique way or give you feedback about yourself that you cannot get anywhere else.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6omrb\", \"text\": \"The greatest products in the world all pass this test too. Uber: press a button, a car comes. DoorDash: press a button, food shows up. Tinder: swipe, find a date. Hinge: swipe, find someone to date. One sentence, total clarity. The best products can be explained in a sentence or less, and that is not a coincidence, it is a requirement.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 73, \"offset\": 49, \"style\": \"Bold\"}], \"key\": \"emodi\", \"text\": \"The smartest way to design a gotcha moment is to reverse engineer the viral video first, then build the product around it. Before I build anything, the question living in the back of my head is: what could I seamlessly drop into a TikTok or a YouTube Short, in the first thirty seconds, that makes someone stop and think \\\"I need to try this,\\\" without it feeling like an ad? I design the feature to win that five second window, and then I build outward from there. I will even use AI to brainstorm this. I will literally ask, given this niche, what would be a TikTok about this app that would go viral, and what single feature would make that video work.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fuhvi\", \"text\": \"Spend at least half your build time, honestly closer to ninety percent of your focus, making that one moment visually impressive and dead simple to understand. Influencers will show your app for ten to fifteen seconds, max. In that short window the viewer has to clearly see why they need it. When you nail the gotcha moment, you have solved most of your distribution problem before you have spent a single dollar, because the feature itself does the selling for you.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d8p00\", \"text\": \"A note from experience: you can have other features you want to push, but resist showing them off early. I push the gotcha moment ninety percent of the time. Only when a particular creator's audience starts to saturate, and the returns from their videos start dipping, do I have them push a secondary feature to chase another, usually smaller, uptick. The headline always stays the headline.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8ndm\", \"text\": \"6. The Six-Step Process I Use to Build Any App\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"elrlj\", \"text\": \"Before I get into the mechanics of building, here is the full arc I run every single time, from blank page to money. If you want a single mental checklist, this is it. The rest of the article expands each of these.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 19, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"be1us\", \"text\": \"Step one, the idea. Uniqueness, helpfulness, gotcha moment. A viral idea in its nature, because if the idea is not viral, distribution cannot save it. This is where I spend real thought, not five minutes.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 28, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"4vcd7\", \"text\": \"Step two, designing the app. Answer two questions: who is it for, and what type of UI would fit that buyer. I take those answers and feed them straight into my build tool. I build the framework first, then the functionality. And I keep one more question in mind the whole time: how could users organically share this, so not all of my traffic has to be paid.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 44, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"2sec1\", \"text\": \"Step three, building the core functionality. I set aside about a week to just sit at my computer and prompt from morning to night. This is where I figure out my backend, whether I want to plug in external APIs, and where I make the gotcha moment actually work and look incredible. Do not cut corners here.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 22, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"eql5\", \"text\": \"Step four, onboarding. The second most important part of the whole app. You can have a great product, but if you cannot convert the user, no one will ever know it was great. I copy what already works from high converting apps and adapt it.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 41, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"fjq5v\", \"text\": \"Step five, hire out what you do not know. With today's tools you can get further on your own than ever, but when you do need help, a good early hire can be huge. The best return on investment I have ever had was bringing on a sharp person early. Sell whoever you hire on the vision so they work like they are part of something bigger.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 34, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"5rc5b\", \"text\": \"Step six, expand past vibe coding. Once you cross about $5K a month, start reinvesting in product quality. Bring on designers. Add discipline. Vibe coding gets you to validation fast, but real product quality is what carries you past the early ceiling.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5iuq\", \"text\": \"That is the entire loop. Now let me go deep on each part.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2bg3j\", \"text\": \"7. Build the App: Vibe Coding With AI\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6itnr\", \"text\": \"I built every one of my apps with AI through Rork, an AI app builder. I saw an ad for it while I was sitting in physics class, scrolling my For You page. It said \\\"build an app in minutes\\\" and I did not believe it. I thought it was one of those drag and drop template things. I clicked anyway, tried it, and built an app called Fight AI where you throw in your training footage and it tells you what you are doing right and wrong. That app made me about $2,000 in its first month just from me posting about it and paying a meme page fifty bucks. It still quietly does about $1,000 a month and I have not marketed it since July. That was the moment I knew apps were the new way to make money.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cgc00\", \"text\": \"The reason I love Rork is that the barrier that used to require a team, a year of work, and a pile of cash is just gone. Think of it like Claude Code, except purpose built for mobile apps. You describe what you want, it builds a fully native iOS app, and you can push it straight to App Review from inside the tool, no Cursor or general coding setup required. I built all of Wrestle AI off the basic $20 a month subscription. These days I highly recommend Rork Max, which builds your app in native Swift instead of React Native, and the jump in quality is night and day. That quality is not a small thing. From everything I have seen, Rork users out-earn people on every other app builder, for one simple reason: it builds the best apps, and better apps convert better, retain better, and land better creator deals. Once you know what you are doing, you can take an app from idea to App Review in under a day, and I do not mean a slop app, I mean a real quality app.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 15, \"offset\": 136, \"style\": \"Bold\"}], \"key\": \"tihr\", \"text\": \"Speaking of slop. People love to call vibe coded apps \\\"AI slop,\\\" and I could not disagree more. What actually exists is not slop, it is underprompting. You are not one shotting a finished product from a single prompt. When I say I spend around fourteen days building, I mean I am prompting relentlessly, page by page, fixing this and tweaking that, until each screen works exactly how I pictured it and looks exactly how I wanted it to look. Code is code. With enough prompts, you can build genuinely great products. I refuse to cut corners. If something does not work, I figure out why instead of moving past it. I have downloaded apps built entirely by AI, like a workout app called Core OS that auto tracks your gym time and your sleep, that are among the best health apps I have ever used. Full AI, incredible product.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"bd0fm\", \"text\": \"Here is the framework I actually use:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 51, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"b2t26\", \"text\": \"Around 14 days for core functionality and branding. Decide what the app does and how it looks. I build how it looks first, get it looking really nice, then make each page work exactly how I imagined. Do not cut corners anywhere. If a page is broken, figure out why.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 29, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"8sst6\", \"text\": \"A few days on the onboarding. This is where you educate the user, personalize the experience, and create the FOMO that drives conversions.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 26, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"bec51\", \"text\": \"Then payments and backend. I add RevenueCat for the paywall and Supabase for the backend, plus any external APIs I need. If I am building a calorie tracker, for example, I plug in a nutrition database. There are plenty of cheap public APIs out there that add real functionality for very little money.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8pq6l\", \"text\": \"8. Your Tech Stack and What It Costs\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fctpr\", \"text\": \"One of the best things about this whole model is how cheap it is to run. People assume you need serious capital. You do not. Here is roughly what my stack looks like and what it costs.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 5, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"8u9pa\", \"text\": \"Rork, the AI app builder where the app itself gets built. It is like Claude Code, except purpose built for mobile apps. I built all of Wrestle AI off the $20 a month subscription, and these days I recommend Rork Max, which builds in native Swift for much higher quality apps.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 8, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"c7gs6\", \"text\": \"Supabase handles my backend and is easy to use, around $30 a month.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 12, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"7bq4b\", \"text\": \"AI inference to power the features inside the app. What you pay here scales with your usage.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 26, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"d32cq\", \"text\": \"A verified Instagram badge for your outreach and brand accounts, about $11.99 a month.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ccn01\", \"text\": \"Add it up and you can run a real, revenue generating app business for the price of a few subscriptions. There is no reason the cost side should ever be what stops you.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4fmev\", \"text\": \"9. Design, UX, and the Mom Test\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5ck01\", \"text\": \"Design and user experience matter more than most beginners think, because a confusing app kills conversions no matter how good the underlying idea is.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"boork\", \"text\": \"My litmus test is simple. I should be able to hand my phone to my mom and have her understand what the app is and how it works without me saying a word. My mom still does not really know how Siri works, so she is a perfect tester. I literally text her my app and ask, \\\"Can you figure this out? Can you tell what it does? Can you use it?\\\" Plenty of times she has come back with \\\"it's too cluttered,\\\" and that is some of the most valuable feedback I get. If your mom cannot use your app, you have to simplify the UI until she can. Strip it down. Make it obvious. If your mom happens to be technical, find someone who is not and run the same test on them.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"49l8d\", \"text\": \"Build for your buyer. Before I design a single screen I answer two questions and feed the answers straight into Rork: who is this for, and what type of UI would fit them. Then I build the framework first and the functionality second. I also keep one more question in the back of my head the whole time: how could users organically share this app? If sharing is built into the experience, not all of your traffic has to come from ad spend, which quietly lowers your cost of growth forever.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"bgdml\", \"text\": \"10. Onboarding: Where Browsers Become Buyers\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1hbrq\", \"text\": \"Onboarding is everything that happens before the paywall, and it is the second most important part of your app, right behind the gotcha moment. You can build a great product, but if you cannot convert the user, no one will ever find out it was great.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"p7gk\", \"text\": \"People massively overcomplicate this. Onboarding really only has four jobs:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 20, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"4psq6\", \"text\": \"1. Educate the user. Show quick three to five second visuals demonstrating each major feature. People will not pay for something they do not understand, so show them clearly what the app does and how it works.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 30, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"b88vi\", \"text\": \"2. Personalize the experience. Ask for their name and use it throughout. Then ask guiding questions that walk them straight toward the problem your app solves. Cal AI does this beautifully: \\\"Have you tried other weight loss apps before?\\\" If yes, \\\"Here's why we're different from traditional calorie trackers.\\\" You are customizing the experience and steering them to their own need at the same time. Then tie their goals directly to the app. Ask their objective, then visually show two roadmaps: their journey without your app versus their journey with it. That builds the internal logic of \\\"this app accelerates my progress.\\\"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 19, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"cldmp\", \"text\": \"3. Build sunk cost. Draw the personalization out just enough that the user feels invested, but not so long that they get bored and bounce. If someone answers twenty questions to build their perfect setup and then hits a paywall, the sunk cost fallacy kicks in. They think, \\\"I have already put all this work in, let me at least start the free trial.\\\" The more time they invest, the more compelled they are to pay.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 56, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"483ud\", \"text\": \"4. Create FOMO, then lock the payoff behind the paywall. This is the move most people miss, and it is the one that lifts conversions the most. Right before the paywall, run your gotcha moment, but withhold the result. In Wrestle AI you upload your match, watch an analysis animation that says things like \\\"targeting\\\" and \\\"calibrating,\\\" and then right as it finishes, the paywall appears saying \\\"unlock your rating now.\\\" Now the user is dying to know their score. That single screen converts far better than dumping someone at a cold paywall after a few setup questions.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5vemc\", \"text\": \"Let me walk you through the actual Wrestle AI onboarding flow, screen by screen, so you can see all of this working together:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 13, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"96fu6\", \"text\": \"Feature pages first, quick visuals explaining exactly what the product does.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 22, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"b2v37\", \"text\": \"A rate the app screen, cheekily placed before the paywall. This single screen drives a huge share of our ratings and pushed us to 4.8 stars across well over a thousand reviews. \\\"Support the mission, rate five stars,\\\" rate and continue.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 19, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"3ga5i\", \"text\": \"The profile survey. Identify your style. What do you compete in. What is your go to attack. Where do you dominate. What is your mat identity. How often do you train. This both personalizes the app and racks up sunk cost.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 35, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"37sp5\", \"text\": \"Weight management and body metrics, which feeds into a personalized nutrition plan.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 20, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"1gd3q\", \"text\": \"Schedule commitment. Getting the user to commit to a training schedule.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 26, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"b0093\", \"text\": \"Goal setting and analysis. Let them type their goal, then visually project their growth over time using the app.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 29, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"bb257\", \"text\": \"A taste of the gotcha moment. We let them upload a video and see the analysis animation happen, right before the paywall, with a skip for now button for anyone who wants to move past it.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 24, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"bpmvh\", \"text\": \"\\\"Your profile is ready,\\\" now complete with a nutrition plan and a training roadmap.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 8, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"88gcv\", \"text\": \"Sign in, pushed as far down the flow as possible to reduce drop off.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 38, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"414qn\", \"text\": \"The prepaywall page, then the paywall. By now they have created, personalized, and emotionally invested. They are primed to convert.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"7aq3s\", \"text\": \"The fastest way to build a great onboarding is to steal what already works. Spend an hour or two downloading high converting apps in your space, Cal AI, Opal, Quittr, and pay attention to exactly where you feel compelled to buy and why. Then apply those same elements to yours. There is no perfect formula. Test, iterate, get creative, and have fun with it.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6lse3\", \"text\": \"11. Pricing and the Paywall\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"eqb6u\", \"text\": \"Keep monetization simple. Make the app pay to access, with the paywall sitting at the end of onboarding.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"djkvm\", \"text\": \"The pricing structure I use again and again:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 15, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"c9lsb\", \"text\": \"$9.99 per month\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 15, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"22ptj\", \"text\": \"$59.99 per year\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 52, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"94cqe\", \"text\": \"A 3 day free trial attached to the yearly plan only.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fu455\", \"text\": \"Putting the trial only on the annual plan steers people toward the yearly option. When they convert, you collect around $60 up front instead of $9. That faster cash collection is a massive reason Wrestle AI was able to scale so quickly. Most of my revenue accrues from yearlies for exactly this reason, because the trial funnels people into the annual plan and then converts.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6b690\", \"text\": \"If you have direct competitors, just copy their pricing. If your app is genuinely unique with no clear comparison, use your intuition, then test once you have traffic. One of the highest leverage things you can do is spend an hour or two downloading successful apps in your space purely to study their monetization, noticing exactly where you feel compelled to buy. Once you have real volume, A/B test pricing to find your ceiling.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fo75g\", \"text\": \"12. Distribution 1: Your Instagram Page Is a Weapon\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"65sh1\", \"text\": \"Now the part everyone is really here for. This is my actionable plan to $10K a month, and most of it lives on Instagram.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"83nqr\", \"text\": \"Your brand Instagram account does two jobs at once: it is a sales funnel for users, and it is your credibility with influencers. Set it up properly before you reach out to anyone.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5jsbo\", \"text\": \"What it needs:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 31, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"2l0h3\", \"text\": \"Social proof through followers. When an account has five followers, people distrust it. When it has at least 5K, you look reputable and creators take you seriously. So build that base. I will be honest about the trade off here: a lot of people buy followers to jumpstart this, and you can find sites that do it. But buying followers is against Instagram's terms of service, full stop. The clean alternative is creating content that gets shared and growing it the old fashioned way. It takes longer but it carries no risk. Wrestle AI itself was never botted. Decide what fits your own risk tolerance, and do not just take my word for it, do your own research.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 13, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"ffksl\", \"text\": \"Verification. Paying for the verified badge, around $11.99 a month, makes you stand out in a creator's inbox and signals you are a real builder, not a scam.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 29, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"1tmim\", \"text\": \"A clean bio with a clear CTA, plus three solid product demos pinned up top. Design them yourself or pay a Fiverr designer. Your bio should clearly say who you are, what you are building, and any apps you have made.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 49, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"eta4v\", \"text\": \"Collab posts with every influencer you work with, especially early on. When you co post, your page looks active, professional, and connected, like you are working with a lot of people. That single detail changes every future negotiation.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4qhjv\", \"text\": \"Here is why this matters in both directions.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 13, \"offset\": 5, \"style\": \"Bold\"}], \"key\": \"1tmfp\", \"text\": \"As a sales funnel: imagine a wrestler watching their favorite wrestling creator. They see Wrestle AI tagged in the caption, think \\\"that looks cool,\\\" click through to my page, and then watch four more Wrestle AI videos right there. In a couple of minutes they went from slightly curious to fully educated and primed to convert. Then they hit the CTA in my bio, download the app, and go through an onboarding that primes them even further. An already warm user gets even warmer.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 12, \"offset\": 3, \"style\": \"Bold\"}], \"key\": \"fdjc9\", \"text\": \"As credibility: when a creator gets my DM, the first thing they do is click my profile. If they see two followers and no posts, they assume it is some no name app nobody uses, and they either ignore me or, if they do respond, I walk into the call with zero authority and have to pay whatever insane rate they ask. But if they see a brand working with tons of creators, they think, \\\"this person is clearly paying others, so these are probably just the going rates.\\\" It is far easier to convince someone to do something when they can see ten other people already did it. That authority is the difference between paying a $2 CPM and paying ten times that. When I propose a low rate off a credible page, they think \\\"everyone must work for these rates,\\\" instead of \\\"this guy is trying to rip me off.\\\"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5qs0f\", \"text\": \"13. Distribution 2: Engineer Your Feed to Find Influencers\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"bri4k\", \"text\": \"This is arguably even more important than the page itself, and almost nobody does it deliberately.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"bgpg\", \"text\": \"Build a detailed mental image of your ideal customer, then open a fresh account and behave exactly like that person. Like the content they would like. Watch the videos they would watch all the way through. Comment, share, and interact naturally as them. You are training the algorithm to feed you a constant stream of the exact creators who reach the people you want. This method takes a little longer than just searching, but every single influencer it surfaces is highly relevant and worth reaching out to.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fhdt3\", \"text\": \"For me this was easy because I was the customer. I knew exactly what content wrestlers watch, so I hypnotized my For You page into being nothing but wrestling. Once it was fully tuned, prospecting became scroll, outreach, scroll, outreach. No more digging through Instagram search trying to find the perfect creators. The leads came to me, which made the whole process ten times faster. This is one more reason to build for something you are passionate about, because you already know what that audience watches and you can slip into their feed effortlessly.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"c01e9\", \"text\": \"If you would rather outsource the finding, you can hand a VA a set of criteria instead: a minimum and maximum follower count, a target for average views, likes and comments per post, posting frequency, and the hashtags your audience interacts with. Then have them run outreach from your account. This gets you volume, but it also floods your inbox with unqualified leads, so you have to be willing to sift.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 49, \"offset\": 74, \"style\": \"Bold\"}], \"key\": \"8eeb4\", \"text\": \"Now, who actually deserves your outreach. The single most important rule: followers do not matter. Views and engagement do.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"eavup\", \"text\": \"Green flags:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3hb8l\", \"text\": \"25K or more views per video on average\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"e1c24\", \"text\": \"Views that never dip under 15K, a stable floor\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"46rv6\", \"text\": \"Content that performs across multiple platforms\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fqjle\", \"text\": \"A distinct style where you can immediately understand why the internet resonates with them, not a trend hopper\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"b456n\", \"text\": \"A comment section that shows a genuinely engaged community\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d39k8\", \"text\": \"Red flags:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4o270\", \"text\": \"Wildly inconsistent views, 100K on one video and 5K on the next\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"e8nfs\", \"text\": \"A trend hopper who just copies popular sounds and feels generic\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"9ghhu\", \"text\": \"Comments that are all emojis, which usually signals low quality viewers or fake engagement, most common on Instagram\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4bhk0\", \"text\": \"Lots of views but barely any comments. If people will not take the time to comment, they probably will not take the time to download your app.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"dbkj4\", \"text\": \"14. Distribution 3: Outreach at Volume\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"76mqn\", \"text\": \"This entire game is a numbers game. How many creators can you message, how much content can you make. The more you do, the more you get out, period.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 20, \"offset\": 26, \"style\": \"Bold\"}], \"key\": \"a2jq8\", \"text\": \"If you are just starting, DM 100 people a day. And replace yourself in this process as fast as you possibly can. If you have $2,000 to start your app, I would genuinely spend close to $800 of it on a VA for the first month. They are integral to volume and they free up your head to think clearly. Hire from Upwork, Fiverr, Founders Arm, wherever. Do not haggle for cents. If they ask for $800 a month, just pay it. You will get far more than $800 in value back. Hop on a call, show them the system, and give them a dead simple rule: scroll the tuned feed, and if a creator averages over 25K views, reach out. Hand them a clean SOP and your DM scripts. Expect to pay roughly $5 to $15 per 100 DMs sent.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"44did\", \"text\": \"There are really two moments to hire a VA. The first is right when you are starting out and you need raw volume to get your foot in the door. The second is once you are hyper successful and the founder simply should not be the one sending cold DMs anymore. The awkward middle, which is where I have been, is when your brand is known enough that your response rate shoots up and you can efficiently do it yourself: scroll for twenty minutes a day off the business account, message everyone you can in that window, and hop on calls the next day to close them.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3704f\", \"text\": \"The DM itself has to be short and instantly clear. Influencers get hundreds, sometimes thousands of DMs a day, and almost all of them say \\\"hey I love your content.\\\" Yours has to lead with the one thing that earns a reply: money. I am, with no exaggeration, a DM wizard. Back when I started I was sending hundreds of DMs a day to anyone willing to build with me. The structure that works:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 30, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"ci6q6\", \"text\": \"First two words: \\\"Paid promo?\\\" Or \\\"Paid promo for [their handle]?\\\" Nothing is more captivating in a flooded inbox than telling someone you will pay them.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 35, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"6lpm6\", \"text\": \"One sentence on what your app does. Just enough for them to understand, not so much that you bury it. Keep them curious.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 19, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"43tad\", \"text\": \"A clear invitation. \\\"I'd love to sponsor you, let me know if you're interested.\\\"\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"23fa0\", \"text\": \"Here is a clean example:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"o2k3\", \"text\": \"\\\"Paid promo for Arc? Hey, I run an app that limits your screen time and unlocks usage once you complete your goals. Love your content and would love to sponsor you. Let me know if you're interested.\\\"\", \"type\": \"blockquote\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fo360\", \"text\": \"That is the whole thing. They will not read a mile long pitch explaining every feature. They will respond to a short one that promises payment.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ejmtk\", \"text\": \"15. Distribution 4: Closing the Deal on the Phone\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 59, \"offset\": 52, \"style\": \"Bold\"}], \"key\": \"blrb5\", \"text\": \"The single most important rule of profitable deals: get off DMs and onto the phone as fast as humanly possible. Influencer marketing is roughly 90 percent sales, and negotiating is a thousand times easier when someone can feel your presence and hear your voice. Every DM you send should be quietly guiding them toward a call. DM as little as possible, and make every message push toward getting on the phone.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"634fb\", \"text\": \"When a creator responds with \\\"tell me more,\\\" do not start dropping numbers. Say:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"61ee3\", \"text\": \"\\\"Absolutely, I'd love to hop on a quick call and walk you through the integration and how I see this working. Here's my number: (xxx-xxx-xxxx).\\\"\", \"type\": \"blockquote\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"dkgg5\", \"text\": \"If they ask directly for a price, deflect it: \\\"Before we get into numbers, I'd love to show you what we want demonstrated in the video.\\\" Do not give a number unless they truly force you to. And if they try to hard close you over text with \\\"I'm busy, what's your offer,\\\" do not fall for it. Just say, \\\"No problem, hit me up when you're free.\\\" They want your money. You are the one paying them, not the other way around.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"55fna\", \"text\": \"On the call:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 32, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"36qro\", \"text\": \"Open warm and be hyper specific. Compliment an actual piece of their content. \\\"I loved your XYZ series.\\\" It proves you are a real fan, not mass blasting DMs, and it earns you a better rate. My single best example: I once spent ninety percent of a call just talking with a creator about both of us being Greek. By the end he did not want to say no to a friend, and we closed at a $2 CPM.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 24, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"ebo7a\", \"text\": \"Explain the integration. Describe how the app will appear naturally inside their content. Share past examples and visual assets if you have them.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 16, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"8kkh1\", \"text\": \"Then talk rates. Ask, \\\"What do you feel is a reasonable rate?\\\" Then anchor everything to value.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6drb9\", \"text\": \"The math I run: take their average views, underestimate conservatively, and multiply by the number of videos. If they average 25K views and I want four posts, I project a conservative 100K total.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5irso\", \"text\": \"My clean opening offer:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 12, \"offset\": 19, \"style\": \"Bold\"}], \"key\": \"7n9ia\", \"text\": \"A flat rate in the $2 to $3 CPM range, so something like $250 for four videos\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 22, \"offset\": 2, \"style\": \"Bold\"}], \"key\": \"29f83\", \"text\": \"A minimum view guarantee of 100K, set low enough that they are confident they will clear it\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 86, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"d8ejk\", \"text\": \"20 to 50 percent up front, the rest once the videos are done and the guarantee is met. If they fall short, let them keep posting until they hit it.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8akj6\", \"text\": \"If they push back on the price, the strongest move is to reframe the flat fee as a chance to bet on themselves with a CPM deal. Do not lead with CPM, or it feels like you are baiting them into commission, which most creators will refuse. Let them crack the door first:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d3jev\", \"text\": \"Influencer: \\\"I think $350 for four videos is too low for me. Any way you can come higher?\\\"Me: \\\"I really have to stay in the $2 to $3 CPM range to be profitable. What I could do is pay you $3 per thousand views, so if four videos do 200K total, that's $600. There would just have to be a cap of $500 per video so one viral hit doesn't wipe me out.\\\"\", \"type\": \"blockquote\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"aisl5\", \"text\": \"In one move I shifted their frame from \\\"$350 for four videos\\\" to \\\"potentially $2,000 for four videos,\\\" while actually locking in a nearly risk free deal, because I stay profitable in that CPM range. And there is a second layer: if you pay weekly on recurring posts, your effective CPM quietly drops, because the views keep climbing for two months while you only paid for the first seven days. I track views for seven days max, then stop, and I am honest about why: \\\"I can't track this forever, my books would be a mess.\\\" Set a weekly payday, like every Sunday, and your floor revenue rises every single week.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 13, \"offset\": 29, \"style\": \"Bold\"}], \"key\": \"4jc24\", \"text\": \"After you present the offer, stop talking. Silence is your friend. You are the buyer. They need the sponsor as much as you need the promotion.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2tehr\", \"text\": \"The two objections you will hear most, and how I handle them:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 41, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"nvpe\", \"text\": \"\\\"XYZ brand paid me thousands for a post.\\\" I respond with one question: \\\"Are you still working with them?\\\" Almost always the answer is no. Big brands overpay for one off brand awareness, the post underperforms because it feels like an ad, and they never come back. That answer opens the door for me to pitch a real long term partnership instead.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 72, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"6v370\", \"text\": \"\\\"Sponsored content hurts my engagement, so I won't do a view guarantee.\\\" I respond: \\\"That's exactly why we don't want a typical ad. We want a subtle integration into content that already performs well. Our best results come when it looks authentic and people naturally comment about the app. In fact, a lot of our promos beat the creator's average video because people comment about the app.\\\" I only add that last line when it is actually true.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 23, \"offset\": 59, \"style\": \"Bold\"}, {\"length\": 20, \"offset\": 92, \"style\": \"Bold\"}], \"key\": \"2i8q6\", \"text\": \"On every call I hammer two themes: I am only interested in long term partnerships, and I am genuinely passionate about what I am building. The first matters because recurring posts raise my floor revenue weekly and make growth predictable, and because most creators have done one off deals but never had a consistent way to monetize. The second matters because passion is contagious. People mirror your enthusiasm, and people follow missions. They love working for a company they believe is out to build the best experience for its customer.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"f37e9\", \"text\": \"Then I invest in the relationship. I pay attention to my creators' lives. If one of my fighters has a fight coming up, I text them \\\"good luck.\\\" I try to be genuinely close with all of them, because that relationship is what earns me the homie discount. After every call I move them to WhatsApp, which keeps my influencer and VA conversations cleanly separated from my personal texts, so I never miss a message from my family or, just as importantly, precious UX feedback from my mom. Then I get them on a simple contract, and the rest is just having them subtly integrate the app into their content.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5gpt8\", \"text\": \"16. Distribution 5: Creatives That Don't Feel Like Ads\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 70, \"offset\": 111, \"style\": \"Bold\"}], \"key\": \"d4ko\", \"text\": \"The content should feel like the influencer genuinely uses your app, not like a paid spot. The core principle: the influencer is the hero, and your app is just a tool in their hand. They are not promoting it, they are using it.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"bef58\", \"text\": \"How I make content feel real:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 34, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"2k1lh\", \"text\": \"Study their last roughly 20 posts. Note what actually performs: their tone, humor style, editing pace, and emotional vibe.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 22, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"e2ksi\", \"text\": \"Use their best format. If they crush \\\"day in the life,\\\" I put the app there. If \\\"routine\\\" videos are their thing, I use those. I never force a new style on a creator who already knows what works for their audience.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 37, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"bu980\", \"text\": \"Make the app a moment, not the topic. It shows up naturally while they are doing something, never as a standalone pitch.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 17, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"csm34\", \"text\": \"Keep their voice. Same language, same energy, same personality, just with the app dropped into their real life.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"7ns39\", \"text\": \"Here is how the same app plugs into every major content format, so you can match whichever one already performs for a given creator:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 16, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"aol1s\", \"text\": \"Day in the life: the app appears as a natural part of their daily actions, like during morning planning or while solving a problem. This format is gold because it makes the app feel real and subconsciously links it to productive, disciplined people. The viewer absorbs the idea that productive people use your app, or that your app makes people productive.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 15, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"agphs\", \"text\": \"Routine videos: the app becomes part of a habit. \\\"Every night I do this\\\" or \\\"I always check this before training.\\\"\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 25, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"igt9\", \"text\": \"Educational or tip based: the app becomes a recommended tool. \\\"One thing that really helps me stay on track is this.\\\"\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 15, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"da8hk\", \"text\": \"Comedy or skit: the app as a prop or the punchline. \\\"I physically can't open my phone until I finish my task, look.\\\" Do not be afraid to poke fun at your own product in good fun.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 29, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"e1rtu\", \"text\": \"Before and after or progress: the app is the quiet reason behind the improvement, not the focus. \\\"Using this consistently helped me change X.\\\"\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 29, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"3d11o\", \"text\": \"Motivational or storytelling: the app supports their personal growth story. \\\"I used to struggle with this, so I started using this tool.\\\"\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 28, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"h6gm\", \"text\": \"Q&A or replying to comments: the app is the answer to a viewer's question. \\\"People always ask how I stay focused, here's what I use.\\\"\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"994ga\", \"text\": \"A real case study. One of my best performing videos cost $70 and generated close to $3,000. It was not even optimized. It featured two products, and my app did not even appear until around the thirty second mark. It still crushed, purely because the gotcha moment so clearly showed what the app did, and the creator made both products feel like natural parts of his day instead of interruptions.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"fab6r\", \"text\": \"One of my favorite early creators was a kid named Cory Zader. I paid him about $400 for six videos, and his very first one converted nearly $5K in sales. That is the power of the right creator with the right integration of the right gotcha moment.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4d1ll\", \"text\": \"When the returns from a particular creator start dipping, that is your sign their audience is saturating. Have them push a secondary feature to chase another uptick, but remember the biggest lift always comes from the gotcha moment.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"18sss\", \"text\": \"17. Distribution 6: Meme Pages, Organic, and Paid Ads\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 21, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"3a0ok\", \"text\": \"Meme and topic pages. This is one of the most cost effective ways to generate views. Have these pages repost your best performing content. Entertaining or funny content tied to your app works best. Do not pay more than about $50 per post, aiming for a CPM in the 50 cent to $1 range. The best meme pages have almost cult like communities built around them, which is exactly the kind of engaged audience you want.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"bi18f\", \"text\": \"Real case study: I paid a kickboxer $350 to film himself using the app, then reposted it on a meme page. That single collaboration helped take an app from $500 a month to $1,800 a month in one month. I was willing to lose money on it because a professional athlete using the app signaled legitimacy. We framed it as a news headline to make it feel less like an ad, and viewers immediately called it out as sponsored in the comments. They meant it as criticism, but all that commenting drove engagement, and it became the most viewed reel on that page that month. The usual rule is content should not feel like an ad. The exception is that every rule in marketing can be broken when engagement is the result.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 16, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"2u6ie\", \"text\": \"Organic content. This is a powerful way to validate your idea and to test whether your gotcha moment actually grabs people. If your core feature is strong, you should be able to pull real views just by demonstrating it. A pre launch tactic that worked well for me: post a demo with a caption like \\\"comment BETA to get early access.\\\" The comments both build a waitlist and prove the gotcha moment is compelling enough to make people act. A slightly dramatic tone and a strong hook help, and authenticity matters more than production value. I will be honest, I am personally not the best at creating this style of content myself. What I am great at is directing influencers on exactly what to post. With every marketing channel, play to your own strengths and your app's strengths. Just know organic can be inconsistent in performance, and done well it can build an almost cult like following for free.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 9, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"3gfec\", \"text\": \"Paid ads. I only recently started running these, and I am falling in love with them, because I now understand why people say influencers are not scalable past a certain point. Influencers are unbeatable when you have a small budget and need to 10x your money. But paid ads will reliably 2 to 3x your money at far greater scale. Two ways I run them:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"2cqel\", \"text\": \"If you work with several creators, pull 5 to 15 quality creatives, drop them all into a testing campaign at around $100 a day, and after the first week separate the winners from the losers.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"s7sm\", \"text\": \"If you do not have a stable of creators, pick one cheap, high agency creator and have them make ads for you instead of posting on their own page. One of my newer projects has grown entirely on paid ads, with a single high agency creator making all our creatives.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 17, \"offset\": 37, \"style\": \"Bold\"}], \"key\": \"3j05v\", \"text\": \"To find winning ad angles, go to the Meta Ads Library. Look up a competitor or an adjacent app. If you are building a running app, look up Strava. Filter by high impressions, because the ads with the most impressions and the most spend are the ones making money, since nobody keeps paying for an ad that does not return. For each one, ask two questions: why does this work, and how can I replicate it? Then hand the winner to your high agency creator and say, \\\"remake this one to one with my app.\\\" You will be shocked how often the highest earning ad is just someone authentically saying \\\"go download this app.\\\" Paid ads do not need to be polished, high production content. As long as it is real and authentic, it converts.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"7hfvv\", \"text\": \"18. After They Post: How to Milk Every Video\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ath7c\", \"text\": \"Getting the video posted is not the finish line. There is a whole layer of work after publication that most people skip, and it is free money.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 24, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"3udtm\", \"text\": \"Moderate your analytics. A good deal should be profitable within one to three days depending on your trial length. Watch it closely so you know fast whether that creator is a keeper or a one off.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 15, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"35e0b\", \"text\": \"Plant comments. Have a couple of friends drop a natural question about the app in the comments, like \\\"wait what app is that?\\\" When people see others curious about your product, they get curious too. Social proof compounds.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 33, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"42p7b\", \"text\": \"Comment from the company account. This turns the influencer's comment section into a second funnel. A viewer watches the influencer's post, clicks into the comments, sees your brand account, gets curious, clicks over to your page, watches a few of your videos, and now they are a primed and educated user who downloads the app. Even someone who was not ready to convert off the single video gets pulled deeper into your funnel. One post becomes a whole chain of touchpoints.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"c5fnv\", \"text\": \"That is the difference between treating a paid post as a lottery ticket and treating it as the top of a funnel you control.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3trtk\", \"text\": \"19. The Launch: Pre-Orders and Hitting the Charts\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d8mh5\", \"text\": \"How you launch matters, because a strong launch can put you on the App Store charts, and charting gets you organic downloads on top of everything you paid for.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4poeb\", \"text\": \"One option, if you have a launch creator lined up, is to set up a pre-order and have them hype it up throughout the week leading in. It is not required, plenty of apps launch fine without it, but it can be a nice boost. When the app goes live, all those pre-orders convert at once, which spikes you up the charts. When we launched Wrestle AI this way, we hit number 18 on the App Store on day one, purely off my co-founder's influence, and we were beating out the NFL app at one point. We had around 4,000 pre-orders waiting.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"54qs9\", \"text\": \"Let me tell you how that night actually went, because it is the most important lesson I have. About thirty minutes before Wrestle AI went live at midnight, the API the entire app depended on went completely down. My app was broken at the exact moment thousands of people were about to download it. People in Japan were already subscribing and immediately refunding because nothing worked. I felt as defeated as I have ever felt. I stayed up the entire night working on it, got it fixed around 5am, hit launch, and went to sleep. I woke up that afternoon to find we were number 19 on the App Store and had already made over a thousand dollars, with our Instagram flooded with comments saying how cool the app was.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ejp0u\", \"text\": \"The lesson: do not complain about having too much on your plate when you prayed to eat. Existence is a pleasure, and the hard part is the fun part. Launches will break. Push through anyway.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"g7cb\", \"text\": \"20. Read Your Numbers, Then Fix the Leaks\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"edko7\", \"text\": \"Once you are consistently pulling real traffic, say 100 or more downloads a day, you finally have enough signal to optimize properly. Three numbers matter most.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 16, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"6mhlq\", \"text\": \"Conversion rate. Where exactly are people dropping in your onboarding or at your paywall? Once you have rough metrics, start A/B testing your onboarding length and your pricing to lift it.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 30, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"5gu79\", \"text\": \"ARPU, or revenue per download. Aim for at least a $2 ARPU in month one. The number shifts with how you market. If you run top of funnel UGC, the girl on screen with text overlay style that pulls millions of views, your ARPU will be lower because the content quality and intent are lower. If you run real influencer posts that clearly explain what the app does, your ARPU should be much higher because that content converts higher.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 10, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"1uuen\", \"text\": \"Retention. As your first month closes, watch how many people unsubscribe. If retention is bad, it is almost always because your app simply is not useful enough yet.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1u6cm\", \"text\": \"Here is the most important growth lesson hiding inside retention, and it comes straight from my own data. Wrestle AI's retention sucked in the first month. The viral feature pulled people in, but they left. So we added something boring but genuinely useful: a calorie tracker, because wrestlers are constantly cutting and managing weight. Churn got cut in half. People came for the viral feature and stayed because the app was actually helping them with their weight. So we kept layering in strictly useful, non viral features, and that solved the retention problem entirely. We even revamped that calorie tracker into something close to MyFitnessPal, with a nutrition database, a barcode scanner, and a photo based calorie estimate, at half the price of the competition.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 55, \"offset\": 39, \"style\": \"Bold\"}], \"key\": \"3qj4b\", \"text\": \"That is the whole formula in one line. The viral feature acquires, the useful features retain. Pull people in with the Purple Cow, then keep them with the everyday utility. Do not be afraid to hook them with something fun and unique, then hold them with the practical stuff they need every day.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"a7oca\", \"text\": \"21. Proof That Anyone Can Do This\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"297mb\", \"text\": \"I know the reaction a lot of people have to all of this is \\\"sure, but that only worked for you.\\\" So let me give you the counterexamples.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"flgce\", \"text\": \"Fight AI was my very first app, built with zero app experience. I made it as an internal tool almost as a joke, posted myself talking to the camera about it, paid a meme page fifty bucks, and it did nearly $2,000 in its first month. It still does around $1,000 a month with no marketing since July. I love opening the dashboard and seeing some guy who has been subscribed for nine months and was active a week ago, and wondering what he is training for.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"45mvo\", \"text\": \"Then there are two kids, Christian and Braylin, who had a bit of a social following. I hit them up and told them they should build an app, walked them through exactly what I did with Wrestle AI, and gave them a free Rork subscription. They took it and ran, and now they are doing around $20K a month, all built in Rork, neither of them knowing how to code.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"dkj48\", \"text\": \"And the flywheel gets even better once your product is genuinely good. On my newer projects, creators have started reaching out to me. A creator with 20K followers, another with 1.8 million, both hitting me up first without me ever messaging them. One creator with 50K followers made videos for us for free just because he wanted to try the app. Another with three million followers, who averages 400K to a million views per video, did a four video, four story deal for $2,500, which is roughly a $1 CPM. You only get rates and inbound like that when the product is actually cool. Build something great and the entire distribution problem gets dramatically easier.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"f2js2\", \"text\": \"If you can find where your ideal customer spends their time, build something genuinely interesting for them, and put it in front of them, you will make money. That is the whole thing.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6ga06\", \"text\": \"22. The Mindset That Ties It All Together\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ap7on\", \"text\": \"A few things matter more than any single tactic.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 14, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"5sc1b\", \"text\": \"Learn to sell. My ability to close influencers came directly from doing door to door power washing sales and running garage sales when I was sixteen. If you have decent social skills, selling to creators becomes ten times easier, because you can build real rapport before you ever talk numbers. Funny enough, this is exactly why vibe coding is such an unlock, because the people who used to build apps often did not have the strongest social skills, and now the person with the relationships and the taste can build the product too.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 36, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"5o2as\", \"text\": \"It is a numbers game that compounds. More DMs, more creatives, more tests. Most of the work is just volume done consistently over time, and the results follow.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 18, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"dm1df\", \"text\": \"Now is the window. In my opinion, this is the drop shipping boom and the ecom boom of our era. Despite all the online noise, the space is nowhere near saturated. You get caught in a Twitter bubble where it feels like everyone is building an app. In reality, almost no one is. Most people still believe you need to know how to code, and most people do not even know vibe coding exists. Roughly 85 percent of the world does not even use AI yet, let alone realize it can build software. I can still post five TikToks about Fight AI, an app I have not touched since July, and get ten sales. The industry is wide open, and I do not think it gets truly saturated for a few more years. The best time to start was yesterday. The second best is today.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 32, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"cgd0b\", \"text\": \"Have the discipline to reinvest. As the numbers grow, resist the urge to pull money out too early. Build the machine first.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 20, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"7kg6v\", \"text\": \"Ignore the doubters. People love saying vibe coded apps cannot scale or are full of security holes. I have not hit a scalability wall, and on security, I simply do not collect sensitive personal data, so I am not exposing myself or my users to that risk in the first place. If you are building a straightforward consumer app, most of these fears do not apply to you. The doomer take on vibe coding is mostly wrong. With enough prompts and real attention to the product, you can build genuinely great things. It changed my life, and it can change yours.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"evur7\", \"text\": \"23. Resources I'd Point You To\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ck9ch\", \"text\": \"A few things worth studying as you build. These are the exact references I would send someone starting out.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 15, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"9cjoc\", \"text\": \"Paywall design. Apphud has a strong breakdown of how to design high converting subscription paywalls. Good paywalls are built, not just designed.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 20, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"edrue\", \"text\": \"Onboarding to model. Study the Cal AI onboarding flow closely, screen by screen. It is one of the best converting flows out there and worth copying the structure of. Userpilot also has a solid collection of onboarding UX examples.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 31, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"t0em\", \"text\": \"ASO, or App Store Optimization. Apptweak has a good beginner guide. Your store listing is part of your funnel, so do not ignore it.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [{\"length\": 25, \"offset\": 0, \"style\": \"Bold\"}], \"key\": \"1pfup\", \"text\": \"The power of influencers. There is a widely cited Forbes piece on how a large share of Gen Z trusts creators on TikTok more than traditional authorities. That trust is exactly what you are renting when you sponsor the right creator.\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"36o0h\", \"text\": \"Beyond that, the single best study habit you can build is downloading successful apps in your space and picking them apart. Study their gotcha moment, their onboarding, their paywall, their pricing, and their creator content. Everything you need to reverse engineer is already live on the App Store and already scrolling past on your For You page.\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"6h2vq\", \"text\": \"24. Start Today\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"a6t7m\", \"text\": \"You now have everything I know, the same playbook I used to make over $300K, do $52K in the last 28 days, and scale two apps to $20K and $25K a month, all on top of the Wrestle AI foundation that did $160K in its first six months:\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"8qr8o\", \"text\": \"Find a frequent, frustrating, niche problem you actually care about, and make sure it is a Purple Cow.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"5uqqv\", \"text\": \"Reverse engineer the viral video first, then build one unmissable gotcha moment around it.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3src2\", \"text\": \"Ship it fast with AI, no code required, prompting until every screen is right.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"sljd\", \"text\": \"Make the UX so simple your mom could use it.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"apbkv\", \"text\": \"Build onboarding that educates, personalizes, creates FOMO, and locks the payoff behind the paywall.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"en10a\", \"text\": \"Price for annual cash flow: $9.99 a month, $59.99 a year, trial on the yearly only.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1bf8m\", \"text\": \"Set up a credible brand page, engineer your feed, and reach out at volume.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"bqbp0\", \"text\": \"Get creators on the phone, close at a $2 to $3 CPM, and treat them like long term partners.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"3p2v5\", \"text\": \"Make content that feels real, milk every post, then layer in meme pages, organic, and paid ads.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"ftrvl\", \"text\": \"Launch (optionally with pre-orders to hit the charts), then read your conversion, ARPU, and retention and plug the leaks.\", \"type\": \"ordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d1vhd\", \"text\": \"$10K a month is $333 a day, and it is one or two of these things done well and compounded over time. The hardest part is not the building or the marketing. It is just getting on the phone and starting. So stop planning. Go build.\\n\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"d5nm1\", \"text\": \"25. Want to Work With Me Directly?\", \"type\": \"header-one\"}, {\"data\": {\"urls\": [{\"fromIndex\": 527, \"text\": \"https://georgelampropoulos.com/\", \"toIndex\": 558}]}, \"entityRanges\": [{\"key\": 0, \"length\": 1, \"offset\": 524}], \"inlineStyleRanges\": [], \"key\": \"hcl4\", \"text\": \"If you have read this far, you are serious about this, and I am happy to help you move faster. If you want to talk through your specific app for an hour, you can book a call and we will get into exactly where you are and what to do next. And if you want ongoing support, I take on a small number of people as an advisor. That means two calls a week with me, plus access to all my internal docs and the same training tools I use to run my own apps. If either one sounds like what you need, use the link below to work with me 👇\\n\\nhttps://georgelampropoulos.com/\", \"type\": \"unstyled\"}], \"entityMap\": [{\"key\": \"0\", \"value\": {\"data\": {\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f447.svg\"}, \"mutability\": \"Immutable\", \"type\": \"TWEMOJI\"}}]}, \"created_at\": \"2026-07-28T05:46:14.000Z\", \"title\": \"How to go from 0-10k a month in under 30 days (I've done this 3 times)\"}\n{\"text\": \"How to Scale Your App to $10K/Month (Easy Mode)\"}\n{\"text\": \"You clicked on this because you want to build a mobile app that actually makes money. Not a portfolio piece. Not a \\\"someday\\\" idea sitting in your notes. Real recurring revenue you can watch hit your dashboard every single morning.\"}\n{\"text\": \"Here is the good news, and I mean it: you do not need a dev team, you do not need funding, and you do not need to know how to code. I know that because I am living proof of it. I am 19. A couple of years ago I was working a register at TJ Maxx. Today I have made over $300,000 building consumer apps with AI. In the last 28 days alone I did $52,000 in revenue, and over the last 90 days I scaled two apps to $20K and $25K a month. It all started with an AI wrestling app called Wrestle AI, which did over $160,000 in its first six months and crossed 100,000 downloads. I do not know how to write a single line of code. I built all of it with AI.\"}\n{\"text\": \"People have been making mobile apps since 2008, and for most of that time it kept getting harder to build something people would actually download and pay for. Then two things changed everything. AI made it so anyone can create software, and AI made it so you can build experiences that are genuinely better than what came before. Cal AI lets you photograph a plate of spaghetti and instantly know the calories. Wrestle AI lets you upload your match and instantly know what you did wrong. Those experiences simply were not possible before, and that is the entire opportunity.\"}\n{\"text\": \"This is everything I know, laid out as a playbook. Nothing held back. If you read it top to bottom and actually do the work, you can do what I did. Let me show you how.\"}\n{\"text\": \"Table of Contents\"}\n{\"text\": \"The Only Math That Matters\"}\n{\"text\": \"Start With an Idea That Can Actually Win\"}\n{\"text\": \"How to Reverse Engineer a Viral App Idea\"}\n{\"text\": \"Why a Good Idea Beats Good Distribution\"}\n{\"text\": \"The Gotcha Moment: Your Single Most Important Asset\"}\n{\"text\": \"The Six-Step Process I Use to Build Any App\"}\n{\"text\": \"Build the App: Vibe Coding With AI\"}\n{\"text\": \"Your Tech Stack and What It Costs\"}\n{\"text\": \"Design, UX, and the Mom Test\"}\n{\"text\": \"Onboarding: Where Browsers Become Buyers\"}\n{\"text\": \"Pricing and the Paywall\"}\n{\"text\": \"Distribution 1: Your Instagram Page Is a Weapon\"}\n{\"text\": \"Distribution 2: Engineer Your Feed to Find Influencers\"}\n{\"text\": \"Distribution 3: Outreach at Volume\"}\n{\"text\": \"Distribution 4: Closing the Deal on the Phone\"}\n{\"text\": \"Distribution 5: Creatives That Don't Feel Like Ads\"}\n{\"text\": \"Distribution 6: Meme Pages, Organic, and Paid Ads\"}\n{\"text\": \"After They Post: How to Milk Every Video\"}\n{\"text\": \"The Launch: Pre-Orders and Hitting the Charts\"}\n{\"text\": \"Read Your Numbers, Then Fix the Leaks\"}\n{\"text\": \"Proof That Anyone Can Do This\"}\n{\"text\": \"The Mindset That Ties It All Together\"}\n{\"text\": \"Resources I'd Point You To\"}\n{\"text\": \"Start Today\"}\n{\"text\": \"1. The Only Math That Matters\"}\n{\"text\": \"$10K a month sounds like a mountain. Break it down and it stops being one. $10K a month is $333 a day. That is it. To get there you really only need to nail one or two things and then let them compound on top of each other.\"}\n{\"text\": \"When I strip it all the way down, a successful app comes from three pillars and nothing else:\"}\n{\"text\": \"A good idea. Something people actually want, that solves a real problem.\"}\n{\"text\": \"A product that matches the idea. The thing has to deliver on the promise the moment someone opens it.\"}\n{\"text\": \"Distribution. Putting that idea in front of the exact people who feel the problem.\"}\n{\"text\": \"Get those three right and the daily revenue takes care of itself. Over the last 90 days I scaled two newer projects to $20K and $25K a month, working roughly three to four hours a week on each. It is not about hours in. It is about following a playbook that gets you there fast.\"}\n{\"text\": \"Here is the framing I want you to hold in your head for the rest of this article. Everything from here is just those three pillars, explained in detail. Idea first, because your marketing will only ever take you as far as your idea allows. Product second, because a great idea with a broken or confusing product converts no one. Distribution third, and in the most depth, because that is where most of the actual work lives and where most people quietly fail. So let me walk you through each one, in order, exactly the way I do it.\"}\n{\"text\": \"2. Start With an Idea That Can Actually Win\"}\n{\"text\": \"The easiest way to find an idea is to find a problem you personally have, and then figure out a creative way to solve it. When the idea comes from your own pain, something powerful happens: you become your own ideal customer. You instinctively know what to build, what features matter, what to cut, and exactly how to talk about it, because you are the person you are building for. It also means there are probably a lot more people out there experiencing the same problem you are.\"}\n{\"text\": \"For me that problem was wrestling. I wrestled all through middle school and high school until COVID cut it short, and the sport genuinely changed my life. So when I was a freshman I asked myself a simple question: what would I have loved to have on my phone back then? That question was the entire idea. I was not guessing at what wrestlers wanted. I was a wrestler.\"}\n{\"text\": \"It also gives you something you cannot fake, which is belief. When I sit across from an influencer or a designer or a developer and pitch them on Wrestle AI, they can feel that I actually care about it. People can tell the difference between someone selling snake oil and someone on a mission. That belief is what convinces creators to partner with me for cheaper rates and work harder than they otherwise would. If you do not believe in your own mission, it becomes very hard to get anyone else to.\"}\n{\"text\": \"So when you are picking an idea, build for something you are passionate about and would happily grind on for ten straight hours. That is not a motivational poster, it is a strategic advantage that shows up in your product quality and in every sales conversation you ever have.\"}\n{\"text\": \"When I break down what makes an idea actually good, there are three pillars underneath it: uniqueness, helpfulness, and the gotcha moment. You need uniqueness so it catches eyes and stops the scroll. You need helpfulness so it has stickiness and people stay. And you need a gotcha moment built into the app that conveys what it does in about five seconds. I will cover the gotcha moment on its own because it deserves it, but keep those three in mind as your filter.\"}\n{\"text\": \"Beyond that, a strong idea solves a problem that is:\"}\n{\"text\": \"Felt frequently. Daily or weekly, not once a month. Someone forgetting a password once a month is weak pain. Someone procrastinating every single day is high frequency pain. The more often a person feels a pain, the more likely they are to search for a solution, value it, pay for it, and build a habit around it.\"}\n{\"text\": \"Emotionally irritating. Something that genuinely frustrates people on a gut level, not a mild inconvenience.\"}\n{\"text\": \"Experienced by a large group, even if that group looks niche from the outside.\"}\n{\"text\": \"Here is something most people get backwards: follow what people actually do, not what they say they want. People say they want to read more. Their real behavior is scrolling TikTok until 2am. Users say one thing and behave differently, so use behavioral truth, not verbal claims. The best ideas often come from asking not \\\"what do people want\\\" but \\\"what do people actually do, even when they know they shouldn't.\\\"\"}\n{\"text\": \"And do not try to build for everyone. Go niche first, then expand. Every massive company started narrow. Facebook was Harvard only. Amazon was just books. Snapchat was teen messaging. TikTok was Gen Z dancing. When I told people I was building a wrestling app, most of them scoffed. \\\"How many wrestlers even are there?\\\" Turns out enough, and because the niche was so specific, I knew exactly who my customer was, which meant I could reverse engineer exactly where to find them. Owning a niche builds loyalty, trust, word of mouth, and authority. You earn the right to expand outward later. The democratization of building is what makes this possible now. You do not need a billion dollar market or a ton of capital to serve a tight community well. Wrestle AI never needed to be a billion dollar company to change my life.\"}\n{\"text\": \"One of my favorite moves is to steal proven mechanics from one category and apply them to another. The psychology already works, you are just porting it. A few examples:\"}\n{\"text\": \"Duolingo into fitness or productivity: streaks, XP, and level ups to gamify consistency.\"}\n{\"text\": \"Spotify Wrapped into personal stats: a yearly fitness, study, sleep, or productivity recap that people want to share.\"}\n{\"text\": \"MyFitnessPal into behavior logging: track moods, workouts, studying, spending, or habits instead of just food.\"}\n{\"text\": \"Tinder into swipe decisions: instantly choose exercises, outfits, meals, or daily goals.\"}\n{\"text\": \"Fortnite into seasonal progression: short seasons of focused improvement with resets and rewards.\"}\n{\"text\": \"The last filter, and it might be the most important: your idea has to be a Purple Cow. In a field of ordinary brown cows, the only one anybody remembers is the purple one. Your app has to visually stand out the instant it appears on a screen. It needs an element of surprise, something the viewer has never seen before, so curiosity alone makes them stop scrolling and download.\"}\n{\"text\": \"And do not forget the back half. A viral hook with no real utility has no longevity. People come for the novelty and leave fast. Apps with valuable but less exciting features are the ones that retain. The ideal is to attract with a viral, attention grabbing feature and then retain with the practical, everyday ones. Pull them in with something fun, keep them with something useful.\"}\n{\"text\": \"3. How to Reverse Engineer a Viral App Idea\"}\n{\"text\": \"If you sat me down right now and told me I had to come up with an app idea today, here is exactly what I would do, step by step.\"}\n{\"text\": \"I would open Instagram or TikTok and just scroll for about fifteen minutes. But I would not scroll passively. Every single time I watched a video, I would ask myself three questions:\"}\n{\"text\": \"Who watches this type of video?\"}\n{\"text\": \"What problem does this influencer's audience face?\"}\n{\"text\": \"How could an influencer promote an app for this, seamlessly, without it feeling like an ad?\"}\n{\"text\": \"That third question is the whole game. I am not just looking for a problem, I am looking for a problem where I can already picture the promotion. If I looked at wrestling content creators, I would ask: how could this person show my app for five seconds within the first thirty seconds of their video and have it feel completely natural? When I found wrestling day in the life creators, I knew instantly they were perfect, because a wrestling app slotting into a wrestler's daily routine feels like real life, not an advertisement.\"}\n{\"text\": \"This is the same thing as reverse engineering the viral video and building the product to fit it, which I will hit again in the gotcha moment section, because it is that important. Most people build a product and then panic about how to market it. Flip the order. Find where your ideal customer already spends attention, find what they already engage with, and build something that plugs into that existing behavior. When you do it this way, distribution stops being a wall and becomes a slot your product just drops into.\"}\n{\"text\": \"The other reason this works: once you have scrolled as your ideal customer for a while, you have quietly trained the algorithm to show you nothing but relevant creators. You have simultaneously found your idea and built your entire outreach lead list. More on that in the feed engineering section.\"}\n{\"text\": \"4. Why a Good Idea Beats Good Distribution\"}\n{\"text\": \"There is a constant argument online, especially on Twitter, that distribution beats product. I push back on that hard, and I have the receipts to prove why.\"}\n{\"text\": \"In October I launched two apps at the same time. The first was Wrestle AI, an idea I was obsessed with. The second was an app I will be honest, I kind of hated. It was a RizzGPT style AI dating assistant, completely unoriginal, but I had an influencer with over two million followers ready to partner with me, so I figured it would print money regardless. I threw out my own rule about building things I care about and chased the bigger audience instead.\"}\n{\"text\": \"Look at what happened. In the first month, Wrestle AI did around a million views and made $17,000. In that same first month, the dating app, called Green, did 1.8 million views and made $35. That is not a typo. From 1.8 million views I got five weekly subscriptions. Thirty five dollars.\"}\n{\"text\": \"I sat there trying to convince myself it was my marketing, my creatives, my targeting. Eventually I got honest with myself. It was none of that. The idea just sucked. Everyone had seen a hundred versions of it already, so nothing converted. Wrestle AI converted because it was actually unique in its niche. Same founder, same effort, same level of reach. The only variable was meaning. Wrestle AI was a Purple Cow. Green was a remix of things people had already scrolled past a thousand times.\"}\n{\"text\": \"That experience set my rule in stone: I only build things I am genuinely passionate about and that are actually novel. Because here is the lesson underneath it all. All distribution does is distribute your idea and your mission. If the idea is weak, all your distribution does is help it fail faster in front of more people. So if your product is not a Purple Cow, then your marketing has to be the Purple Cow instead. Think about a brand like Liquid Death or Rainbet. Their differentiation lives entirely in how they market, and the experience is the marketing. When the product itself is not remarkable, the marketing has to carry everything, and that is a much harder game. But when the product is genuinely remarkable, marketing stops being a crutch and becomes pure leverage.\"}\n{\"text\": \"5. The Gotcha Moment: Your Single Most Important Asset\"}\n{\"text\": \"If you remember one thing from this entire article, make it this section. The gotcha moment is the feature I spend the overwhelming majority of my build time on, and it is the thing that quietly determines whether all your distribution works or falls flat. At least half of your build time, honestly more, should go into creating and refining this one thing.\"}\n{\"text\": \"The gotcha moment is the one feature that stops the scroll and sends someone straight to the App Store. It has to be so simple that anyone watching it for five seconds instantly understands the entire thesis of your app, without a single word of explanation.\"}\n{\"text\": \"Cal AI: take a picture of your food, get the calories.\"}\n{\"text\": \"Wrestle AI: upload your match, get told exactly what you did right and what you did wrong.\"}\n{\"text\": \"Quittr: panic mode.\"}\n{\"text\": \"UMax: the face rater.\"}\n{\"text\": \"Notice the pattern. Every one of them can be explained in a single sentence, and every one delivers personalized feedback you can only experience by actually using the app. That personalization is key. These features work because they either solve a problem in a genuinely unique way or give you feedback about yourself that you cannot get anywhere else.\"}\n{\"text\": \"The greatest products in the world all pass this test too. Uber: press a button, a car comes. DoorDash: press a button, food shows up. Tinder: swipe, find a date. Hinge: swipe, find someone to date. One sentence, total clarity. The best products can be explained in a sentence or less, and that is not a coincidence, it is a requirement.\"}\n{\"text\": \"The smartest way to design a gotcha moment is to reverse engineer the viral video first, then build the product around it. Before I build anything, the question living in the back of my head is: what could I seamlessly drop into a TikTok or a YouTube Short, in the first thirty seconds, that makes someone stop and think \\\"I need to try this,\\\" without it feeling like an ad? I design the feature to win that five second window, and then I build outward from there. I will even use AI to brainstorm this. I will literally ask, given this niche, what would be a TikTok about this app that would go viral, and what single feature would make that video work.\"}\n{\"text\": \"Spend at least half your build time, honestly closer to ninety percent of your focus, making that one moment visually impressive and dead simple to understand. Influencers will show your app for ten to fifteen seconds, max. In that short window the viewer has to clearly see why they need it. When you nail the gotcha moment, you have solved most of your distribution problem before you have spent a single dollar, because the feature itself does the selling for you.\"}\n{\"text\": \"A note from experience: you can have other features you want to push, but resist showing them off early. I push the gotcha moment ninety percent of the time. Only when a particular creator's audience starts to saturate, and the returns from their videos start dipping, do I have them push a secondary feature to chase another, usually smaller, uptick. The headline always stays the headline.\"}\n{\"text\": \"6. The Six-Step Process I Use to Build Any App\"}\n{\"text\": \"Before I get into the mechanics of building, here is the full arc I run every single time, from blank page to money. If you want a single mental checklist, this is it. The rest of the article expands each of these.\"}\n{\"text\": \"Step one, the idea. Uniqueness, helpfulness, gotcha moment. A viral idea in its nature, because if the idea is not viral, distribution cannot save it. This is where I spend real thought, not five minutes.\"}\n{\"text\": \"Step two, designing the app. Answer two questions: who is it for, and what type of UI would fit that buyer. I take those answers and feed them straight into my build tool. I build the framework first, then the functionality. And I keep one more question in mind the whole time: how could users organically share this, so not all of my traffic has to be paid.\"}\n{\"text\": \"Step three, building the core functionality. I set aside about a week to just sit at my computer and prompt from morning to night. This is where I figure out my backend, whether I want to plug in external APIs, and where I make the gotcha moment actually work and look incredible. Do not cut corners here.\"}\n{\"text\": \"Step four, onboarding. The second most important part of the whole app. You can have a great product, but if you cannot convert the user, no one will ever know it was great. I copy what already works from high converting apps and adapt it.\"}\n{\"text\": \"Step five, hire out what you do not know. With today's tools you can get further on your own than ever, but when you do need help, a good early hire can be huge. The best return on investment I have ever had was bringing on a sharp person early. Sell whoever you hire on the vision so they work like they are part of something bigger.\"}\n{\"text\": \"Step six, expand past vibe coding. Once you cross about $5K a month, start reinvesting in product quality. Bring on designers. Add discipline. Vibe coding gets you to validation fast, but real product quality is what carries you past the early ceiling.\"}\n{\"text\": \"That is the entire loop. Now let me go deep on each part.\"}\n{\"text\": \"7. Build the App: Vibe Coding With AI\"}\n{\"text\": \"I built every one of my apps with AI through Rork, an AI app builder. I saw an ad for it while I was sitting in physics class, scrolling my For You page. It said \\\"build an app in minutes\\\" and I did not believe it. I thought it was one of those drag and drop template things. I clicked anyway, tried it, and built an app called Fight AI where you throw in your training footage and it tells you what you are doing right and wrong. That app made me about $2,000 in its first month just from me posting about it and paying a meme page fifty bucks. It still quietly does about $1,000 a month and I have not marketed it since July. That was the moment I knew apps were the new way to make money.\"}\n{\"text\": \"The reason I love Rork is that the barrier that used to require a team, a year of work, and a pile of cash is just gone. Think of it like Claude Code, except purpose built for mobile apps. You describe what you want, it builds a fully native iOS app, and you can push it straight to App Review from inside the tool, no Cursor or general coding setup required. I built all of Wrestle AI off the basic $20 a month subscription. These days I highly recommend Rork Max, which builds your app in native Swift instead of React Native, and the jump in quality is night and day. That quality is not a small thing. From everything I have seen, Rork users out-earn people on every other app builder, for one simple reason: it builds the best apps, and better apps convert better, retain better, and land better creator deals. Once you know what you are doing, you can take an app from idea to App Review in under a day, and I do not mean a slop app, I mean a real quality app.\"}\n{\"text\": \"Speaking of slop. People love to call vibe coded apps \\\"AI slop,\\\" and I could not disagree more. What actually exists is not slop, it is underprompting. You are not one shotting a finished product from a single prompt. When I say I spend around fourteen days building, I mean I am prompting relentlessly, page by page, fixing this and tweaking that, until each screen works exactly how I pictured it and looks exactly how I wanted it to look. Code is code. With enough prompts, you can build genuinely great products. I refuse to cut corners. If something does not work, I figure out why instead of moving past it. I have downloaded apps built entirely by AI, like a workout app called Core OS that auto tracks your gym time and your sleep, that are among the best health apps I have ever used. Full AI, incredible product.\"}\n{\"text\": \"Here is the framework I actually use:\"}\n{\"text\": \"Around 14 days for core functionality and branding. Decide what the app does and how it looks. I build how it looks first, get it looking really nice, then make each page work exactly how I imagined. Do not cut corners anywhere. If a page is broken, figure out why.\"}\n{\"text\": \"A few days on the onboarding. This is where you educate the user, personalize the experience, and create the FOMO that drives conversions.\"}\n{\"text\": \"Then payments and backend. I add RevenueCat for the paywall and Supabase for the backend, plus any external APIs I need. If I am building a calorie tracker, for example, I plug in a nutrition database. There are plenty of cheap public APIs out there that add real functionality for very little money.\"}\n{\"text\": \"8. Your Tech Stack and What It Costs\"}\n{\"text\": \"One of the best things about this whole model is how cheap it is to run. People assume you need serious capital. You do not. Here is roughly what my stack looks like and what it costs.\"}\n{\"text\": \"Rork, the AI app builder where the app itself gets built. It is like Claude Code, except purpose built for mobile apps. I built all of Wrestle AI off the $20 a month subscription, and these days I recommend Rork Max, which builds in native Swift for much higher quality apps.\"}\n{\"text\": \"Supabase handles my backend and is easy to use, around $30 a month.\"}\n{\"text\": \"AI inference to power the features inside the app. What you pay here scales with your usage.\"}\n{\"text\": \"A verified Instagram badge for your outreach and brand accounts, about $11.99 a month.\"}\n{\"text\": \"Add it up and you can run a real, revenue generating app business for the price of a few subscriptions. There is no reason the cost side should ever be what stops you.\"}\n{\"text\": \"9. Design, UX, and the Mom Test\"}\n{\"text\": \"Design and user experience matter more than most beginners think, because a confusing app kills conversions no matter how good the underlying idea is.\"}\n{\"text\": \"My litmus test is simple. I should be able to hand my phone to my mom and have her understand what the app is and how it works without me saying a word. My mom still does not really know how Siri works, so she is a perfect tester. I literally text her my app and ask, \\\"Can you figure this out? Can you tell what it does? Can you use it?\\\" Plenty of times she has come back with \\\"it's too cluttered,\\\" and that is some of the most valuable feedback I get. If your mom cannot use your app, you have to simplify the UI until she can. Strip it down. Make it obvious. If your mom happens to be technical, find someone who is not and run the same test on them.\"}\n{\"text\": \"Build for your buyer. Before I design a single screen I answer two questions and feed the answers straight into Rork: who is this for, and what type of UI would fit them. Then I build the framework first and the functionality second. I also keep one more question in the back of my head the whole time: how could users organically share this app? If sharing is built into the experience, not all of your traffic has to come from ad spend, which quietly lowers your cost of growth forever.\"}\n{\"text\": \"10. Onboarding: Where Browsers Become Buyers\"}\n{\"text\": \"Onboarding is everything that happens before the paywall, and it is the second most important part of your app, right behind the gotcha moment. You can build a great product, but if you cannot convert the user, no one will ever find out it was great.\"}\n{\"text\": \"People massively overcomplicate this. Onboarding really only has four jobs:\"}\n{\"text\": \"1. Educate the user. Show quick three to five second visuals demonstrating each major feature. People will not pay for something they do not understand, so show them clearly what the app does and how it works.\"}\n{\"text\": \"2. Personalize the experience. Ask for their name and use it throughout. Then ask guiding questions that walk them straight toward the problem your app solves. Cal AI does this beautifully: \\\"Have you tried other weight loss apps before?\\\" If yes, \\\"Here's why we're different from traditional calorie trackers.\\\" You are customizing the experience and steering them to their own need at the same time. Then tie their goals directly to the app. Ask their objective, then visually show two roadmaps: their journey without your app versus their journey with it. That builds the internal logic of \\\"this app accelerates my progress.\\\"\"}\n{\"text\": \"3. Build sunk cost. Draw the personalization out just enough that the user feels invested, but not so long that they get bored and bounce. If someone answers twenty questions to build their perfect setup and then hits a paywall, the sunk cost fallacy kicks in. They think, \\\"I have already put all this work in, let me at least start the free trial.\\\" The more time they invest, the more compelled they are to pay.\"}\n{\"text\": \"4. Create FOMO, then lock the payoff behind the paywall. This is the move most people miss, and it is the one that lifts conversions the most. Right before the paywall, run your gotcha moment, but withhold the result. In Wrestle AI you upload your match, watch an analysis animation that says things like \\\"targeting\\\" and \\\"calibrating,\\\" and then right as it finishes, the paywall appears saying \\\"unlock your rating now.\\\" Now the user is dying to know their score. That single screen converts far better than dumping someone at a cold paywall after a few setup questions.\"}\n{\"text\": \"Let me walk you through the actual Wrestle AI onboarding flow, screen by screen, so you can see all of this working together:\"}\n{\"text\": \"Feature pages first, quick visuals explaining exactly what the product does.\"}\n{\"text\": \"A rate the app screen, cheekily placed before the paywall. This single screen drives a huge share of our ratings and pushed us to 4.8 stars across well over a thousand reviews. \\\"Support the mission, rate five stars,\\\" rate and continue.\"}\n{\"text\": \"The profile survey. Identify your style. What do you compete in. What is your go to attack. Where do you dominate. What is your mat identity. How often do you train. This both personalizes the app and racks up sunk cost.\"}\n{\"text\": \"Weight management and body metrics, which feeds into a personalized nutrition plan.\"}\n{\"text\": \"Schedule commitment. Getting the user to commit to a training schedule.\"}\n{\"text\": \"Goal setting and analysis. Let them type their goal, then visually project their growth over time using the app.\"}\n{\"text\": \"A taste of the gotcha moment. We let them upload a video and see the analysis animation happen, right before the paywall, with a skip for now button for anyone who wants to move past it.\"}\n{\"text\": \"\\\"Your profile is ready,\\\" now complete with a nutrition plan and a training roadmap.\"}\n{\"text\": \"Sign in, pushed as far down the flow as possible to reduce drop off.\"}\n{\"text\": \"The prepaywall page, then the paywall. By now they have created, personalized, and emotionally invested. They are primed to convert.\"}\n{\"text\": \"The fastest way to build a great onboarding is to steal what already works. Spend an hour or two downloading high converting apps in your space, Cal AI, Opal, Quittr, and pay attention to exactly where you feel compelled to buy and why. Then apply those same elements to yours. There is no perfect formula. Test, iterate, get creative, and have fun with it.\"}\n{\"text\": \"11. Pricing and the Paywall\"}\n{\"text\": \"Keep monetization simple. Make the app pay to access, with the paywall sitting at the end of onboarding.\"}\n{\"text\": \"The pricing structure I use again and again:\"}\n{\"text\": \"$9.99 per month\"}\n{\"text\": \"$59.99 per year\"}\n{\"text\": \"A 3 day free trial attached to the yearly plan only.\"}\n{\"text\": \"Putting the trial only on the annual plan steers people toward the yearly option. When they convert, you collect around $60 up front instead of $9. That faster cash collection is a massive reason Wrestle AI was able to scale so quickly. Most of my revenue accrues from yearlies for exactly this reason, because the trial funnels people into the annual plan and then converts.\"}\n{\"text\": \"If you have direct competitors, just copy their pricing. If your app is genuinely unique with no clear comparison, use your intuition, then test once you have traffic. One of the highest leverage things you can do is spend an hour or two downloading successful apps in your space purely to study their monetization, noticing exactly where you feel compelled to buy. Once you have real volume, A/B test pricing to find your ceiling.\"}\n{\"text\": \"12. Distribution 1: Your Instagram Page Is a Weapon\"}\n{\"text\": \"Now the part everyone is really here for. This is my actionable plan to $10K a month, and most of it lives on Instagram.\"}\n{\"text\": \"Your brand Instagram account does two jobs at once: it is a sales funnel for users, and it is your credibility with influencers. Set it up properly before you reach out to anyone.\"}\n{\"text\": \"What it needs:\"}\n{\"text\": \"Social proof through followers. When an account has five followers, people distrust it. When it has at least 5K, you look reputable and creators take you seriously. So build that base. I will be honest about the trade off here: a lot of people buy followers to jumpstart this, and you can find sites that do it. But buying followers is against Instagram's terms of service, full stop. The clean alternative is creating content that gets shared and growing it the old fashioned way. It takes longer but it carries no risk. Wrestle AI itself was never botted. Decide what fits your own risk tolerance, and do not just take my word for it, do your own research.\"}\n{\"text\": \"Verification. Paying for the verified badge, around $11.99 a month, makes you stand out in a creator's inbox and signals you are a real builder, not a scam.\"}\n{\"text\": \"A clean bio with a clear CTA, plus three solid product demos pinned up top. Design them yourself or pay a Fiverr designer. Your bio should clearly say who you are, what you are building, and any apps you have made.\"}\n{\"text\": \"Collab posts with every influencer you work with, especially early on. When you co post, your page looks active, professional, and connected, like you are working with a lot of people. That single detail changes every future negotiation.\"}\n{\"text\": \"Here is why this matters in both directions.\"}\n{\"text\": \"As a sales funnel: imagine a wrestler watching their favorite wrestling creator. They see Wrestle AI tagged in the caption, think \\\"that looks cool,\\\" click through to my page, and then watch four more Wrestle AI videos right there. In a couple of minutes they went from slightly curious to fully educated and primed to convert. Then they hit the CTA in my bio, download the app, and go through an onboarding that primes them even further. An already warm user gets even warmer.\"}\n{\"text\": \"As credibility: when a creator gets my DM, the first thing they do is click my profile. If they see two followers and no posts, they assume it is some no name app nobody uses, and they either ignore me or, if they do respond, I walk into the call with zero authority and have to pay whatever insane rate they ask. But if they see a brand working with tons of creators, they think, \\\"this person is clearly paying others, so these are probably just the going rates.\\\" It is far easier to convince someone to do something when they can see ten other people already did it. That authority is the difference between paying a $2 CPM and paying ten times that. When I propose a low rate off a credible page, they think \\\"everyone must work for these rates,\\\" instead of \\\"this guy is trying to rip me off.\\\"\"}\n{\"text\": \"13. Distribution 2: Engineer Your Feed to Find Influencers\"}\n{\"text\": \"This is arguably even more important than the page itself, and almost nobody does it deliberately.\"}\n{\"text\": \"Build a detailed mental image of your ideal customer, then open a fresh account and behave exactly like that person. Like the content they would like. Watch the videos they would watch all the way through. Comment, share, and interact naturally as them. You are training the algorithm to feed you a constant stream of the exact creators who reach the people you want. This method takes a little longer than just searching, but every single influencer it surfaces is highly relevant and worth reaching out to.\"}\n{\"text\": \"For me this was easy because I was the customer. I knew exactly what content wrestlers watch, so I hypnotized my For You page into being nothing but wrestling. Once it was fully tuned, prospecting became scroll, outreach, scroll, outreach. No more digging through Instagram search trying to find the perfect creators. The leads came to me, which made the whole process ten times faster. This is one more reason to build for something you are passionate about, because you already know what that audience watches and you can slip into their feed effortlessly.\"}\n{\"text\": \"If you would rather outsource the finding, you can hand a VA a set of criteria instead: a minimum and maximum follower count, a target for average views, likes and comments per post, posting frequency, and the hashtags your audience interacts with. Then have them run outreach from your account. This gets you volume, but it also floods your inbox with unqualified leads, so you have to be willing to sift.\"}\n{\"text\": \"Now, who actually deserves your outreach. The single most important rule: followers do not matter. Views and engagement do.\"}\n{\"text\": \"Green flags:\"}\n{\"text\": \"25K or more views per video on average\"}\n{\"text\": \"Views that never dip under 15K, a stable floor\"}\n{\"text\": \"Content that performs across multiple platforms\"}\n{\"text\": \"A distinct style where you can immediately understand why the internet resonates with them, not a trend hopper\"}\n{\"text\": \"A comment section that shows a genuinely engaged community\"}\n{\"text\": \"Red flags:\"}\n{\"text\": \"Wildly inconsistent views, 100K on one video and 5K on the next\"}\n{\"text\": \"A trend hopper who just copies popular sounds and feels generic\"}\n{\"text\": \"Comments that are all emojis, which usually signals low quality viewers or fake engagement, most common on Instagram\"}\n{\"text\": \"Lots of views but barely any comments. If people will not take the time to comment, they probably will not take the time to download your app.\"}\n{\"text\": \"14. Distribution 3: Outreach at Volume\"}\n{\"text\": \"This entire game is a numbers game. How many creators can you message, how much content can you make. The more you do, the more you get out, period.\"}\n{\"text\": \"If you are just starting, DM 100 people a day. And replace yourself in this process as fast as you possibly can. If you have $2,000 to start your app, I would genuinely spend close to $800 of it on a VA for the first month. They are integral to volume and they free up your head to think clearly. Hire from Upwork, Fiverr, Founders Arm, wherever. Do not haggle for cents. If they ask for $800 a month, just pay it. You will get far more than $800 in value back. Hop on a call, show them the system, and give them a dead simple rule: scroll the tuned feed, and if a creator averages over 25K views, reach out. Hand them a clean SOP and your DM scripts. Expect to pay roughly $5 to $15 per 100 DMs sent.\"}\n{\"text\": \"There are really two moments to hire a VA. The first is right when you are starting out and you need raw volume to get your foot in the door. The second is once you are hyper successful and the founder simply should not be the one sending cold DMs anymore. The awkward middle, which is where I have been, is when your brand is known enough that your response rate shoots up and you can efficiently do it yourself: scroll for twenty minutes a day off the business account, message everyone you can in that window, and hop on calls the next day to close them.\"}\n{\"text\": \"The DM itself has to be short and instantly clear. Influencers get hundreds, sometimes thousands of DMs a day, and almost all of them say \\\"hey I love your content.\\\" Yours has to lead with the one thing that earns a reply: money. I am, with no exaggeration, a DM wizard. Back when I started I was sending hundreds of DMs a day to anyone willing to build with me. The structure that works:\"}\n{\"text\": \"First two words: \\\"Paid promo?\\\" Or \\\"Paid promo for [their handle]?\\\" Nothing is more captivating in a flooded inbox than telling someone you will pay them.\"}\n{\"text\": \"One sentence on what your app does. Just enough for them to understand, not so much that you bury it. Keep them curious.\"}\n{\"text\": \"A clear invitation. \\\"I'd love to sponsor you, let me know if you're interested.\\\"\"}\n{\"text\": \"Here is a clean example:\"}\n{\"text\": \"\\\"Paid promo for Arc? Hey, I run an app that limits your screen time and unlocks usage once you complete your goals. Love your content and would love to sponsor you. Let me know if you're interested.\\\"\"}\n{\"text\": \"That is the whole thing. They will not read a mile long pitch explaining every feature. They will respond to a short one that promises payment.\"}\n{\"text\": \"15. Distribution 4: Closing the Deal on the Phone\"}\n{\"text\": \"The single most important rule of profitable deals: get off DMs and onto the phone as fast as humanly possible. Influencer marketing is roughly 90 percent sales, and negotiating is a thousand times easier when someone can feel your presence and hear your voice. Every DM you send should be quietly guiding them toward a call. DM as little as possible, and make every message push toward getting on the phone.\"}\n{\"text\": \"When a creator responds with \\\"tell me more,\\\" do not start dropping numbers. Say:\"}\n{\"text\": \"\\\"Absolutely, I'd love to hop on a quick call and walk you through the integration and how I see this working. Here's my number: (xxx-xxx-xxxx).\\\"\"}\n{\"text\": \"If they ask directly for a price, deflect it: \\\"Before we get into numbers, I'd love to show you what we want demonstrated in the video.\\\" Do not give a number unless they truly force you to. And if they try to hard close you over text with \\\"I'm busy, what's your offer,\\\" do not fall for it. Just say, \\\"No problem, hit me up when you're free.\\\" They want your money. You are the one paying them, not the other way around.\"}\n{\"text\": \"On the call:\"}\n{\"text\": \"Open warm and be hyper specific. Compliment an actual piece of their content. \\\"I loved your XYZ series.\\\" It proves you are a real fan, not mass blasting DMs, and it earns you a better rate. My single best example: I once spent ninety percent of a call just talking with a creator about both of us being Greek. By the end he did not want to say no to a friend, and we closed at a $2 CPM.\"}\n{\"text\": \"Explain the integration. Describe how the app will appear naturally inside their content. Share past examples and visual assets if you have them.\"}\n{\"text\": \"Then talk rates. Ask, \\\"What do you feel is a reasonable rate?\\\" Then anchor everything to value.\"}\n{\"text\": \"The math I run: take their average views, underestimate conservatively, and multiply by the number of videos. If they average 25K views and I want four posts, I project a conservative 100K total.\"}\n{\"text\": \"My clean opening offer:\"}\n{\"text\": \"A flat rate in the $2 to $3 CPM range, so something like $250 for four videos\"}\n{\"text\": \"A minimum view guarantee of 100K, set low enough that they are confident they will clear it\"}\n{\"text\": \"20 to 50 percent up front, the rest once the videos are done and the guarantee is met. If they fall short, let them keep posting until they hit it.\"}\n{\"text\": \"If they push back on the price, the strongest move is to reframe the flat fee as a chance to bet on themselves with a CPM deal. Do not lead with CPM, or it feels like you are baiting them into commission, which most creators will refuse. Let them crack the door first:\"}\n{\"text\": \"Influencer: \\\"I think $350 for four videos is too low for me. Any way you can come higher?\\\"Me: \\\"I really have to stay in the $2 to $3 CPM range to be profitable. What I could do is pay you $3 per thousand views, so if four videos do 200K total, that's $600. There would just have to be a cap of $500 per video so one viral hit doesn't wipe me out.\\\"\"}\n{\"text\": \"In one move I shifted their frame from \\\"$350 for four videos\\\" to \\\"potentially $2,000 for four videos,\\\" while actually locking in a nearly risk free deal, because I stay profitable in that CPM range. And there is a second layer: if you pay weekly on recurring posts, your effective CPM quietly drops, because the views keep climbing for two months while you only paid for the first seven days. I track views for seven days max, then stop, and I am honest about why: \\\"I can't track this forever, my books would be a mess.\\\" Set a weekly payday, like every Sunday, and your floor revenue rises every single week.\"}\n{\"text\": \"After you present the offer, stop talking. Silence is your friend. You are the buyer. They need the sponsor as much as you need the promotion.\"}\n{\"text\": \"The two objections you will hear most, and how I handle them:\"}\n{\"text\": \"\\\"XYZ brand paid me thousands for a post.\\\" I respond with one question: \\\"Are you still working with them?\\\" Almost always the answer is no. Big brands overpay for one off brand awareness, the post underperforms because it feels like an ad, and they never come back. That answer opens the door for me to pitch a real long term partnership instead.\"}\n{\"text\": \"\\\"Sponsored content hurts my engagement, so I won't do a view guarantee.\\\" I respond: \\\"That's exactly why we don't want a typical ad. We want a subtle integration into content that already performs well. Our best results come when it looks authentic and people naturally comment about the app. In fact, a lot of our promos beat the creator's average video because people comment about the app.\\\" I only add that last line when it is actually true.\"}\n{\"text\": \"On every call I hammer two themes: I am only interested in long term partnerships, and I am genuinely passionate about what I am building. The first matters because recurring posts raise my floor revenue weekly and make growth predictable, and because most creators have done one off deals but never had a consistent way to monetize. The second matters because passion is contagious. People mirror your enthusiasm, and people follow missions. They love working for a company they believe is out to build the best experience for its customer.\"}\n{\"text\": \"Then I invest in the relationship. I pay attention to my creators' lives. If one of my fighters has a fight coming up, I text them \\\"good luck.\\\" I try to be genuinely close with all of them, because that relationship is what earns me the homie discount. After every call I move them to WhatsApp, which keeps my influencer and VA conversations cleanly separated from my personal texts, so I never miss a message from my family or, just as importantly, precious UX feedback from my mom. Then I get them on a simple contract, and the rest is just having them subtly integrate the app into their content.\"}\n{\"text\": \"16. Distribution 5: Creatives That Don't Feel Like Ads\"}\n{\"text\": \"The content should feel like the influencer genuinely uses your app, not like a paid spot. The core principle: the influencer is the hero, and your app is just a tool in their hand. They are not promoting it, they are using it.\"}\n{\"text\": \"How I make content feel real:\"}\n{\"text\": \"Study their last roughly 20 posts. Note what actually performs: their tone, humor style, editing pace, and emotional vibe.\"}\n{\"text\": \"Use their best format. If they crush \\\"day in the life,\\\" I put the app there. If \\\"routine\\\" videos are their thing, I use those. I never force a new style on a creator who already knows what works for their audience.\"}\n{\"text\": \"Make the app a moment, not the topic. It shows up naturally while they are doing something, never as a standalone pitch.\"}\n{\"text\": \"Keep their voice. Same language, same energy, same personality, just with the app dropped into their real life.\"}\n{\"text\": \"Here is how the same app plugs into every major content format, so you can match whichever one already performs for a given creator:\"}\n{\"text\": \"Day in the life: the app appears as a natural part of their daily actions, like during morning planning or while solving a problem. This format is gold because it makes the app feel real and subconsciously links it to productive, disciplined people. The viewer absorbs the idea that productive people use your app, or that your app makes people productive.\"}\n{\"text\": \"Routine videos: the app becomes part of a habit. \\\"Every night I do this\\\" or \\\"I always check this before training.\\\"\"}\n{\"text\": \"Educational or tip based: the app becomes a recommended tool. \\\"One thing that really helps me stay on track is this.\\\"\"}\n{\"text\": \"Comedy or skit: the app as a prop or the punchline. \\\"I physically can't open my phone until I finish my task, look.\\\" Do not be afraid to poke fun at your own product in good fun.\"}\n{\"text\": \"Before and after or progress: the app is the quiet reason behind the improvement, not the focus. \\\"Using this consistently helped me change X.\\\"\"}\n{\"text\": \"Motivational or storytelling: the app supports their personal growth story. \\\"I used to struggle with this, so I started using this tool.\\\"\"}\n{\"text\": \"Q&A or replying to comments: the app is the answer to a viewer's question. \\\"People always ask how I stay focused, here's what I use.\\\"\"}\n{\"text\": \"A real case study. One of my best performing videos cost $70 and generated close to $3,000. It was not even optimized. It featured two products, and my app did not even appear until around the thirty second mark. It still crushed, purely because the gotcha moment so clearly showed what the app did, and the creator made both products feel like natural parts of his day instead of interruptions.\"}\n{\"text\": \"One of my favorite early creators was a kid named Cory Zader. I paid him about $400 for six videos, and his very first one converted nearly $5K in sales. That is the power of the right creator with the right integration of the right gotcha moment.\"}\n{\"text\": \"When the returns from a particular creator start dipping, that is your sign their audience is saturating. Have them push a secondary feature to chase another uptick, but remember the biggest lift always comes from the gotcha moment.\"}\n{\"text\": \"17. Distribution 6: Meme Pages, Organic, and Paid Ads\"}\n{\"text\": \"Meme and topic pages. This is one of the most cost effective ways to generate views. Have these pages repost your best performing content. Entertaining or funny content tied to your app works best. Do not pay more than about $50 per post, aiming for a CPM in the 50 cent to $1 range. The best meme pages have almost cult like communities built around them, which is exactly the kind of engaged audience you want.\"}\n{\"text\": \"Real case study: I paid a kickboxer $350 to film himself using the app, then reposted it on a meme page. That single collaboration helped take an app from $500 a month to $1,800 a month in one month. I was willing to lose money on it because a professional athlete using the app signaled legitimacy. We framed it as a news headline to make it feel less like an ad, and viewers immediately called it out as sponsored in the comments. They meant it as criticism, but all that commenting drove engagement, and it became the most viewed reel on that page that month. The usual rule is content should not feel like an ad. The exception is that every rule in marketing can be broken when engagement is the result.\"}\n{\"text\": \"Organic content. This is a powerful way to validate your idea and to test whether your gotcha moment actually grabs people. If your core feature is strong, you should be able to pull real views just by demonstrating it. A pre launch tactic that worked well for me: post a demo with a caption like \\\"comment BETA to get early access.\\\" The comments both build a waitlist and prove the gotcha moment is compelling enough to make people act. A slightly dramatic tone and a strong hook help, and authenticity matters more than production value. I will be honest, I am personally not the best at creating this style of content myself. What I am great at is directing influencers on exactly what to post. With every marketing channel, play to your own strengths and your app's strengths. Just know organic can be inconsistent in performance, and done well it can build an almost cult like following for free.\"}\n{\"text\": \"Paid ads. I only recently started running these, and I am falling in love with them, because I now understand why people say influencers are not scalable past a certain point. Influencers are unbeatable when you have a small budget and need to 10x your money. But paid ads will reliably 2 to 3x your money at far greater scale. Two ways I run them:\"}\n{\"text\": \"If you work with several creators, pull 5 to 15 quality creatives, drop them all into a testing campaign at around $100 a day, and after the first week separate the winners from the losers.\"}\n{\"text\": \"If you do not have a stable of creators, pick one cheap, high agency creator and have them make ads for you instead of posting on their own page. One of my newer projects has grown entirely on paid ads, with a single high agency creator making all our creatives.\"}\n{\"text\": \"To find winning ad angles, go to the Meta Ads Library. Look up a competitor or an adjacent app. If you are building a running app, look up Strava. Filter by high impressions, because the ads with the most impressions and the most spend are the ones making money, since nobody keeps paying for an ad that does not return. For each one, ask two questions: why does this work, and how can I replicate it? Then hand the winner to your high agency creator and say, \\\"remake this one to one with my app.\\\" You will be shocked how often the highest earning ad is just someone authentically saying \\\"go download this app.\\\" Paid ads do not need to be polished, high production content. As long as it is real and authentic, it converts.\"}\n{\"text\": \"18. After They Post: How to Milk Every Video\"}\n{\"text\": \"Getting the video posted is not the finish line. There is a whole layer of work after publication that most people skip, and it is free money.\"}\n{\"text\": \"Moderate your analytics. A good deal should be profitable within one to three days depending on your trial length. Watch it closely so you know fast whether that creator is a keeper or a one off.\"}\n{\"text\": \"Plant comments. Have a couple of friends drop a natural question about the app in the comments, like \\\"wait what app is that?\\\" When people see others curious about your product, they get curious too. Social proof compounds.\"}\n{\"text\": \"Comment from the company account. This turns the influencer's comment section into a second funnel. A viewer watches the influencer's post, clicks into the comments, sees your brand account, gets curious, clicks over to your page, watches a few of your videos, and now they are a primed and educated user who downloads the app. Even someone who was not ready to convert off the single video gets pulled deeper into your funnel. One post becomes a whole chain of touchpoints.\"}\n{\"text\": \"That is the difference between treating a paid post as a lottery ticket and treating it as the top of a funnel you control.\"}\n{\"text\": \"19. The Launch: Pre-Orders and Hitting the Charts\"}\n{\"text\": \"How you launch matters, because a strong launch can put you on the App Store charts, and charting gets you organic downloads on top of everything you paid for.\"}\n{\"text\": \"One option, if you have a launch creator lined up, is to set up a pre-order and have them hype it up throughout the week leading in. It is not required, plenty of apps launch fine without it, but it can be a nice boost. When the app goes live, all those pre-orders convert at once, which spikes you up the charts. When we launched Wrestle AI this way, we hit number 18 on the App Store on day one, purely off my co-founder's influence, and we were beating out the NFL app at one point. We had around 4,000 pre-orders waiting.\"}\n{\"text\": \"Let me tell you how that night actually went, because it is the most important lesson I have. About thirty minutes before Wrestle AI went live at midnight, the API the entire app depended on went completely down. My app was broken at the exact moment thousands of people were about to download it. People in Japan were already subscribing and immediately refunding because nothing worked. I felt as defeated as I have ever felt. I stayed up the entire night working on it, got it fixed around 5am, hit launch, and went to sleep. I woke up that afternoon to find we were number 19 on the App Store and had already made over a thousand dollars, with our Instagram flooded with comments saying how cool the app was.\"}\n{\"text\": \"The lesson: do not complain about having too much on your plate when you prayed to eat. Existence is a pleasure, and the hard part is the fun part. Launches will break. Push through anyway.\"}\n{\"text\": \"20. Read Your Numbers, Then Fix the Leaks\"}\n{\"text\": \"Once you are consistently pulling real traffic, say 100 or more downloads a day, you finally have enough signal to optimize properly. Three numbers matter most.\"}\n{\"text\": \"Conversion rate. Where exactly are people dropping in your onboarding or at your paywall? Once you have rough metrics, start A/B testing your onboarding length and your pricing to lift it.\"}\n{\"text\": \"ARPU, or revenue per download. Aim for at least a $2 ARPU in month one. The number shifts with how you market. If you run top of funnel UGC, the girl on screen with text overlay style that pulls millions of views, your ARPU will be lower because the content quality and intent are lower. If you run real influencer posts that clearly explain what the app does, your ARPU should be much higher because that content converts higher.\"}\n{\"text\": \"Retention. As your first month closes, watch how many people unsubscribe. If retention is bad, it is almost always because your app simply is not useful enough yet.\"}\n{\"text\": \"Here is the most important growth lesson hiding inside retention, and it comes straight from my own data. Wrestle AI's retention sucked in the first month. The viral feature pulled people in, but they left. So we added something boring but genuinely useful: a calorie tracker, because wrestlers are constantly cutting and managing weight. Churn got cut in half. People came for the viral feature and stayed because the app was actually helping them with their weight. So we kept layering in strictly useful, non viral features, and that solved the retention problem entirely. We even revamped that calorie tracker into something close to MyFitnessPal, with a nutrition database, a barcode scanner, and a photo based calorie estimate, at half the price of the competition.\"}\n{\"text\": \"That is the whole formula in one line. The viral feature acquires, the useful features retain. Pull people in with the Purple Cow, then keep them with the everyday utility. Do not be afraid to hook them with something fun and unique, then hold them with the practical stuff they need every day.\"}\n{\"text\": \"21. Proof That Anyone Can Do This\"}\n{\"text\": \"I know the reaction a lot of people have to all of this is \\\"sure, but that only worked for you.\\\" So let me give you the counterexamples.\"}\n{\"text\": \"Fight AI was my very first app, built with zero app experience. I made it as an internal tool almost as a joke, posted myself talking to the camera about it, paid a meme page fifty bucks, and it did nearly $2,000 in its first month. It still does around $1,000 a month with no marketing since July. I love opening the dashboard and seeing some guy who has been subscribed for nine months and was active a week ago, and wondering what he is training for.\"}\n{\"text\": \"Then there are two kids, Christian and Braylin, who had a bit of a social following. I hit them up and told them they should build an app, walked them through exactly what I did with Wrestle AI, and gave them a free Rork subscription. They took it and ran, and now they are doing around $20K a month, all built in Rork, neither of them knowing how to code.\"}\n{\"text\": \"And the flywheel gets even better once your product is genuinely good. On my newer projects, creators have started reaching out to me. A creator with 20K followers, another with 1.8 million, both hitting me up first without me ever messaging them. One creator with 50K followers made videos for us for free just because he wanted to try the app. Another with three million followers, who averages 400K to a million views per video, did a four video, four story deal for $2,500, which is roughly a $1 CPM. You only get rates and inbound like that when the product is actually cool. Build something great and the entire distribution problem gets dramatically easier.\"}\n{\"text\": \"If you can find where your ideal customer spends their time, build something genuinely interesting for them, and put it in front of them, you will make money. That is the whole thing.\"}\n{\"text\": \"22. The Mindset That Ties It All Together\"}\n{\"text\": \"A few things matter more than any single tactic.\"}\n{\"text\": \"Learn to sell. My ability to close influencers came directly from doing door to door power washing sales and running garage sales when I was sixteen. If you have decent social skills, selling to creators becomes ten times easier, because you can build real rapport before you ever talk numbers. Funny enough, this is exactly why vibe coding is such an unlock, because the people who used to build apps often did not have the strongest social skills, and now the person with the relationships and the taste can build the product too.\"}\n{\"text\": \"It is a numbers game that compounds. More DMs, more creatives, more tests. Most of the work is just volume done consistently over time, and the results follow.\"}\n{\"text\": \"Now is the window. In my opinion, this is the drop shipping boom and the ecom boom of our era. Despite all the online noise, the space is nowhere near saturated. You get caught in a Twitter bubble where it feels like everyone is building an app. In reality, almost no one is. Most people still believe you need to know how to code, and most people do not even know vibe coding exists. Roughly 85 percent of the world does not even use AI yet, let alone realize it can build software. I can still post five TikToks about Fight AI, an app I have not touched since July, and get ten sales. The industry is wide open, and I do not think it gets truly saturated for a few more years. The best time to start was yesterday. The second best is today.\"}\n{\"text\": \"Have the discipline to reinvest. As the numbers grow, resist the urge to pull money out too early. Build the machine first.\"}\n{\"text\": \"Ignore the doubters. People love saying vibe coded apps cannot scale or are full of security holes. I have not hit a scalability wall, and on security, I simply do not collect sensitive personal data, so I am not exposing myself or my users to that risk in the first place. If you are building a straightforward consumer app, most of these fears do not apply to you. The doomer take on vibe coding is mostly wrong. With enough prompts and real attention to the product, you can build genuinely great things. It changed my life, and it can change yours.\"}\n{\"text\": \"23. Resources I'd Point You To\"}\n{\"text\": \"A few things worth studying as you build. These are the exact references I would send someone starting out.\"}\n{\"text\": \"Paywall design. Apphud has a strong breakdown of how to design high converting subscription paywalls. Good paywalls are built, not just designed.\"}\n{\"text\": \"Onboarding to model. Study the Cal AI onboarding flow closely, screen by screen. It is one of the best converting flows out there and worth copying the structure of. Userpilot also has a solid collection of onboarding UX examples.\"}\n{\"text\": \"ASO, or App Store Optimization. Apptweak has a good beginner guide. Your store listing is part of your funnel, so do not ignore it.\"}\n{\"text\": \"The power of influencers. There is a widely cited Forbes piece on how a large share of Gen Z trusts creators on TikTok more than traditional authorities. That trust is exactly what you are renting when you sponsor the right creator.\"}\n{\"text\": \"Beyond that, the single best study habit you can build is downloading successful apps in your space and picking them apart. Study their gotcha moment, their onboarding, their paywall, their pricing, and their creator content. Everything you need to reverse engineer is already live on the App Store and already scrolling past on your For You page.\"}\n{\"text\": \"24. Start Today\"}\n{\"text\": \"You now have everything I know, the same playbook I used to make over $300K, do $52K in the last 28 days, and scale two apps to $20K and $25K a month, all on top of the Wrestle AI foundation that did $160K in its first six months:\"}\n{\"text\": \"Find a frequent, frustrating, niche problem you actually care about, and make sure it is a Purple Cow.\"}\n{\"text\": \"Reverse engineer the viral video first, then build one unmissable gotcha moment around it.\"}\n{\"text\": \"Ship it fast with AI, no code required, prompting until every screen is right.\"}\n{\"text\": \"Make the UX so simple your mom could use it.\"}\n{\"text\": \"Build onboarding that educates, personalizes, creates FOMO, and locks the payoff behind the paywall.\"}\n{\"text\": \"Price for annual cash flow: $9.99 a month, $59.99 a year, trial on the yearly only.\"}\n{\"text\": \"Set up a credible brand page, engineer your feed, and reach out at volume.\"}\n{\"text\": \"Get creators on the phone, close at a $2 to $3 CPM, and treat them like long term partners.\"}\n{\"text\": \"Make content that feels real, milk every post, then layer in meme pages, organic, and paid ads.\"}\n{\"text\": \"Launch (optionally with pre-orders to hit the charts), then read your conversion, ARPU, and retention and plug the leaks.\"}\n{\"text\": \"$10K a month is $333 a day, and it is one or two of these things done well and compounded over time. The hardest part is not the building or the marketing. It is just getting on the phone and starting. So stop planning. Go build.\\n\"}\n{\"text\": \"25. Want to Work With Me Directly?\"}\n{\"text\": \"If you have read this far, you are serious about this, and I am happy to help you move faster. If you want to talk through your specific app for an hour, you can book a call and we will get into exactly where you are and what to do next. And if you want ongoing support, I take on a small number of people as an advisor. That means two calls a week with me, plus access to all my internal docs and the same training tools I use to run my own apps. If either one sounds like what you need, use the link below to work with me 👇\\n\\nhttps://georgelampropoulos.com/\"}\n{\"text\": \"https://georgelampropoulos.com/\"}\n{\"url\": \"https://abs.twimg.com/emoji/v2/svg/1f447.svg\"}\n{\"description\": \"100k+ downloads through apps built with Rork.\\n\\nBook a call with me 1-1 👇\", \"name\": \"George Lampropoulos\", \"url\": \"https://x.com/GeorgeLampro20\"}\n{\"text\": \"100k+ downloads through apps built with Rork.\\n\\nBook a call with me 1-1 👇\"}\n{\"url\": \"https://georgelampropoulos.com/\"}\n{\"text\": \"I've spent the last month compiling everything I know about apps that took me from $0 to $50k a month. This is the Growth Playbook. https://t.co/IwoIHPJ4NI\"}\n{\"author\": {\"avatar_url\": \"https://pbs.twimg.com/profile_images/2034922434248548352/-O_MEWDQ_200x200.jpg\", \"banner_url\": \"https://pbs.twimg.com/profile_banners/1903578997981646848/1767495013\", \"description\": \"100k+ downloads through apps built with Rork.\\n\\nBook a call with me 1-1 👇\", \"followers\": 10305, \"following\": 473, \"id\": \"1903578997981646848\", \"joined\": \"Sat Mar 22 22:46:22 +0000 2025\", \"likes\": 1263, \"location\": \"\", \"media_count\": 245, \"name\": \"George Lampropoulos\", \"protected\": false, \"raw_description\": {\"facets\": [], \"text\": \"100k+ downloads through apps built with Rork.\\n\\nBook a call with me 1-1 👇\"}, \"screen_name\": \"GeorgeLampro20\", \"statuses\": 2498, \"type\": \"profile\", \"url\": \"https://x.com/GeorgeLampro20\", \"verification\": {\"type\": \"individual\", \"verified\": true, \"verified_at\": null}, \"website\": {\"display_url\": \"georgelampropoulos.com\", \"url\": \"https://georgelampropoulos.com/\"}}, \"created_at\": \"Tue Jul 28 05:46:14 +0000 2026\", \"text\": \"I've spent the last month compiling everything I know about apps that took me from $0 to $50k a month. This is the Growth Playbook.\", \"url\": \"https://x.com/GeorgeLampro20/status/2081979523873038368\"}\n{\"content\": {\"blocks\": [], \"entityMap\": []}, \"created_at\": \"1970-01-01T00:00:00.000Z\", \"title\": \"How to go from 0-10k a month in under 30 days (I've done this 3 times)\"}\n{\"description\": \"100k+ downloads through apps built with Rork.\\n\\nBook a call with me 1-1 👇\", \"name\": \"George Lampropoulos\", \"url\": \"https://x.com/GeorgeLampro20\"}\n{\"text\": \"100k+ downloads through apps built with Rork.\\n\\nBook a call with me 1-1 👇\"}\n{\"url\": \"https://georgelampropoulos.com/\"}\n{\"text\": \"I've spent the last month compiling everything I know about apps that took me from $0 to $50k a month. This is the Growth Playbook. https://t.co/IwoIHPJ4NI\"}\n\n### /Users/anicca/anicca/skills/earn/marketing-engine/evidence/intel/pulls/68f5220fe826411ab0d41408bda1f09e/apple.competitors-affirmation-us.json\n{\"canonical_url\": \"https://itunes.apple.com/search\", \"source_id\": \"apple.competitors-affirmation-us\"}\n{\"averageUserRating\": 4.83804, \"description\": \"How many negative thoughts have been endlessly repeating in your mind? Daily affirmations help rewire our brains, build self-esteem, and change negative thought patterns. Empower yourself by verbally affirming your dreams and ambitions. Choose from many daily intentions and set reminders to be delivered throughout the day.\\n\\nPositive affirmations help make major shifts in your mindset, and they also serve as prompts and daily reminders about what you’re truly capable of, ensuring every day is an amazing day\\n\\nAn affirmation is a simple but powerful statement that helps to strengthen the connection between your conscious and unconscious mind. The more you strengthen this connection, the more resilient you’ll be when you experience difficult or challenging circumstances.\\n\\nAs Buddha wisely said: you become what you believe. And the best way to strengthen your resilience is to practice affirmations every single day.\\n\\n\\nThere are many benefits to using affirmations as part of your daily morning routine:\\n\\n\\n- They help increase your awareness of your thoughts and words, making it easier to recognize the negative and self-doubting thought patterns holding you back.\\n- Affirmations define your focus. When you focus your energy on the things you want, like achieving your goals, the positive, uplifting, and good, you’re creating an abundance mindset and strengthening your resolve to make it happen.\\n- They open you up to possibility. Too often we get stuck in the ‘impossible’ mindset, but affirmations flip this on its head. When you begin to positively affirm what is actually possible, a whole world of opportunity opens up to you.\\n\\nTo get access to the I am Premium content and functionality, you can choose between a lifetime, monthly, and yearly auto-renewable subscription. This is a recurring transaction that will be charged to your iTunes Account at confirmation of purchase and will automatically renew unless you cancel it at least 24 hours before the end of your subscription. Renewals will be charged at the same cost within 24 hours prior to the end of the current period. You can manage your subscriptions and auto-renewal can be turned off by going to your iTunes Account Settings after purchase.\\n\\n\\nFind tons of inspiring content on our blog: https://blog.theiam.app/\\n\\nPrivacy Policy: https://monkeytaps.net/privacy\\n\\nTerms of use: https://monkeytaps.net/terms\", \"releaseNotes\": \"- New themes and tons of new affirmations!\\n- Other fixes and improvements\\n\\nFind tons of inspiring content on our blog: https://blog.theiam.app/\\n\\nLove the app? Tell us in the reviews section! We read all of them. Have a happy day!\", \"trackName\": \"I am - Daily Affirmations\", \"trackViewUrl\": \"https://apps.apple.com/us/app/i-am-daily-affirmations/id874656917?uo=4\"}\n{\"averageUserRating\": 4.82826, \"description\": \"Whether you're going through hard times, need an extra push to get stuff done, or like sharing inspirational quotes on social media, Motivation has you covered.\\n\\nPositive reminders are one of the simplest and most powerful tools for mental growth. It’s all about keeping the right thoughts top of mind from the get-go every day, so they’re readily available on those hard days when you need them most.\\n\\nNow, from iOS 14, you can think positive thoughts without even trying with the Motivation widget! Simply install the widget in your home screen and customize it from the app. You can have as many widgets as you want!\\n\\nCustomize the design of the quotes and share the uplifting message of the day with your friends, or use the image for Instagram or as a wallpaper.\\n\\nThe app includes a wide range of topics such as self-esteem, relationships, and dealing with stress, as well as a selection of carefully designed themes to choose from - updated frequently.\\n\\n+ Read through Hundreds of Quotes\\n+ Find Motivational Books\\n+ Save or Share your Quotes\\n+ Set Motivational Reminders throughout the Day\\n+ Save your Favorite Quotes\\n+ Change Font and Colors\\n+ Filter Quotes by Category\\n+ Set a Home Screen Motivation Widget\\n\\nFrom quotes about working out to love and family quotes, Motivation has them all! Browse thousands of quotes organized by category:\\n\\n\\n- Motivation to work harder\\n- Love quotes\\n- Motivation to train and work out\\n- Help for depression\\n- Boost your self-esteem and self-confidence\\n- Get over a break up\\n- Life lessons and sayings\\n- Sports quotes from athletes and trainers\\n- Business, money, success, and career\\n- Being present and mindful\\n- Quotes from and for women\\n- Philosophy from the best minds\\n- Quotes to be thankful for what you got\\n- Inspirations for joy\\n- Quotes from movies\\n- Verses from the Bible\\n- And much more!\\n\\nAnd now with Motivation Premium you can:\\n\\n\\n+ Remove ads\\n+ Unlock all themes and categories\\n+ Set background photo\\n+ Get unlimited reminders\\n+ Search quotes\\n\\nTo get access to the Motivation Premium content and functionality, you can choose between a lifetime, monthly, and yearly auto-renewable subscription. This is a recurring transaction that will be charged to your iTunes Account at confirmation of purchase and will automatically renew unless you cancel it at least 24 hours before the end of your subscription. Renewals will be charged at the same cost within 24 hours prior to the end of the current period. You can manage your subscriptions and auto-renewal can be turned off by going to your iTunes Account Settings after purchase.\\n\\n\\nFind tons of inspiring content on our blog: https://blog.motivation.app/\\n\\nPrivacy Policy: https://monkeytaps.net/privacy\\n\\nTerms of use: https://monkeytaps.net/terms\", \"releaseNotes\": \"- New themes and tons of new quotes!\\n- Other fixes and improvements\\n\\nFind tons of inspiring content on our blog: https://blog.motivation.app/\\n\\nLove the app? Tell us in the reviews section! We read all of them. Have a happy day!\", \"trackName\": \"Motivation - Daily quotes\", \"trackViewUrl\": \"https://apps.apple.com/us/app/motivation-daily-quotes/id876080126?uo=4\"}\n{\"averageUserRating\": 4.8381, \"description\": \"Our brains are wired to repeat negative feelings if fed with negative thoughts. Luckily the same goes for the positive side. Daily affirmations help us rewire our brains and fix these negative patterns. \\n\\n“If you practice saying positive things in non-stressful situations, it has been found that you can change your brain’s reactions” - Caroline Miller \\n\\nAffirmations are simple yet powerful statements that help us validate our core values. The latest researches indicate that practicing positive mantras and daily affirmations decreases stress, improves performance on challenging duties, builds self-esteem, and overall, makes us happier. As a result; we feel better, make healthier decisions, and live a happier life. Now, unleash your subconscious mind’s power and take your first step in the world of affirmations with Mantra.\\n\\nAll the affirmations inside our app are constantly updated. Instructions are clear: Think positive and hold down the button! Your affirmation will glow and you will light up! Give it a try and observe how you start your days in a better mood! Besides your daily affirmations, you can always read as many affirmations as you like by simply swiping.\\n\\nHere is what you will get with our application:\\n• Affirmations for any situation from 30+ different categories and topics.\\n• More than a thousand \\\"I am\\\" affirmations\\n• Smart daytime and bedtime affirmation reminders (as push notifications)\\n• Uniquely new daily affirmations\\n• Practice as many affirmations as you want\\n• Create your own collections of affirmations \\n• Add your own affirmations if you can’t find what you’re looking for\\n• Record your voice and listen on repeat\\n• Manifestation sessions and guided affirmation sessions\\n• Personalize your theme with hundreds of cherry-picked background images, videos and fonts\\n• Ambient sounds that uplift you\\n• Share your daily affirmations to any platform in portrait or square mode\\n• Like your affirmations to see them anytime in your favorites\\n• And much, much more…\\n\\nIf you have any feedback please contact us via email: mantra@broftware.com  We will get back to you immediately :)   Love you!\\n\\n--\\n\\nPrivate Policy:\\nhttps://getmantra.app/privacy-policy\\n\\nTerms of Use:\\nhttps://getmantra.app/terms\", \"releaseNotes\": \"Keep nurturing your positive mindset with Mantra! \\n\\nIn this update, we’ve added many new affirmations and made some improvements to enhance your experience.\\n\\nIf you're enjoying the app, consider leaving a review for other people! Your reviews mean the world to us, and we read every single one.\\n\\nIf you encounter any issues, please email us at mantra@broftware.com. Your feedback is essential in helping us improve!\\n\\nThank you for making Mantra a part of your day.\", \"trackName\": \"Mantra - Daily Affirmations\", \"trackViewUrl\": \"https://apps.apple.com/us/app/mantra-daily-affirmations/id1202851636?uo=4\"}\n{\"averageUserRating\": 4.78521, \"description\": \"Unlock the Power of Affirmations with Our App!\\n\\nTransform your life one positive thought at a time. The Affirmations App helps you harness your inner strength, align with your desires, and create the life you’ve always dreamed of. Whether you’re looking to attract MONEY, improve your SLEEP, or foster a deeper SPIRITUAL connection, this app is your ultimate guide to manifesting positivity and success.\\n\\nWhy Use Affirmations?\\nAffirmations are more than just words—they are powerful declarations of what you want to create in life. By practicing daily affirmations, you can reprogram your mind, overcome negativity, and achieve your goals. Whether you’re seeking financial abundance, a BIBLICAL perspective, or a more POSITIVE mindset, affirmations offer a proven way to transform your thoughts into actions.\\n\\nHow It Works:\\n- Discover Daily Affirmations: Choose from expertly curated categories like success, relationships, gratitude, and JOURNAL prompts for deeper reflection.\\n- Create Your Own: Be your own affirmation CREATOR and design personalized affirmations tailored to your unique journey.\\n- Build a Daily Routine: Use customizable tools like affirmation WIDGETS and a calming ALARM to keep your practice consistent.\\n- Features of the Affirmations App:\\n- A vast library of affirmations designed for success, money, and personal growth\\n- Custom JOURNAL for tracking affirmations and personal insights\\n- Beautiful WIDGET designs to keep affirmations visible throughout your day\\n- Calming ALARM tones to start and end your day with positivity\\n- Tools for crafting personalized affirmations as your own affirmation MAKER\\n\\nWhy Affirmations Work:\\nYour thoughts shape your reality. By focusing on POSITIVE affirmations daily, you can foster self-love, embrace abundance, and align your actions with your goals. Whether you’re connecting with BIBLICAL principles, improving SLEEP, or achieving financial success, affirmations are the key to living with purpose. This app helps you cultivate a mindset that supports both your SPIRITUAL and personal growth.\\n\\nLive Your Best Life: \\nThe Affirmations App is your gateway to mindfulness and intentional living. Whether you’re looking to attract MONEY, build confidence, or deepen your SPIRITUAL awareness, this app supports your growth every step of the way. Make affirmations a part of your daily routine, and watch as positivity transforms your life into the one you’ve always envisioned.\\n\\nDownload the Affirmations App today and become the CREATOR of your best self!\", \"releaseNotes\": \"- Brand new redesigned experience\\n- New iOS glass design for a modern look\\n- Improved widgets for your home screen\\n- Apple Watch experience upgraded\\n- Faster performance across the app\\n- Bug fixes and stability improvements\\n\\nThank you to everyone for all the great support! We are working very hard to get stuff done. In this update you'll find bug fixes, small improvements and performance enhancements. If you love Affirmations App, please rate us, it would really help! :)\", \"trackName\": \"Affirmations for You\", \"trackViewUrl\": \"https://apps.apple.com/us/app/affirmations-for-you/id1585586331?uo=4\"}\n{\"averageUserRating\": 4.88145, \"description\": \"The Gratitude app is a carefully-designed self-care tool to help you focus on your mental health.\\n\\nWith a gratitude journal, affirmations, vision board, and daily motivation content, Gratitude provides you with all the tools and reminders you need to gain motivation and develop a healthy self-love routine in your life. \\n \\nTo live a happy and fulfilling life, it is important for us to have good mental health and a strong sense of self-love.\\n\\nAnd, as the app is completely private, you can always be assured that your precious journal entries, affirmations, and vision board are for your eyes only.\\n\\nHere are the tools that you will find in the Gratitude app:\\n\\n1. GRATITUDE JOURNAL\\n\\nA gratitude journal or diary opens up your eyes to reflect on all the little blessings in your life.\\n\\nIn daily life, we can lose sight of what we are fortunate to have and by keeping a journal you can slowly and steadily shift your perspective to focus on what is good in your life.\\n\\nThe Gratitude app will send you reminders with prompts to help you build the habit of journaling.\\n\\nYou can also add photos to your journal entries and can record journals in your voice, build a gratitude journal streak, and access hundreds of journal prompts. \\n\\n2. POSITIVE AFFIRMATIONS\\n\\nIf you’ve heard about manifestation or the law of attraction, you’ve probably heard about affirmations.\\n\\nPositive daily affirmations change our self-talk to focus on more loving and kind thoughts towards ourselves.\\n\\nThey give us the motivation we need to keep moving forward and believe in ourselves.\\n\\nThe Gratitude app has hundreds of affirmations that you can listen to or read, as per your need.\\n\\nYou can also write your own affirmations, add music, and record your voice to them.\\n\\nPositive affirmations are a dearly loved tool and with this affirmations app, it is very easy for you to practice them.\\n\\n3. CREATE VISION BOARDS\\n\\nAnother super popular manifestation tool is a vision board, also called a dream board. The vision board serves as a collage of your dreams and goals in the form of photos, quotes, and affirmations.\\n\\nIn the Gratitude app, we’ll help you make a great vision board using sections, goal ideas, and create a video of all your goals together with music. You can also make multiple vision boards!\\n\\n4. DAILY ZEN\\n\\nWe understand the need for motivation and inspiration as you build a healthy routine with these self-help tools, which is why Daily Zen is an important part of the app.\\n\\nHere, you will find gratitude quotes, motivation quotes, thought switch ideas, thank you cards, affirmations, blog articles, and real-life stories of people who changed their mindset with gratitude.\\n\\n5. MINDFUL MINUTES\\n\\nWe define the Mindful minutes as the time that you spend in the Gratitude app. You can view the mindful minutes under 'All Health Data' section in the Health app provided by Apple. Currently, the app does not read any data from the health app. We don't write any data in the health app without your consent. You can turn on the mindful minutes from the profile & settings in the Gratitude app.\\n\\nPrivacy Policy: https://www.notion.so/Gratitude-App-Privacy-Policy-40195d1e9f51499c82dc8f7d06ab2a1c\\nTerms of Use: https://medium.com/@priteshsankhe/terms-and-conditions-c7a676f5d884\", \"releaseNotes\": \"Thank you for being part of the Gratitude community!\\nIn this update, we’ve focused on helping you stay consistent and improving overall stability:\\n\\n- Addressed an issue where Daily Zen posts could not be shared on Instagram\\n\\nLoving the app? Please consider leaving us a review - it helps more people discover Gratitude.\", \"trackName\": \"Gratitude: Self-Care Journal\", \"trackViewUrl\": \"https://apps.apple.com/us/app/gratitude-self-care-journal/id1372575227?uo=4\"}\n{\"averageUserRating\": 4.77431, \"description\": \"Stuck in negative thought loops? Self Love delivers daily affirmations, powerful I am statements, and gentle reminders exactly when you need them—so positivity is never out of reach.\\n\\nTransform your mindset with uplifting quotes on your lock screen, beautiful home-screen widgets, and themed backgrounds that make every affirmation feel personal. \\n\\nRead it. Speak it. Believe it.\\n\\nWHY SELF LOVE WORKS?\\n\\nDaily affirmations are more than quotes—they are small habits that reshape how you see yourself. With Self Love, you replace self-doubt with confidence, calm, and clarity one message at a time.\\n\\nDAILY AFFIRMATIONS & I AM STATEMENTS\\n\\n• Hundreds of affirmations for confidence, self-esteem, gratitude, and growth\\n• I am statements that strengthen a positive mindset\\n• New categories and quotes added regularly\\n• Save favorites and revisit the messages that resonate most\\n\\nREMINDERS THAT MEET YOU WHERE YOU ARE\\n\\n• Smart reminders deliver affirmations throughout your day\\n• Choose how often you want encouragement—morning, midday, or evening\\n• Turn your phone into a source of support, not stress\\n\\nWIDGETS & BEAUTIFUL THEMES\\n\\n• Home-screen widgets keep affirmations visible all day\\n• Stunning themes and backgrounds personalize your self-care routine\\n• A calm, uplifting design made for daily use\\n\\nEXPLORE CATEGORIES FOR EVERY MOOD\\n\\n• Confidence & self-belief\\n• Mental wellness & self-care\\n• Manifestation & abundance\\n• Stoic calm & mindfulness\\n• Seasonal inspiration (New Year, holidays, and more)\\n\\nMIRROR MODE & DAILY PRACTICES\\n\\n• Speak affirmations to yourself in Mirror Mode — a therapist-recommended technique\\n• Build your streak and stay consistent day after day\\n• Quick Story Style practices for deeper self-reflection\\n\\nBUILT FOR YOUR WHOLE DAY\\n\\n• iPhone & iPad\\n• Apple Watch affirmations on your wrist\\n• iMessage support\\n\\nSPEAK IT. BELIEVE IT. LIVE IT.\\n\\nMany users read each affirmation twice and speak it aloud twice—so the words sink in and become part of how you think. Small repetition. Real change.\\n\\nFREE TO START. PREMIUM WHEN YOU’RE READY\\n\\nDownload free and explore daily affirmations at your own pace. Upgrade to Premium to unlock the full library, themes, widgets, and reminders.\\n\\nSELF LOVE PREMIUM\\n\\n• Monthly and annual plans available\\n• Optional free trial on eligible subscriptions\\n• Payment charged to your Apple ID account\\n• Subscription renews automatically unless canceled at least 24 hours before the end of the current period\\n• Manage or cancel anytime in App Store account settings\\n\\nPrivacy Policy: http://ruruinfotech.com/PrivacyPolicy/im/imp.html\\nTerms of Use: http://ruruinfotech.com/PrivacyPolicy/im/imtou.html\\n\\nYour journey to self-love starts with one affirmation today. Download Self Love and feel the difference.\", \"releaseNotes\": \"Make every glance more uplifting with Affirmation Wallpapers!\\n\\n• Create personalized wallpapers with your favorite themes and affirmation categories.\\n• Automatically change your wallpaper using Apple Shortcuts.\\n• Discover hundreds of new affirmations across more self-growth categories.\\n• Enjoy beautiful new themes and additional customization options.\\n• Performance improvements, bug fixes, and overall app enhancements.\\n\\nEnjoying Self Love? Please leave a review on the App Store. We read every review and truly appreciate your support.\\n\\nThank you for growing with us.\", \"trackName\": \"Self Love - Daily Affirmations\", \"trackViewUrl\": \"https://apps.apple.com/us/app/self-love-daily-affirmations/id1591901241?uo=4\"}\n{\"averageUserRating\": 4.80975, \"description\": \"Daily affirmations app Miracle is one of the best affirmations apps for iPhone with widgets. Build motivation, shift your mindset, and bring more positivity into your day.\\n\\nUse daily affirmations and motivational quotes to push through challenges and stay focused on what you want. Miracle is an affirmations app for women built around daily affirmations for positivity and self-belief, designed to actually fit into your routine instead of just sitting on your home screen.\\n\\nKey Features:\\n• Daily Affirmations\\nStart each day with an affirmation matched to your goals. Whether you want daily affirmations for women, morning affirmations, or powerful daily affirmations, Miracle gives you words that support self-belief and a positive mindset from the moment you wake up.\\n\\n• Affirmation Practice, Your Voice and Your Pace\\nRun guided affirmation sessions the way you want. Choose the voice that reads your affirmations out loud, and set how long each step of the practice lasts. Slow and grounding before bed, or quick and focused before a meeting. Both work.\\n\\n• Adaptive Widgets\\nAdd adaptive widgets to your Home Screen. They adjust to your wallpaper and time of day, surfacing a fresh affirmation whenever you glance at your phone.\\n\\n• Lock Screen Widgets\\nSet an affirmation as your lock screen so a positive thought greets you every time you pick up your phone.\\n\\n• Ambient Sounds\\nAdd rain, sea, birds, night, and other ambient sounds. Use them during practice, or just as background while you read your affirmations.\\n\\n• Custom Fonts\\nChange the font your affirmations are written in. Find one that feels right to read.\\n\\n• Custom Backgrounds\\nPick a background from different categories to make the app look the way you want it to.\\n\\n• iOS 26 Alarms Integration\\nWake up to your affirmations. Miracle plugs into iOS 26 Alarms, so your morning practice begins the moment your alarm goes off, not as one more notification fighting for attention.\\n\\n• Customizable Reminders\\nSchedule reminders for the times that work for you. Morning affirmations to start the day, positive affirmations any time you need a reset. Our daily affirmations for women app keeps you consistent.\\n\\n• Positive Daily Affirmations Library\\nBrowse a full library of affirmations, sorted by category: positive affirmations for women, powerful daily affirmations, manifest affirmations, and more. Find the right words for the moment.\\n\\n• Save and Favorite\\nSave the affirmations that resonate to your personal collection in our free affirmations app. Build a library of daily affirmations for women, positive affirmation quotes, and favorites you come back to. You can also write your own.\\n\\n• Share the Positivity\\nSend your favorite affirmations to friends and family through social media, text, or email.\\n\\n• Clean, Simple Interface\\nEasy to navigate, easy to use. Open the app, get what you came for, move on with your day.\\n\\nLooking for the best affirmation app? Download Miracle now and start building the mindset you want.\\n\\nTerms of use: https://reshetnikoff.com/terms/\\nPrivacy policy: https://reshetnikoff.com/policy/\", \"releaseNotes\": \"- Practice reminder bug fix\", \"trackName\": \"Daily Affirmations & Widgets\", \"trackViewUrl\": \"https://apps.apple.com/us/app/daily-affirmations-widgets/id1671846678?uo=4\"}\n{\"averageUserRating\": 4.75122, \"description\": \"Inspirational and motivational quotes. Daily reminders to help you overcome adversity, persevere, achieve your goals, succeed. Start your day with a quote from our thoughtfully curated collection.\\n\\nDAILY QUOTE WALLPAPERS\\nMeaningful photography and typography, hand-picked, and carefully combined to make quotes more impactful.\\n\\nIMPORTANT: iPhone wallpapers are optimized for iPhone XS, iPhone XS Max, iPhone XR, iPhone X, iPhone 8 & iPhone 8 Plus, iPhone 7 & 7 Plus, iPhone 6s & 6s Plus!\\n\\nAUDIO QUOTES \\nHave quotes read aloud by Siri! From your lock screen! Get a “pick me up” whenever you need it with Audio Quotes.\\n\\nUse a phrase, such as “Motivate me”, “Inspire me”, “Activate positivity”. Choose from different categories:\\n\\n• The Quote of the Day\\n• Our Most Popular Quotes\\n• Inspirational Quotes\\n• Motivational Quotes\\n• Positive Mindset Quotes\\n• Success Quotes\\n\\nAudio Quotes require an in-app purchase. See below for more details.\\n\\nSIRI SHORTCUTS\\nIn addition to Audio Quotes, you can personalize and add Siri Shortcuts for most essential features.\\n\\nWhy should you download the Daily Quote app?\\n\\n• Downloaded and enjoyed by MILLIONS of people!\\n• Recognized as one of the \\\"favorite gadgets\\\" of former Girl Scouts CEO Anna Maria Chávez.\\n• Featured in Success Magazine article titled \\\"A New You: Reinvent yourself with these apps\\\"\\n\\nHere are just a couple reviews we're proud of (and truly humbled by):\\n\\nAmazing! by Sam.i.am\\nAmazing is only one word to describe this app. It always has meaningful quotes that really can push yourself to do better! I would definitely encourage people to get this app!\\n\\nWorks well by LolaBarbie\\nI had this app for about 3 years! Works well!\\n\\nDaily Inspiration by 123becky\\nLove seeing my DailyQuote. They put hope for the day and motivate me with a positive attitude in facing each new day. Especially since I am handicapped living in pain every day. So I do look forward to my daily inspiration.\\n\\nIt's simple but helpful! by NickiBYU\\nI've had this app for over a year now and it's been great. No kinks or anything just a simple quote every morning to remind me of important ways to be that help me throughout the day. I love it!\\n\\nFEATURES\\nOur goal is to provide motivational and inspirational quotes each day. \\n\\n• Set reminders to view your daily quote\\n• Save your favorite quotes\\n• Add hashtags to your favorite quotes so you can easily find them later\\n• Add quotes\\n• Set a custom background photo, or choose from our free collection\\n• Browse a mix of quotes from our collection\\n\\nCreate And Share\\n• Create quote wallpapers for uses as backgrounds and lock screen wallpapers\\n• Customize font size, font color, and layout, before saving or sharing \\n• Add emoji or add additional text to quotes\\n• Select from custom background photos and background colors\\n• Easily share quotes on Instagram\\n\\n\\\"Create And Share\\\" requires our companion app, QWP, which is also available as a free download. \\n\\nPREMIUM FEATURES\\n• Audio Quotes\\n• Quote Search\\n• Ad-free usage\\n\\nDaily Quote is free to download and use. We also have premium features that require an in-app purchase. You can choose a single, one-time purchase, for lifetime access. Or you can purchase a yearly, or monthly, auto-renewing subscription. \\n\\nIf you choose to subscribe, your subscription will automatically renew and charge your credit card through your iTunes account. You can turn off auto-renew at any time from your iTunes account settings. Payment will be charged to iTunes Account at confirmation of purchase. Subscription automatically renews unless auto-renew is turned off at least 24-hours before the end of the current period. Any unused portion of a free trial period will be forfeited after purchase.\\n\\nDailyQuote privacy policy: http://dailyqotd.com/privacy\\n\\nDailyQuote terms of use: http://dailyqotd.com/user-agreement\\n\\nWe're grateful for your continuous support. If you have any questions or suggestions on how we can improve the app, please do not hesitate to contact us at http://dailyqotd.com/feedback\", \"releaseNotes\": \"Stability improvements and bug fixes. Fixed bug where notification is not sent at set time.\\n\\nThoughts or feedback? Please leave a review here on the App Store or contact me at http://dailyquoteapp.com/feedback\", \"trackName\": \"Daily Quote - Positive quotes\", \"trackViewUrl\": \"https://apps.apple.com/us/app/daily-quote-positive-quotes/id586028606?uo=4\"}\n{\"averageUserRating\": 4.76656, \"description\": \"Unique Daily Affirmations is a free creative affirmation tool that helps you succeed in your endeavors, bring you out from under the clouds, and make positive changes in your life. Through uplifting statements and quotes, you'll believe in yourself with these one-a-day affirmations for daily motivation.\\n\\nHold down the large gray button to reveal your daily affirmation and effectively use the app by repeating the statement out loud.  Saying the affirmation in front of a mirror is even better. It's been scientifically proven that the more stimuli your mind has, the more your mind will retain the information.  By vocalizing in front of a mirror, you stimulate sight and sound.  Envision your personal success.\\n\\nLet these positive declarations become truth in your subconscious mind as you think about it throughout the day.\\n\\nGive us some feedback in the app if you have suggestions or problems.  We really doubt you'll need this though;  just look at all the raving reviews:\\n\\n\\\"Missing one important thing - I think this app is neat but I believe the real power of daily affirmations is when you repeat the same affirmations day after day. A new one every day kind of loses its power because you should be repeating the ones that are important to you so that they eventually become ingrained and change your way of thinking. So, a favorites list would be the perfect solution! If a daily affirmation pops up that you really want to stay with you, add to your favorites and go to your favorites list and read through them everyday. ...\\\" - Tag477543\\n\\nExcellent affirmations\\nThis app provides excellent affirmations to start your day. Every day a new affirmation is generated in which you can use and apply it to your life. I have been using it for a couple of months and it definitely helps start my day to a positive start. I highly recommend it!!\\n-Oceanblue27\\n\\nFantastic\\nI love this affirmations app, it's really practical, it's not just a bunch of quotes like some affirmations apps I've seen. :) well done!\\n-Ladyredfearn\\n\\nHighly recommend this app. - I love this app. The affirmation statements are great and not convoluted. I love the hold button and the slow revealing of the affirmation. Gives you that moment to slow your mind and focus on the moment and truly take in the affirmation.\\n- Hkygal\\n\\nINSTRUCTIONS\\nPress and hold the large gray button to reveal today's affirmation.\\n\\nTap the bottom left icon for options on sharing, saving or skipping the affirmation.  You can SHARE, SAVE, or VIEW the affirmation.\\n\\nWhen viewing your list of Favorite affirmations you can swipe left to delete an affirmation.  Tapping on a specific affirmation will let you view it.\\n\\nTo add your own affirmations, tap on the bottom left icon then tap on \\\"Add Your Own\\\".  Any affirmation you add will appear in your favorites list.\\n\\nTo record yourself saying an affirmation, tap the top right REC icon and then on the red button to start recording.  You can save one recording per affirmation.\\n\\nTo add your own backgrounds, tap on the bottom right icon,  then tap on \\\"My Backgrounds\\\".  Any background here will appear in one of your daily affirmations unless you set one as your current.\\n\\nALL ACCESS\\nWhen you subscribe to \\\"All Access\\\":\\n - Ads are removed (even if you decide to cancel)\\n - Set up email notifications of your favorites\\n - No limits* on Phone Alerts\\n - No limits on the number of recordings\\n - No limits on the number of backgrounds\\n - Set the daily affirmation as a Phone Alert\\n - Set a background and font for each favorite\\n\\n* Notifications are limited to device limits.\\n\\n“All Access” is a monthly subscription that automatically renews at the same cost as the first month.  Payment is charged to iTunes Account at confirmation of purchase.  Account will be charged for renewal within 24-hours prior to the end of the current period.  Turn off auto-renew at any time from your iTunes Account settings.\\n\\nTERMS & PRIVACY POLICY\\nhttps://gopherapps.com/terms/\", \"releaseNotes\": \"• Improved automatic text color on background photos — light and dark text is now chosen from the area directly behind your quote, so affirmations stay readable on tricky images.\\n• Widget backgrounds now get the same automatic text color treatment.\\n• Fixed favorites and custom quote lists not refreshing after deleting or clearing quotes.\\n• Cleaned up the Unsplash photo picker layout.\", \"trackName\": \"Unique Daily Affirmations\", \"trackViewUrl\": \"https://apps.apple.com/us/app/unique-daily-affirmations/id418693319?uo=4\"}\n\n### /Users/anicca/anicca/skills/earn/marketing-engine/evidence/intel/pulls/68f5220fe826411ab0d41408bda1f09e/rss.aso-skills-commits.json\n{\"canonical_url\": \"https://github.com/Eronred/aso-skills/commits/main.atom\", \"source_id\": \"rss.aso-skills-commits\"}\n{\"published_at\": \"2026-07-27T19:18:39Z\", \"summary\": \"<pre style='white-space:pre-wrap;width:81ex'>docs: review pass — fix SEO titles, MCP tool accuracy, factor weights, broken links</pre>\", \"title\": \"docs: review pass — fix SEO titles, MCP tool accuracy, factor weights…\"}\n{\"published_at\": \"2026-07-27T19:06:45Z\", \"summary\": \"<pre style='white-space:pre-wrap;width:81ex'>docs: generate customer-facing documentation for ASO Skills by Appeeky</pre>\", \"title\": \"docs: generate customer-facing documentation for ASO Skills by Appeeky\"}\n{\"published_at\": \"2026-06-20T15:35:23Z\", \"summary\": \"<pre style='white-space:pre-wrap;width:81ex'>Update README.md</pre>\", \"title\": \"Update README.md\"}\n{\"published_at\": \"2026-05-08T15:40:38Z\", \"summary\": \"<pre style='white-space:pre-wrap;width:81ex'>Enhance README and REGISTRY with new skills and routing information\\n\\nAdded new skills to the README, including `paywall-optimization`, `app-preview-video`, `attribution-setup`, `custom-product-pages`, `app-rejection-recovery`, `referral-program`, `creator-ugc-marketing`, `web-to-app-funnel`, and `category-positioning`. Updated the REGISTRY to reflect the tools associated with these skills and introduced the `aso-router` for streamlined skill access.</pre>\", \"title\": \"Enhance README and REGISTRY with new skills and routing information\"}\n{\"published_at\": \"2026-03-22T13:35:29Z\", \"summary\": \"<pre style='white-space:pre-wrap;width:81ex'>Update README with new image and text changes\\n\\nUpdated the image source and modified text for clarity.</pre>\", \"title\": \"Update README with new image and text changes\"}\n{\"published_at\": \"2026-03-22T13:32:54Z\", \"summary\": \"<pre style='white-space:pre-wrap;width:81ex'>New skills for ASO and app marketing include new skills: `android-aso`, `app-clips`, `app-icon-optimization`, `apple-search-ads`, `asc-metrics`, `competitor-tracking`, and `crash-analytics`, detailing their functionalities and usage.</pre>\", \"title\": \"New skills for ASO and app marketing include new skills: `android-aso…\"}\n{\"published_at\": \"2026-03-15T18:43:23Z\", \"summary\": \"<pre style='white-space:pre-wrap;width:81ex'>Update README with new links and web version info\\n\\nUpdated links and added information about the web version powered by LLMs.</pre>\", \"title\": \"Update README with new links and web version info\"}\n{\"published_at\": \"2026-03-05T15:58:36Z\", \"summary\": \"<pre style='white-space:pre-wrap;width:81ex'>Include new market intelligence skills. Add market movers and market activity tools to the registry and integrations documentation. Update API documentation for market tracking features.</pre>\", \"title\": \"Include new market intelligence skills. Add market movers and market …\"}\n{\"published_at\": \"2026-02-28T09:51:00Z\", \"summary\": \"<pre style='white-space:pre-wrap;width:81ex'>fix readme</pre>\", \"title\": \"fix readme\"}\n{\"published_at\": \"2026-02-28T00:02:31Z\", \"summary\": \"<pre style='white-space:pre-wrap;width:81ex'>Update link in README to point to documentation</pre>\", \"title\": \"Update link in README to point to documentation\"}\n{\"published_at\": \"2026-02-27T23:57:02Z\", \"summary\": \"<pre style='white-space:pre-wrap;width:81ex'>Initial commit: Add ASO &amp; App Marketing skills repository with foundational documents, skills structure, and validation script. Includes guidelines for agents, contributing instructions, and various skills for app optimization and marketing strategies.</pre>\", \"title\": \"Initial commit: Add ASO & App Marketing skills repository with founda…\"}\n{\"url\": \"https://github.com/Eronred/aso-skills/commits/main.atom\"}\n\n### /Users/anicca/anicca/skills/earn/marketing-engine/evidence/intel/pulls/68f5220fe826411ab0d41408bda1f09e/apple.owned-apps-jp.json\n{\"canonical_url\": \"https://itunes.apple.com/lookup\", \"source_id\": \"apple.owned-apps-jp\"}\n{\"averageUserRating\": 4.5, \"description\": \"あなたが本当に必要な瞬間に、優しい言葉が届くアファメーション。\\n\\nアニッチャ（Anicca）は、AIによるセルフケア・コンパニオン。自己肯定、引き寄せ（マニフェステーション）、心の平和の言葉を、美しいカードと通知で、心が揺れ始める\\\"その瞬間\\\"に届けます。\\n\\n多くのアファメーション・アプリは、自分でアプリを開いて読まなければなりません。アニッチャは違います。あなたの一日を学び — 夜更かししそうな時、自己否定が始まりそうな時、不安が忍び寄る時 — その瞬間にひとつの優しい言葉を届けます。タップすればカード全文。読むだけで、少し心が軽くなる。\\n\\n## アニッチャが違う理由\\n\\n- アファメーションは「思い出した時」ではなく「必要な時」に届く\\n- AIがあなたの心に響く言葉を学習する\\n- 仏教の「無常（アニッチャ）」に根ざした設計 — どんな嵐もいつか過ぎ去る\\n- ストリーク・罪悪感・生産性プレッシャーは一切なし\\n- すでに自分を責めすぎている人のために作られた\\n\\n## 主な機能\\n\\n### ◆ 毎日のアファメーション・カード\\n美しくデザインされたカードに、自己肯定の言葉、引き寄せのプロンプト、セルフラブのリマインダー — 今日のあなたに合わせて選ばれます。\\n\\n### ◆ スマート・タイミング\\nアニッチャはあなたのパターンを学習。夜中のスクロール？23:47にカードが届きます。自己批判のループ？内なる批判者が動き出した瞬間にカードが現れます。\\n\\n### ◆ 13のセルフケア・テーマ\\n自己愛・不安の緩和・考えすぎを手放す・怒りを鎮める・自信のマニフェステーション・自己疑念の解放・赦し・過去を手放す・孤独・先延ばし・誠実な言葉・健全な境界線・眠りの平和。\\n\\n### ◆ ボイス・セッション\\n話したい時に話せる。穏やかなAIの声があなたの言葉を受け止め、自己慈悲に根ざした視点を返します — アドバイスでも治療でもなく、ただ\\\"そばに居る\\\"。\\n\\n### ◆ 適応学習\\n心に響いたカードは優先され、響かなかったものは自然に消えていきます。日々、あなたの\\\"フィード\\\"はあなた自身に近づきます。\\n\\n### ◆ 優しい、決して責めない\\n途切れたら罪悪感、というストリークはありません。「昨日サボったね」も言いません。コーチではなく、優しい友人のように現れます。\\n\\n## こんな方へ\\n\\n- 無理にポジティブでいるのに疲れた人\\n- 自己批判・燃え尽き・不安から回復している人\\n- アファメーション・引き寄せが好きで、ToDoではなく日常に溶け込ませたい人\\n- 自分との関係を、もっと静かで、もっと優しくしたい人\\n\\n## 哲学\\n\\n「アニッチャ（Anicca）」は仏教のパーリ語で「無常」を意味します — どんな感情も、どんな思考も、どんな嵐も、永遠ではないという真理。届く一通の通知は、その小さなリマインダーです。あなたは\\\"最悪の瞬間\\\"のあなたではない。これもまた過ぎ去る。\\n\\n## 利用情報\\n\\nプライバシーポリシー: https://aniccaai.com/privacy\\n利用規約 (EULA): https://www.apple.com/legal/internet-services/itunes/dev/stdeula/\\n\\n### サブスクリプション情報（自動更新）\\n\\n- タイトル: Anicca Pro（月額/年額）\\n- 期間: 1か月 / 1年\\n- 価格: 端末の購入画面に表示される金額が適用されます\\n\\n免責事項：アニッチャはセルフケア・ウェルネスアプリです。医学的な診断、治療、またはアドバイスを提供するものではありません。コンテンツは情報提供およびモチベーション目的のみです。健康上の懸念がある場合や、心身の健康に関する判断を行う前に、必ず医療専門家にご相談ください。\", \"releaseNotes\": \"不具合の修正とパフォーマンスの改善。\", \"trackName\": \"毎日のアファメーション - アニッチャ\", \"trackViewUrl\": \"https://apps.apple.com/jp/app/%E6%AF%8E%E6%97%A5%E3%81%AE%E3%82%A2%E3%83%95%E3%82%A1%E3%83%A1%E3%83%BC%E3%82%B7%E3%83%A7%E3%83%B3-%E3%82%A2%E3%83%8B%E3%83%83%E3%83%81%E3%83%A3/id6755129214?uo=4\"}\n{\"averageUserRating\": 5, \"description\": \"LINEや会話文を貼り付けるだけで、相手の本当の気持ちをAIが即分析。\\n\\n怒り・不安・寂しさ・期待…隠された感情を読み解き、関係を壊さない最適な返答まで具体的に提案します。\\n\\n- 無料: 1日3回まで\\n- プレミアム: 翻訳無制限 + 全履歴 + 優先高速分析 + 詳細な心理分析\\n\\n対応する関係性:\\n* 恋人・カップル\\n* 友人\\n* 家族\\n* 同僚・上司\\n\\n利用規約: https://www.apple.com/legal/internet-services/itunes/dev/stdeula/\", \"releaseNotes\": \"edited the ai url so honne ai can properly analyze honne!\", \"trackName\": \"本音翻訳\", \"trackViewUrl\": \"https://apps.apple.com/jp/app/%E6%9C%AC%E9%9F%B3%E7%BF%BB%E8%A8%B3/id6759667221?uo=4\"}\n\n### /Users/anicca/anicca/skills/earn/marketing-engine/evidence/intel/pulls/68f5220fe826411ab0d41408bda1f09e/github.hook-rubric.json\n{\"canonical_url\": \"https://github.com/Anil-matcha/AI-Youtube-Shorts-Generator\", \"source_id\": \"github.hook-rubric\"}\n{\"author\": {\"avatar_url\": \"https://avatars.githubusercontent.com/u/4326215?v=4\", \"events_url\": \"https://api.github.com/users/Anil-matcha/events{/privacy}\", \"followers_url\": \"https://api.github.com/users/Anil-matcha/followers\", \"following_url\": \"https://api.github.com/users/Anil-matcha/following{/other_user}\", \"gists_url\": \"https://api.github.com/users/Anil-matcha/gists{/gist_id}\", \"gravatar_id\": \"\", \"html_url\": \"https://github.com/Anil-matcha\", \"id\": 4326215, \"login\": \"Anil-matcha\", \"node_id\": \"MDQ6VXNlcjQzMjYyMTU=\", \"organizations_url\": \"https://api.github.com/users/Anil-matcha/orgs\", \"received_events_url\": \"https://api.github.com/users/Anil-matcha/received_events\", \"repos_url\": \"https://api.github.com/users/Anil-matcha/repos\", \"site_admin\": false, \"starred_url\": \"https://api.github.com/users/Anil-matcha/starred{/owner}{/repo}\", \"subscriptions_url\": \"https://api.github.com/users/Anil-matcha/subscriptions\", \"type\": \"User\", \"url\": \"https://api.github.com/users/Anil-matcha\", \"user_view_type\": \"public\"}, \"commit\": {\"author\": {\"date\": \"2026-07-29T05:21:59Z\", \"email\": \"matcha72@gmail.com\", \"name\": \"Anil Matcha\"}, \"comment_count\": 0, \"committer\": {\"date\": \"2026-07-29T05:22:08Z\", \"email\": \"matcha72@gmail.com\", \"name\": \"Anil Matcha\"}, \"message\": \"Add demo video embed to README\", \"tree\": {\"sha\": \"e95c77350c7cb4cf5ef4fbf4cdf4d09548140549\", \"url\": \"https://api.github.com/repos/Anil-matcha/AI-Youtube-Shorts-Generator/git/trees/e95c77350c7cb4cf5ef4fbf4cdf4d09548140549\"}, \"url\": \"https://api.github.com/repos/Anil-matcha/AI-Youtube-Shorts-Generator/git/commits/c30376e94326f8674793c960b482eb532ffbf1f6\", \"verification\": {\"payload\": null, \"reason\": \"unsigned\", \"signature\": null, \"verified\": false, \"verified_at\": null}}, \"html_url\": \"https://github.com/Anil-matcha/AI-Youtube-Shorts-Generator/commit/c30376e94326f8674793c960b482eb532ffbf1f6\", \"url\": \"https://api.github.com/repos/Anil-matcha/AI-Youtube-Shorts-Generator/commits/c30376e94326f8674793c960b482eb532ffbf1f6\"}\n{\"html_url\": \"https://github.com/Anil-matcha\", \"url\": \"https://api.github.com/users/Anil-matcha\"}\n{\"author\": {\"date\": \"2026-07-29T05:21:59Z\", \"email\": \"matcha72@gmail.com\", \"name\": \"Anil Matcha\"}, \"message\": \"Add demo video embed to README\", \"url\": \"https://api.github.com/repos/Anil-matcha/AI-Youtube-Shorts-Generator/git/commits/c30376e94326f8674793c960b482e