ineStyleRanges\": [], \"key\": \"b0bfb\", \"text\": \"売上だけを見るのではなく、\\nどの数字を改善するか考えることが大事です。\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"666vk\", \"text\": \"\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cht8i\", \"text\": \"最初の30日ロードマップ\", \"type\": \"header-one\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cju5m\", \"text\": \"1週目：テーマを決める\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1k648\", \"text\": \"大テーマを一つ決める\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"72att\", \"text\": \"読者の悩みを30個出す\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"4oqck\", \"text\": \"紹介できる商品カテゴリを整理する\\n\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"cug52\", \"text\": \"2週目：ボードと型を作る\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"euio4\", \"text\": \"ボードを5〜8個作る\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"e12ej\", \"text\": \"チェックリスト型\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"9m2ef\", \"text\": \"比較型\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"7taos\", \"text\": \"おすすめまとめ型\", \"type\": \"unordered-list-item\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"1e9p4\", \"text\": \"この3つの画像テンプレートを用意します。\\n\", \"type\": \"unstyled\"}, {\"data\": {}, \"entityRanges\": [], \"inlineStyleRanges\": [], \"key\": \"156us\", \"text\": \"3週目：ピンを投稿する\", \"type\": \"header-two\"}, {\"data\": {}, \"entityRanges\":