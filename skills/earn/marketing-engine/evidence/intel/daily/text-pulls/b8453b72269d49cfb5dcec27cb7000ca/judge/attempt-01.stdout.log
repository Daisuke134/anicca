ini\",\"iPhone13-iPhone13\",\"iPadMiniSixthGen-iPadMiniSixthGen\",\"iPadMiniSixthGenCellular-iPadMiniSixthGenCellular\",\"iPadNinthGen-iPadNinthGen\",\"iPadNinthGenCellular-iPadNinthGenCellular\",\"iPhoneSEThirdGen-iPhoneSEThirdGen\",\"iPadAirFifthGen-iPadAirFifthGen\",\"iPadAirFifthGenCellular-iPadAirFifthGenCellular\",\"iPhone14-iPhone14\",\"iPhone14Plus-iPhone14Plus\",\"iPhone14Pro-iPhone14Pro\",\"iPhone14ProMax-iPhone14ProMax\",\"iPadTenthGen-iPadTenthGen\",\"iPadTenthGenCellular-iPadTenthGenCellular\",\"iPadPro11FourthGen-iPadPro11FourthGen\",\"iPadPro11FourthGenCellular-iPadPro11FourthGenCellular\",\"iPadProSixthGen-iPadProSixthGen\",\"iPadProSixthGenCellular-iPadProSixthGenCellular\",\"iPhone15-iPhone15\",\"iPhone15Plus-iPhone15Plus\",\"iPhone15Pro-iPhone15Pro\",\"iPhone15ProMax-iPhone15ProMax\",\"iPadAir11M2-iPadAir11M2\",\"iPadAir11M2Cellular-iPadAir11M2Cellular\",\"iPadAir13M2-iPadAir13M2\",\"iPadAir13M2Cellular-iPadAir13M2Cellular\",\"iPadPro11M4-iPadPro11M4\",\"iPadPro11M4Cellular-iPadPro11M4Cellular\",\"iPadPro13M4-iPadPro13M4\",\"iPadPro13M4Cellular-iPadPro13M4Cellular\",\"iPhone16-iPhone16\",\"iPhone16Plus-iPhone16Plus\",\"iPhone16Pro-iPhone16Pro\",\"iPhone16ProMax-iPhone16ProMax\",\"iPadMiniA17Pro-iPadMiniA17Pro\",\"iPadMiniA17ProCellular-iPadMiniA17ProCellular\",\"iPhone16e-iPhone16e\",\"iPadA16-iPadA16\",\"iPadA16Cellular-iPadA16Cellular\",\"iPadAir11M3-iPadAir11M3\",\"iPadAir11M3Cellular-iPadAir11M3Cellular\",\"iPadAir13M3-iPadAir13M3\",\"iPadAir13M3Cellular-iPadAir13M3Cellular\",\"iPhone17Pro-iPhone17Pro\",\"iPhone17ProMax-iPhone17ProMax\",\"iPhone17-iPhone17\",\"iPhoneAir-iPhoneAir\",\"iPadPro11M5-iPadPro11M5\",\"iPadPro11M5Cellular-iPadPro11M5Cellular\",\"iPadPro13M5-iPadPro13M5\",\"iPadPro13M5Cellular-iPadPro13M5Cellular\",\"iPhone17e-iPhone17e\",\"iPadAir11M4-iPadAir11M4\",\"iPadAir11M4Cellular-iPadAir11M4Cellular\",\"iPadAir13M4-iPadAir13M4\",\"iPadAir13M4Cellular-iPadAir13M4Cellular\"],\"trackCensoredName\":\"Daily Affirmations & Widgets\",\"trackContentRating\":\"4+\",\"trackId\":1671846678,\"trackName\":\"Daily Affirmations & Widgets\",\"trackViewUrl\":\"https://apps.apple.com/us/app/daily-affirmations-widgets/id1671846678?uo=4\",\"userRatingCount\":841,\"userRatingCountForCurrentVersion\":841,\"version\":\"2.004\",\"wrapperType\":\"software\"},{\"advisories\":[],\"appletvScreenshotUrls\":[],\"artistId\":1449250156,\"artistName\":\"Ravi Kotadiya\",\"artistViewUrl\":\"https://apps.apple.com/us/developer/ravi-kotadiya/id1449250156?uo=4\",\"artworkUrl100\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/aa/8b/c4/aa8bc479-245a-36d7-0f0b-bf25809e4553/AppIcon-0-0-1x_U007epad-0-1-0-sRGB-85-220.png/100x100bb.jpg\",\"artworkUrl512\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/aa/8b/c4/aa8bc479-245a-36d7-0f0b-bf25809e4553/AppIcon-0-0-1x_U007epad-0-1-0-sRGB-85-220.png/512x512bb.jpg\",\"artworkUrl60\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/aa/8b/c4/aa8bc479-245a-36d7-0f0b-bf25809e4553/AppIcon-0-0-1x_U007epad-0-1-0-sRGB-85-220.png/60x60bb.jpg\",\"averageUserRating\":4.77392,\"averageUserRatingForCurrentVersion\":4.77392,\"bundleId\":\"com.ravi.affirm\",\"contentAdvisoryRating\":\"4+\",\"currency\":\"USD\",\"currentVersionReleaseDate\":\"2026-07-10T23:43:44Z\",\"description\":\"Stuck in negative thought loops? Self Love delivers daily affirmations, powerful I am statements, and gentle reminders exactly when you need them—so positivity is never out of reach.\\n\\nTransform your mindset with uplifting quotes on your lock screen, beautiful home-screen widgets, and themed backgrounds that make every affirmation feel personal. \\n\\nRead it. Speak it. Believe it.\\n\\nWHY SELF LOVE WORKS?\\n\\nDaily affirmations are more than quotes—they are small habits that reshape how you see yourself. With Self Love, you replace self-doubt with confidence, calm, and clarity one message at a time.\\n\\nDAILY AFFIRMATIONS & I AM STATEMENTS\\n\\n• Hundreds of affirmations for confidence, self-esteem, gratitude, and growth\\n• I am statements that strengthen a positive mindset\\n• New categories and quotes added regularly\\n• Save favorites and revisit the messages that resonate most\\n\\nREMINDERS THAT MEET YOU WHERE YOU ARE\\n\\n• Smart reminders deliver affirmations throughout your day\\n• Choose how often you want encouragement—morning, midday, or evening\\n• Turn your phone into a source of support, not stress\\n\\nWIDGETS & BEAUTIFUL THEMES\\n\\n• Home-screen widgets keep affirmations visible all day\\n• Stunning themes and backgrounds personalize your self-care routine\\n• A calm, uplifting design made for daily use\\n\\nEXPLORE CATEGORIES FOR EVERY MOOD\\n\\n• Confidence & self-belief\\n• Mental wellness & self-care\\n• Manifestation & abundance\\n• Stoic calm & mindfulness\\n• Seasonal inspiration (New Year, holidays, and more)\\n\\nMIRROR MODE & DAILY PRACTICES\\n\\n• Speak affirmations to yourself in Mirror Mode — a therapist-recommended technique\\n• Build your streak and stay consistent day after day\\n• Quick Story Style practices for deeper self-reflection\\n\\nBUILT FOR YOUR WHOLE DAY\\n\\n• iPhone & iPad\\n• Apple Watch affirmations on your wrist\\n• iMessage support\\n\\nSPEAK IT. BELIEVE IT. LIVE IT.\\n\\nMany users read each affirmation twice and speak it aloud twice—so the words sink in and become part of how you think. Small repetition. Real change.\\n\\nFREE TO START. PREMIUM WHEN YOU’RE READY\\n\\nDownload free and explore daily affirmations at your own pace. Upgrade to Premium to unlock the full library, themes, widgets, and reminders.\\n\\nSELF LOVE PREMIUM\\n\\n• Monthly and annual plans available\\n• Optional free trial on eligible subscriptions\\n• Payment charged to your Apple ID account\\n• Subscription renews automatically unless canceled at least 24 hours before the end of the current period\\n• Manage or cancel anytime in App Store account settings\\n\\nPrivacy Policy: http://ruruinfotech.com/PrivacyPolicy/im/imp.html\\nTerms of Use: http://ruruinfotech.com/PrivacyPolicy/im/imtou.html\\n\\nYour journey to self-love starts with one affirmation today. Download Self Love and feel the difference.\",\"features\":[\"iosUniversal\"],\"fileSizeBytes\":\"285072384\",\"formattedPrice\":\"Free\",\"genreIds\":[\"6013\",\"6012\"],\"genres\":[\"Health & Fitness\",\"Lifestyle\"],\"ipadScreenshotUrls\":[],\"isGameCenterEnabled\":false,\"isVppDeviceBasedLicensingEnabled\":true,\"kind\":\"software\",\"languageCodesISO2A\":[\"EN\"],\"minimumOsVersion\":\"16.0\",\"price\":0.0,\"primaryGenreId\":6013,\"primaryGenreName\":\"Health & Fitness\",\"releaseDate\":\"2022-04-02T07:00:00Z\",\"releaseNotes\":\"Make every glance more uplifting with Affirmation Wallpapers!\\n\\n• Create personalized wallpapers with your favorite themes and affirmation categories.\\n• Automatically change your wallpaper using Apple Shortcuts.\\n• Discover hundreds of new affirmations across more self-growth categories.\\n• Enjoy beautiful new themes and additional customization options.\\n• Performance improvements, bug fixes, and overall app enhancements.\\n\\nEnjoying Self Love? Please leave a review on the App Store. We read every review and truly appreciate your support.\\n\\nThank you for growing with us.\",\"screenshotUrls\":[],\"sellerName\":\"Ravi Kotadiya\",\"sellerUrl\":\"https://ruruinfotech.com\",\"supportedDevices\":[\"iPhone5s-iPhone5s\",\"iPadAir-iPadAir\",\"iPadAirCellular-iPadAirCellular\",\"iPadMiniRetina-iPadMiniRetina\",\"iPadMiniRetinaCellular-iPadMiniRetinaCellular\",\"iPhone6-iPhone6\",\"iPhone6Plus-iPhone6Plus\",\"iPadAir2-iPadAir2\",\"iPadAir2Cellular-iPadAir2Cellular\",\"iPadMini3-iPadMini3\",\"iPadMini3Cellular-iPadMini3Cellular\",\"iPodTouchSixthGen-iPodTouchSixthGen\",\"iPhone6s-iPhone6s\",\"iPhone6sPlus-iPhone6sPlus\",\"iPadMini4-iPadMini4\",\"iPadMini4Cellular-iPadMini4Cellular\",\"iPadPro-iPadPro\",\"iPadProCellular-iPadProCellular\",\"iPadPro97-iPadPro97\",\"iPadPro97Cellular-iPadPro97Cellular\",\"iPhone