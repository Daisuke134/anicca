anges\":[],\"inlineStyleRanges\":[],\"key\":\"8lk\",\"text\":\"自分は商品情報の確認と\\n経験やストーリーを加えるだけ。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"1njl4\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"b75dg\",\"text\":\"「いや、AIに記事を書かせて\\n　本当に収益につながるの？」\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"au6mb\",\"text\":\"って思うかもしれません。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"7hsc0\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5t4d3\",\"text\":\"僕も最初は、AIで作った文章なんて、\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"etp5a\",\"text\":\"読者にバレるし、\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"4nkjm\",\"text\":\"検索にも評価されないし、\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"52o4p\",\"text\":\"結局、売れないと思ってました。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5he8s\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"fp4th\",\"text\":\"でも実際に、仕組みを分解してみると\\n他のアフィリエイトとは\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":13,\"offset\":0,\"style\":\"Bold\"}],\"key\":\"62omj\",\"text\":\"『攻略パターンが少し違う』\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"b8gug\",\"text\":\"と気づいたんです。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"e1gs3\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"a2vr7\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"aosc5\",\"text\":\"というのも、理由が3つあって\",