n\":\"6.0.8\",\"wrapperType\":\"software\"}]},\"reason\":null,\"source_id\":\"apple.competitors-affirmation-us\",\"status\":\"success\"},\"schema_version\":\"marketing.source-capture.v1\",\"source\":{\"adapter\":\"apple_search\",\"cadence\":\"daily\",\"country\":\"us\",\"enabled\":true,\"entity\":\"software\",\"id\":\"apple.competitors-affirmation-us\",\"lang\":\"en_us\",\"languages\":[\"en\"],\"limit\":10,\"media\":\"software\",\"product_ids\":[\"aniccaios\"],\"term\":\"daily affirmations\"}}\nFILE:/Users/anicca/anicca/skills/earn/marketing-engine/evidence/intel/daily/text-pulls/7d8ae92686624b9d90490a48a168c5b1/apple.competitors-relationship-jp.json\n{\"result\":{\"api_status\":null,\"cache\":{},\"canonical_url\":\"https://itunes.apple.com/search\",\"error_class\":null,\"http_status\":200,\"item_ids\":[\"apple:6784031888@1.1.8:r545\",\"apple:1247701802@2.50.0:r1038\",\"apple:6473902336@1.0.8:r137\",\"apple:1517761308@7.3:r1026\",\"apple:1494428618@2.0.53:r71438\",\"apple:6467590967@6.0:r193\"],\"payload\":{\"resultCount\":6,\"results\":[{\"advisories\":[\"まれ／軽度な過激な言葉遣いまたは下品なユーモア\",\"まれ／軽度な成人向けまたはわいせつなテーマ\",\"まれ／軽度なアルコール、タバコ、ドラッグの使用または言及\"],\"appletvScreenshotUrls\":[],\"artistId\":1896756707,\"artistName\":\"Issei Nishi\",\"artistViewUrl\":\"https://apps.apple.com/jp/developer/issei-nishi/id1896756707?uo=4\",\"artworkUrl100\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/7b/14/4a/7b144ae0-dd97-e18a-c6c6-a071333b55bf/AppIcon-0-0-1x_U007emarketing-0-11-0-85-220.png/100x100bb.jpg\",\"artworkUrl512\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/7b/14/4a/7b144ae0-dd97-e18a-c6c6-a071333b55bf/AppIcon-0-0-1x_U007emarketing-0-11-0-85-220.png/512x512bb.jpg\",\"artworkUrl60\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/7b/14/4a/7b144ae0-dd97-e18a-c6c6-a071333b55bf/AppIcon-0-0-1x_U007emarketing-0-11-0-85-220.png/60x60bb.jpg\",\"averageUserRating\":4.53394,\"averageUserRatingForCurrentVersion\":4.53394,\"bundleId\":\"com.mayth.lovetemp\",\"contentAdvisoryRating\":\"12+\",\"currency\":\"JPY\",\"currentVersionReleaseDate\":\"2026-07-31T14:06:00Z\",\"description\":\"気になるあの人とのトーク、本当はどう思われてる？\\n恋愛温度計は、ふたりのトーク履歴を取り込むだけで“関係の温度”が見えてくる恋愛分析アプリ。\\nさらに「もしも」では、送り方を変えたら相手がどう返すかをAIが予測。今のトークへの返し方の提案や、ふたりの週間レポートも読めます。\\n\\n■ 取り込むだけ、あとは自動で分析\\n・やりとりの量やテンポ、返信の速さ、盛り上がった日をグラフで可視化\\n・ふたりの“関係の温度”をスコアで表示\\n・毎日の小さな変化をやさしくまとめてお知らせ\\n※分析はすべて端末の中だけで完結。相手に通知が届いたり、バレることは一切ありません。\\n\\n■ 「もしも」——あの送信、変えていたら？\\n過去の自分のメッセージを書き換えると、「相手だったらどう返すか」をAIが“もしも”の続きとして予測。\\nさらに「返信を考える」では、今のトークにどう返すかを、あなたの話し方でAIが3案提案します。\\n※実在の相手の発言ではなく、AIによる予測シミュレーションです。\\n\\n■ 週間レポート\\n今週のふたりの温度の変化や気づき、盛り上がった日をまとめて振り返り。\\n相手の好意のサインや“次の一手”は、AIの考察としてプレミアムで読めます。\\n\\n■ こんな人に\\n・好きな人との距離をもう一歩縮めたい\\n・脈ありかどうか、それとなく確かめたい\\n・自分の送り方・返し方を見直したい\\n・恋の駆け引きのヒントがほしい\\n\\n■ プライバシーへの配慮\\n・トーク履歴の分析は端末内で処理します\\n・あなたのトークを第三者に公開することはありません\\n（AIを使う機能〔「もしも」「いまの返事」「週間レポート」〕の利用時のみ、予測・生成のために会話の一部をAIへ送信します。詳しくはプライバシーポリシーをご覧ください）\\n\\n■ 料金について\\n基本機能は無料でご利用いただけます。「もしも」など一部機能は、プレミアム（自動更新サブスクリプション）または単発のチケットでご利用いただけます。\\n・プレミアムでできること：毎日チケットが届く／「いまの返事」を1日にたっぷり使える（無料は1日1回）／週間レポートのAI考察が読める\\n・プレミアム：週額 ¥600 ／ 年額 ¥12,800（自動更新）\\n・お支払いは購入確定時にApple IDへ請求されます。\\n・期間終了の24時間前までに解約しない限り自動更新され、更新分は期間終了前の24時間以内に請求されます。\\n・解約・管理は購入後いつでもApple IDのアカウント設定から行えます。\\n\\nプライバシーポリシー: https://daffy-angle-c7a.notion.site/lovetemp-privacy\\n利用規約: https://daffy-angle-c7a.notion.site/lovetemp-terms\",\"features\":[],\"fileSizeBytes\":\"46002176\",\"formattedPrice\":\"無料\",\"genreIds\":[\"6012\",\"6002\"],\"genres\":[\"ライフスタイル\",\"ユーティリティ\"],\"ipadScreenshotUrls\":[],\"isGameCenterEnabled\":false,\"isVppDeviceBasedLicensingEnabled\":true,\"kind\":\"software\",\"languageCodesISO2A\":[\"EN\"],\"minimumOsVersion\":\"13.0\",\"price\":0.0,\"primaryGenreId\":6012,\"primaryGenreName\":\"Lifestyle\",\"releaseDate\":\"2026-06-30T07:00:00Z\",\"releaseNotes\":\"トーク履歴の共有時・取り込み時の問題を修正しました。\",\"screenshotUrls\":[\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/aa/d9/10/aad910cd-eb23-bd82-1baf-a8f718cf1a7c/p1.png/320x480bb.j