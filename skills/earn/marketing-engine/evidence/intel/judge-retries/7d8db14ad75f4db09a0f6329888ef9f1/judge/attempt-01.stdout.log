"blue\":102,\"green\":120,\"red\":173}},{\"percentage\":13.33,\"rgb\":{\"blue\":134,\"green\":115,\"red\":130}},{\"percentage\":9.41,\"rgb\":{\"blue\":80,\"green\":54,\"red\":43}},{\"percentage\":7.12,\"rgb\":{\"blue\":126,\"green\":117,\"red\":134}}]},\"original_img_height\":1071,\"original_img_url\":\"https://pbs.twimg.com/media/HLL6B3RW4AAW7Xn.jpg\",\"original_img_width\":1690},\"media_key\":\"3_2067990088840044544\"},{\"id\":\"QXBpTWVkaWE6DAAFCgABHLL6EsDW0AAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2067990137368137728\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":88.04,\"rgb\":{\"blue\":18,\"green\":18,\"red\":18}},{\"percentage\":10.21,\"rgb\":{\"blue\":242,\"green\":240,\"red\":239}},{\"percentage\":0.8,\"rgb\":{\"blue\":102,\"green\":110,\"red\":126}}]},\"original_img_height\":726,\"original_img_url\":\"https://pbs.twimg.com/media/HLL6EsDW0AAl8Zr.jpg\",\"original_img_width\":1086},\"media_key\":\"3_2067990137368137728\"},{\"id\":\"QXBpTWVkaWE6DAAECgABHLL6NoiWAAEKAAIAAAAAAAAAAAAA\",\"media_id\":\"2067990291043188737\",\"media_info\":{\"__typename\":\"ApiVideo\",\"aspect_ratio\":{\"denominator\":460,\"numerator\":587},\"duration_millis\":10148,\"preview_image\":{\"color_info\":{\"palette\":[{\"percentage\":35.91,\"rgb\":{\"blue\":133,\"green\":153,\"red\":181}},{\"percentage\":27.63,\"rgb\":{\"blue\":25,\"green\":22,\"red\":21}},{\"percentage\":9.98,\"rgb\":{\"blue\":69,\"green\":86,\"red\":125}},{\"percentage\":5.02,\"rgb\":{\"blue\":157,\"green\":145,\"red\":141}},{\"percentage\":3.18,\"rgb\":{\"blue\":41,\"green\":55,\"red\":15}}]},\"original_img_height\":1840,\"original_img_url\":\"https://pbs.twimg.com/amplify_video_thumb/2067990291043188737/img/Qn0WjFDVhuCvcmd9.jpg\",\"original_img_width\":2348},\"variants\":[{\"bit_rate\":25128000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/vid/avc1/2348x1840/Scu855McrdOl87t1.mp4?tag=28\"},{\"bit_rate\":10368000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/vid/avc1/1378x1080/8SzSc4VEqsHHKamP.mp4?tag=28\"},{\"content_type\":\"application/x-mpegURL\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/pl/RLOxRTSH8f0s0Xpz.m3u8?tag=28&v=cfc\"},{\"bit_rate\":832000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/vid/avc1/458x360/hD2SWtw-h6qOIvOq.mp4?tag=28\"},{\"bit_rate\":2176000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/vid/avc1/918x720/_53riOCkeYpFhyEa.mp4?tag=28\"},{\"bit_rate\":256000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/vid/avc1/344x270/HbMXbCVnh5eaLzNo.mp4?tag=28\"}]},\"media_key\":\"13_2067990291043188737\"},{\"id\":\"QXBpTWVkaWE6DAAFCgABHLL5sgeXgAAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2067989721943343104\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":79.69,\"rgb\":{\"blue\":21,\"green\":20,\"red\":20}},{\"percentage\":11.26,\"rgb\":{\"blue\":255,\"green\":255,\"red\":255}},{\"percentage\":4.18,\"rgb\":{\"blue\":120,\"green\":120,\"red\":120}},{\"percentage\":4.13,\"rgb\":{\"blue\":250,\"green\":128,\"red\":10}},{\"percentage\":1.01,\"rgb\":{\"blue\":115,\"green\":67,\"red\":23}}]},\"original_img_height\":1200,\"original_img_url\":\"https://pbs.twimg.com/media/HLL5sgeXgAAHUKR.jpg\",\"original_img_width\":1200},\"media_key\":\"3_2067989721943343104\"}],\"modified_at\":\"2026-06-19T15:41:05.000Z\",\"preview_text\":\"There is an app called 75HER pulling $200,000 a month right now, Go look at their TikTok videos, Every video looks like a real women sharing their before and after transformation.... yet none of those\",\"title\":\"This app makes $200K/month with 10 AI UGC creators ( full guide )\"},\"author\":{\"avatar_url\":\"https://pbs.twimg.com/profile_images/1930138018951643136/wEgZY178_200x200.jpg\",\"banner_url\":\"https://pbs.twimg.com/profile_banners/1890388644273258496/1742417398\",\"description\":\"I own a few apps. currently at $200k MRR, sharing daily B2C scaling strategies. founder of @tryviewtrack\",\"followers\":58728,\"following\":794,\"id\":\"1890388644273258496\",\"joined\":\"Fri Feb 14 13:12:38 +0000 2025\",\"likes\":13792,\"location\":\"\",\"media_count\":1917,\"name\":\"Ernesto Lopez\",\"protected\":false,\"raw_description\":{\"facets\":[],\"text\":\"I own a few apps. currently at $200k MRR, sharing daily B2C scaling strategies. founder of @tryviewtrack\"},\"screen_name\":\"ErnestoSOFTWARE\",\"statuses\":7090,\"type\":\"profile\",\"url\":\"https://x.com/ErnestoSOFTWARE\",\"verification\":{\"type\":\"individual\",\"verified\":true,\"verified_at\":null},\"website\":null},\"bookmarks\":1044,\"community_note\":null,\"created_at\":\"Fri Jun 19 15:35:35 +0000 2026\",\"created_timestamp\":1781883335,\"embed_card\":\"tweet\",\"id\":\"2067994710841360596\",\"is_note_tweet\":false,\"lang\":null,\"likes\":321,\"media\":{},\"possibly_sensitive\":false,\"provider\":\"twitter\",\"quotes\":8,\"raw_text\":{\"display_text_range\":[0,23],\"facets\":[],\"text\":\"https://t.co/MalWXQnGZa\"},\"replies\":14,\"replying_to\":null,\"reposted_by\":null,\"reposts\":28,\"source\":\"Twitter Web App\",\"text\":\"\",\"type\":\"status\",\"url\":\"https://x.com/ErnestoSOFTWARE/status/2067994710841360596\",\"views\":307711},{\"article\":{\"content\":{\"blocks\":[{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"dtp68\",\"text\":\"we automated an entire AI UGC studio with Claude + Higgsfield AI for context I make $1M+/yr across my apps and businesses. and very recently we scaled one of our apps to $720,000/yr and #22 on the appstore.\\n\\nWe did this with a combination of Meta ads, tiktok ads and UGC. \\n\\nthe most effective being UGC, however.. UGC can get quite expensive at scale, think about it \\n\\n$15 per video  x 2 videos per day\\n$30 per creator/day * 7 days in the week\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"20c9h\",\"text\":\"its $210/week or $900/mo \\nwithout counting the virality bonuses.\\n\\nif our team is 30 creators we are looking to spend\\n$27,000/mo just base on creators.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":0,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"evkv6\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"fopvl\",\"text\":\"and with our campaign generating over many millions of views/mo we \\nof course have creators hitting bonuses quite often.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"8h7ta\",\"text\":\"this is not unprofitable for us at all. \\nwe see great margins from our UGC efforts.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"1rlbo\",\"text\":\"the only problem is.. that to expand your team from 10  to 20 creators for example it gets complicated.\\n\\ninstead of just hiring 10 more people\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5pqv4\",\"text\":\"you end up having to hire 30 more, then end up firing about 70% of them\\nuntil you are left with the top 10 from that batch that you can keep long term\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"4sabf\",\"text\":\"this is just how UGC works, usually most of the results from your UGC campaign will come from the top 20% of creators.\\n\\nthe other 20 are basically a waste of money. \\nSo we built a system to fix this.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":35,\"offset\":0,\"style\":\"Bold\"}],\"key\":\"70aju\",\"text\":\"I combined Claude + higgsfield mcp which is now thats generating us 100s of new realisitc UGC videos daily.\\n\\nthis allows us to test new formats for pennies on the dollar.\\nThe whole thing runs without us touching it.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":13,\"offset\":185,\"style\":\"Bold\"}],\"key\":\"6k799\",\"text\":\"This is not theory, AI really is there now.\\n\\nwe have seen some  AI videos get as high as \\n10k-50k+ views and have many comments asking whats the app.\\n\\nWhich proves that this converts.\\n\\n( DISCLAIMER: always disclose that your videos are AI generated with a tag or somewhere on your post ) 99% won't notice the tag, but it's important to disclose to avoid any legal issues.\\n\\nwe have also spoken to multiple founders running this AI ugc playbook\\nwith apps making over $100k/mo purely from AI content.\\n\\nand the cost per video is basically < $0 for us, because we are sponsored by higgsfield haha, but for you it would be around a $29 or $39 subscription \\n\\nin this article ill break down our exact system to make Realistic AI UGC at scale.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"eglei\",\"text\":\"#1 connect higgsfield MCP ( super easy )\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[{\"key\":1,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"7srcg\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{\"urls\":[{\"fromIndex\":38,\"text\":\"higgsfield.ai/cli\",\"toIndex\":55}]},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"ea5tq\",\"text\":\"This part is super simlple just go to higgsfield.ai/cli\\nsend the command on your terminal or just send it to claude\\n\\nand just like that you gave Claude a weapon of mass generation.\\nClaude can now generate world-class images and videos at scale.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":25,\"offset\":0,\"style\":\"Bold\"}],\"key\":\"44kpb\",\"text\":\"#2 Research viral scripts\",\"type\":\"unstyled\"},{\"data\":{\"urls\":[{\"fromIndex\":262,\"text\":\"viewtrack.app\",\"toIndex\":275}]},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"4b4ov\",\"text\":\"You cannot prompt your way to virality. \\nYou need data aka Viral formats in your niche that are proven to work.\\n\\nThen and only then you can use claude + higgs to recreate them.\\n\\nyou can find plenty of viral formats by doom scrolling on your niche \\n\\nor inside of viewtrack.app we have a collection of over 4000+ \\nviral formats you can take inspiration from.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":2,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"dtc6p\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"297v3\",\"text\":\"#3 GENERATE THE CHARACTER ( Nano Banana Pro )\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"3ai86\",\"text\":\"You can use the MCP for this but i prefer to do this in higgsfield UI first \\nThen delegating video creation to the MCP \\n\\nTo make your character its super simple\\nget clear on how you want your character to look\\n\\nmake sure to go for what works best in your niche\\nthese things matter a lot to go viral\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"bcn50\",\"text\":\"-> Age, ethnicity, hair, skin\\n-> Lighting (gym, golden hour, natural)\\n-> Environment (kitchen, gym, bedroom)\\n-> Accessories (resistance band, AirPods, water bottle)\\n-> Vibe (biohacker, wellness girlie, morning routine guy)\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"c2q3u\",\"text\":\"once you are clear on those variables\\ngo to pinterest and literally look for someone who matches those characteristics\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":3,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"464fj\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"6jgte\",\"text\":\"in this case let's say I want to use a guy that is in his car talking to the camera\\nI will use a pinterest image as a reference point\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"1ri15\",\"text\":\"then get that picture and send it to higgsfield\\n and make some edits to the character by prompting it.\\n\\nto end up with a completely different look but in a realistic enviroment.\\n\\nbut having a starting image of a real person will ensure your final result also looks real which is the goal here. \\n\\nplease be ethical and don't steal anyones identity. ( it's ilegal )\\nonce you have that character down you are ready to mass produce videos\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"cj4bq\",\"text\":\"#4 THE CONTENT FACTORY\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":39,\"offset\":0,\"style\":\"Bold\"}],\"key\":\"cu36l\",\"text\":\"We are in the ERA of 24 hour software. With a claude max plan of $200/mo you are virtually unstoppable in what you can create.\\n\\nWhich is why I recommend to create your own website with your own workflow\\nand have claude + higgs MCP drop videos in there. \\n\\nthink about it like this\\n\\n> Claude is your executioner \\n> Higgsfield is your artist \\n> your workflow is what ties everything together.\\n\\nIn our case we made a custom website that stiches everthing togehter\\nhiggs can also do this using their new feature Super computer.\\n\\nbut for our use case its a little different.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"7b6mj\",\"text\":\"higgsfield generates four 15 second seedance videos which is the max length a seedance video can be.\\n\\nthen we have claude drop that video into our custom website and \\n\\nthen the website stitches them together and automatically\\nedits them.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":4,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"bc128\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{\"mentions\":[{\"fromIndex\":187,\"text\":\"postbridge\",\"toIndex\":198}]},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"655h0\",\"text\":\"In summarythe complexity of automating this can vary depending on what format you are trying to replicate.\\n\\nBut ultimately everything can be done with enough prompting.\\n\\nThen you can use @postbridge to schedule out the content to Tiktok, Youtube and Instagram right from the custom platform.\\n\\nand thats literally it, now you have a content factory that can generate unlimited videos for unlimited characters\\n\\nAnd post them across dozens of accounts.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":5,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"dducq\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"c5knu\",\"text\":\"IN SUMARRY\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"4ueov\",\"text\":\"> connect your higgsfield MCP\\n> find a viral format to replicate\\n> create your character using nano banana in higgs\\n> have the MCP generate the video using your start image\\n> create your own custom website to scheduele out content and auto edit it\\n> generate 100s of new creatives per day and post them out\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"60lb9\",\"text\":\"try this for your app and thank me later.\",\"type\":\"unstyled\"}],\"entityMap\":[{\"key\":\"4\",\"value\":{\"data\":{\"entityKey\":\"c0d8cdd9-fccd-4c3d-8dd8-a40d0c405849\",\"mediaItems\":[{\"localMediaId\":\"11\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2062578706036436992\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"5\",\"value\":