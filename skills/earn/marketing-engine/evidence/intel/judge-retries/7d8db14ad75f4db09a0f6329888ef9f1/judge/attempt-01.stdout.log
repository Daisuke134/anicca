\"blue\":242,\"green\":240,\"red\":239}},{\"percentage\":0.8,\"rgb\":{\"blue\":102,\"green\":110,\"red\":126}}]},\"original_img_height\":726,\"original_img_url\":\"https://pbs.twimg.com/media/HLL6EsDW0AAl8Zr.jpg\",\"original_img_width\":1086},\"media_key\":\"3_2067990137368137728\"},{\"id\":\"QXBpTWVkaWE6DAAECgABHLL6NoiWAAEKAAIAAAAAAAAAAAAA\",\"media_id\":\"2067990291043188737\",\"media_info\":{\"__typename\":\"ApiVideo\",\"aspect_ratio\":{\"denominator\":460,\"numerator\":587},\"duration_millis\":10148,\"preview_image\":{\"color_info\":{\"palette\":[{\"percentage\":35.91,\"rgb\":{\"blue\":133,\"green\":153,\"red\":181}},{\"percentage\":27.63,\"rgb\":{\"blue\":25,\"green\":22,\"red\":21}},{\"percentage\":9.98,\"rgb\":{\"blue\":69,\"green\":86,\"red\":125}},{\"percentage\":5.02,\"rgb\":{\"blue\":157,\"green\":145,\"red\":141}},{\"percentage\":3.18,\"rgb\":{\"blue\":41,\"green\":55,\"red\":15}}]},\"original_img_height\":1840,\"original_img_url\":\"https://pbs.twimg.com/amplify_video_thumb/2067990291043188737/img/Qn0WjFDVhuCvcmd9.jpg\",\"original_img_width\":2348},\"variants\":[{\"bit_rate\":25128000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/vid/avc1/2348x1840/Scu855McrdOl87t1.mp4?tag=28\"},{\"bit_rate\":10368000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/vid/avc1/1378x1080/8SzSc4VEqsHHKamP.mp4?tag=28\"},{\"content_type\":\"application/x-mpegURL\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/pl/RLOxRTSH8f0s0Xpz.m3u8?tag=28&v=cfc\"},{\"bit_rate\":832000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/vid/avc1/458x360/hD2SWtw-h6qOIvOq.mp4?tag=28\"},{\"bit_rate\":2176000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/vid/avc1/918x720/_53riOCkeYpFhyEa.mp4?tag=28\"},{\"bit_rate\":256000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2067990291043188737/vid/avc1/344x270/HbMXbCVnh5eaLzNo.mp4?tag=28\"}]},\"media_key\":\"13_2067990291043188737\"},{\"id\":\"QXBpTWVkaWE6DAAFCgABHLL5sgeXgAAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2067989721943343104\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":79.69,\"rgb\":{\"blue\":21,\"green\":20,\"red\":20}},{\"percentage\":11.26,\"rgb\":{\"blue\":255,\"green\":255,\"red\":255}},{\"percentage\":4.18,\"rgb\":{\"blue\":120,\"green\":120,\"red\":120}},{\"percentage\":4.13,\"rgb\":{\"blue\":250,\"green\":128,\"red\":10}},{\"percentage\":1.01,\"rgb\":{\"blue\":115,\"green\":67,\"red\":23}}]},\"original_img_height\":1200,\"original_img_url\":\"https://pbs.twimg.com/media/HLL5sgeXgAAHUKR.jpg\",\"original_img_width\":1200},\"media_key\":\"3_2067989721943343104\"}],\"modified_at\":\"2026-06-19T15:41:05.000Z\",\"preview_text\":\"There is an app called 75HER pulling $200,000 a month right now, Go look at their TikTok videos, Every video looks like a real women sharing their before and after transformation.... yet none of those\",\"title\":\"This app makes $200K/month with 10 AI UGC creators ( full guide )\"},\"author\":{\"avatar_url\":\"https://pbs.twimg.com/profile_images/1930138018951643136/wEgZY178_200x200.jpg\",\"banner_url\":\"https://pbs.twimg.com/profile_banners/1890388644273258496/1742417398\",\"description\":\"I own a few apps. currently at $200k MRR, sharing daily B2C scaling strategies. founder of @tryviewtrack\",\"followers\":58728,\"following\":794,\"id\":\"1890388644273258496\",\"joined\":\"Fri Feb 14 13:12:38 +0000 2025\",\"likes\":13792,\"location\":\"\",\"media_count\":1917,\"name\":\"Ernesto Lopez\",\"protected\":false,\"raw_description\":{\"facets\":[],\"text\":\"I own a few apps. currently at $200k MRR, sharing daily B2C scaling strategies. founder of @tryviewtrack\"},\"screen_name\":\"ErnestoSOFTWARE\",\"statuses\":7090,\"type\":\"profile\",\"url\":\"https://x.com/ErnestoSOFTWARE\",\"verification\":{\"type\":\"individual\",\"verified\":true,\"verified_at\":null},\"website\":null},\"bookmarks\":1044,\"community_note\":null,\"created_at\":\"Fri Jun 19 15:35:35 +0000 2026\",\"created_timestamp\":1781883335,\"embed_card\":\"tweet\",\"id\":\"2067994710841360596\",\"is_note_tweet\":false,\"lang\":null,\"likes\":321,\"media\":{},\"possibly_sensitive\":false,\"provider\":\"twitter\",\"quotes\":8,\"raw_text\":{\"display_text_range\":[0,23],\"facets\":[],\"text\":\"https://t.co/MalWXQnGZa\"},\"replies\":14,\"replying_to\":null,\"reposted_by\":null,\"reposts\":28,\"source\":\"Twitter Web App\",\"text\":\"\",\"type\":\"status\",\"url\":\"https://x.com/ErnestoSOFTWARE/status/2067994710841360596\",\"views\":307711},{\"article\":{\"content\":{\"blocks\":[{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"dtp68\",\"text\":\"we automated an entire AI UGC studio with Claude + Higgsfield AI for context I make $1M+/yr across my apps and businesses. and very recently we scaled one of our apps to $720,000/yr and #22 on the appstore.\\n\\nWe did this with a combination of Meta ads, tiktok ads and UGC. \\n\\nthe most effective being UGC, however.. UGC can get quite expensive at scale, think about it \\n\\n$15 per video  x 2 videos per day\\n$30 per creator/day * 7 days in the week\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"20c9h\",\"text\":\"its $210/week or $900/mo \\nwithout counting the virality bonuses.\\n\\nif our team is 30 creators we are looking to spend\\n$27,000/mo just base on creators.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":0,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"evkv6\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"fopvl\",\"text\":\"and with our campaign generating over many millions of views/mo we \\nof course have creators hitting bonuses quite often.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"8h7ta\",\"text\":\"this is not unprofitable for us at all. \\nwe see great margins from our UGC efforts.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"1rlbo\",\"text\":\"the only problem is.. that to expand your team from 10  to 20 creators for example it gets complicated.\\n\\ninstead of just hiring 10 more people\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5pqv4\",\"text\":\"you end up having to hire 30 more, then end up firing about 70% of them\\nuntil you are left with the top 10 from that batch that you can keep long term\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"4sabf\",\"text\":\"this is just how UGC works, usually most of the results from your UGC campaign will come from the top 20% of creators.\\n\\nthe other 20 are basically a waste of money. \\nSo we built a system to fix this.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":35,\"offset\":0,\"style\":\"Bold\"}],\"key\":\"70aju\",\"text\":\"I combined Claude + higgsfield mcp which is now thats generating us 100s of new realisitc UGC videos daily.\\n\\nthis allows us to test new formats for pennies on the dollar.\\nThe whole thing runs without us touching it.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":13,\"offset\":185,\"style\":\"Bold\"}],\"key\":\"6k799\",\"text\":\"This is not theory, AI really is there now.\\n\\nwe have seen some  AI videos get as high as \\n10k-50k+ views and have many comments asking whats the app.\\n\\nWhich proves that this converts.\\n\\n( DISCLAIMER: always disclose that your videos are AI generated with a tag or somewhere on your post ) 99% won't notice the tag, but it's important to disclose to avoid any legal issues.\\n\\nwe have also spoken to multiple founders running this AI ugc playbook\\nwith apps making over $100k/mo purely from AI content.\\n\\nand the cost per video is basically < $0 for us, because we are sponsored by higgsfield haha, but for you it would be around a $29 or $39 subscription \\n\\nin this article ill break down our exact system to make Realistic AI UGC at scale.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"eglei\",\"text\":\"#1 connect higgsfield MCP ( super easy )\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[{\"key\":1,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"7srcg\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{\"urls\":[{\"fromIndex\":38,\"text\":\"higgsfield.ai/cli\",\"toIndex\":55}]},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"ea5tq\",\"text\":\"This part is super simlple just go to higgsfield.ai/cli\\nsend the command on your terminal or just send it to claude\\n\\nand just like that you gave Claude a weapon of mass generation.\\nClaude can now generate world-class images and videos at scale.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":25,\"offset\":0,\"style\":\"Bold\"}],\"key\":\"44kpb\",\"text\":\"#2 Research viral scripts\",\"type\":\"unstyled\"},{\"data\":{\"urls\":[{\"fromIndex\":262,\"text\":\"viewtrack.app\",\"toIndex\":275}]},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"4b4ov\",\"text\":\"You cannot prompt your way to virality. \\nYou need data aka Viral formats in your niche that are proven to work.\\n\\nThen and only then you can use claude + higgs to recreate them.\\n\\nyou can find plenty of viral formats by doom scrolling on your niche \\n\\nor inside of viewtrack.app we have a collection of over 4000+ \\nviral formats you can take inspiration from.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":2,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"dtc6p\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"297v3\",\"text\":\"#3 GENERATE THE CHARACTER ( Nano Banana Pro )\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"3ai86\",\"text\":\"You can use the MCP for this but i prefer to do this in higgsfield UI first \\nThen delegating video creation to the MCP \\n\\nTo make your character its super simple\\nget clear on how you want your character to look\\n\\nmake sure to go for what works best in your niche\\nthese things matter a lot to go viral\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"bcn50\",\"text\":\"-> Age, ethnicity, hair, skin\\n-> Lighting (gym, golden hour, natural)\\n-> Environment (kitchen, gym, bedroom)\\n-> Accessories (resistance band, AirPods, water bottle)\\n-> Vibe (biohacker, wellness girlie, morning routine guy)\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"c2q3u\",\"text\":\"once you are clear on those variables\\ngo to pinterest and literally look for someone who matches those characteristics\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":3,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"464fj\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"6jgte\",\"text\":\"in this case let's say I want to use a guy that is in his car talking to the camera\\nI will use a pinterest image as a reference point\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"1ri15\",\"text\":\"then get that picture and send it to higgsfield\\n and make some edits to the character by prompting it.\\n\\nto end up with a completely different look but in a realistic enviroment.\\n\\nbut having a starting image of a real person will ensure your final result also looks real which is the goal here. \\n\\nplease be ethical and don't steal anyones identity. ( it's ilegal )\\nonce you have that character down you are ready to mass produce videos\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"cj4bq\",\"text\":\"#4 THE CONTENT FACTORY\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":39,\"offset\":0,\"style\":\"Bold\"}],\"key\":\"cu36l\",\"text\":\"We are in the ERA of 24 hour software. With a claude max plan of $200/mo you are virtually unstoppable in what you can create.\\n\\nWhich is why I recommend to create your own website with your own workflow\\nand have claude + higgs MCP drop videos in there. \\n\\nthink about it like this\\n\\n> Claude is your executioner \\n> Higgsfield is your artist \\n> your workflow is what ties everything together.\\n\\nIn our case we made a custom website that stiches everthing togehter\\nhiggs can also do this using their new feature Super computer.\\n\\nbut for our use case its a little different.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"7b6mj\",\"text\":\"higgsfield generates four 15 second seedance videos which is the max length a seedance video can be.\\n\\nthen we have claude drop that video into our custom website and \\n\\nthen the website stitches them together and automatically\\nedits them.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":4,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"bc128\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{\"mentions\":[{\"fromIndex\":187,\"text\":\"postbridge\",\"toIndex\":198}]},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"655h0\",\"text\":\"In summarythe complexity of automating this can vary depending on what format you are trying to replicate.\\n\\nBut ultimately everything can be done with enough prompting.\\n\\nThen you can use @postbridge to schedule out the content to Tiktok, Youtube and Instagram right from the custom platform.\\n\\nand thats literally it, now you have a content factory that can generate unlimited videos for unlimited characters\\n\\nAnd post them across dozens of accounts.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":5,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"dducq\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"c5knu\",\"text\":\"IN SUMARRY\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"4ueov\",\"text\":\"> connect your higgsfield MCP\\n> find a viral format to replicate\\n> create your character using nano banana in higgs\\n> have the MCP generate the video using your start image\\n> create your own custom website to scheduele out content and auto edit it\\n> generate 100s of new creatives per day and post them out\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"60lb9\",\"text\":\"try this for your app and thank me later.\",\"type\":\"unstyled\"}],\"entityMap\":[{\"key\":\"4\",\"value\":{\"data\":{\"entityKey\":\"c0d8cdd9-fccd-4c3d-8dd8-a40d0c405849\",\"mediaItems\":[{\"localMediaId\":\"11\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2062578706036436992\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"5\",\"value\":{\"data\":{\"entityKey\":\"86078e59-aec0-4860-aef4-7f3edd0ccfa7\",\"mediaItems\":[{\"localMediaId\":\"13\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2062578756183584768\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"1\",\"value\":{\"data\":{\"entityKey\":\"9cf0da91-f951-4a3a-af71-ac1cd5c367b0\",\"mediaItems\":[{\"localMediaId\":\"5\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2062578528055361536\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"0\",\"value\":{\"data\":{\"entityKey\":\"2bac28c7-50ee-4af7-8cb2-c765274ec0f0\",\"mediaItems\":[{\"localMediaId\":\"3\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2062578458400583680\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"2\",\"value\":{\"data\":{\"entityKey\":\"dd178d39-9e37-42ee-9b09-03482d6114af\",\"mediaItems\":[{\"localMediaId\":\"7\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2062578576008851456\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"3\",\"value\":{\"data\":{\"entityKey\":\"07fc2ef8-ce7a-4e08-bfaa-4b00873b0f1c\",\"mediaItems\":[{\"localMediaId\":\"9\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2062578641771413504\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}}]},\"cover_media\":{\"id\":\"QXBpTWVkaWE6DAAFCgABHJ/DUjeXcAAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2062581912246382592\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":81.25,\"rgb\":{\"blue\":0,\"green\":1,\"red\":1}},{\"percentage\":8.47,\"rgb\":{\"blue\":1,\"green\":61,\"red\":65}},{\"percentage\":6.71,\"rgb\":{\"blue\":2,\"green\":149,\"red\":157}},{\"percentage\":2.53,\"rgb\":{\"blue\":1,\"green\":99,\"red\":104}},{\"percentage\":0.92,\"rgb\":{\"blue\":3,\"green\":205,\"red\":214}}]},\"original_img_height\":724,\"original_img_url\":\"https://pbs.twimg.com/media/HJ_DUjeXcAAO7Sd.jpg\",\"original_img_width\":1810},\"media_key\":\"3_2062581912246382592\"},\"created_at\":\"2026-06-04T17:08:06.000Z\",\"id\":\"2062578397226950656\",\"media_entities\":[{\"id\":\"QXBpTWVkaWE6DAAFCgABHJ/Ac2OW8AAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2062578756183584768\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":36.64,\"rgb\":{\"blue\":87,\"green\":109,\"red\":137}},{\"percentage\":32.4,\"rgb\":{\"blue\":191,\"green\":199,\"red\":214}},{\"percentage\":9.42,\"rgb\":{\"blue\":103,\"green\":103,\"red\":103}},{\"percentage\":8.06,\"rgb\":{\"blue\":129,\"green\":160,\"red\":207}},{\"percentage\":7.2,\"rgb\":{\"blue\":50,\"green\":48,\"red\":49}}]},\"original_img_height\":1717,\"original_img_url\":\"https://pbs.twimg.com/media/HJ_Ac2OW8AA35fx.jpg\",\"original_img_width\":2445},\"media_key\":\"3_2062578756183584768\"},{\"id\":\"QXBpTWVkaWE6DAAFCgABHJ/AWMAXwAAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2062578641771413504\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":42.52,\"rgb\":{\"blue\":245,\"green\":245,\"red\":245}},{\"percentage\":41.52,\"rgb\":{\"blue\":37,\"green\":32,\"red\":35}},{\"percentage\":1.55,\"rgb\":{\"blue\":47,\"green\":63,\"red\":72}},{\"percentage\":1.52,\"rgb\":{\"blue\":142,\"green\":156,\"red\":180}},{\"percentage\":1.01,\"rgb\":{\"blue\":82,\"green\":57,\"red\":62}}]},\"original_img_height\":1964,\"original_img_url\":\"https://pbs.twimg.com/media/HJ_AWMAXwAA9ai6.jpg\",\"original_img_width\":3024},\"media_key\":\"3_2062578641771413504\"},{\"id\":\"QXBpTWVkaWE6DAAFCgABHJ/ALg5W8AAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2062578458400583680\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":94.91,\"rgb\":{\"blue\":255,\"green\":255,\"red\":255}},{\"percentage\":2.81,\"rgb\":{\"blue\":195,\"green\":233,\"red\":175}},{\"percentage\":1.28,\"rgb\":{\"blue\":94,\"green\":81,\"red\":74}},{\"percentage\":0.53,\"rgb\":{\"blue\":151,\"green\":142,\"red\":138}},{\"percentage\":0.12,\"rgb\":{\"blue\":161,\"green\":221,\"red\":127}}]},\"original_img_height\":804,\"original_img_url\":\"https://pbs.twimg.com/media/HJ_ALg5W8AAaSg6.jpg\",\"original_img_width\":1206},\"media_key\":\"3_2062578458400583680\"},{\"id\":\"QXBpTWVkaWE6DAAFCgABHJ/AZ7aWMAAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2062578706036436992\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":78.75,\"rgb\":{\"blue\":255,\"green\":255,\"red\":255}},{\"percentage\":9.55,\"rgb\":{\"blue\":111,\"green\":117,\"red\":122}},{\"percentage\":5.64,\"rgb\":{\"blue\":101,\"green\":137,\"red\":172}},{\"percentage\":3.87,\"rgb\":{\"blue\":36,\"green\":47,\"red\":63}},{\"percentage\":2.45,\"rgb\":{\"blue\":16,\"green\":108,\"red\":238}}]},\"original_img_height\":1732,\"original_img_url\":\"https://pbs.twimg.com/media/HJ_AZ7aWMAAeAmf.jpg\",\"original_img_width\":2983},\"media_key\":\"3_2062578706036436992\"},{\"id\":\"QXBpTWVkaWE6DAAFCgABHJ/ASXBWsAAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2062578576008851456\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":42.97,\"rgb\":{\"blue\":28,\"green\":27,\"red\":28}},{\"percentage\":24.8,\"rgb\":{\"blue\":229,\"green\":229,\"red\":229}},{\"percentage\":6.92,\"rgb\":{\"blue\":60,\"green\":76,\"red\":117}},{\"percentage\":4.1,\"rgb\":{\"blue\":90,\"green\":121,\"red\":134}},{\"percentage\":3.16,\"rgb\":{\"blue\":196,\"green\":153,\"red\":93}}]},\"original_img_height\":1713,\"original_img_url\":\"https://pbs.twimg.com/media/HJ_ASXBWsAADjMS.jpg\",\"original_img_width\":2486},\"media_key\":\"3_2062578576008851456\"},{\"id\":\"QXBpTWVkaWE6DAAFCgABHJ/APkYWgAAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2062578528055361536\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":98.91,\"rgb\":{\"blue\":29,\"green\":27,\"red\":26}},{\"percentage\":0.57,\"rgb\":{\"blue\":23,\"green\":238,\"red\":195}},{\"percentage\":0.31,\"rgb\":{\"blue\":97,\"green\":95,\"red\":94}},{\"percentage\":0.13,\"rgb\":{\"blue\":27,\"green\":163,\"red\":135}}]},\"original_img_height\":646,\"original_img_url\":\"https://pbs.twimg.com/media/HJ_APkYWgAAq57B.jpg\",\"original_img_width\":2744},\"media_key\":\"3_2062578528055361536\"}],\"modified_at\":\"2026-06-04T17:08:06.000Z\",\"preview_text\":\"we automated an entire AI UGC studio with Claude + Higgsfield AI for context I make $1M+/yr across my apps and businesses. and very recently we scaled one of our apps to $720,000/yr and #22 on the\",\"title\":\"Our app makes $720,000/yr and print 8M views/week using this agentic AI UGC system.\"},\"author\":{\"avatar_url\":\"https://pbs.twimg.com/profile_images/1930138018951643136/wEgZY178_200x200.jpg\",\"banner_url\":\"https://pbs.twimg.com/profile_banners/1890388644273258496/1742417398\",\"description\":\"I own a few apps. currently at $200k MRR, sharing daily B2C scaling strategies. founder of @tryviewtrack\",\"followers\":58728,\"following\":794,\"id\":\"1890388644273258496\",\"joined\":\"Fri Feb 14 13:12:38 +0000 2025\",\"likes\":13792,\"location\":\"\",\"media_count\":1917,\"name\":\"Ernesto Lopez\",\"protected\":false,\"raw_description\":{\"facets\":[],\"text\":\"I own a few apps. currently at $200k MRR, sharing daily B2C scaling strategies. founder of @tryviewtrack\"},\"screen_name\":\"ErnestoSOFTWARE\",\"statuses\":7090,\"type\":\"profile\",\"url\":\"https://x.com/ErnestoSOFTWARE\",\"verification\":{\"type\":\"individual\",\"verified\":true,\"verified_at\":null},\"website\":null},\"bookmarks\":1963,\"community_note\":null,\"created_at\":\"Thu Jun 04 17:08:06 +0000 2026\",\"created_timestamp\":1780592886,\"embed_card\":\"tweet\",\"id\":\"2062582178236727320\",\"is_note_tweet\":false,\"lang\":null,\"likes\":482,\"media\":{},\"possibly_sensitive\":false,\"provider\":\"twitter\",\"quotes\":15,\"raw_text\":{\"display_text_range\":[0,23],\"facets\":[],\"text\":\"https://t.co/vwKQ5fWGMd\"},\"replies\":32,\"replying_to\":null,\"reposted_by\":null,\"reposts\":37,\"source\":\"Twitter Web App\",\"text\":\"\",\"type\":\"status\",\"url\":\"https://x.com/ErnestoSOFTWARE/status/2062582178236727320\",\"views\":601950},{\"article\":{\"content\":{\"blocks\":[{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":28,\"offset\":78,\"style\":\"Bold\"}],\"key\":\"7of27\",\"text\":\"We have scaled our business to over $1M/yr with  projects across every space, B2C apps, SaaS and services.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"aannd\",\"text\":\"And so far SaaS has been the hardest to crack by a mile.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"43qfh\",\"text\":\"With B2C apps the formula is pretty simple.\\n→ You get attention,\\n→ build a good onboarding,\\n→ add a strong paywall\\n→ and scale with creators or paid ads.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"2he85\",\"text\":\"Services are also pretty straight forward.\\n→ You find a painful problem,\\n→ find the people with the proble\\n→ sell the outcome, \\n→and fulfill the service.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"8dhd1\",\"text\":\"But SaaS is different, because mostly you are selling to other founders\\nspecially if your SAAS is X based\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"dd6q4\",\"text\":\"but we found a clear blueprint on how anyone can take their SaaS\\nfrom $0 to $10k MRR from doing it ourselves\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":0,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"31q2a\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"3avto\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"bhgrc\",\"text\":\"1. Build software from your own pain\",\"type\":\"header-two\"},{\"data\":{\"urls\":[{\"fromIndex\":0,\"text\":\"viewtrack.app\",\"toIndex\":13}]},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"d968j\",\"text\":\"viewtrack.app came from a problem inside our own business\\nMost people start SaaS by asking the wrong question.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5j875\",\"text\":\"They ask “what SaaS should I build?” \\n\\nwhen the better question is what problem am I already dealing with every day that could be turned into software.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"6ngcs\",\"text\":\"That is exactly how Viewtrack started.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5hm56\",\"text\":\"We were scaling multiple apps with creators. \\n\\nUGC creators, influencers, faceless pages, organic content.\\nAt first, it was manageable because we only had a few creators.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"19vqr\",\"text\":\"But once you start working with 10, 20, 30+ creators,\\n the whole thing starts breaking.\\n\\nso we said why don't we simply creator tracking from this: \",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":1,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"as7gn\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"d2nsr\",\"text\":\"to this: \",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":2,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"31kq9\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"4nunj\",\"text\":\"And when you are running creator campaigns for apps, \\nthis is not a small problem.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"8lkhe\",\"text\":\"This is directly tied to revenue.\\n If they use the wrong CTA, you lose downloads.\\n\\nIf you don’t know which videos are working, you can’t scale.\\nSo Viewtrack was not some random idea we pulled out of nowhere.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"6adbc\",\"text\":\"It was software we needed for ourselves.\\n\\nThe best SaaS ideas usually come from a problem \\nyou already understand deeply.\\n\\nwhen you understand the pain, \\n\\nyou know exactly what needs to be built.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"dme58\",\"text\":\"2. Validate the pain before building too much\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"fuo6h\",\"text\":\"Once you find a problem, \\ndon’t disappear for 6 months building a giant product nobody will use.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"f8m2e\",\"text\":\"That is how founders waste their life.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"e98eg\",\"text\":\"The goal is to find out if other people have the same problem\\nbefore you overbuild.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5j4ut\",\"text\":\"For Viewtrack, the validation was pretty obvious because we were already talking to founders, agencies and creators every day.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"8r8e2\",\"text\":\"Everyone running UGC had some version of the same mess.\\nThat is usually a good sign.\\n\\nbut for your SAAS you can validate on reddit or looking for the top people in your space and dming people in their comments.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"4cp72\",\"text\":\"Your job is to build a version that saves time and ultimately helps them make more money..\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"9vk8r\",\"text\":\"3. Build the smallest useful version\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"81gnu\",\"text\":\"Your first version should not be huge. \\nIt should be useful.\\n\\nmost founders overbuild \\nWhich is literally why most of them make $0\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"brgq4\",\"text\":\"For Viewtrack, the first version only needed to answer a few questions.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"18uol\",\"text\":\"Who are the creators? \\nWhat are they supposed to post?\\nWhen are they supposed to post? \\nDid they post? \\nHow many views did they get? \\nWhich creators are actually worth keeping?\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"fomug\",\"text\":\"That’s the all we needed to solve for mvp 1.\\n\\nVersion 1 should be simple enough that you can send it out to a few people\\nand use it for it's core purpose.\\n\\nfor example this is viewtrack MVP1 vs how it looks now\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":3,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"81jck\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"fr2em\",\"text\":\"\\n4. HOW TO ACTUALLY GET SALES THROUGH X MARKETING\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"7c7a\",\"text\":\"The most important part here is to not be a bot.\\nMost founders post on X like clankers.\\n\\n They say stuff like “just launched my new SaaS” \\nor “excited to announce” literally nobody cares g.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"fbigg\",\"text\":\"You need a format that actually gets attention.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"1ql6\",\"text\":\"I’ve been doing X for about a year now, and the main reason it worked is because I shared my own experiences and real valuable information in my niche.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"c2ul6\",\"text\":\"So now when I launched something like Viewtrack, \\npeople already know I’m not just saying random stuff.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"4vbrn\",\"text\":\"They have seen me scale apps with creators before.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"d6huc\",\"text\":\"That’s why I think it’s ideal to build a SaaS around something you have already done yourself, which will help your X strategy\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"3c4ro\",\"text\":\"For Viewtrack, I started making posts that i knew would go super viral.\\nX loves free sauce. \\n\\nSo instead of saying \\\" go try viewtrack \\\"\\n\\nI gave away valuable information while displaying Viewtrack in action \\nAnd that got me 500k views with just 1 post\\n\\nthen to convert i simply added a small CTA in the visual + in the text copy.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":4,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"btmsi\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"7kfsq\",\"text\":\"People click because the information is good,\\nand then they realize theres a product they can use behind it.\\n\\nThat is how you should market on X.\\ndon't talk about your SAAS show your SAAS in action.\\n\\nit may take some time, but consistency is key.\\nbig accounts like mine with 50k+ followers \\n\\nalso  started with 0 followers at some point \",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"1ueea\",\"text\":\"5. Prevent churn \",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"b7nfa\",\"text\":\"Once you have a banger product and actually start getting sales, the most important part is preventing churn.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5ej2m\",\"text\":\"This is where SaaS gets annoying.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"8t9a\",\"text\":\"Because most users don’t churn because your product is trash.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"bsd45\",\"text\":\"A lot of the time they churn because they literally don’t understand how to use it.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"1tt3e\",\"text\":\"Especially with a product like Viewtrack.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5tuu8\",\"text\":\"The product has a ton of different capabilities, so if someone signs up and gets overwhelmed, the easiest thing for them to do is just leave.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"6tvcq\",\"text\":\"That is what we are trying to prevent.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"ealh9\",\"text\":\"This is where Poly is insane.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"9kge6\",\"text\":\"We use Poly to have a voice agent inside the product that users can talk to whenever they get confused.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"ddfre\",\"text\":\"The agent talks super clearly, just like a human, and it is trained on the whole platform.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"452nh\",\"text\":\"So when a user clicks the little button, the agent can see their dashboard, understand what they are trying to do, and guide them through the exact question they have.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"btpus\",\"text\":\"It’s literally like being on a call with a specialist.\\n\\n\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":5,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"7c7c0\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"8uj2d\",\"text\":\"Except you don’t need to hire a whole support team.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"fh3jh\",\"text\":\"And hiring a support team for every confused user gets expensive fast.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5ceqn\",\"text\":\"With Poly, you can basically give every user instant help without adding a ton of overhead.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5nc2r\",\"text\":\"and thats an easy way to reduce churn by 30% to 50%\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"62itp\",\"text\":\"The $0 to $10k MRR blueprint\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"3lrlj\",\"text\":\"those are the 5 steps i would follow to build a world class $10k/mrr SAAS from scratch all over again. \\n\\nif you found this article useful!  feel free to follow me for more value.\",\"type\":\"unstyled\"}],\"entityMap\":[{\"key\":\"4\",\"value\":{\"data\":{\"entityKey\":\"27452d13-6ecd-4a0f-bd82-71d7ed8bca5e\",\"mediaItems\":[{\"localMediaId\":\"1\",\"mediaCategory\":\"AmplifyVideo\",\"mediaId\":\"2056111557067632640\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"5\",\"value\":{\"data\":{\"entityKey\":\"2b054f58-fba6-4987-947e-422d2379895c\",\"mediaItems\":[{\"localMediaId\":\"23\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2056121811562004481\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"1\",\"value\":{\"data\":{\"entityKey\":\"c08b3461-bde7-4ed2-a9f1-c961cc5603af\",\"mediaItems\":[{\"localMediaId\":\"7\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2056114834538704896\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"0\",\"value\":{\"data\":{\"entityKey\":\"6eaf40d7-9480-45ba-a955-5fc7f9c3827d\",\"mediaItems\":[{\"localMediaId\":\"5\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2056114547455356928\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"2\",\"value\":{\"data\":{\"entityKey\":\"a39fb961-6529-402f-8ba9-6f02237d00da\",\"mediaItems\":[{\"localMediaId\":\"14\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2056115659008831488\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"3\",\"value\":{\"data\":{\"entityKey\":\"d6ef1eb2-a5e4-43c1-813f-3944df7b395b\",\"mediaItems\":[{\"localMediaId\":\"21\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2056117110003089408\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}}]},\"cover_media\":{\"id\":\"QXBpTWVkaWE6DAAFCgABHIsCJxNWMAEKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2056740021676158977\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":89.75,\"rgb\":{\"blue\":0,\"green\":0,\"red\":0}},{\"percentage\":6.46,\"rgb\":{\"blue\":10,\"green\":54,\"red\":11}},{\"percentage\":2.56,\"rgb\":{\"blue\":54,\"green\":155,\"red\":61}},{\"percentage\":0.6,\"rgb\":{\"blue\":17,\"green\":95,\"red\":20}},{\"percentage\":0.37,\"rgb\":{\"blue\":67,\"green\":138,\"red\":71}}]},\"original_img_height\":724,\"original_img_url\":\"https://pbs.twimg.com/media/HIsCJxNWMAEUYwU.jpg\",\"original_img_width\":1810},\"media_key\":\"3_2056740021676158977\"},\"created_at\":\"2026-05-19T14:14:19.000Z\",\"id\":\"2056095196602134528\",\"media_entities\":[{\"id\":\"QXBpTWVkaWE6DAAFCgABHIjLniZWQAAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2056117110003089408\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":52.47,\"rgb\":{\"blue\":255,\"green\":255,\"red\":255}},{\"percentage\":42.84,\"rgb\":{\"blue\":22,\"green\":20,\"red\":20}},{\"percentage\":4.1,\"rgb\":{\"blue\":123,\"green\":123,\"red\":123}},{\"percentage\":0.3,\"rgb\":{\"blue\":45,\"green\":129,\"red\":251}},{\"percentage\":0.26,\"rgb\":{\"blue\":133,\"green\":179,\"red\":252}}]},\"original_img_height\":1695,\"original_img_url\":\"https://pbs.twimg.com/media/HIjLniZWQAANmIn.jpg\",\"original_img_width\":125