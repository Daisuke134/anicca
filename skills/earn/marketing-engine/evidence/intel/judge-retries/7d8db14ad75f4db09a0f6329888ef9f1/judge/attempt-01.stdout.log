s\":[],\"inlineStyleRanges\":[],\"key\":\"e43qr\",\"text\":\"顔出しなし。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"1fn7d\",\"text\":\"撮影なし。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"9v1ja\",\"text\":\"文章が得意じゃなくてもOK。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"c1bp6\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"8luvh\",\"text\":\"やることは、Claude Codeに\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"2re19\",\"text\":\"・商品リサーチ\\n・記事構成\\n・比較表\\n・紹介文\\n・Threads投稿\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"evt7i\",\"text\":\"までまとめて作らせて、\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"8lk\",\"text\":\"自分は商品情報の確認と\\n経験やストーリーを加えるだけ。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"1njl4\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"b75dg\",\"text\":\"「いや、AIに記事を書かせて\\n　本当に収益につながるの？」\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"au6mb\",\"text\":\"って思うかもしれません。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"7hsc0\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5t4d3\",\"text\":\"僕も最初は、AIで作った文章なんて、\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"etp5a\",\"text\":\"読者にバレるし、\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"4nkjm\",\"text\":\"検索にも評価されないし、\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"52o4p\",\"text\":\"結局、売れないと思ってました。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5he8s\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"fp4th\",\"text\":\"でも実際に、仕組みを分解してみると\\n他のアフィリエイトとは\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":13,\"offset\":0,\"style\":\"Bold\"}],\"key\":\"62omj\",\"text\":\"『攻略パターンが少し違う』\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"b8gug\",\"text\":\"と気づいたんです。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"e1gs3\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"a2vr7\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"aosc5\",\"text\":\"というのも、理由が3つあって\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"ejjvp\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":22,\"offset\":6,\"style\":\"Bold\"}],\"key\":\"2me73\",\"text\":\"1つ目は、\\n楽天には“買う前提の人”が集まっていること。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5ulul\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"2qo05\",\"text\":\"\\n楽天市場を見ている人の多くは、\\n\\nすでに欲しい商品が決まっていたり、\\n複数の商品を比較していたりします。\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"966oc\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"2nqn4\",\"text\":\"つまり、ゼロから欲しくさせるのではなく、\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":12,\"offset\":0,\"style\":\"Bold\"}],\"key\":\"ajlo2\",\"text\":\"「どれを選べばいいか？」\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":7,\"offset\":0,\"s