img_width\":1313},\"media_key\":\"3_2056115659008831488\"},{\"id\":\"QXBpTWVkaWE6DAAECgABHIjGkUGXcAAKAAIAAAAAAAAAAAAA\",\"media_id\":\"2056111557067632640\",\"media_info\":{\"__typename\":\"ApiVideo\",\"aspect_ratio\":{\"denominator\":540,\"numerator\":689},\"duration_millis\":15092,\"preview_image\":{\"color_info\":{\"palette\":[{\"percentage\":100,\"rgb\":{\"blue\":0,\"green\":0,\"red\":0}}]},\"original_img_height\":1080,\"original_img_url\":\"https://pbs.twimg.com/amplify_video_thumb/2056111557067632640/img/d6uPkjFuxkfC-ivK.jpg\",\"original_img_width\":1378},\"variants\":[{\"bit_rate\":256000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2056111557067632640/vid/avc1/344x270/6myreqx_ch4NbiPj.mp4?tag=27\"},{\"bit_rate\":10368000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2056111557067632640/vid/avc1/1378x1080/J705QD_UOX8n2Rru.mp4?tag=27\"},{\"bit_rate\":2176000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2056111557067632640/vid/avc1/918x720/__YoLKStKGRgjVDb.mp4?tag=27\"},{\"bit_rate\":832000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2056111557067632640/vid/avc1/458x360/uBg1zLOQFsdbypgX.mp4?tag=27\"},{\"content_type\":\"application/x-mpegURL\",\"url\":\"https://video.twimg.com/amplify_video/2056111557067632640/pl/vlKY472ZoxbzjRLj.m3u8?tag=27\"}]},\"media_key\":\"13_2056111557067632640\"},{\"id\":\"QXBpTWVkaWE6DAAFCgABHIjJSYKW8AAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2056114547455356928\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":71.95,\"rgb\":{\"blue\":28,\"green\":23,\"red\":22}},{\"percentage\":24.19,\"rgb\":{\"blue\":255,\"green\":255,\"red\":255}},{\"percentage\":1.65,\"rgb\":{\"blue\":8,\"green\":35,\"red\":22}},{\"percentage\":0.12,\"rgb\":{\"blue\":23,\"green\":106,\"red\":41}}]},\"original_img_height\":500,\"original_img_url\":\"https://pbs.twimg.com/media/HIjJSYKW8AADcwh.png\",\"original_img_width\":500},\"media_key\":\"3_2056114547455356928\"},{\"id\":\"QXBpTWVkaWE6DAAFCgABHIjJjFoXMAAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2056114834538704896\",\"media_info\":{\"__typename\":\"ApiImage\",\"color_info\":{\"palette\":[{\"percentage\":65.18,\"rgb\":{\"blue\":221,\"green\":224,\"red\":225}},{\"percentage\":16.5,\"rgb\":{\"blue\":125,\"green\":207,\"red\":208}},{\"percentage\":4.75,\"rgb\":{\"blue\":121,\"green\":185,\"red\":224}},{\"percentage\":3.29,\"rgb\":{\"blue\":168,\"green\":203,\"red\":184}},{\"percentage\":1.5,\"rgb\":{\"blue\":229,\"green\":207,\"red\":196}}]},\"original_img_height\":660,\"original_img_url\":\"https://pbs.twimg.com/media/HIjJjFoXMAAcdLV.jpg\",\"original_img_width\":1400},\"media_key\":\"3_2056114834538704896\"}],\"modified_at\":\"2026-05-19T14:14:19.000Z\",\"preview_text\":\"We have scaled our business to over $1M/yr with  projects across every space, B2C apps, SaaS and services.\\nAnd so far SaaS has been the hardest to crack by a mile.\\nWith B2C apps the formula is pretty\",\"title\":\"HOW TO BUILD A $10K/MO SAAS ( in 5 simple steps )\"},\"author\":{\"avatar_url\":\"https://pbs.twimg.com/profile_images/1930138018951643136/wEgZY178_200x200.jpg\",\"banner_url\":\"https://pbs.twimg.com/profile_banners/1890388644273258496/1742417398\",\"description\":\"I own a few apps. currently at $200k MRR, sharing daily B2C scaling strategies. founder of @tryviewtrack\",\"followers\":58728,\"following\":794,\"id\":\"1890388644273258496\",\"joined\":\"Fri Feb 14 13:12:38 +0000 2025\",\"likes\":13792,\"location\":\"\",\"media_count\":1917,\"name\":\"Ernesto Lopez\",\"protected\":false,\"raw_description\":{\"facets\":[],\"text\":\"I own a few apps. currently at $200k MRR, sharing daily B2C scaling strategies. founder of @tryviewtrack\"},\"screen_name\":\"ErnestoSOFTWARE\",\"statuses\":7090,\"type\":\"profile\",\"url\":\"https://x.com/ErnestoSOFTWARE\",\"verification\":{\"type\":\"individual\",\"verified\":true,\"verified_at\":null},\"website\":null},\"bookmarks\":578,\"community_note\":null,\"created_at\":\"Tue May 19 14:14:19 +0000 2026\",\"created_timestamp\":1779200059,\"embed_card\":\"tweet\",\"id\":\"2056740238890766383\",\"is_note_tweet\":false,\"lang\":null,\"likes\":194,\"media\":{},\"possibly_sensitive\":false,\"provider\":\"twitter\",\"quotes\":1,\"raw_text\":{\"display_text_range\":[0,23],\"facets\":[],\"text\":\"https://t.co/UVi5HEaz1e\"},\"replies\":5,\"replying_to\":null,\"reposted_by\":null,\"reposts\":7,\"source\":\"Twitter Web App\",\"text\":\"\",\"type\":\"status\",\"url\":\"https://x.com/ErnestoSOFTWARE/status/2056740238890766383\",\"views\":105171},{\"article\":{\"content\":{\"blocks\":[{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"953v5\",\"text\":\"Last 2 weeks we generated 17M views with an army of 30 UGC creators\\nwhich is great, yet this posed a problem we had not thought about before.\\n\\nrunning a team at this scale  is costing us over $6,000/week base,  but its working... our revenue nearly tripled in the last 2 weeks and our app is ranking #30 in the appstore.\\n\\nlast week it was more like $10,000 in spend between ads and our UGC team\\nwhich is normal when you mass hire. \\n\\nbecause 90% of our UGC campaigns success comes from the top 5-6 creators the rest are mostly noise.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":0,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"cvqec\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"2b97m\",\"text\":\"These cost will obviously decrease as we fire the creators that are not performing and keep the killers.\\n\\nbut i encourage you to watch $10,000 leaving your bank account every week \\nit really makes you ask yourself some questions. \\n\\nand for us that question was, how do we take our margins from 30% to 70%\\nand become extremely profitable? \",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"5ljh7\",\"text\":\"and the answer to that question is the reason i'm writing this article. \",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":38,\"offset\":684,\"style\":\"Bold\"}],\"key\":\"8jtrd\",\"text\":\"We paid a guy $3.5k last week in bonuses \\n\\nand he told us that he was surprised we wanted to continue \\nworking with him.\\n\\nHe explained that most brands he works with fire him after he goes viral.\\n\\nIn my opinion thats either because their product sucks or because they have no money to sustain the cost. \\n\\nThankfully we have a great app all around that helps us stay profitable nonetheless.\\n\\nso while the average NGMI founder is stopping their UGC campaing\\nwe are thinking how do we go beyond 30 creators \\n\\nHow do we get 60 creators without having to double our weekly spend which would be $12,000/week \\n\\nand thats when we turned our eyes toward AI UGC\\n\\nviral content is no more than \\nHook, script, face, delivery, post.  \\n\\nits a system, a system that can skillfully be replicated with AI. \\nand distributed at mass scale to create the same effect of Real UGC\\n\\nat 1/10th of the cost, this is why I deeply believe AI ugc is the future.\\n\\nwe have already started to test AI ugc and it works \\nwith some of our videos getting up to 18k views.\\n\\nand while thats not a lot, we literally just started, and nobody knows it's AI\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":1,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"5l46e\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"fm9ec\",\"text\":\"AI ugc is not a theory, its all around us already.  \\nI've talked to the team from a looks maxing app  \\n\\nthey're doing over $30k/mo  running only AI UGC content.\\n\\nI also talked to another 18yo kid who scaled his quit gooning app to $10k/mo with 1 single AI UGC creator.\\n\\nthere are plenty of examples so let me just list them a few out here:\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":2,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"6li5h\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[{\"key\":3,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"4plg2\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[{\"key\":4,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"bog37\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[{\"key\":5,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"btbcn\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"1be46\",\"text\":\"\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[{\"key\":6,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"623cn\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"cff9n\",\"text\":\"\\nThese accounts alone together have generated over 300+ million views, but how do you actually build an AI UGC creator\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"2tags\",\"text\":\"What I learned from talking to a founder making $100k/mo with AI UGC\",\"type\":\"header-two\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"bilg3\",\"text\":\"I wanted to see how the top killers in the AI UGC space were scaling\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":44,\"offset\":182,\"style\":\"Bold\"}],\"key\":\"9cimn\",\"text\":\"So I got on a call with a founder making $100k/mo with his app that he is scaling with AI UGC, he has been on starter story with verified metrics.\\n\\nhe gave me a super simple system\\n\\n1.  you find a format that already works. \\n\\nfind videos that already went viral in your niche.\\n\\nFor us, this is easy because our real UGC creators already \\nshowed us what works.\\n\\nbut you can find this by just scrolling on your niche.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"a8ppd\",\"text\":\"so he basically takes the winning viral format, him and his team finds\\nand rebuild them with AI.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"38dvj\",\"text\":\"Then they break the video down.\\nEvery viral UGC video is basically:\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"44c2g\",\"text\":\"Hook → Script →Face → Delivery .\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"2tnss\",\"text\":\"Once you see it that way, it stops being a video \\nand becomes a recipe  that can be automated.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":33,\"offset\":0,\"style\":\"Bold\"}],\"key\":\"27rj1\",\"text\":\"2. you build your AI UGC creator.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":7,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"40tjk\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"7dvib\",\"text\":\"\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"6k5i9\",\"text\":\"you can run the whole thing through Higgsfield Supercomputer.  so you give higgsfield supercomputer the winning format,  the creator and the prompt.\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"fjp8e\",\"text\":\"and It handles the rest.\\nScript, Video Editing, Final asset.\\n\\nAnd the best part is once you get the AI video back if it looks good.\\nyou can just tell higgs super computer  to create your 100s of variations \\n\\nAnd then again spread that across 5-10 influencers\\nAnd now you literally have an army.\\n\\nI've already created 4 influencers for our app\",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[{\"key\":8,\"length\":1,\"offset\":0}],\"inlineStyleRanges\":[],\"key\":\"8i52p\",\"text\":\" \",\"type\":\"atomic\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[{\"length\":59,\"offset\":0,\"style\":\"Bold\"}],\"key\":\"bom14\",\"text\":\"3. Scale with clippers \\n\\nOnce you have your AI ugc creators \",\"type\":\"unstyled\"},{\"data\":{},\"entityRanges\":[],\"inlineStyleRanges\":[],\"key\":\"mkbi\",\"text\":\"you can basically hire US based clippers for $100 a month,literally, to just hit post on the videos that you give them, \\n\\n ideally someone you know like you 14yo cousin with a scrolling addiction. \\n\\nsince Higgsfield already edits the videos for you and makes them for you. \\nyou just give the clippers a google drive folder with the content to post\\n\\nIf you don't wanna fully automate it, it's fine to start just posting yourself. \\n\\nYou can do up to 4 or 8  account in your own phone , and if you run out of space just buy a new iphone 8 for $250 and run up 8 more.\\n\\nShadow bans don't exist. \\nand so now instead of paying $900/mo per creator \\n\\nyou can pay  $30-$100/mo per realistic AI UGC creator that you make.\\n\\nand thats literally all you have to do. \\n\\nI will keep using  this tech and keep you guys posted on how this continues to work for us.\\n\\nbe sure to follow for more daily sauce like this!\\n\",\"type\":\"unstyled\"}],\"entityMap\":[{\"key\":\"8\",\"value\":{\"data\":{\"entityKey\":\"0591eaa3-a4a6-413b-92d3-17d511c6e0e1\",\"mediaItems\":[{\"localMediaId\":\"28\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2055119664225656832\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"4\",\"value\":{\"data\":{\"entityKey\":\"bb77f28b-534e-4ad7-ab4a-2499ce772ca4\",\"mediaItems\":[{\"localMediaId\":\"12\",\"mediaCategory\":\"AmplifyVideo\",\"mediaId\":\"2055117754051481600\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"5\",\"value\":{\"data\":{\"entityKey\":\"2dd7055b-a1c8-49ad-8662-8c5f9abb0b62\",\"mediaItems\":[{\"localMediaId\":\"16\",\"mediaCategory\":\"AmplifyVideo\",\"mediaId\":\"2055117865531908096\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"6\",\"value\":{\"data\":{\"entityKey\":\"66ca9ac0-b91f-4b17-8d8e-5a4388df2dfb\",\"mediaItems\":[{\"localMediaId\":\"23\",\"mediaCategory\":\"AmplifyVideo\",\"mediaId\":\"2055118074542489600\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"1\",\"value\":{\"data\":{\"entityKey\":\"d3e4c68f-45fb-408a-b1b9-617dc27a3cec\",\"mediaItems\":[{\"localMediaId\":\"31\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2055120237872168960\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"0\",\"value\":{\"data\":{\"entityKey\":\"4e1967fb-58dd-44cf-b5f5-60164258ae29\",\"mediaItems\":[{\"localMediaId\":\"2\",\"mediaCategory\":\"DraftTweetImage\",\"mediaId\":\"2055078890956013568\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"2\",\"value\":{\"data\":{\"entityKey\":\"4610d09c-62e5-4d7b-890b-cd78c78b6a6b\",\"mediaItems\":[{\"localMediaId\":\"3\",\"mediaCategory\":\"AmplifyVideo\",\"mediaId\":\"2055096528679686144\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"7\",\"value\":{\"data\":{\"entityKey\":\"1a58d160-d60a-4395-b086-3f976dfc1253\",\"mediaItems\":[{\"localMediaId\":\"10\",\"mediaCategory\":\"AmplifyVideo\",\"mediaId\":\"2055167361766879232\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}},{\"key\":\"3\",\"value\":{\"data\":{\"entityKey\":\"54027b61-81d1-4dd2-b0f8-ee00897d909a\",\"mediaItems\":[{\"localMediaId\":\"14\",\"mediaCategory\":\"AmplifyVideo\",\"mediaId\":\"2055117831969116160\"}]},\"mutability\":\"Immutable\",\"type\":\"MEDIA\"}}]},\"cover_media\":{\"id\":\"QXBpTWVkaWE6DAAFCgABHIVvylvXcAAKAAIaPAJ0zVcAAAAA\",\"media_id\":\"2055171719879421952\",\"media_info\":{\"__typename\":\"ApiImage\",\"