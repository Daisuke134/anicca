{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aniccaai.com/schemas/marketing-ad-swipe-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "platform", "advertiser", "product_id", "source_url", "source_null_reason", "captured_at", "first_seen_at", "last_seen_at", "impressions", "impressions_null_reason", "why_it_works", "replication_plan", "status", "evidence_url", "evidence_null_reason"],
  "properties": {
    "schema_version": {"const": "marketing.ad-swipe.v1"},
    "id": {"type": "string"},
    "platform": {"enum": ["meta", "tiktok", "youtube", "app_store", "web"]},
    "advertiser": {"type": "string", "minLength": 1},
    "product_id": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"]},
    "source_null_reason": {"type": ["string", "null"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "first_seen_at": {"type": ["string", "null"]},
    "last_seen_at": {"type": ["string", "null"]},
    "impressions": {"type": ["integer", "null"], "minimum": 0},
    "impressions_null_reason": {"type": ["string", "null"]},
    "why_it_works": {"type": "string"},
    "replication_plan": {"type": "string"},
    "status": {"enum": ["new", "queued", "tested", "won", "lost", "retired"]},
    "evidence_url": {"type": ["string", "null"]},
    "evidence_null_reason": {"type": ["string", "null"]}
  }
}
