{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "portfolio_source_digest", "created_at", "items"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "capafy_portfolio_cleanup"},
    "portfolio_source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string"},
    "items": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "observed_at", "claim", "confidence"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "observed_at": {"type": "string"},
        "claim": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "triggers", "related_agent_ids", "action", "action_reason", "stop_condition", "evidence", "status", "remote_url"],
      "properties": {
        "agent_id": {"type": "string", "pattern": "^[0-9]+$"},
        "triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["under_review", "draft", "rejected", "overlap"]}},
        "related_agent_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]+$"}},
        "action": {"type": "string", "enum": ["repair", "reposition", "retire_candidate"]},
        "action_reason": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proof"}},
        "status": {"type": "string", "const": "queued"},
        "remote_url": {"type": ["string", "null"]}
      }
    }
  }
}
