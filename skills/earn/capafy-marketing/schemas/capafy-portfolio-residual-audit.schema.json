{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "portfolio_source_digest", "audited_at", "products"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "capafy_portfolio_audit"},
    "portfolio_source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "audited_at": {"type": "string"},
    "products": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"$ref": "#/$defs/product"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "observed_at", "claim", "confidence", "supports"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "observed_at": {"type": "string"},
        "claim": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "supports": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "enum": ["recurring_mechanism", "purchase_model", "value_metric", "target_customer", "next_best_alternative", "renewal_reason", "decision"]}
        }
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "recurring_mechanism", "purchase_model", "value_metric", "target_customer", "next_best_alternative", "renewal_reason", "decision", "decision_reason", "unknowns", "evidence"],
      "properties": {
        "agent_id": {"type": "string", "pattern": "^[0-9]+$"},
        "recurring_mechanism": {"type": ["string", "null"], "enum": ["repeated_workflow", "scheduled_refresh", "ongoing_monitoring", "collaboration", "metered_execution", null]},
        "purchase_model": {"type": "string", "enum": ["subscription", "usage", "one_time", "hybrid", "undecided"]},
        "value_metric": {"type": ["string", "null"]},
        "target_customer": {"type": ["string", "null"]},
        "next_best_alternative": {"type": ["string", "null"]},
        "renewal_reason": {"type": ["string", "null"]},
        "decision": {"type": "string", "enum": ["promote", "repair", "reposition", "pause", "retire_candidate"]},
        "decision_reason": {"type": "string", "minLength": 1},
        "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
