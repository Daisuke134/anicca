<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.anicca.sol-funding</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/skills/earn/sol-funding-daemon.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LIFE_MANAGER_HOME__/logs/sol-funding.log</string>
  <key>StandardErrorPath</key>
  <string>__LIFE_MANAGER_HOME__/logs/sol-funding.err</string>
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
