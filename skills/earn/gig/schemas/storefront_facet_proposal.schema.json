{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["facets", "rationale"],
  "properties": {
    "facets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 400}
  }
}
