{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["facets", "rationale"],
  "properties": {
    "facets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "values"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^[0-9]+$"},
          "values": {
            "type": "array",
            "minItems": 0,
            "maxItems": 12,
            "items": {"type": "string", "pattern": "^[0-9]+$"}
          }
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 400}
  }
}
