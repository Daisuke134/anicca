{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["sub_value", "type_value", "rationale"],
  "properties": {
    "sub_value": {"type": "string", "pattern": "^[0-9]+$"},
    "type_value": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 400}
  }
}
