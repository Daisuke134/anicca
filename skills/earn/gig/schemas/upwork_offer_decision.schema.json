{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upwork direct offer terms decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "reason_codes", "offer"],
  "properties": {
    "action": {"enum": ["accept", "request_changes", "decline"]},
    "reason_codes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 120},
      "maxItems": 20
    },
    "offer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "offer_id", "offer_url", "offer_source_sha256", "title", "scope", "contract_type", "rate_or_amount_usd", "deadline", "payment_protection", "funded_milestone_usd", "weekly_limit_hours", "account_state", "off_platform_required", "synchronous_or_physical_required"],
      "properties": {
        "provider": {"const": "upwork"},
        "offer_id": {"type": "string", "minLength": 1},
        "offer_url": {"type": "string", "pattern": "^https://www\\.upwork\\.com/"},
        "offer_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "scope": {"type": "string", "minLength": 20, "maxLength": 10000},
        "contract_type": {"enum": ["fixed_price", "hourly"]},
        "rate_or_amount_usd": {"type": "number", "exclusiveMinimum": 0},
        "deadline": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "payment_protection": {"enum": ["funded_milestone", "verified_hourly_billing"]},
        "funded_milestone_usd": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "weekly_limit_hours": {"type": ["integer", "null"], "minimum": 1, "maximum": 168},
        "account_state": {"const": "accept_enabled"},
        "off_platform_required": {"const": false},
        "synchronous_or_physical_required": {"const": false}
      }
    }
  }
}
