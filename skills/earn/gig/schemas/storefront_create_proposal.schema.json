{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision", "source_service_id", "title_stem", "catchphrase", "head", "body",
    "display_price_jpy", "delivery_days", "paid_option_title", "paid_option_price_jpy",
    "image_copy", "delivery_kind", "recurring_support_included",
    "hypothesis", "evidence", "success_metric", "observation_window_days",
    "no_op_reason", "uncertainty"
  ],
  "properties": {
    "decision": {"type": "string", "enum": ["create", "no_op"]},
    "source_service_id": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "title_stem": {"type": ["string", "null"], "minLength": 1, "maxLength": 23},
    "catchphrase": {"type": ["string", "null"], "minLength": 15, "maxLength": 30},
    "head": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
    "body": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
    "display_price_jpy": {"type": ["integer", "null"], "minimum": 500, "maximum": 1000000},
    "delivery_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 99},
    "paid_option_title": {"type": ["string", "null"], "minLength": 1, "maxLength": 60},
    "paid_option_price_jpy": {"type": ["integer", "null"], "minimum": 500, "maximum": 1000000},
    "image_copy": {"type": ["string", "null"], "maxLength": 240},
    "delivery_kind": {"type": ["string", "null"], "enum": ["implementation", "content", "analysis", "design", null]},
    "recurring_support_included": {"type": ["boolean", "null"]},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 1000},
    "evidence": {"type": "array", "minItems": 0, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "success_metric": {"type": ["string", "null"], "enum": ["inquiries", "purchases", "views_to_inquiry", "views_to_purchase", "net_receipt", null]},
    "observation_window_days": {"type": ["integer", "null"], "enum": [7, 14, null]},
    "no_op_reason": {"type": ["string", "null"], "maxLength": 1000},
    "uncertainty": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
  }
}
