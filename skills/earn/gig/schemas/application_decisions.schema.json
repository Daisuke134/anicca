{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gig application planner decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "business_class",
          "reason_codes",
          "proposal_text",
          "price_jpy",
          "deliver_date"
        ],
        "properties": {
          "request_id": {"type": "string", "pattern": "^[0-9]+$"},
          "business_class": {"enum": ["submit_required", "hard_prohibited"]},
          "reason_codes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "proposal_text": {"type": ["string", "null"], "minLength": 200, "maxLength": 3000},
          "price_jpy": {"type": ["integer", "null"], "minimum": 1},
          "deliver_date": {
            "type": ["string", "null"],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  }
}
