{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upwork public-job qualification and proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "reason_codes", "proposal"],
  "properties": {
    "decision": {"enum": ["submit", "skip"]},
    "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "proposal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "job_id", "job_url", "job_source_sha256", "title", "status", "terms", "cover_letter", "screening_answers", "unsupported_claims", "attachments"],
      "properties": {
        "provider": {"const": "upwork"},
        "job_id": {"type": "string", "pattern": "^~[0-9]{15,}$"},
        "job_url": {"type": "string", "pattern": "^https://www\\.upwork\\.com/jobs/"},
        "job_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "status": {"const": "frozen_waiting_for_connects"},
        "terms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "bid_usd", "delivery_days", "required_connects", "available_connects_before"],
          "properties": {
            "type": {"enum": ["fixed_price", "hourly"]},
            "bid_usd": {"type": "number", "exclusiveMinimum": 0},
            "delivery_days": {"type": "integer", "minimum": 1, "maximum": 365},
            "required_connects": {"type": "integer", "minimum": 0},
            "available_connects_before": {"type": "integer", "minimum": 0}
          }
        },
        "cover_letter": {"type": "string", "minLength": 80, "maxLength": 5000},
        "screening_answers": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer"],
            "properties": {
              "question": {"type": "string", "minLength": 1, "maxLength": 1000},
              "answer": {"type": "string", "minLength": 1, "maxLength": 5000}
            }
          }
        },
        "unsupported_claims": {"type": "array", "maxItems": 0},
        "attachments": {"type": "array", "maxItems": 0}
      }
    }
  }
}
