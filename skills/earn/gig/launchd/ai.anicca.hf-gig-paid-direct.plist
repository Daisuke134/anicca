<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.anicca.hf-gig-paid-direct</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
        <string>__LIFE_MANAGER_REPO__/skills/earn/gig/scripts/paid_direct.py</string>
    <string>--output</string><string>__GIG_STATE_DIR__/evidence/paid-direct-live/latest.json</string>
    <string>--evidence-dir</string><string>__GIG_STATE_DIR__/evidence/paid-direct-live</string>
    <string>--projects-root</string><string>__GIG_STATE_DIR__/projects</string>
    <string>--lock-file</string><string>__GIG_STATE_DIR__/.paid-direct.lock</string>
    <string>--cdp-lock-dir</string><string>__GIG_STATE_DIR__/.cdp-gig.lock</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>ProcessType</key><string>Background</string>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>WorkingDirectory</key><string>__HOME__</string>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CDP_LOCK_DIR</key><string>__GIG_STATE_DIR__/.cdp-gig.lock</string>
    <key>CLOAK_CONTEXT_LEASES_FILE</key><string>__HOME__/.cloak/vault/gig-leases.json</string>
    <key>CLOAK_BROWSER_OWNER</key><string>gig-paid-direct</string>
    <key>CLOAK_BROWSER_LAUNCHD_LABEL</key><string>ai.anicca.hf-gig-browser</string>
    <key>CLOAK_CDP_BASE_URL</key><string>http://127.0.0.1:9223</string>
    <key>CDP_DAILY_DRIVER_PORT</key><string>9223</string>
    <key>CDP_DAILY_DRIVER_PROFILE</key><string>__HOME__/.cloak/profiles/gig-daily-driver</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.openclaw/logs/gig-paid-direct-launchd.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.openclaw/logs/gig-paid-direct-launchd.err.log</string>
</dict></plist>
