{
  "_comment": "DistroKid upload form selectors. Fragile. Each field is an array of selector candidates tried in order until one is visible. UPDATE THIS FILE when DistroKid UI changes — that's the single point of failure.",
  "_strategy": "Prefer label-based locators (text=, role=) over CSS class names. Class names get autogenerated and break weekly.",

  "audio_file": [
    "input[type='file'][accept*='audio']",
    "input[name='audio']",
    "input[name='file']",
    "input[type='file']"
  ],

  "cover_file": [
    "input[type='file'][accept*='image']",
    "input[name='artwork']",
    "input[name='cover']"
  ],

  "track_title": [
    "input[name='songTitle']",
    "input[name='title']",
    "input[placeholder*='Title']",
    "input[aria-label*='Title']"
  ],

  "songwriter": [
    "input[name='songwriter']",
    "input[placeholder*='Songwriter']",
    "input[aria-label*='Songwriter']"
  ],

  "genre_primary": [
    "select[name='primaryGenre']",
    "select[name='genre']",
    "select[aria-label*='Primary Genre']"
  ],

  "genre_secondary": [
    "select[name='secondaryGenre']",
    "select[aria-label*='Secondary Genre']"
  ],

  "language": [
    "select[name='language']",
    "select[name='audioLanguage']",
    "select[aria-label*='Language']"
  ],

  "explicit_no": [
    "input[type='radio'][value='no']",
    "label:has-text('No') input[type='radio']"
  ],

  "ai_yes": [
    "label:has-text('はい') input[type='radio']",
    "label:has-text('Yes') input[type='radio']",
    "input[type='radio'][value='yes'][name*='ai']"
  ],

  "ai_music": [
    "label:has-text('The music') input[type='checkbox']",
    "input[type='checkbox'][name*='aiMusic']",
    "input[type='checkbox'][value='music']"
  ],

  "ai_all_audio": [
    "label:has-text('All of the audio') input[type='checkbox']",
    "input[type='checkbox'][name*='aiAllAudio']",
    "input[type='checkbox'][value='all_audio']"
  ],

  "release_date": [
    "input[name='releaseDate']",
    "input[type='date']",
    "input[aria-label*='Release Date']"
  ],

  "cb_no_streaming_bots": [
    "label:has-text('再生回数を増やすサービスを使用しません') input[type='checkbox']",
    "label:has-text('streaming') input[type='checkbox']",
    "input[name='noStreamingFraud']"
  ],

  "cb_own_recording": [
    "label:has-text('私自身がレコーディング') input[type='checkbox']",
    "label:has-text('I own this recording') input[type='checkbox']",
    "input[name='ownRecording']"
  ],

  "cb_no_other_artist": [
    "label:has-text('他のアーティストの名前を使用していません') input[type='checkbox']",
    "label:has-text('other artists') input[type='checkbox']",
    "input[name='noOtherArtists']"
  ],

  "cb_agree_terms": [
    "label:has-text('利用規約') input[type='checkbox']",
    "label:has-text('I agree') input[type='checkbox']",
    "label:has-text('Terms') input[type='checkbox']",
    "input[name='agreeTerms']"
  ],

  "submit": [
    "button:has-text('Submit')",
    "button:has-text('提出')",
    "button[type='submit']",
    "input[type='submit']"
  ],

  "isrc_display": [
    "[data-isrc]",
    "code:has-text('-')",
    "text=/[A-Z]{2}-?[A-Z0-9]{3}-?\\d{2}-?\\d{5}/"
  ]
}
