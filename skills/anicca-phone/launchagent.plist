<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.pipecat-phone</string>

  <!--
    Boots cloudflared + Pipecat Gemini Live phone bot at login and self-heals
    on crash. The wrapper writes the live tunnel URL to
    ~/.openclaw/state/anicca_phone_url.txt so cron consumers (lateness_check.py)
    pick up the current URL on every fire.
    Source: ~/.openclaw/skills/anicca-phone/outbound/run.sh
    Restored 2026-06-14 from ~/anicca/_archive_2026-06-09 (anicca-oss-pipecat repo was retired).
  -->

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/anicca/.openclaw/skills/anicca-phone/outbound/run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/anicca/.openclaw/skills/anicca-phone/outbound</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!--
    Throttle relaunch after rapid crashes (default 10s would be too tight for
    cloudflared cold-starts on a slow network).
  -->
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>/tmp/anicca-pipecat-phone.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/anicca-pipecat-phone.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/anicca</string>
  </dict>
</dict>
</plist>
