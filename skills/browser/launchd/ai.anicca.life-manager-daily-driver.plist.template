<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.anicca.life-manager-daily-driver</string>
  <key>ProgramArguments</key><array>
    <string>__CLOAK_PYTHON__</string>
    <string>__REPO_ROOT__/skills/browser/cdp_persistent_context.py</string>
    <string>--profile</string><string>__DAILY_DRIVER_PROFILE__</string>
    <string>--port</string><string>9222</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_ROOT__</string>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>__HOME__</string>
    <key>BROWSER_DISK_HEADROOM_KIB</key><string>262144</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__LIFE_MANAGER_HOME__/logs/daily-driver.out.log</string>
  <key>StandardErrorPath</key><string>__LIFE_MANAGER_HOME__/logs/daily-driver.err.log</string>
</dict></plist>
