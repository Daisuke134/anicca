# NAIST skill — environment variables.
# Copy this file to `~/.openclaw/.env` (or your runtime's env file) and replace
# every <REPLACE_ME>.  These values are READ at runtime; nothing is ever
# committed.  Secrets are also accepted in per-slug
# `~/.openclaw/state/naist/<slug>/secrets.env` (chmod 600) which takes
# precedence over the global file.

# --- Required: NAIST IDP authentication ---
# The username/password you type at https://idp.naist.jp/.
NAIST_IDP_USERNAME=<REPLACE_ME>
NAIST_IDP_PASSWORD=<REPLACE_ME>

# Base32 secret from your Google Authenticator export QR.
#   zbarimg --raw OTP-export.png | python3 scripts/decode-otp-migration.py
# Pick the entry where `issuer` is NAIST and copy its `secret_base32`.
NAIST_TOTP_SECRET=<REPLACE_ME_BASE32>

# Optional alias accepted by the scripts (for legacy compatibility).
# NAIST_EDU_USER, NAIST_EDU_PASSWORD — same as IDP_USERNAME / IDP_PASSWORD.

# --- Optional: Slack digest posting ---
# Leave empty (or unset) to skip Slack posts entirely.
SLACK_BOT_TOKEN=
SLACK_FALLBACK_CHANNEL=

# --- Optional: LLM driver for auto-draft (planned, Task #6) ---
# When set, scripts/homework-auto-draft.py uses these to call an LLM that
# turns a fetched assignment + lecture PDF into a Quarto draft.
# Recommended cheap default: DeepSeek v4-pro via OpenRouter ($0.08 / draft).
OPENROUTER_API_KEY=
HOMEWORK_DRAFT_MODEL=deepseek/deepseek-v4-pro
HOMEWORK_DRAFT_LANGUAGE=en
