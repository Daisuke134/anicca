#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
PYTHON="${LIFE_MANAGER_PYTHON:-$(command -v python3)}"
STATE_DIR="${WRITER_STATE_DIR:-$HOME/.local/state/life-manager/writer}"

exec "$PYTHON" "$ROOT/skills/writer-agent/scripts/money_sync.py" \
  --state-dir "$STATE_DIR" \
  --db "$STATE_DIR/money.sqlite3" \
  "$@"
