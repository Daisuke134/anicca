<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- SSOT 9.3.1 item H2, wired. This label is neither the one daily creator
       nor the one same-run recovery owner: it never runs article-daily.sh, it
       never runs article-resume-pending.sh, it never takes the publication
       lock, and it stops at a registered verified candidate. Deploy, resume
       and public readback are Order 5 and are not performed here. -->
  <key>Label</key>
  <string>ai.anicca.article-repair-candidate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/anicca/Projects/mr-bot-main/skills/writer-agent/scripts/article-repair-candidate.sh</string>
  </array>
  <!-- No ARTICLE_AUTOPUBLISH. The one switch that authorises publication is
       deliberately absent from this worker's environment. -->
  <key>RunAtLoad</key>
  <false/>
  <!-- One bounded attempt costs up to 900 s of model budget plus its test
       gate, so a shorter interval could only queue work it cannot start.
       launchd never starts a second copy of a label that is still running. -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/anicca/.openclaw/logs/article-repair-candidate.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/anicca/.openclaw/logs/article-repair-candidate.err</string>
</dict>
</plist>
