<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  #67 (2026-07-17, docs/loop-engineering/54-orphan-script-audit-2026-07-17.md finding 2):
  learn-whitelist.sh's own header says "Triggered weekly by
  Writer Agent whitelist-learning cron (Sun 03:00 JST)" but no such trigger (cron
  or launchd) actually existed anywhere on this machine; confirmed via `openclaw cron
  list` (zero hits) and a fresh launchd plist search before this file was added. Weekday
  0 = Sunday (launchd/cron convention).

  Activate: cp this ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) \
    ~/Library/LaunchAgents/ai.anicca.article-learn-whitelist.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.article-learn-whitelist</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/anicca/Projects/mr-bot-main/skills/writer-agent/scripts/learn-whitelist.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ARTICLE_SKILL_DIR</key>
    <string>/Users/anicca/Projects/mr-bot-main/skills/writer-agent</string>
    <key>ARTICLE_STATE_DIR</key>
    <string>/Users/anicca/.local/state/mr-bot/writer</string>
    <key>ARTICLE_SOURCE_BRANCH</key>
    <string>codex/writer-e1-incident-red</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/anicca/.openclaw/logs/article-learn-whitelist.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/anicca/.openclaw/logs/article-learn-whitelist.err</string>
</dict>
</plist>
