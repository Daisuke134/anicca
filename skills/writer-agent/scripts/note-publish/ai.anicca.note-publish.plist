<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  F3 — STAGED launchd job for the note agent. NOT ACTIVE: this file lives in the skill dir, NOT in
  ~/Library/LaunchAgents, so launchd never sees it until the "tap":
     cp this ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/ai.anicca.note-publish.plist
  Runs daily-run.sh, which runs the F2 agent with AUTONOMY=off (draft only — can never publish on its own).
  No RunAtLoad → even if loaded, it waits for the scheduled time; it never fires immediately.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.note-publish</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/anicca/Projects/mr-bot-main/skills/writer-agent/scripts/note-publish/daily-run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/anicca/Projects/mr-bot-main/skills/writer-agent/scripts/note-publish</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>AUTONOMY</key>
    <string>off</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/anicca/.cloak/note-work/note-publish.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/anicca/.cloak/note-work/note-publish.err</string>
</dict>
</plist>
