<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.writer-craft-train</string>

  <!-- 23:10 JST: after the 22:30 learning entry point has scored the day's
       ledger, so the trainer gates on a beat rate that already exists. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>/Users/anicca/Projects/mr-bot-main/skills/writer-agent/scripts/craft-train.sh; /Users/anicca/Projects/mr-bot-main/skills/writer-agent/scripts/craft-train-notify.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>

  <!-- launchd starts with almost no environment. craft-train.sh reads the
       proxy key from the CLIProxyAPI config itself, so no secret lives here,
       but PATH must still reach homebrew python and git. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>ARTICLE_SKILL_DIR</key>
    <string>/Users/anicca/Projects/mr-bot-main/skills/writer-agent</string>
    <key>ARTICLE_STATE_DIR</key>
    <string>/Users/anicca/.local/state/mr-bot/writer</string>
    <key>CRAFT_MD</key>
    <string>/Users/anicca/Projects/mr-bot-main/skills/writer-agent/reference/CRAFT.md</string>
    <key>CRAFT_TRAIN_JSONL</key>
    <string>/Users/anicca/.local/state/mr-bot/writer/craft-train.jsonl</string>
    <key>CRAFT_TRAIN_RUNS_ROOT</key>
    <string>/Users/anicca/.local/state/mr-bot/writer/runs</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/anicca</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/anicca/.openclaw/logs/writer-craft-train.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/anicca/.openclaw/logs/writer-craft-train.err.log</string>
</dict>
</plist>
