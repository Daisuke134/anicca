<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  #66 (2026-07-17, docs/loop-engineering/54-orphan-script-audit-2026-07-17.md finding 1):
  self-improve.sh was fully implemented (SEO topic-queue generation + the L3 measure-learn-
  apply-keep/revert loop that writes state/playbook.json) but had zero caller; no launchd
  plist, no parent script invocation. article-daily.sh STEP 1.5 only READS playbook.json;
  nothing ever WROTE it, so L3 self-improve was structurally dead despite being "done" in
  the spec. This plist is the missing wire.

  Scheduled 22:30 JST: after article-daily.sh's 06:00 run has had a full day to accumulate
  funnel.jsonl data, and before article-diary-digest's 23:30 run (different state files, no
  conflict, but staggered to avoid two claude -p / SEO-API calls firing at the exact same
  minute).

  Activate: cp this ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) \
    ~/Library/LaunchAgents/ai.anicca.article-self-improve.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.article-self-improve</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/anicca/Projects/life-manager-main/skills/writer-agent/scripts/self-improve.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ARTICLE_SKILL_DIR</key>
    <string>/Users/anicca/Projects/life-manager-main/skills/writer-agent</string>
    <key>ARTICLE_STATE_DIR</key>
    <string>/Users/anicca/.local/state/life-manager/writer</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/anicca/.openclaw/logs/article-self-improve.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/anicca/.openclaw/logs/article-self-improve.err</string>
</dict>
</plist>
