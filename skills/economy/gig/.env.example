# economy/gig — required env vars.
# Real values live OUTSIDE this repo at ~/.anicca-signing/gig-board/.env (gitignored, chmod 600) plus
# the already-built facilitator's own ~/.anicca-signing/x402-facilitator/.env. NEVER commit a real
# private key here.

# The gig board's own custody keypair (see README "Escrow model"). Funds pass through this address
# between gig_post (poster -> escrow) and gig_verify_and_pay (escrow -> taker).
GIG_ESCROW_PRIVATE_KEY=0xREPLACE_ME
GIG_ESCROW_ADDRESS=0xREPLACE_ME

# The self-host x402-rs facilitator (P2.1, services/facilitator/). Default matches its default port.
GIG_FACILITATOR_URL=http://127.0.0.1:8405
