<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.connector-daily-report</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/skills/connector/connector_daily_report.sh</string>
  </array>
  <key>StandardErrorPath</key>
  <string>__MR_BOT_HOME__/logs/connector-daily-report.err</string>
  <key>StandardOutPath</key>
  <string>__MR_BOT_HOME__/logs/connector-daily-report.out</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>
</dict>
</plist>
