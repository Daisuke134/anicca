<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.anicca.cadence-deadline-check</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_ROOT__/skills/self/cadence-deadline-check.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardErrorPath</key>
    <string>__LIFE_MANAGER_HOME__/logs/cadence-deadline-check-launchd.err.log</string>
    <key>StandardOutPath</key>
    <string>__LIFE_MANAGER_HOME__/logs/cadence-deadline-check-launchd.out.log</string>
</dict>
</plist>
