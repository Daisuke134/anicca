{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "goal_id", "job_id", "rationale"],
  "additionalProperties": false,
  "oneOf": [
    {"required": ["action"], "not": {"required": ["wait"]}},
    {"required": ["wait"], "not": {"required": ["action"]}}
  ],
  "properties": {
    "schema_version": {"const": 1},
    "goal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 1000},
    "action": {
      "type": "object",
      "required": ["command", "authority", "argv", "confidence"],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1, "maxLength": 128},
        "authority": {"enum": ["READ_ONLY", "WRITE_LOCAL", "SECRET_LOCAL", "MODEL_EXTERNAL", "WRITE_EXTERNAL", "MONEY_RECONCILE", "REPORT"]},
        "argv": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1024}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "wait": {
      "type": "object",
      "required": ["reason", "next_due_at"],
      "additionalProperties": false,
      "properties": {
        "reason": {"enum": ["NO_DUE_ACTION", "EXTERNAL_COOLDOWN", "BUDGET_BLOCKED", "QUARANTINED", "NEEDS_READBACK"]},
        "next_due_at": {"type": "string", "format": "date-time", "maxLength": 64}
      }
    }
  }
}
