# ─── Anicca tmux phone interceptor ──────────────────────────────────────
# Moshi mobile tap runs `tmux attach -t phone`. Intercept and create a NEW
# unique session each time (phone-<unix_ts>) so each tap gives a fresh shell
# that supports scroll in the Moshi terminal.
# Non-matching tmux args fall through to the real binary.
tmux() {
  if [[ "$1" == "attach" && "$2" == "-t" && "$3" == "phone" ]]; then
    local s="phone-$(date +%s)"
    command tmux new-session -A -s "$s" -c "$HOME/anicca-project"
  else
    command tmux "$@"
  fi
}
