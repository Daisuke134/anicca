# Copy to .env.local for a Vite build. Leave blank to keep offline demo mode.
# Real values are public in a shipped web app (Firebase web config is not a secret)
# but a registered App Check debug token must stay out of git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_APPCHECK_SITE_KEY=
# localhost only: true, or a token already registered in the Firebase console.
# Never commit a real debug token. Leave empty for a production reCAPTCHA build.
VITE_APPCHECK_DEBUG_TOKEN=
