# x402-rs facilitator — required env vars.
# Real values live OUTSIDE this repo at ~/.anicca-signing/x402-facilitator/.env
# (gitignored, chmod 600). NEVER commit a real private key here.

# EVM signer for eip155:84532 (Base Sepolia). This wallet pays gas + submits
# settle txs. Fund it with testnet ETH from a faucet before starting.
FACILITATOR_PRIVATE_KEY=0xREPLACE_ME

# Where the facilitator writes logs (used by start.sh).
RUST_LOG=info
