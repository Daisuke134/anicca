<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.x402-endpoint</string>

  <!--
    Boots Anicca's x402 endpoint (Hono on :8403) + cloudflared quick tunnel at
    login and self-heals on crash. The wrapper persists the live https URL to
    ~/.openclaw/state/anicca_x402_url.txt so cron consumers + the agentic.market
    listing payload pick up the current public URL on every fire.
    Source: anicca-oss/.worktrees/earn-x402/services/x402-endpoint/run.sh
    Spec  : /specs/09-EARN-X402-LIVE.md
  -->

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/anicca/anicca-oss/.worktrees/earn-x402/services/x402-endpoint/run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/anicca/anicca-oss/.worktrees/earn-x402/services/x402-endpoint</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- Throttle relaunch to avoid cloudflared cold-start thrash on flaky net. -->
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>/tmp/anicca-x402.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/anicca-x402.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/anicca</string>
  </dict>
</dict>
</plist>
