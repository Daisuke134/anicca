default_platform(:ios)

platform :ios do
  def app_store_connect_api_key_from_env
    key_path = ENV.fetch("ASC_API_KEY_PATH")
    UI.user_error!("ASC_API_KEY_PATH does not point to a file") unless File.file?(key_path)

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      in_house: false
    )
  end

  def simulator_destination
    simulator_udid = ENV["LIFEMANAGER_SIMULATOR_UDID"] || `xcrun simctl list devices available`.lines
      .find { |line| line.include?("iPhone 17 Pro") }
      &.match(/\(([0-9A-F-]{36})\)/i)
      &.captures
      &.first

    simulator_udid ||= "9B260E35-98C8-46A8-B10B-39AE1427C219"
    "platform=iOS Simulator,id=#{simulator_udid}"
  end

  desc "Run the Life Manager smoke tests"
  lane :test do
    run_tests(
      project: "LifeManager.xcodeproj",
      scheme: "LifeManager",
      destination: simulator_destination,
      skip_detect_devices: true,
      derived_data_path: "build/DerivedData",
      clean: true,
      skip_build: false,
      disable_concurrent_testing: true,
      xcargs: "-parallel-testing-enabled NO"
    )
  end

  desc "Build the Life Manager app for the iOS Simulator"
  lane :build_for_simulator do
    build_app(
      project: "LifeManager.xcodeproj",
      scheme: "LifeManager",
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      derived_data_path: "build/DerivedData",
      skip_archive: true,
      skip_codesigning: true,
      clean: true
    )
  end

  desc "Archive and export the signed App Store/TestFlight build"
  lane :build_for_testflight do
    build_number = ENV.fetch("LIFEMANAGER_BUILD_NUMBER")
    increment_build_number(
      xcodeproj: "LifeManager.xcodeproj",
      build_number: build_number
    )
    build_app(
      project: "LifeManager.xcodeproj",
      scheme: "LifeManager",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/TestFlight",
      output_name: "LifeManager.ipa",
      clean: true,
      skip_codesigning: false,
      xcargs: "CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=YES"
    )
  end

  desc "Upload an already-built IPA to TestFlight"
  lane :upload_testflight do
    upload_to_testflight(
      api_key: app_store_connect_api_key_from_env,
      ipa: ENV.fetch("LIFEMANAGER_IPA_PATH", "build/TestFlight/LifeManager.ipa"),
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
  end
end
