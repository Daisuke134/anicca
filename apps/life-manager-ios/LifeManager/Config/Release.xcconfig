// Non-secret release configuration. Local overrides are optional and ignored by git.
LIFEMANAGER_API_BASE_URL = https:/$()/life-call-production.up.railway.app/api/mobile/v1
LIFEMANAGER_CALLBACK_SCHEME = lifemanager
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = LifeManager/Config/Release.entitlements
CODE_SIGNING_ALLOWED[sdk=iphoneos*] = YES
CODE_SIGNING_REQUIRED[sdk=iphoneos*] = YES
CODE_SIGNING_ALLOWED[sdk=iphonesimulator*] = NO
CODE_SIGNING_REQUIRED[sdk=iphonesimulator*] = NO
#include? "Release.local.xcconfig"
