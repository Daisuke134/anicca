# apps/life-voice — env for the FREE Pipecat compositional voice service.
# Copy the two required values from apps/life-call's Railway env so the signed ctx (OQ9) verifies.

# REQUIRED — Groq (STT whisper-large-v3-turbo + LLM llama-3.1-8b-instant). Same key as life-call.
GROQ_API_KEY=gsk_...

# REQUIRED — must be the SAME value as apps/life-call LM_CALL_SECRET, or every /ws upgrade is rejected 1008.
LM_CALL_SECRET=<same value as apps/life-call>

# OPTIONAL — Kokoro TTS model files. Leave UNSET to let kokoro-onnx auto-download them on first init
# (KokoroTTSService._ensure_model_files). Set only if you pre-bake the ONNX + voices into the image.
# KOKORO_MODEL_PATH=/app/models/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=/app/models/voices-v1.0.bin

# Railway injects PORT; default 8080 for local runs.
PORT=8080

# --- CUTOVER (set on apps/life-call, NOT here) ---
# life-call/scheduler.js buildStreamUrl reads PUBLIC_WSS as the bridge host. To route calls to THIS
# service, set life-call's env:  PUBLIC_WSS=wss://<life-voice>.up.railway.app
