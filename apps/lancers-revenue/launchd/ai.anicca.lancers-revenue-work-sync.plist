<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.lancers-revenue-work-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LANCERS_PYTHON__</string>
    <string>__LANCERS_WORK_SYNC__</string>
    <string>--json</string>
    <string>--state-path</string>
    <string>__LANCERS_WORK_SYNC_STATE__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__LANCERS_RUNTIME_PATH__</string></dict>
  <key>WorkingDirectory</key>
  <string>__LANCERS_RELEASE_ROOT__</string>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__LANCERS_WORK_SYNC_STDOUT__</string>
  <key>StandardErrorPath</key>
  <string>__LANCERS_WORK_SYNC_STDERR__</string>
</dict>
</plist>
