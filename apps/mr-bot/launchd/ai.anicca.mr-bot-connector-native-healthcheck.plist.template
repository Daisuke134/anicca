<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.anicca.mr-bot-connector-native-healthcheck</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__REPO_ROOT__/skills/connector/healthcheck.sh</string></array>
  <key>WorkingDirectory</key><string>__REPO_ROOT__</string>
  <key>StartInterval</key><integer>60</integer>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__MR_BOT_HOME__/logs/connector-native-healthcheck.out.log</string>
  <key>StandardErrorPath</key><string>__MR_BOT_HOME__/logs/connector-native-healthcheck.err.log</string>
