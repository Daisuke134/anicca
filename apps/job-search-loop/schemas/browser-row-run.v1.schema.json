{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-row-run.v1.schema.json",
  "title": "Job Hunter sanitized browser row run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "api_version", "row", "run"],
  "properties": {
    "version": {"const": 1},
    "api_version": {"const": "job-hunter-browser-agent/1"},
    "row": {"$ref": "#/$defs/row_envelope"},
    "run": {"$ref": "#/$defs/row_run"}
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/opaque_id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "row_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_id",
        "company",
        "role",
        "canonical_url",
        "provider",
        "ledger_state",
        "candidate_memory_ref",
        "answer_memory_ref",
        "resume",
        "posting",
        "eligibility"
      ],
      "properties": {
        "application_id": {"$ref": "#/$defs/opaque_id"},
        "company": {"type": "string", "minLength": 1, "maxLength": 240},
        "role": {"type": "string", "minLength": 1, "maxLength": 240},
        "canonical_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "provider": {
          "enum": ["workday", "ashby", "greenhouse", "lever", "generic"]
        },
        "ledger_state": {
          "enum": ["qualified", "materials_ready", "not_submitted"]
        },
        "candidate_memory_ref": {"$ref": "#/$defs/opaque_id"},
        "answer_memory_ref": {"$ref": "#/$defs/opaque_id"},
        "resume": {"$ref": "#/$defs/evidence_ref"},
        "posting": {"$ref": "#/$defs/evidence_ref"},
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "policy_version", "evidence"],
          "properties": {
            "decision": {"const": "eligible"},
            "policy_version": {"$ref": "#/$defs/opaque_id"},
            "evidence": {"$ref": "#/$defs/evidence_ref"}
          }
        }
      }
    },
    "run_common": {
      "type": "object",
      "required": [
        "row_run_id",
        "wake_id",
        "step_index",
        "remaining_steps",
        "remaining_seconds",
        "observation_ref",
        "checkpoint_predecessor_sha256",
        "updated_at"
      ],
      "properties": {
        "row_run_id": {"$ref": "#/$defs/opaque_id"},
        "wake_id": {"$ref": "#/$defs/opaque_id"},
        "step_index": {"type": "integer", "minimum": 0},
        "remaining_steps": {"type": "integer", "minimum": 0},
        "remaining_seconds": {"type": "integer", "minimum": 0},
        "observation_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/evidence_ref"}
          ]
        },
        "checkpoint_predecessor_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "pre_submit_run": {
      "allOf": [
        {"$ref": "#/$defs/run_common"},
        {
          "type": "object",
          "required": ["state", "effect_phase"],
          "properties": {
            "state": {
              "enum": [
                "queued",
                "opening",
                "authenticating",
                "observing",
                "acting",
                "recovering",
                "reviewing",
                "checkpointed"
              ]
            },
            "effect_phase": {"const": "pre_submit"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "post_submit_verification_run": {
      "allOf": [
        {"$ref": "#/$defs/run_common"},
        {
          "type": "object",
          "required": [
            "state",
            "effect_phase",
            "intent_id",
            "fence",
            "final_action_receipt"
          ],
          "properties": {
            "state": {"enum": ["submit_claimed", "verifying"]},
            "effect_phase": {"const": "post_submit_verification"},
            "intent_id": {"$ref": "#/$defs/opaque_id"},
            "fence": {"type": "integer", "minimum": 1},
            "final_action_receipt": {"$ref": "#/$defs/evidence_ref"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "row_run": {
      "oneOf": [
        {"$ref": "#/$defs/pre_submit_run"},
        {"$ref": "#/$defs/post_submit_verification_run"}
      ]
    }
  }
}
