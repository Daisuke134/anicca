{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "processed_threads", "processed_thread_ids", "processed_message_ids", "calendar_events", "replies", "assessments", "prep_packs", "verifications", "reports"],
  "properties": {
    "status": {"type": "string"},
    "mercor_work_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "event_id", "next_state", "evidence_ref"],
        "properties": {
          "work_id": {"type": "string", "minLength": 1},
          "event_id": {"type": "string", "minLength": 1},
          "next_state": {
            "enum": ["selected", "contracted", "authorized_work", "work_submitted", "accepted", "paid_settled", "needs_human", "rejected"]
          },
          "evidence_ref": {"type": "string", "minLength": 1},
          "payment_id": {"type": "string", "minLength": 1},
          "settlement_status": {"enum": ["paid", "settled", "completed", "pending"]},
          "amount_usd": {"type": ["string", "number"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "mercor_calendar_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "event_id", "calendar_event_key", "evidence_ref"],
        "properties": {
          "work_id": {"type": "string", "minLength": 1},
          "event_id": {"type": "string", "minLength": 1},
          "calendar_event_key": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "processed_threads": {"type": "integer"},
    "processed_thread_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
    },
    "processed_message_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
    },
    "calendar_events": {"type": "array", "items": {"type": "string"}},
    "replies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id", "status"],
        "properties": {
          "message_id": {"type": "string"},
          "status": {
            "enum": ["sent", "blocked", "route_scheduling", "delivery_unknown"]
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assessment_id", "route", "state"],
        "properties": {
          "assessment_id": {"type": "string"},
          "route": {
            "enum": ["autonomous_allowed", "manual_integrity_gate"]
          },
          "state": {
            "enum": [
              "detected",
              "policy_blocked",
              "prepared",
              "executing",
              "execution_failed",
              "verified",
              "submit_claimed",
              "submit_started",
              "submitted",
              "submit_unknown"
            ]
          }
        }
      }
    },
    "prep_packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interview_key", "status"],
        "properties": {
          "interview_key": {"type": "string"},
          "status": {
            "enum": ["pending_generation", "generated", "sent", "delivery_unknown"]
          }
        }
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id", "tenant", "url_sha256", "status"],
        "properties": {
          "message_id": {"type": "string"},
          "tenant": {"type": "string"},
          "url_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {
            "enum": ["opened", "navigation_unknown", "blocked", "duplicate"]
          }
        }
      }
    },
    "reports": {"type": "array", "items": {"type": "string"}}
  }
}
