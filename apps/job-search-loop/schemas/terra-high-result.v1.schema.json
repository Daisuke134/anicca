{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "mode", "dream_dossiers", "hypothesis", "blocked"],
  "properties": {
    "status": {"type": "string", "enum": ["ok", "blocked"]},
    "mode": {"type": "string", "enum": ["dream", "weekly"]},
    "dream_dossiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_url", "recommendations"],
        "properties": {
          "job_url": {"type": "string"},
          "recommendations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "fact_ids", "source_spans"],
              "properties": {
                "text": {"type": "string"},
                "fact_ids": {"type": "array", "items": {"type": "string"}},
                "source_spans": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "hypothesis": {
      "type": ["object", "null"],
      "properties": {
        "statement": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "single_changed_field": {"type": "string"},
        "expected_metric": {"type": "string"},
        "falsification_rule": {"type": "string"}
      },
      "required": ["statement", "evidence_ids", "single_changed_field", "expected_metric", "falsification_rule"],
      "additionalProperties": false
    },
    "blocked": {"type": "array", "items": {"type": "string"}}
  }
}
