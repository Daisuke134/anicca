<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.anicca.job-search-daily</string>
  <key>ProgramArguments</key><array>
    <string>__JOB_SEARCH_DAILY_PROGRAM__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer>
  </dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__JOB_SEARCH_DAILY_STDOUT__</string>
  <key>StandardErrorPath</key><string>__JOB_SEARCH_DAILY_STDERR__</string>
</dict></plist>
