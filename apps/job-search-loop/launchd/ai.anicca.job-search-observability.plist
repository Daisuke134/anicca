<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.anicca.job-search-observability</string>
  <key>ProgramArguments</key><array>
    <string>__COLLECTOR_BINARY__</string>
    <string>--config=__COLLECTOR_CONFIG__</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>JOB_HUNTER_TRACE_PATH</key><string>__TRACE_PATH__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__STDOUT__</string>
  <key>StandardErrorPath</key><string>__STDERR__</string>
</dict></plist>
