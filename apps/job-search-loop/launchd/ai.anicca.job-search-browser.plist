<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.anicca.job-search-browser</string>
  <key>ProgramArguments</key><array>
    <string>__JOB_SEARCH_BROWSER_PROGRAM__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__JOB_SEARCH_BROWSER_STDOUT__</string>
  <key>StandardErrorPath</key><string>__JOB_SEARCH_BROWSER_STDERR__</string>
</dict></plist>
