# Life Manager owns these roots in both local and cloud modes.
LM_MODE=local
LM_DATA_DIR=/absolute/path/to/life-manager/data
LM_CACHE_DIR=/absolute/path/to/life-manager/cache

# Jobs store references only. Secret values live in the local keychain or tenant vault.
TELEGRAM_BOT_TOKEN_REF=secret://telegram/bot-token
POSTIZ_ACCESS_TOKEN_REF=secret://postiz/access-token
REVENUECAT_API_KEY_REF=secret://revenuecat/api-key
