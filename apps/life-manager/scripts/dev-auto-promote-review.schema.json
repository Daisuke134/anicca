{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reviewed_head", "blocking_findings", "evidence"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "reviewed_head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
