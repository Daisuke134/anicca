<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.anicca.life-manager-ugig-invoice-observer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__APP_DIR__/scripts/ugig-invoice-observer-boot.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/life-manager/logs/life-manager-ugig-invoice-observer.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/life-manager/logs/life-manager-ugig-invoice-observer.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
