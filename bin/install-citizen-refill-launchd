#!/usr/bin/env node
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { execFileSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const LABEL = "ai.anicca.citizen-refill";
const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const home = os.homedir();
const uid = process.getuid();
const templatePath = path.join(repoRoot, "launchd", `${LABEL}.plist.template`);
const targetPath = path.join(home, "Library", "LaunchAgents", `${LABEL}.plist`);
const logDir = path.join(home, ".anicca", "logs");

const rendered = fs.readFileSync(templatePath, "utf8")
  .replaceAll("__HOME__", home)
  .replaceAll("__REPO_ROOT__", repoRoot);

fs.mkdirSync(logDir, { recursive: true });
fs.mkdirSync(path.dirname(targetPath), { recursive: true });
fs.writeFileSync(targetPath, rendered, { mode: 0o644 });

try {
  execFileSync("launchctl", ["bootout", `gui/${uid}/${LABEL}`], { stdio: "ignore" });
} catch {
  // A first install has nothing to unload.
}
execFileSync("launchctl", ["bootstrap", `gui/${uid}`, targetPath]);
execFileSync("launchctl", ["enable", `gui/${uid}/${LABEL}`]);
execFileSync("launchctl", ["kickstart", "-k", `gui/${uid}/${LABEL}`]);
process.stdout.write(`${LABEL} installed and triggered\n`);
