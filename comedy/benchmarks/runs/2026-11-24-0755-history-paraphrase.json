  "evaluation_source": "import json,sys,platform,subprocess\nfrom pathlib import Path\nfrom collections import Counter\nimport validate_run as v\nimport audit_improv_relevance as a\nroot=Path(__file__).resolve().parent\ndata=json.loads((root/'cases.json').read_text())\ntasks=[]; rows=[]\nfor c in data['cases']:\n    tasks.append(dict(id=c['id'],kind='adlib',category='phone_ai_stage',prompt=c['history']+'\\nダイス：'+data['cue'],any_of=[c['character']],cue_ack_any_of=['お客様'],action_any_of=['手配','発行','登録'],max_chars=110,max_questions=0,forbidden=['深呼吸','吸って','吐いて','住所を教えて','窓の外','台本を確認']))\n    for k in ('literal','paraphrase','negative'):\n        rows.append(dict(task_id=c['id'],candidate=k,response=c[k],model='ChatGPT GPT-6.2',model_version=None,skill_blob_sha=data['skill_blob_sha'],invocation_source='chat_session_constructed',modality='text'))\nreport={}\nfor k in ('literal','paraphrase','negative'):\n    r=[x for x in rows if x['candidate']==k]\n    ar=a.audit(tasks,r,candidates_per_task=1)\n    items=[]\n    for t,x,y,c in zip(tasks,r,ar['items'],data['cases']):\n        assert t['id']==x['task_id']==y['task_id']==c['id']\n        marker=c['marker'] in x['response'] and c['other'] not in x['response']\n        items.append(dict(task_id=t['id'],format_issues=v.score(t,x['response']),literal_gate=y['gate'],literal_reasons=y['reasons'],history_marker=marker,combined_gate=not v.score(t,x['response']) and y['gate']=='PASS' and marker))\n    report[k]={'n':len(items),'format_pass':sum(not x['format_issues'] for x in items),'literal_pass':ar['passed'],'history_marker_pass':sum(x['history_marker'] for x in items),'combined_pass':sum(x['combined_gate'] for x in items),'items':items}\nfixed=[]\nfor t in v.jsonl(root/'injury-stage-exact-2026-11-23.jsonl'):\n    correct=t.get('expected_exact','')\n    for label,response in [('synthetic_positive',correct),('synthetic_negative',correct+'確認します。')]:\n        issues=v.score(t,response)\n        fixed.append(dict(task_id=t['id'],kind=label,response=response,issues=issues,expected_match=bool(issues)==(label=='synthetic_negative')))\nassert len(tasks)==6 and len(rows)==18\nassert all(x['expected_match'] for x in fixed)\ndata['tasks']=tasks\ndata['responses']=rows\ndata['evaluation']={'python':platform.python_version(),'method':'canonical validate_run.score and audit_improv_relevance.audit plus reconstructed literal history marker proxy; constructed examples, no semantic human gold','conditions':report,'fixed_stage_contract':fixed}\ndata['evaluation_source']=Path(__file__).read_text()\n(root/'result.json').write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\\n')\nprint(json.dumps({k:{i:j for i,j in r.items() if i!='items'} for k,r in report.items()},ensure_ascii=False))\nprint('fixed expected matches',sum(x['expected_match'] for x in fixed),len(fixed))\n\n"
