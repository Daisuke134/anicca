{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fields"],
  "properties": {
    "version": {"const": 1},
    "fields": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]{1,79}$"},
      "additionalProperties": {"$ref": "#/$defs/field"}
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacy", "source", "purpose", "scopes", "updated_at", "expires_at",
        "consent", "value", "secret_ref", "evidence_sha256"
      ],
      "properties": {
        "privacy": {"enum": ["reusable", "provider_only", "secret_ref"]},
        "source": {"enum": ["owner_input", "provider_readback", "imported"]},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 240},
        "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9*][a-z0-9._*-]{0,79}$"}},
        "updated_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "consent": {
          "type": "object", "additionalProperties": false,
          "required": ["granted", "granted_at"],
          "properties": {
            "granted": {"type": "boolean"},
            "granted_at": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "value": {"type": ["string", "null"], "maxLength": 10000},
        "secret_ref": {"type": ["string", "null"], "pattern": "^(credentials|keychain|provider):"},
        "evidence_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"privacy": {"const": "reusable"}}},
          "then": {"properties": {"value": {"type": "string", "minLength": 1}, "secret_ref": {"type": "null"}, "evidence_sha256": {"type": "null"}}}
        },
        {
          "if": {"properties": {"privacy": {"const": "provider_only"}}},
          "then": {"properties": {"value": {"type": "null"}, "secret_ref": {"type": "null"}, "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
        },
        {
          "if": {"properties": {"privacy": {"const": "secret_ref"}}},
          "then": {"properties": {"value": {"type": "null"}, "secret_ref": {"type": "string", "pattern": "^(credentials|keychain|provider):"}, "evidence_sha256": {"type": "null"}}}
        }
      ]
    }
  }
}
