{
  "mcpServers": {
    "conway": {
      "command": "npx",
      "args": [
        "-y",
        "@nicepkg/conway-mcp"
      ],
      "env": {}
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        "/Users/anicca/anicca-project"
      ],
      "env": {}
    }
  }
}