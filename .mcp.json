{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "serena-mcp"
      ],
      "env": {}
    },
    "maestro": {
      "command": "npx",
      "args": [
        "-y",
        "@nicepkg/maestro-mcp"
      ],
      "env": {}
    },
    "conway": {
      "command": "npx",
      "args": [
        "-y",
        "@nicepkg/conway-mcp"
      ],
      "env": {}
    }
  }
}